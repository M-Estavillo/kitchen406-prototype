        <bpmn:flowNodeRef>Confirm_36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel_36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ViewUpdated_36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_36</bpmn:flowNodeRef>
      </bpmn:lane>
