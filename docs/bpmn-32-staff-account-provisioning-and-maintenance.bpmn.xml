      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_36" name="Administrator opens Staff account maintenance">
      <bpmn:outgoing>Flow_36_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Access_36" name="Check Admin/Owner permission; load Staff registry">
      <bpmn:documentation>FR-STAFF-01-02; NFR-SEC-03. Enforce server-side administrator authorization before exposing Staff management data. Current authenticated session is from BPMN-26. Customer directory maintenance is outside this process.</bpmn:documentation>
      <bpmn:incoming>Flow_36_1</bpmn:incoming>
      <bpmn:outgoing>Flow_36_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed_36" name="Administrator access allowed?">
      <bpmn:incoming>Flow_36_2</bpmn:incoming>
      <bpmn:outgoing>Flow_36_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_36_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Denied_36" name="Explain permission/load failure; keep account records unchanged">
      <bpmn:incoming>Flow_36_3</bpmn:incoming>
      <bpmn:outgoing>Flow_36_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DeniedEnd_36" name="Maintenance denied; no changes">
      <bpmn:incoming>Flow_36_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Draft_36" name="Choose Create, Update or Deactivate; enter/review Staff details">
      <bpmn:documentation>For create enter permitted Staff profile and initial credentials. For update select Staff account and edit permitted profile fields. For deactivate select account and review access-removal consequence. No role elevation, self-service Staff provisioning, password-reset or deletion is authorized by this screen. Review the selected operation before submitting; leaving cancels.</bpmn:documentation>
      <bpmn:incoming>Flow_36_5</bpmn:incoming>
      <bpmn:incoming>Flow_36_11</bpmn:incoming>
      <bpmn:outgoing>Flow_36_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirm_36" name="Administrator confirms change?">
      <bpmn:incoming>Flow_36_6</bpmn:incoming>
      <bpmn:outgoing>Flow_36_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_36_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Cancel_36" name="Cancelled; account/access state retained">
      <bpmn:incoming>Flow_36_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Check_36" name="Validate action, profile/credentials and current Staff record">
      <bpmn:documentation>FR-STAFF-01-03; NFR-SEC-08. Recognize create/update/deactivate. Creation/update require valid permitted names/email; case-insensitive email uniqueness across login identities follows prototype M.duplicate. Initial password required only on creation; validate configured supported policy without inventing an SRS-specific minimum. Update/deactivate require existing Staff target and expected current version; stale/missing/non-Staff target is rejected, not recreated or promoted. Deactivation needs no re-entry of profile/password. Original creator must remain attached. Requested role/access cannot grant admin/financial/customer-management rights. Same successful operation reuses result rather than creating duplicates.</bpmn:documentation>
      <bpmn:incoming>Flow_36_8</bpmn:incoming>
      <bpmn:outgoing>Flow_36_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Valid_36" name="Input and current record valid?">
      <bpmn:incoming>Flow_36_9</bpmn:incoming>
      <bpmn:outgoing>Flow_36_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_36_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="InputError_36" name="Explain invalid fields, duplicate email or stale/missing Staff target">
      <bpmn:documentation>Explain invalid fields, duplicate email or an outdated or missing Staff account. Keep saved records unchanged and return to the form so the Admin/Owner can correct the details, choose a current Staff record or cancel.</bpmn:documentation>
      <bpmn:incoming>Flow_36_10</bpmn:incoming>
      <bpmn:outgoing>Flow_36_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Action_36" name="Requested Staff account action?">
      <bpmn:incoming>Flow_36_12</bpmn:incoming>
      <bpmn:outgoing>Flow_36_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_36_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_36_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Create_36" name="Prepare new Staff account">
      <bpmn:documentation>Prepare an active Staff account with the authenticated creating administrator and Staff access. Hash the initial password before storage.</bpmn:documentation>
      <bpmn:incoming>Flow_36_13</bpmn:incoming>
      <bpmn:outgoing>Flow_36_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Update_36" name="Prepare Staff profile updates">
      <bpmn:documentation>Prepare permitted profile changes and preserve the original creator, Staff role, active status and unchanged credential.</bpmn:documentation>
      <bpmn:incoming>Flow_36_14</bpmn:incoming>
      <bpmn:outgoing>Flow_36_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Deactivate_36" name="Prepare Staff deactivation">
      <bpmn:documentation>Prepare inactive status, actor, time and history. Once saved, BPMN-26 denies future access, including protected requests from existing sessions.</bpmn:documentation>
      <bpmn:incoming>Flow_36_15</bpmn:incoming>
      <bpmn:outgoing>Flow_36_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SaveResult_36" name="Save changes">
      <bpmn:documentation>Save the requested account and access change together. At save, check administrator access and the latest record, email uniqueness and operation identity as applicable. Preserve history and existing values on failure. Use the saved result for a matching repeated request.</bpmn:documentation>
      <bpmn:incoming>Flow_36_16</bpmn:incoming>
      <bpmn:incoming>Flow_36_17</bpmn:incoming>
      <bpmn:incoming>Flow_36_18</bpmn:incoming>
      <bpmn:outgoing>Flow_36_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SaveError_36" name="Return conflict/save failure; preserve latest account and access state">
      <bpmn:documentation>Failed combined update leaves no orphan account, overwritten creator, partial role/status or inconsistent access permission. Keep independently committed newer data. Repeated operation uses recorded result; conflict requires refresh/review/retry. Failed create does not create duplicate account. No plaintext password/error details disclosed.</bpmn:documentation>
      <bpmn:incoming>Flow_36_19</bpmn:incoming>
      <bpmn:outgoing>Flow_36_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="SaveFailed_36" name="No change saved by this attempt; review/retry">
      <bpmn:incoming>Flow_36_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Show_36" name="Show saved Staff details">
      <bpmn:documentation>FR-STAFF-04-06. Display created/updated/inactive result to administrator, with creator association retained. Active Staff may perform permitted operations and preparing-owner entry only; financial analytics, allocated sales/cost/profit, pricing and customer management remain owner-only. Staff performer never receives an owner allocation automatically. BPMN-26 enforces active status and role on actual Staff access; no staff login is initiated here.</bpmn:documentation>
      <bpmn:incoming>Flow_36_21</bpmn:incoming>
      <bpmn:outgoing>Flow_36_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_36" name="Updated Staff details viewed">
      <bpmn:incoming>Flow_36_ViewEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="SaveFailedBoundary_36" name="Save failed" attachedToRef="SaveResult_36" cancelActivity="true">
      <bpmn:outgoing>Flow_36_19</bpmn:outgoing>
      <bpmn:errorEventDefinition id="StaffSaveErrorDefinition_36" errorRef="StaffSaveFailure_36" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ViewUpdated_36" name="View updated Staff details">
      <bpmn:incoming>Flow_36_22</bpmn:incoming>
      <bpmn:outgoing>Flow_36_ViewEnd</bpmn:outgoing>
    </bpmn:userTask>
