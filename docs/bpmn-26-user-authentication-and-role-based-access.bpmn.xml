<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_26" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:message id="Message_Protected" name="Protected action requested" />
  <bpmn:collaboration id="Collaboration_26">
    <bpmn:participant id="Pool_Protected" name="Protected Kitchen406 Workflow">
      <bpmn:documentation>The requesting workflow supplies the action and applicable record context. It proceeds with its own business rules only when access is granted.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Pool_30" name="BPMN-26 | User Authentication and Role-Based Access" processRef="Process_26" />
    <bpmn:messageFlow id="MessageFlow_Protected" sourceRef="Pool_Protected" targetRef="Start_Protected" messageRef="Message_Protected" />
  </bpmn:collaboration>
  <bpmn:process id="Process_26" name="User Authentication and Role-Based Access" isExecutable="false">
    <bpmn:documentation>Sources: proposed-bpmn-catalog.md BPMN-26 and handoff rules; Kitchen406 - Capstone Paper.md SRS 4.1.2, FR-AUTH-02 through FR-AUTH-05 and FR-AUTH-07, NFR-SEC-02 through NFR-SEC-05; index.html and linked app/auth.js, app/session-state.js and role-specific workspaces. The proposed system follows the SRS for registered credentials and server-side enforcement. Sign-in, authorization of each protected action, and session termination are independently triggered. Account verification and password recovery are references to BPMN-27 and BPMN-28, respectively, under FR-AUTH-06.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_30">
      <bpmn:lane id="Lane_User" name="Customer, Staff or Admin/Owner">
        <bpmn:flowNodeRef>Start_SignIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Logout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Task_Authenticate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Authenticated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Feedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Establish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SignedIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Protected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Authorize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Authorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Expiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Closure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Invalidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Session</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_SignIn" name="Sign-in requested">
      <bpmn:documentation>A registered user opens sign-in, including when a customer needs to authenticate before completing a transaction.</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Submit email and password">
      <bpmn:documentation>Enter the account credentials. Password recovery can be requested separately through BPMN-28.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Authenticate" name="Validate credentials and account eligibility">
      <bpmn:documentation>FR-AUTH-03 and NFR-SEC-02. Validate input and verify the submitted credentials against the registered account and its protected password hash. Require an active account and applicable verification or setup.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Authenticated" name="Sign-in valid?" gatewayDirection="Diverging" default="F04">
      <bpmn:documentation>Only verified credentials for an eligible account permit a session. Invalid input, bad credentials, ineligible accounts and an unavailable authentication check take the failure path.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Feedback" name="Show sign-in error or next step">
      <bpmn:documentation>Show appropriate correction or retry feedback. If customer verification is required, refer to BPMN-27. A new sign-in attempt starts separately.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NoSession" name="Sign-in unsuccessful">
      <bpmn:documentation>No new authenticated session is granted.</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Establish" name="Establish session and provide assigned role access">
      <bpmn:documentation>FR-AUTH-04 and NFR-SEC-05. Establish a secure session for the account and provide the applicable Customer, Staff, or Admin/Owner entry point based on its assigned role.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_SignedIn" name="Role-specific session active">
      <bpmn:documentation>Protected functions still require a server-side authorization decision for each request.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Protected" name="Protected action requested">
      <bpmn:documentation>The business workflow requests an authorization decision for the specific function and data involved.</bpmn:documentation>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_Protected" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_Authorize" name="Check session, role and record access">
      <bpmn:documentation>FR-AUTH-02, 05, 07 and NFR-SEC-03 through 05. Check the session and assigned role on the server. Deny Staff access to administrator-only functions. Apply ownership checks to private customer data where applicable.</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Authorized" name="Action authorized?" gatewayDirection="Diverging" default="F11">
      <bpmn:documentation>Only a valid session with permission for the requested function and data may proceed.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Allowed" name="Access granted">
      <bpmn:documentation>The requesting workflow may proceed with its own validations.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Denied" name="Access denied">
      <bpmn:documentation>Block the action and protected data. When the session is missing, invalid or expired, require sign-in for subsequent protected access.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Logout" name="User requests logout">
      <bpmn:documentation>The authenticated user selects Sign Out for the active session.</bpmn:documentation>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_Expiry" name="Session reaches its expiry">
      <bpmn:documentation>The session reaches the expiry set by server policy. No fixed duration is specified in the SRS.</bpmn:documentation>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">The tracked active session has reached its configured expiration.</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Closure" gatewayDirection="Converging">
      <bpmn:documentation>Either logout or expiry initiates invalidation for the affected session.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Invalidate" name="Invalidate the affected session">
      <bpmn:documentation>NFR-SEC-05. End the session server-side. Further protected requests using it are denied.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Session" name="Session ended">
      <bpmn:documentation>Any further protected access requires a valid authenticated session.</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_SignIn" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Submit" targetRef="Task_Authenticate" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Authenticate" targetRef="Gateway_Authenticated" />
    <bpmn:sequenceFlow id="F04" sourceRef="Gateway_Authenticated" targetRef="Task_Feedback" name="No" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_Feedback" targetRef="End_NoSession" />
    <bpmn:sequenceFlow id="F06" sourceRef="Gateway_Authenticated" targetRef="Task_Establish" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Credentials are valid and the account is eligible.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F07" sourceRef="Task_Establish" targetRef="End_SignedIn" />
    <bpmn:sequenceFlow id="F08" sourceRef="Start_Protected" targetRef="Task_Authorize" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Authorize" targetRef="Gateway_Authorized" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gateway_Authorized" targetRef="End_Allowed" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The session, role permissions, and applicable record access permit the requested action.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="Gateway_Authorized" targetRef="End_Denied" name="No" />
    <bpmn:sequenceFlow id="F12" sourceRef="Start_Logout" targetRef="Gateway_Closure" />
    <bpmn:sequenceFlow id="F13" sourceRef="Start_Expiry" targetRef="Gateway_Closure" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gateway_Closure" targetRef="Task_Invalidate" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Invalidate" targetRef="End_Session" />
  </bpmn:process>
