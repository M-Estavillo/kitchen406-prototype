<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_25" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:message id="Message_OperationalEvent" name="Notification-relevant operational event" />
  <bpmn:error id="Error_ReadSave" name="Read status save failed" />
  <bpmn:collaboration id="Collaboration_25">
    <bpmn:participant id="Pool_Source" name="Originating Kitchen406 workflow">
      <bpmn:documentation>Examples: BPMN-06 subscription deferment, BPMN-11 reservation blocked by insufficient stock, BPMN-23 low-stock threshold alert (including after a successful reservation), or the owner alert from BPMN-24 after external retries are exhausted. Each source owns its event and business outcome.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Pool_29" name="BPMN-25 | Internal Notification Creation and Read Acknowledgment" processRef="Process_25" />
    <bpmn:messageFlow id="Flow_OperationalEvent" sourceRef="Pool_Source" targetRef="Start_Operational" messageRef="Message_OperationalEvent" />
  </bpmn:collaboration>
  <bpmn:process id="Process_25" name="Internal Notification Creation and Read Acknowledgment" isExecutable="false">
    <bpmn:documentation>Sources: proposed-bpmn-catalog.md, BPMN-25; Kitchen406 - Capstone Paper.md, SRS 4.17.2 and FR-NOTIF-08 through FR-NOTIF-10; NFR-SEC-03, 05 and NFR-AVL-02. The prototype routes linked by index.html show notification lists, View details, Mark all as read, unread indicators, and failed-save feedback for Owner and Staff. Read state scoped to the recipient account follows the SRS. Creation and later acknowledgment are independent top-to-bottom paths; either can finish without the other running. The originating workflow hands off a relevant event and continues independently. Refer to BPMN-24 for email/SMS dispatch and retry. Refer to BPMN-26 for the prerequisite authenticated workspace session; this process applies its access rules to the specific acknowledgment target.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_29">
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Start_Operational</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Role</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SaveFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Read</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Recipient" name="Admin/Owner or Staff Recipient">
        <bpmn:flowNodeRef>Start_Workspace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Acknowledge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Operational" name="Operational event received">
      <bpmn:documentation>Input: notification-relevant event and related activity reference. The source owns the business action and any event-specific qualification.</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_OperationalEvent" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_Role" name="Determine intended recipient role">
      <bpmn:documentation>FR-NOTIF-08 and 09: Select the applicable Admin/Owner or Staff audience based on the operational event.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_Create" name="Publish role-targeted notification">
      <bpmn:documentation>FR-NOTIF-08 through 10: Store the notice with its intended role and related system activity. Make it visible to intended accounts, with each account initially seeing its own unread state.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Available" name="Notification available">
      <bpmn:documentation>The creation instance ends here. Each intended account retains its own unread state until that account acknowledges the notice.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Workspace" name="Acknowledgment initiated later">
      <bpmn:documentation>An Admin/Owner or Staff recipient initiates an acknowledgment in the Notifications workspace under the session established by BPMN-26.</bpmn:documentation>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Acknowledge" name="Select View details or Mark all as read">
      <bpmn:documentation>View details targets one notice. Mark all as read targets the notices available to this account, including those outside the current UI filter. Browsing or leaving without either action preserves unread state.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Check" name="Check session, role and notification access">
      <bpmn:documentation>Apply BPMN-26 session and role access rules to the acting account. Verify the selected notice still exists and is visible to that account, or resolve the set of visible notices for Mark all as read.</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Allowed" name="Action allowed?" gatewayDirection="Diverging" default="F07">
      <bpmn:documentation>The session and role must allow access and a singly selected notice must still be available to the account.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Denied" name="Denied or notice unavailable">
      <bpmn:documentation>Reject the action without disclosing a protected notice or changing read state.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Save" name="Save read status for this account">
      <bpmn:documentation>FR-NOTIF-10: Mark the applicable notices read for this account only. Repeated acknowledgments preserve already-read state. On failed save preserve prior read state.</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_Save" attachedToRef="Task_Save" cancelActivity="true">
      <bpmn:documentation>A failed acknowledgment save interrupts this task.</bpmn:documentation>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_ReadSave" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_SaveFailed" name="Save failed · Retry available">
      <bpmn:documentation>Report the failed read-status save. A retry is a later user action and rechecks access.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Show" name="Refresh unread indicators and open details if selected">
      <bpmn:documentation>Refresh the acting account’s list and unread count. For View details, open the linked activity subject to its access controls. Mark all as read stays in Notifications.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Read" name="Read status retained for this account">
      <bpmn:documentation>Other recipient accounts retain their independent read state.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Operational" targetRef="Task_Role" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Role" targetRef="Task_Create" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Create" targetRef="End_Available" />
    <bpmn:sequenceFlow id="F04" sourceRef="Start_Workspace" targetRef="Task_Acknowledge" />
    <bpmn:sequenceFlow id="F05" sourceRef="Task_Acknowledge" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_Check" targetRef="Gateway_Allowed" />
    <bpmn:sequenceFlow id="F07" sourceRef="Gateway_Allowed" targetRef="End_Denied" name="No" />
    <bpmn:sequenceFlow id="F08" sourceRef="Gateway_Allowed" targetRef="Task_Save" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The acting account is authorized and the requested acknowledgment is available.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Save" targetRef="Task_Show" />
    <bpmn:sequenceFlow id="F10" sourceRef="Boundary_Save" targetRef="End_SaveFailed" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Show" targetRef="End_Read" />
  </bpmn:process>
