      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_33" name="Administrator requests product or variant maintenance">
      <bpmn:outgoing>Flow_33_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Access_33" name="Load catalog entry and current version">
      <bpmn:documentation>FR-CAT-03-04; NFR-SEC-03. Authorized Admin/Owner page access is established before entry. Load existing product/variant where selected, catalog/version context and saved recipe/price references; new product/variant has no existing target. Staff cannot edit catalog or owner pricing.</bpmn:documentation>
      <bpmn:incoming>Flow_33_1</bpmn:incoming>
      <bpmn:outgoing>Flow_33_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed_33" name="Catalog entry available for this action?">
      <bpmn:incoming>Flow_33_2</bpmn:incoming>
      <bpmn:outgoing>Flow_33_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AccessError_33" name="Explain missing entry or loading failure; retain catalog">
      <bpmn:incoming>Flow_33_3</bpmn:incoming>
      <bpmn:outgoing>Flow_33_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AccessEnd_33" name="Maintenance blocked; no changes">
      <bpmn:incoming>Flow_33_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Edit_33" name="Create/edit product or variant; set images, availability and subscription eligibility">
      <bpmn:documentation>FR-CAT-01-05. Edit product name/description/images, supported category association and variant labels/status; select activation/deactivation and subscription eligibility. Review existing variant final prices; if a price/recipe is changed, use BPMN-36/35 rules rather than catalog auto-pricing. Prototype separate variant form preserves existing prices on label/status edits. Deactivation prevents new selection, not fulfillment of paid orders. Unselecting a variant must not delete purchased references. Multiple variant support does not require a separate product for each variation.</bpmn:documentation>
      <bpmn:incoming>Flow_33_31</bpmn:incoming>
      <bpmn:incoming>Flow_33_5</bpmn:incoming>
      <bpmn:outgoing>Flow_33_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirm_33" name="Administrator confirms requested changes?">
      <bpmn:incoming>Flow_33_6</bpmn:incoming>
      <bpmn:outgoing>Flow_33_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Cancel_33" name="Cancelled; saved catalog retained">
      <bpmn:incoming>Flow_33_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Validate_33" name="Validate catalog fields, variant references and related saved inputs">
      <bpmn:documentation>FR-CAT-01-05; NFR-SEC-08. Validate action/target/version, applicable product name/description/category/image choice and supported variants. Prototype requires name/description, valid category, at least one selected variant on product save, unique variant label within product and positive finite selected final prices. Apply only fields relevant to current operation; activation-only does not require re-entering product/price. Reuse saved recipe references (BPMN-35) and owner-reviewed final price inputs (BPMN-36); distinguish valid draft catalog creation from missing ordering readiness. Never infer zero/missing cost as a price or change approved final price from a suggestion. Subscription eligibility refers to future offerings; do not rewrite confirmed schedule/address/amount commitments. If dependent edits accompany same form, validate them under their owning rules before any combined save.</bpmn:documentation>
      <bpmn:incoming>Flow_33_34</bpmn:incoming>
      <bpmn:incoming>Flow_33_8</bpmn:incoming>
      <bpmn:outgoing>Flow_33_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Valid_33" name="Catalog input and version valid?">
      <bpmn:incoming>Flow_33_9</bpmn:incoming>
      <bpmn:outgoing>Flow_33_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="InputError_33" name="Explain input/version issue; retain editable draft and saved catalog">
      <bpmn:documentation>Return exact issue; correct relevant input or reopen latest entry. Preserve latest saved catalog, recipe/price and existing purchases. Do not invent unique product-name constraint or require complete stock just to save a catalog record.</bpmn:documentation>
      <bpmn:incoming>Flow_33_10</bpmn:incoming>
      <bpmn:outgoing>Flow_33_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NewImage_33" name="Selected image still needs upload?">
      <bpmn:documentation>Upload only new/changed selected media without an already successful usable upload reference. An unchanged successfully stored image is reused after local save failure. A failed upload retains the proposed file for validation/retry; choosing a different file invalidates prior validation/reference.</bpmn:documentation>
      <bpmn:incoming>Flow_33_12</bpmn:incoming>
      <bpmn:outgoing>Flow_33_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="CheckImage_33" name="Validate uploaded image type and size before storage">
      <bpmn:documentation>NFR-SEC-09. Permit only supported image file types/sizes under configured rules; reject unsupported/executable content. Do not invent a size limit or assume file extension alone is sufficient. Existing validated media selection/reference bypasses a new upload.</bpmn:documentation>
      <bpmn:incoming>Flow_33_13</bpmn:incoming>
      <bpmn:outgoing>Flow_33_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ImageValid_33" name="Image permitted?">
      <bpmn:incoming>Flow_33_15</bpmn:incoming>
      <bpmn:outgoing>Flow_33_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ImageError_33" name="Explain unsupported image; retain draft for correction">
      <bpmn:incoming>Flow_33_16</bpmn:incoming>
      <bpmn:outgoing>Flow_33_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Upload_33" name="Store validated product image through Cloudinary">
      <bpmn:documentation>Use supported protected integration; return usable media reference or safe provider failure. Keep current catalog/image until final save succeeds. No unsupported automatic deletion of remote assets after a later local failure. Upload alone does not activate or publish product.</bpmn:documentation>
      <bpmn:incoming>Flow_33_18</bpmn:incoming>
      <bpmn:outgoing>Flow_33_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Uploaded_33" name="Usable image reference returned?">
      <bpmn:incoming>Flow_33_19</bpmn:incoming>
      <bpmn:outgoing>Flow_33_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="UploadError_33" name="Explain upload failure; retain file and draft for safe retry">
      <bpmn:incoming>Flow_33_20</bpmn:incoming>
      <bpmn:outgoing>Flow_33_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Save_33" name="Save product/variant changes, activation and subscription eligibility consistently">
      <bpmn:documentation>Recheck administrator session/action permission, target and current catalog/dependent version at commit. Create distinct product/variant or update existing fields; retain stable references to inactive variants needed by history. Preserve unchanged saved recipe and final price; supplied combined recipe/price/schedule drafts must save consistently only after owning rule validation. Save activation/deactivation and subscription flag, supported media reference and catalog version together. Failed combined update commits no partial catalog/dependent changes; preserve independently committed newer state. Use safe repeated-operation identity/record context to avoid duplicate creates. Never rewrite purchased item price/quantity/configuration snapshots, subscription amounts/schedules or preparing-owner shares.</bpmn:documentation>
      <bpmn:incoming>Flow_33_22</bpmn:incoming>
      <bpmn:incoming>Flow_33_14</bpmn:incoming>
      <bpmn:outgoing>Flow_33_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Saved_33" name="Catalog changes saved?">
      <bpmn:incoming>Flow_33_23</bpmn:incoming>
      <bpmn:outgoing>Flow_33_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SaveError_33" name="Explain save/conflict failure; retain draft and successful media reference">
      <bpmn:documentation>No partial published product, activation flag, variant, price or recipe update. Refresh/review before retry; reuse known completed request result rather than duplicate creation. Existing remote upload does not mean catalog save succeeded. Old purchase commitments remain intact.</bpmn:documentation>
      <bpmn:incoming>Flow_33_24</bpmn:incoming>
      <bpmn:outgoing>Flow_33_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Refresh_33" name="Refresh storefront details and applicable ordering/subscription eligibility">
      <bpmn:documentation>FR-CAT-01-05. Show saved product information, images, variant/final price and availability consistently. Inactive product/variant cannot be selected for new transactions. Active still requires applicable recipe/stock controls owned by BPMN-23/shared inventory rules and final checkout BPMN-09; no ingredient/capacity reservation here. Subscription flag makes applicable configured offerings eligible for future enrollment through BPMN-03/34; it does not create a schedule or activate prepaid subscriptions. Preserve existing confirmed commitments when catalog eligibility is removed. A display refresh failure does not roll back a successfully saved catalog; refresh safely from saved records.</bpmn:documentation>
      <bpmn:incoming>Flow_33_37</bpmn:incoming>
      <bpmn:incoming>Flow_33_26</bpmn:incoming>
      <bpmn:outgoing>Flow_33_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_33" name="Catalog maintained; storefront reflects saved availability">
      <bpmn:incoming>Flow_33_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_33_1" sourceRef="Start_33" targetRef="Access_33" />
    <bpmn:sequenceFlow id="Flow_33_2" sourceRef="Access_33" targetRef="Allowed_33" />
    <bpmn:sequenceFlow id="Flow_33_3" sourceRef="Allowed_33" targetRef="AccessError_33" name="No" />
    <bpmn:sequenceFlow id="Flow_33_4" sourceRef="AccessError_33" targetRef="AccessEnd_33" />
    <bpmn:sequenceFlow id="Flow_33_5" sourceRef="Allowed_33" targetRef="Edit_33" name="Yes" />
    <bpmn:sequenceFlow id="Flow_33_6" sourceRef="Edit_33" targetRef="Confirm_33" />
    <bpmn:sequenceFlow id="Flow_33_7" sourceRef="Confirm_33" targetRef="Cancel_33" name="No / cancel" />
    <bpmn:sequenceFlow id="Flow_33_8" sourceRef="Confirm_33" targetRef="Validate_33" name="Yes" />
    <bpmn:sequenceFlow id="Flow_33_9" sourceRef="Validate_33" targetRef="Valid_33" />
    <bpmn:sequenceFlow id="Flow_33_10" sourceRef="Valid_33" targetRef="InputError_33" name="No" />
    <bpmn:sequenceFlow id="Flow_33_11" sourceRef="InputError_33" targetRef="RecoveryReview_33" />
    <bpmn:sequenceFlow id="Flow_33_12" sourceRef="Valid_33" targetRef="NewImage_33" name="Yes" />
    <bpmn:sequenceFlow id="Flow_33_13" sourceRef="NewImage_33" targetRef="CheckImage_33" name="Yes" />
    <bpmn:sequenceFlow id="Flow_33_14" sourceRef="NewImage_33" targetRef="Save_33" name="No — retain/select existing media" />
    <bpmn:sequenceFlow id="Flow_33_15" sourceRef="CheckImage_33" targetRef="ImageValid_33" />
    <bpmn:sequenceFlow id="Flow_33_16" sourceRef="ImageValid_33" targetRef="ImageError_33" name="No" />
    <bpmn:sequenceFlow id="Flow_33_17" sourceRef="ImageError_33" targetRef="RecoveryReview_33" />
    <bpmn:sequenceFlow id="Flow_33_18" sourceRef="ImageValid_33" targetRef="Upload_33" name="Yes" />
    <bpmn:sequenceFlow id="Flow_33_19" sourceRef="Upload_33" targetRef="Uploaded_33" />
    <bpmn:sequenceFlow id="Flow_33_20" sourceRef="Uploaded_33" targetRef="UploadError_33" name="No" />
    <bpmn:sequenceFlow id="Flow_33_21" sourceRef="UploadError_33" targetRef="RecoveryReview_33" />
    <bpmn:sequenceFlow id="Flow_33_22" sourceRef="Uploaded_33" targetRef="Save_33" name="Yes" />
    <bpmn:sequenceFlow id="Flow_33_23" sourceRef="Save_33" targetRef="Saved_33" />
    <bpmn:sequenceFlow id="Flow_33_24" sourceRef="Saved_33" targetRef="SaveError_33" name="No" />
    <bpmn:sequenceFlow id="Flow_33_25" sourceRef="SaveError_33" targetRef="RecoveryReview_33" />
    <bpmn:sequenceFlow id="Flow_33_26" sourceRef="Saved_33" targetRef="Refresh_33" name="Yes" />
    <bpmn:sequenceFlow id="Flow_33_27" sourceRef="Refresh_33" targetRef="End_33" />
    <bpmn:textAnnotation id="ValidationRules_33">
      <bpmn:text>Catalog validation
Relevant product fields and supported variants.
Existing edit target/version must be current.
Applicable variant label/status and positive owner-selected final price.
Use saved recipe/price references; no automatic suggested-price approval.
BPMN-35: recipe/BoM rules.
BPMN-36: costing and final-price approval.
Availability-only changes reuse saved details.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ValidationRules_33" sourceRef="Validate_33" targetRef="ValidationRules_33" associationDirection="None" />
    <bpmn:textAnnotation id="ImageRules_33">
      <bpmn:text>Image controls
New upload: supported file type/size (NFR-SEC-09).
Existing valid media: no upload required.
Cloudinary failure ≠ successful catalog save.
Current image/catalog remain until save.
No provider-specific size limit or cleanup behavior is invented.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ImageRules_33" sourceRef="CheckImage_33" targetRef="ImageRules_33" associationDirection="None" />
    <bpmn:textAnnotation id="Snapshots_33">
      <bpmn:text>Save and historical commitments
Create/update the intended product/variant only.
Activation, eligibility and supplied dependent changes save consistently.
Deactivate rather than remove purchased variant references.
Do not rewrite paid order/subscription snapshots or original amounts.
Permission/version conflict or failed write leaves prior saved state intact.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Snapshots_33" sourceRef="Save_33" targetRef="Snapshots_33" associationDirection="None" />
    <bpmn:textAnnotation id="AvailabilityRules_33">
      <bpmn:text>Availability is not stock reservation
Inactive product/variant blocks new selection.
Active still depends on recipe and ingredient availability (BPMN-23).
BPMN-09 owns final checkout resources.
Subscription eligibility applies to future offerings; schedules/selection belong to BPMN-34/03.
Confirmed subscriptions remain unchanged.
BPMN-26 owns authentication.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AvailabilityRules_33" sourceRef="Refresh_33" targetRef="AvailabilityRules_33" associationDirection="None" />
    <bpmn:userTask id="RecoveryReview_33" name="Review error; save again, correct entries/image, or close">
      <bpmn:documentation>Keep the failed form and its entries visible where available. Invalid fields/images require correction through Edit. Changed catalog or pricing data requires closing and reopening the form to review current values before resubmission, as instructed by the website; no automatic refresh or draft merge is offered. Automatic authorization still applies. Unchanged upload failure can retry with same validated file; save failure reuses successful media. A matching already successful request can retry to display its saved result without duplicating writes.</bpmn:documentation>
      <bpmn:incoming>Flow_33_35</bpmn:incoming>
      <bpmn:incoming>Flow_33_11</bpmn:incoming>
      <bpmn:incoming>Flow_33_17</bpmn:incoming>
      <bpmn:incoming>Flow_33_21</bpmn:incoming>
      <bpmn:incoming>Flow_33_25</bpmn:incoming>
      <bpmn:outgoing>Flow_33_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RecoveryChoice_33" name="Administrator recovery choice?">
      <bpmn:incoming>Flow_33_29</bpmn:incoming>
      <bpmn:outgoing>Flow_33_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Stop_33" name="Stopped for now; saved catalog retained">
      <bpmn:incoming>Flow_33_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="RetryCheck_33" name="Check safe retry: current permission/version, corrected input and prior save result">
      <bpmn:documentation>Retry is not unconditional. Return saved-success if same operation already completed; retry-eligible only if current authorization, expected version/dependency context and draft remain valid for resubmission. Stale/unreviewed conflict, rejected unchanged image or invalid fields requires Edit/Review, not a blind retry. Lost permission cannot authorize retry and must be resolved or stopped. Validate matching successful media reference; never re-upload after a confirmed successful upload solely because catalog save failed.</bpmn:documentation>
      <bpmn:incoming>Flow_33_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33_33</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="RetryRoute_33" name="Safe retry result?">
      <bpmn:incoming>Flow_33_33</bpmn:incoming>
      <bpmn:outgoing>Flow_33_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_33_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AlreadySaved_33" name="Reuse confirmed saved result and media; no duplicate catalog update">
      <bpmn:documentation>Same successful operation/result was found during recovery. Preserve original saved record/reference, do not create duplicate product/variant or overwrite current catalog. Refresh/display saved state through the existing storefront refresh task.</bpmn:documentation>
      <bpmn:incoming>Flow_33_36</bpmn:incoming>
      <bpmn:outgoing>Flow_33_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_33_29" sourceRef="RecoveryReview_33" targetRef="RecoveryChoice_33" />
    <bpmn:sequenceFlow id="Flow_33_30" sourceRef="RecoveryChoice_33" targetRef="Stop_33" name="Stop / cancel" />
    <bpmn:sequenceFlow id="Flow_33_31" sourceRef="RecoveryChoice_33" targetRef="Edit_33" name="Edit / replace image" />
    <bpmn:sequenceFlow id="Flow_33_32" sourceRef="RecoveryChoice_33" targetRef="RetryCheck_33" name="Retry unchanged" />
    <bpmn:sequenceFlow id="Flow_33_33" sourceRef="RetryCheck_33" targetRef="RetryRoute_33" />
    <bpmn:sequenceFlow id="Flow_33_34" sourceRef="RetryRoute_33" targetRef="Validate_33" name="Retry eligible — revalidate" />
