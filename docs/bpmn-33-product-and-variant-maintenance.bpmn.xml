        <bpmn:flowNodeRef>CheckImage_33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ImageValid_33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ImageError_33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Upload_33</bpmn:flowNodeRef>
