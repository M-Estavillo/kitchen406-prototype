<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_28" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_28">
    <bpmn:participant id="Pool_32" name="BPMN-28 | Password Recovery" processRef="Process_28" />
  </bpmn:collaboration>
  <bpmn:process id="Process_28" name="Password Recovery" isExecutable="false">
    <bpmn:documentation>Sources: proposed-bpmn-catalog.md BPMN-28; Kitchen406 - Capstone Paper.md SRS 4.1.2 and FR-AUTH-06, Figure 7 Forgot Password Modal, Figure 16 AccountVerification, NFR-SEC-02 and NFR-SEC-08; index.html and linked app/auth.js. The request and later link use are independently triggered. The link carries a password-recovery verification credential; the specification does not set a lifetime. Refer to BPMN-24 for email dispatch and BPMN-26 for subsequent sign-in. Tasks use generic markers and the lanes identify responsibility.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_32">
      <bpmn:lane id="Lane_User" name="Account User">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NewPassword</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LinkRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Saved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reset</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="Recovery requested">
      <bpmn:documentation>The user selects Forgot password from the sign-in interface.</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Email" name="Submit account email">
      <bpmn:documentation>Enter the registered email and submit. Disable repeated submissions while the request is being processed.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check" name="Check email and account">
      <bpmn:documentation>Validate input server-side and check whether the email is associated with an account eligible for recovery.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Send" name="Send reset email?" default="F05" gatewayDirection="Diverging">
      <bpmn:documentation>Issue a link only for a valid request with an eligible account. Malformed input, an unavailable check or an ineligible or unknown account follows the response path.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Issue" name="Issue password-reset link">
      <bpmn:documentation>Create a verification credential for this account and the password-reset purpose. A replacement invalidates earlier credentials for the same purpose.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="Task_Dispatch" name="BPMN-24: Send reset email" calledElement="Process_24_Reference">
      <bpmn:documentation>Pass the reset email, registered recipient and recovery activity context to the shared dispatch process. Provider retries and logging are handled there.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_Response" gatewayDirection="Converging">
      <bpmn:documentation>Join the request paths before showing one applicable response.</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Response" name="Show recovery response">
      <bpmn:documentation>Use the same neutral acknowledgment for eligible and unknown or ineligible accounts. Show field-level feedback for malformed input and any applicable generic service error without exposing account existence or delivery status. Permit correction or a new request, and allow return to sign-in.</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Request" name="Request handled">
      <bpmn:documentation>The password is unchanged. The reset proceeds only if a valid link is opened later.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Link" name="Reset link opened later">
      <bpmn:documentation>The user opens the link received at the registered email. This starts a separate verification interaction.</bpmn:documentation>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Verify" name="Verify reset link">
      <bpmn:documentation>Check that the recovery credential matches the account and purpose, is current and unused, and has not expired under the applicable policy.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Link" name="Link valid?" default="F13" gatewayDirection="Diverging">
      <bpmn:documentation>Only a valid link permits the password form to be shown.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_LinkRejected" name="Request a new link">
      <bpmn:documentation>Show that the link is invalid, expired, used or superseded and direct the user back to password recovery.</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_NewPassword" name="Enter and confirm new password">
      <bpmn:documentation>Collect the new password and matching confirmation.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Save" name="Validate and save new password">
      <bpmn:documentation>Validate the password and confirmation server-side, recheck the recovery credential at submission, and on success save the adaptive hash and consume the credential together. On failure preserve the previous password.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Saved" name="Password saved?" default="F17" gatewayDirection="Diverging">
      <bpmn:documentation>Branch on the committed credential update.</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Failed" name="Reset incomplete">
      <bpmn:documentation>Show feedback. Allow correction or retry while the link remains valid. If it is no longer valid, direct the user to request a replacement.</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Reset" name="Password reset complete">
      <bpmn:documentation>Confirm success and allow return to sign-in under BPMN-26.</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Request" targetRef="Task_Email" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Email" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Check" targetRef="Gateway_Send" />
    <bpmn:sequenceFlow id="F04" sourceRef="Gateway_Send" targetRef="Task_Issue" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A valid request identifies an account eligible for recovery.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" sourceRef="Gateway_Send" targetRef="Gateway_Response" name="No" />
    <bpmn:sequenceFlow id="F06" sourceRef="Task_Issue" targetRef="Task_Dispatch" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_Dispatch" targetRef="Gateway_Response" />
    <bpmn:sequenceFlow id="F08" sourceRef="Gateway_Response" targetRef="Task_Response" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Response" targetRef="End_Request" />
    <bpmn:sequenceFlow id="F10" sourceRef="Start_Link" targetRef="Task_Verify" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Verify" targetRef="Gateway_Link" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gateway_Link" targetRef="Task_NewPassword" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The reset credential is valid for this account and purpose.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="Gateway_Link" targetRef="End_LinkRejected" name="No" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_NewPassword" targetRef="Task_Save" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Save" targetRef="Gateway_Saved" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gateway_Saved" targetRef="End_Reset" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The password update and credential consumption were saved.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="Gateway_Saved" targetRef="End_Failed" name="No" />
  </bpmn:process>
