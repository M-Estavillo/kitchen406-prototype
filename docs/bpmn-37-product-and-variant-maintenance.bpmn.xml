    <bpmn:sequenceFlow id="Flow_37_6" sourceRef="Edit_37" targetRef="Confirm_37" />
    <bpmn:sequenceFlow id="Flow_37_7" sourceRef="Confirm_37" targetRef="Cancel_37" name="No / cancel" />
    <bpmn:sequenceFlow id="Flow_37_8" sourceRef="Confirm_37" targetRef="Validate_37" name="Yes" />
    <bpmn:sequenceFlow id="Flow_37_9" sourceRef="Validate_37" targetRef="Valid_37" />
    <bpmn:sequenceFlow id="Flow_37_10" sourceRef="Valid_37" targetRef="InputError_37" name="No" />
    <bpmn:sequenceFlow id="Flow_37_11" sourceRef="InputError_37" targetRef="Recover_37" />
    <bpmn:sequenceFlow id="Flow_37_12" sourceRef="Valid_37" targetRef="NewImage_37" name="Yes" />
    <bpmn:sequenceFlow id="Flow_37_13" sourceRef="NewImage_37" targetRef="CheckImage_37" name="Yes" />
    <bpmn:sequenceFlow id="Flow_37_14" sourceRef="NewImage_37" targetRef="Save_37" name="No — retain/select existing media" />
    <bpmn:sequenceFlow id="Flow_37_15" sourceRef="CheckImage_37" targetRef="ImageValid_37" />
    <bpmn:sequenceFlow id="Flow_37_16" sourceRef="ImageValid_37" targetRef="ImageError_37" name="No" />
    <bpmn:sequenceFlow id="Flow_37_17" sourceRef="ImageError_37" targetRef="Recover_37" />
    <bpmn:sequenceFlow id="Flow_37_18" sourceRef="ImageValid_37" targetRef="Upload_37" name="Yes" />
    <bpmn:sequenceFlow id="Flow_37_19" sourceRef="Upload_37" targetRef="Uploaded_37" />
    <bpmn:sequenceFlow id="Flow_37_20" sourceRef="Uploaded_37" targetRef="UploadError_37" name="No" />
    <bpmn:sequenceFlow id="Flow_37_21" sourceRef="UploadError_37" targetRef="Recover_37" />
    <bpmn:sequenceFlow id="Flow_37_22" sourceRef="Uploaded_37" targetRef="Save_37" name="Yes" />
    <bpmn:sequenceFlow id="Flow_37_23" sourceRef="Save_37" targetRef="Saved_37" />
    <bpmn:sequenceFlow id="Flow_37_24" sourceRef="Saved_37" targetRef="SaveError_37" name="No" />
    <bpmn:sequenceFlow id="Flow_37_25" sourceRef="SaveError_37" targetRef="Recover_37" />
    <bpmn:sequenceFlow id="Flow_37_26" sourceRef="Saved_37" targetRef="Refresh_37" name="Yes" />
    <bpmn:sequenceFlow id="Flow_37_27" sourceRef="Refresh_37" targetRef="End_37" />
    <bpmn:textAnnotation id="ValidationRules_37">
      <bpmn:text>Catalog validation
Relevant product fields and supported variants.
Existing edit target/version must be current.
Applicable variant label/status and positive owner-selected final price.
Use saved recipe/price references; no automatic suggested-price approval.
BPMN-39: recipe/BoM rules.
BPMN-40: costing and final-price approval.
Availability-only changes reuse saved details.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ValidationRules_37" sourceRef="Validate_37" targetRef="ValidationRules_37" associationDirection="None" />
    <bpmn:textAnnotation id="ImageRules_37">
      <bpmn:text>Image controls
New upload: supported file type/size (NFR-SEC-09).
Existing valid media: no upload required.
Cloudinary failure ≠ successful catalog save.
Current image/catalog remain until save.
No provider-specific size limit or cleanup behavior is invented.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ImageRules_37" sourceRef="CheckImage_37" targetRef="ImageRules_37" associationDirection="None" />
    <bpmn:textAnnotation id="Snapshots_37">
      <bpmn:text>Save and historical commitments
Create/update the intended product/variant only.
Activation, eligibility and supplied dependent changes save consistently.
Deactivate rather than remove purchased variant references.
Do not rewrite paid order/subscription snapshots or original amounts.
Permission/version conflict or failed write leaves prior saved state intact.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Snapshots_37" sourceRef="Save_37" targetRef="Snapshots_37" associationDirection="None" />
    <bpmn:textAnnotation id="AvailabilityRules_37">
      <bpmn:text>Availability is not stock reservation
Inactive product/variant blocks new selection.
Active still depends on recipe and ingredient availability (BPMN-27).
BPMN-09 owns final checkout resources.
Subscription eligibility applies to future offerings; schedules/selection belong to BPMN-38/03.
Confirmed subscriptions remain unchanged.
BPMN-30 owns authentication.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_AvailabilityRules_37" sourceRef="Refresh_37" targetRef="AvailabilityRules_37" associationDirection="None" />
    <bpmn:serviceTask id="Recover_37" name="Refresh current catalog and reconcile saved attempt/media before retry">
      <bpmn:documentation>Preserve unsaved draft separately while rereading current record/session/permissions, relevant dependency versions and known operation result. If a save actually succeeded, retain its result and uploaded media identity; do not create another product/upload. Detect stale conflict and present current saved values for explicit administrator review, never blindly rebase/overwrite the old draft. Unsupported images require replacement; provider-only upload error may retry the same file; a successful upload is reusable if file/reference still matches. Permission revocation blocks resubmission. No saved business data is changed by this refresh.</bpmn:documentation>
      <bpmn:incoming>Flow_37_25</bpmn:incoming>
      <bpmn:incoming>Flow_37_21</bpmn:incoming>
      <bpmn:incoming>Flow_37_17</bpmn:incoming>
      <bpmn:incoming>Flow_37_11</bpmn:incoming>
      <bpmn:outgoing>Flow_37_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="RecoveryReview_37" name="Review failure/latest data; choose Retry, Edit/replace image, or Stop">
      <bpmn:documentation>Keep draft/context visible. Invalid fields/image require correction through Edit; missing permission requires ending the attempt. Stale-version conflict requires reviewing refreshed data and explicitly reconciling the draft through Edit before retry is eligible. Unchanged upload failure can retry with same validated file; save failure reuses successful media. A matching already successful request can retry to display its saved result without duplicating writes.</bpmn:documentation>
      <bpmn:incoming>Flow_37_35</bpmn:incoming>
      <bpmn:incoming>Flow_37_28</bpmn:incoming>
      <bpmn:outgoing>Flow_37_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RecoveryChoice_37" name="Administrator recovery choice?">
      <bpmn:incoming>Flow_37_29</bpmn:incoming>
      <bpmn:outgoing>Flow_37_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_37_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_37_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Stop_37" name="Stopped for now; saved catalog retained">
      <bpmn:incoming>Flow_37_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="RetryCheck_37" name="Check safe retry: current permission/version, corrected input and prior save result">
      <bpmn:documentation>Retry is not unconditional. Return saved-success if same operation already completed; retry-eligible only if current authorization, expected version/dependency context and draft remain valid for resubmission. Stale/unreviewed conflict, rejected unchanged image or invalid fields requires Edit/Review, not a blind retry. Lost permission cannot authorize retry and must be resolved or stopped. Validate matching successful media reference; never re-upload after a confirmed successful upload solely because catalog save failed.</bpmn:documentation>
      <bpmn:incoming>Flow_37_32</bpmn:incoming>
      <bpmn:outgoing>Flow_37_33</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="RetryRoute_37" name="Safe retry result?">
      <bpmn:incoming>Flow_37_33</bpmn:incoming>
      <bpmn:outgoing>Flow_37_34</bpmn:outgoing>
      <bpmn:outgoing>Flow_37_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_37_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AlreadySaved_37" name="Reuse confirmed saved result and media; no duplicate catalog update">
      <bpmn:documentation>Same successful operation/result was found during recovery. Preserve original saved record/reference, do not create duplicate product/variant or overwrite current catalog. Refresh/display saved state through the existing storefront refresh task.</bpmn:documentation>
      <bpmn:incoming>Flow_37_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37_37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_37_28" sourceRef="Recover_37" targetRef="RecoveryReview_37" />
    <bpmn:sequenceFlow id="Flow_37_29" sourceRef="RecoveryReview_37" targetRef="RecoveryChoice_37" />
