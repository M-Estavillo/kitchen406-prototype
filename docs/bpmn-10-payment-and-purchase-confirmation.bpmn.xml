<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_10" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:message id="Message_Session" name="QR session request" />
  <bpmn:message id="Message_QR" name="QR session details" />
  <bpmn:message id="Message_Status" name="Existing payment status request" />
  <bpmn:message id="Message_Result" name="Payment status or lookup error" />
  <bpmn:collaboration id="Collaboration_10">
    <bpmn:participant id="Kitchen406" name="BPMN-10 | Payment and Purchase Confirmation" processRef="Process_10" />
    <bpmn:participant id="PayMongo" name="PayMongo" />
    <bpmn:messageFlow id="Msg_Session" sourceRef="ShowQR" targetRef="PayMongo" messageRef="Message_Session" />
    <bpmn:messageFlow id="Msg_QR" sourceRef="PayMongo" targetRef="ShowQR" messageRef="Message_QR" />
    <bpmn:messageFlow id="Msg_Status" sourceRef="Check" targetRef="PayMongo" messageRef="Message_Status" />
    <bpmn:messageFlow id="Msg_Result" sourceRef="PayMongo" targetRef="Check" messageRef="Message_Result" />
  </bpmn:collaboration>
  <bpmn:process id="Process_10" name="Payment and Purchase Confirmation" isExecutable="false">
    <bpmn:documentation>Shared checkout payment and purchase confirmation, including late-payment reconciliation. Inputs from BPMN-09: reviewed purchase and saved payable total, ingredient and capacity reservations, and original hold expiry. Applies to standard orders, prepaid subscriptions, and accepted custom cake quotations. SRS: FR-PAY-03 through FR-PAY-08, FR-CAP-15 through FR-CAP-16, FR-CAP-18, FR-INV-07 through FR-INV-08, FR-INV-20, NFR-SAF-01 through NFR-SAF-03, NFR-SAF-06, and NFR-SEC-10.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Customer" name="Customer">
        <bpmn:flowNodeRef>Scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QRExpiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ViewPurchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="System" name="Kitchen406 System">
        <bpmn:flowNodeRef>ShowQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QRReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Held</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReleaseEligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StatusEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Restored</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyToConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KeepCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RefundEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReserveError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReserveRecovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmRecovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NextAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReturnToCheckout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckoutHandoff</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Enter Payment Page">
      <bpmn:documentation>The customer enters with a reviewed purchase after BPMN-09 reserves resources, or reopens the same purchase after an attempt. Reuse its original deadlines and check an uncertain attempt before offering another QR.</bpmn:documentation>
      <bpmn:outgoing>F_Start_ShowQR</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ShowQR" name="Request and display QR Ph and amount due">
      <bpmn:documentation>For an eligible first visit, request a QR Ph session using the saved payable amount and record the attempt reference. On reopening, recover the existing attempt. Display its QR only if still payable. If the attempt requires verification, the customer requests cancellation, or initiation fails or is unclear, continue to the existing payment check before offering another session.</bpmn:documentation>
      <bpmn:incoming>F_Start_ShowQR</bpmn:incoming>
      <bpmn:outgoing>F_ShowQR_QRReady</bpmn:outgoing>
      <bpmn:incoming>F_NextAction_ShowQR</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="QRReady" name="QR ready?" default="F_QRReady_Merge">
      <bpmn:incoming>F_ShowQR_QRReady</bpmn:incoming>
      <bpmn:outgoing>F_QRReady_Scan</bpmn:outgoing>
      <bpmn:outgoing>F_QRReady_Merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Scan" name="Scan QR and pay">
      <bpmn:documentation>The customer scans the PayMongo QR with a supported banking or e-wallet app.</bpmn:documentation>
      <bpmn:incoming>F_QRReady_Scan</bpmn:incoming>
      <bpmn:outgoing>F_Scan_Merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="QRExpiry" name="30-minute QR expires" attachedToRef="Scan" cancelActivity="true">
      <bpmn:outgoing>F_QRExpiry_Merge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="QRExpiry_Definition">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">paymentSession.expiresAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:startEvent id="Hold" name="Check same attempt at minute 32">
      <bpmn:documentation>Schedule one final check at the original hold expiry from BPMN-09. Correlate the timer to the existing purchase ID and payment attempt. It does not start another checkout.</bpmn:documentation>
      <bpmn:outgoing>F_Hold_Merge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Hold_Definition">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">checkoutHold.expiresAt</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Merge">
      <bpmn:incoming>F_QRReady_Merge</bpmn:incoming>
      <bpmn:incoming>F_Scan_Merge</bpmn:incoming>
      <bpmn:incoming>F_QRExpiry_Merge</bpmn:incoming>
      <bpmn:incoming>F_Hold_Merge</bpmn:incoming>
      <bpmn:outgoing>F_Merge_Check</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Check" name="Check existing payment with PayMongo">
      <bpmn:documentation>Match the provider result to the original attempt and saved full payable amount. Make a final status lookup at hold expiry or before acting on a cancellation request. Distinguish a completed check that reports failed, expired, or still unresolved payment from a failed lookup. Record the outcome once; serialize competing attempts and check the current purchase and reservation state before any transition. Verify PayMongo signatures before applying any webhook data used as supporting evidence.</bpmn:documentation>
      <bpmn:incoming>F_Merge_Check</bpmn:incoming>
      <bpmn:outgoing>F_Check_Paid</bpmn:outgoing>
      <bpmn:incoming>F_NextAction_Verify</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Paid" name="Verified payment to resolve?" default="F_Paid_ReleaseEligible">
      <bpmn:incoming>F_Check_Paid</bpmn:incoming>
      <bpmn:outgoing>F_Paid_Held</bpmn:outgoing>
      <bpmn:outgoing>F_Paid_ReleaseEligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Held" name="Required reservations still held?">
      <bpmn:incoming>F_Paid_Held</bpmn:incoming>
      <bpmn:outgoing>F_Held_ReadyToConfirm</bpmn:outgoing>
      <bpmn:outgoing>F_Held_Late</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ReleaseEligible" name="Can reservations be released?" default="F_ReleaseEligible_Status">
      <bpmn:documentation>Release is permitted after the final check completes without verified full payment at hold expiry, or for an eligible customer cancellation after checking the original attempt. A lookup error before hold expiry pauses cancellation. If the final lookup fails at expiry, cancel and release resources, flag the attempt for owner reconciliation, and block a fresh attempt until its outcome is known.</bpmn:documentation>
      <bpmn:incoming>F_Paid_ReleaseEligible</bpmn:incoming>
      <bpmn:outgoing>F_ReleaseEligible_Cancel</bpmn:outgoing>
      <bpmn:outgoing>F_ReleaseEligible_Status</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Confirm" name="Confirm purchase and commit reservations">
      <bpmn:documentation>Recheck the required reservations and confirm purchase and payment in one consistent transition. Keep ingredient reservations and commit held capacity. Make a standard or cake order available for fulfillment, or hand off the prepaid subscription to BPMN-04. Dispatch applicable notifications independently. For a late payment, commit the newly restored reservations for the same purchase. On a technical failure, keep the purchase and reservations in a safely recoverable state without publishing confirmation. On retry, read the current state under the same guard. If already confirmed, show the recorded confirmation without duplicating commitments or notifications.</bpmn:documentation>
      <bpmn:incoming>F_ReadyToConfirm_Confirm</bpmn:incoming>
      <bpmn:outgoing>F_Confirm_Show</bpmn:outgoing>
      <bpmn:incoming>F_ConfirmRecovery_Retry</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Late" name="Recheck and reserve original resources&#10;Refer to BPMN-09">
      <bpmn:documentation>If final verification failed because PayMongo was unreachable, do not try to restore resources after later verification. Return the external-refund outcome. Otherwise, apply the applicable BPMN-09 checks to the same purchase and agreed fulfillment details: original scheduling constraints, blocked dates, capacity and ingredients. Restore all applicable reservations together. For subscriptions, reserve capacity for all four commitments and ingredients for the first fulfillment. For cakes, preserve the accepted quotation and the original submission timing. No new purchase, checkout hold or payment attempt. Return a definitive availability result; signal a technical error separately. On retry, read the current state under the same guard and reuse any reservations already restored for this purchase.</bpmn:documentation>
      <bpmn:incoming>F_Held_Late</bpmn:incoming>
      <bpmn:outgoing>F_Late_Restored</bpmn:outgoing>
      <bpmn:startEvent id="Late_Start">
        <bpmn:outgoing>F_Late_Begin</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Late_Work" name="Apply BPMN-09 checks and reserve against original purchase">
        <bpmn:incoming>F_Late_Begin</bpmn:incoming>
        <bpmn:outgoing>F_Late_Finish</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Late_End">
        <bpmn:incoming>F_Late_Finish</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_Late_Begin" sourceRef="Late_Start" targetRef="Late_Work" />
      <bpmn:sequenceFlow id="F_Late_Finish" sourceRef="Late_Work" targetRef="Late_End" />
      <bpmn:incoming>F_ReserveRecovery_Retry</bpmn:incoming>
      <bpmn:textAnnotation id="LateRules">
        <bpmn:text>Recheck the original dates, scheduling rules, capacity and ingredients.
For subscriptions, check all four capacity commitments and first-fulfillment ingredients.
Keep the accepted cake quotation and original submission timing.
Restore reservations together for the original purchase. Report technical errors separately from confirmed unavailability.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Ref_LateRules" sourceRef="Late_Work" targetRef="LateRules" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Cancel" name="Cancel purchase and release reservations">
      <bpmn:documentation>Cancel only an unconfirmed purchase and release its temporary capacity and ingredient reservations once. If the final lookup failed, preserve the attempt and flag it for owner reconciliation. If payment is later verified for that attempt, retain cancellation and notify the customer of external refund eligibility.</bpmn:documentation>
      <bpmn:incoming>F_ReleaseEligible_Cancel</bpmn:incoming>
      <bpmn:outgoing>F_Cancel_Status</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Status" name="Show payment status and available actions">
      <bpmn:documentation>Show the recorded outcome and offer only actions allowed by the current purchase, reservation, and provider state. Verification may resume following a customer status check or a later provider update. Reuse the same QR only while payable. A new QR always requires fresh validation and reservation through BPMN-09 after the old attempt is resolved. Checking the existing attempt does not extend either deadline.</bpmn:documentation>
      <bpmn:incoming>F_ReleaseEligible_Status</bpmn:incoming>
      <bpmn:incoming>F_Cancel_Status</bpmn:incoming>
      <bpmn:outgoing>F_Status_ReviewStatus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Show" name="Show Payment confirmed and purchase link">
      <bpmn:documentation>Show Payment confirmed and the original purchase reference after purchase confirmation is saved. Provide View order for standard and custom cake orders or View subscription for prepaid subscriptions. The link opens the confirmed purchase details.</bpmn:documentation>
      <bpmn:incoming>F_Confirm_Show</bpmn:incoming>
      <bpmn:outgoing>F_Show_ViewPurchase</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ViewPurchase" name="Review confirmation and optionally open order or subscription">
      <bpmn:documentation>The customer can open the confirmed purchase details or leave the confirmation page. The purchase is confirmed before this interaction.</bpmn:documentation>
      <bpmn:incoming>F_Show_ViewPurchase</bpmn:incoming>
      <bpmn:outgoing>F_ViewPurchase_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ReviewStatus" name="Review payment status and choose next action">
      <bpmn:documentation>While payment is unresolved, check the existing attempt again or leave and revisit its status. Use the same payable QR only while valid, or request a fresh checkout through BPMN-09 when eligible. If payment has been resolved and a new attempt is eligible, follow the retry option, returning to BPMN-09 when new reservations are required. If the purchase is already confirmed, open its details from the status page. A status refresh uses the existing attempt and does not extend either deadline.</bpmn:documentation>
      <bpmn:incoming>F_Status_ReviewStatus</bpmn:incoming>
      <bpmn:outgoing>F_ReviewStatus_NextAction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Confirmation reviewed">
      <bpmn:incoming>F_ViewPurchase_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="StatusEnd" name="Current payment outcome shown">
      <bpmn:incoming>F_NextAction_StatusEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Restored" name="Required resources reserved again?" gatewayDirection="Diverging" default="F_Restored_KeepCancelled">
      <bpmn:incoming>F_Late_Restored</bpmn:incoming>
      <bpmn:outgoing>F_Restored_ReadyToConfirm</bpmn:outgoing>
      <bpmn:outgoing>F_Restored_KeepCancelled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ReadyToConfirm" gatewayDirection="Converging">
      <bpmn:incoming>F_Held_ReadyToConfirm</bpmn:incoming>
      <bpmn:incoming>F_Restored_ReadyToConfirm</bpmn:incoming>
      <bpmn:outgoing>F_ReadyToConfirm_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="KeepCancelled" name="Keep the purchase cancelled">
      <bpmn:documentation>Record the failed reconciliation against the verified payment and retain cancellation with no partial reservation.</bpmn:documentation>
      <bpmn:incoming>F_Restored_KeepCancelled</bpmn:incoming>
      <bpmn:outgoing>F_KeepCancelled_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Notify" name="Notify customer of external refund eligibility">
      <bpmn:documentation>Request the notice once and use BPMN-24 for applicable external dispatch and retry. The refund itself is handled externally.</bpmn:documentation>
      <bpmn:incoming>F_KeepCancelled_Notify</bpmn:incoming>
      <bpmn:outgoing>F_Notify_RefundEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RefundEnd" name="Cancellation retained and notice requested">
      <bpmn:incoming>F_Notify_RefundEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="ReserveError" attachedToRef="Late" cancelActivity="true">
      <bpmn:outgoing>F_ReserveError_ReserveRecovery</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ReserveError_Definition" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="ReserveRecovery" name="Wait before rechecking resources">
      <bpmn:documentation>Preserve the verified payment and safely recoverable state. Retry against the original purchase after a delay. A temporary system failure does not establish refund eligibility.</bpmn:documentation>
      <bpmn:incoming>F_ReserveError_ReserveRecovery</bpmn:incoming>
      <bpmn:outgoing>F_ReserveRecovery_Retry</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ReserveRecovery_Timer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">reconciliationRetryDelay</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:boundaryEvent id="ConfirmError" attachedToRef="Confirm" cancelActivity="true">
      <bpmn:outgoing>F_ConfirmError_ConfirmRecovery</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ConfirmError_Definition" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="ConfirmRecovery" name="Wait before retrying confirmation">
      <bpmn:documentation>Keep the verified payment and recoverable state. Retry the original confirmation after a delay.</bpmn:documentation>
      <bpmn:incoming>F_ConfirmError_ConfirmRecovery</bpmn:incoming>
      <bpmn:outgoing>F_ConfirmRecovery_Retry</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ConfirmRecovery_Timer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">confirmationRetryDelay</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="F_Start_ShowQR" sourceRef="Start" targetRef="ShowQR" />
    <bpmn:sequenceFlow id="F_ShowQR_QRReady" sourceRef="ShowQR" targetRef="QRReady" />
    <bpmn:sequenceFlow id="F_QRReady_Scan" sourceRef="QRReady" targetRef="Scan" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">qrReady</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_QRReady_Merge" sourceRef="QRReady" targetRef="Merge" name="No" />
    <bpmn:sequenceFlow id="F_Scan_Merge" sourceRef="Scan" targetRef="Merge" />
    <bpmn:sequenceFlow id="F_QRExpiry_Merge" sourceRef="QRExpiry" targetRef="Merge" />
    <bpmn:sequenceFlow id="F_Hold_Merge" sourceRef="Hold" targetRef="Merge" />
    <bpmn:sequenceFlow id="F_Merge_Check" sourceRef="Merge" targetRef="Check" />
    <bpmn:sequenceFlow id="F_Check_Paid" sourceRef="Check" targetRef="Paid" />
    <bpmn:sequenceFlow id="F_Paid_Held" sourceRef="Paid" targetRef="Held" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">verifiedFullPayment and ((validReservations and purchaseUnconfirmed) or (reservationsReleased and purchaseCancelled and latePaymentUnreconciled))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Paid_ReleaseEligible" sourceRef="Paid" targetRef="ReleaseEligible" name="No" />
    <bpmn:sequenceFlow id="F_Held_ReadyToConfirm" sourceRef="Held" targetRef="ReadyToConfirm" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validReservations and purchaseUnconfirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Held_Late" sourceRef="Held" targetRef="Late" name="Released">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reservationsReleased and purchaseCancelled and latePaymentUnreconciled</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ReleaseEligible_Cancel" sourceRef="ReleaseEligible" targetRef="Cancel" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">unconfirmedPurchase and reservationsNotReleased and ((holdExpired and finalLookupFailed) or (finalCheckCompleted and (holdExpiredWithoutVerifiedFullPayment or (cancellationRequested and cancellationEligible and noSuccessfulOrUnresolvedPayment))))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ReleaseEligible_Status" sourceRef="ReleaseEligible" targetRef="Status" name="No" />
    <bpmn:sequenceFlow id="F_Cancel_Status" sourceRef="Cancel" targetRef="Status" />
    <bpmn:sequenceFlow id="F_Confirm_Show" sourceRef="Confirm" targetRef="Show" />
    <bpmn:sequenceFlow id="F_Show_ViewPurchase" sourceRef="Show" targetRef="ViewPurchase" />
    <bpmn:sequenceFlow id="F_ViewPurchase_End" sourceRef="ViewPurchase" targetRef="End" />
    <bpmn:sequenceFlow id="F_Status_ReviewStatus" sourceRef="Status" targetRef="ReviewStatus" />
    <bpmn:sequenceFlow id="F_ReviewStatus_NextAction" sourceRef="ReviewStatus" targetRef="NextAction" />
    <bpmn:sequenceFlow id="F_Late_Restored" sourceRef="Late" targetRef="Restored" />
    <bpmn:sequenceFlow id="F_Restored_ReadyToConfirm" sourceRef="Restored" targetRef="ReadyToConfirm" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allRequiredResourcesReserved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Restored_KeepCancelled" sourceRef="Restored" targetRef="KeepCancelled" name="No" />
    <bpmn:sequenceFlow id="F_ReadyToConfirm_Confirm" sourceRef="ReadyToConfirm" targetRef="Confirm" />
    <bpmn:sequenceFlow id="F_KeepCancelled_Notify" sourceRef="KeepCancelled" targetRef="Notify" />
    <bpmn:sequenceFlow id="F_Notify_RefundEnd" sourceRef="Notify" targetRef="RefundEnd" />
    <bpmn:sequenceFlow id="F_ReserveError_ReserveRecovery" sourceRef="ReserveError" targetRef="ReserveRecovery" />
    <bpmn:sequenceFlow id="F_ConfirmError_ConfirmRecovery" sourceRef="ConfirmError" targetRef="ConfirmRecovery" />
    <bpmn:exclusiveGateway id="NextAction" name="Eligible follow-up?" default="F_NextAction_StatusEnd">
      <bpmn:incoming>F_ReviewStatus_NextAction</bpmn:incoming>
      <bpmn:outgoing>F_NextAction_StatusEnd</bpmn:outgoing>
      <bpmn:outgoing>F_NextAction_Verify</bpmn:outgoing>
      <bpmn:outgoing>F_NextAction_ShowQR</bpmn:outgoing>
      <bpmn:outgoing>F_NextAction_Validate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReturnToCheckout" name="Return to validation and reservation (BPMN-09)">
      <bpmn:incoming>F_NextAction_Validate</bpmn:incoming>
      <bpmn:outgoing>F_Validate_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CheckoutHandoff" name="Fresh checkout handed off">
      <bpmn:incoming>F_Validate_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_NextAction_StatusEnd" sourceRef="NextAction" targetRef="StatusEnd" name="Leave or no action available" />
    <bpmn:sequenceFlow id="F_NextAction_Verify" sourceRef="NextAction" targetRef="Check" name="Check again">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">paymentVerificationOutstanding and verificationRequestedOrProviderUpdated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NextAction_ShowQR" sourceRef="NextAction" targetRef="ShowQR" name="Use the existing valid QR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">customerRequestedPayment and checkoutEligible and originalHoldActive and existingQrPayable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
