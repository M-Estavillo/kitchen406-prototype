<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_15" targetNamespace="https://kitchen406.local/bpmn" xmlns:k406="https://kitchen406.local/bpmn">
  <bpmn:import namespace="https://kitchen406.local/bpmn" location="bpmn-12-preparing-owner-assignment-and-allocation-validation.bpmn.xml" importType="http://www.omg.org/spec/BPMN/20100524/MODEL" />
  <bpmn:collaboration id="Collaboration_15">
    <bpmn:participant id="Participant_15" name="BPMN-15 | Third-Party Courier Booking and Booking Recovery" processRef="Process_15" />
    <bpmn:participant id="Lalamove_19" name="Lalamove — courier service" />
    <bpmn:messageFlow id="BookingRequest_19" sourceRef="Submit_19" targetRef="Lalamove_19" name="Create booking from stored information" />
    <bpmn:messageFlow id="BookingResponse_19" sourceRef="Lalamove_19" targetRef="Submit_19" name="Booking response when received" />
    <bpmn:messageFlow id="LookupRequest_19" sourceRef="Reconcile_19" targetRef="Lalamove_19" name="Resolve existing booking attempt" />
    <bpmn:messageFlow id="LookupResponse_19" sourceRef="Lalamove_19" targetRef="Reconcile_19" name="Existing-attempt status when available" />
  </bpmn:collaboration>
  <bpmn:process id="Process_15" name="Third-Party Courier Booking and Booking Recovery" isExecutable="false">
    <bpmn:documentation>Sources: capstone SRS FR-DEL-08–11,14,17 and FR-FUL-18–20,23,26. The Admin/Owner books Lalamove for a paid Ready standard order or weekly subscription delivery. BPMN-26 supplies sign-in and Admin/Owner access. Established bookings continue in BPMN-16. Save the pending attempt and allocation lock before submitting. A pending attempt is looked up before another booking is allowed. A confirmed failure or cancellation returns to the Owner for retry. BPMN-16 owns tracking and completion.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_15">
      <bpmn:lane id="Lane_19_owner" name="Admin/Owner">
        <bpmn:flowNodeRef>Review_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllocationRejected_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RetryBooking_19</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_19_system" name="Kitchen406 System — Delivery Management">
        <bpmn:flowNodeRef>Start_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Load_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Existing_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allocation_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllocationValid_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllocationError_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pending_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PendingSaved_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PendingError_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Outcome_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accepted_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Booked_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Failure_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reconcile_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recovered_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecoveryAccepted_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecoveryBooked_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecoveryFailed_19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecoveryUnknown_19</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_19" name="Owner requests booking or recovery review">
      <bpmn:outgoing>Flow_19_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Load_19" name="Load fulfillment and booking history">
      <bpmn:documentation>Load the selected fulfillment, saved delivery details and booking history. Admin/Owner access is established before this process. The booking action applies to paid Ready standard orders or weekly delivery fulfillments without an established booking. Active bookings use BPMN-16.</bpmn:documentation>
      <bpmn:incoming>Flow_19_1</bpmn:incoming>
      <bpmn:outgoing>Flow_19_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Existing_19" name="Booking state?">
      <bpmn:documentation>With no prior booking or a confirmed failure or cancellation, the Owner can review and request a new booking. A pending or unresolved attempt must be looked up using its existing booking details.</bpmn:documentation>
      <bpmn:incoming>Flow_19_2</bpmn:incoming>
      <bpmn:outgoing>Flow_19_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Review_19" name="Review saved delivery details and request a new booking">
      <bpmn:documentation>Only no prior attempt or definitively failed/cancelled prior booking may proceed, while fulfillment remains incomplete and otherwise eligible. Review saved checkout destination and delivery data. Subscription address remains agreed for all four fulfillments; actual fee differences are borne by bakery under BR-27. No new customer charge/refund. Owner may edit unlocked allocations separately through BPMN-12; no forced split modal.</bpmn:documentation>
      <bpmn:incoming>Flow_19_8</bpmn:incoming>
      <bpmn:incoming>Flow_19_RetryReview</bpmn:incoming>
      <bpmn:incoming>Flow_19_RetryBooking</bpmn:incoming>
      <bpmn:outgoing>Flow_19_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirm_19" name="Owner confirms booking?">
      <bpmn:incoming>Flow_19_10</bpmn:incoming>
      <bpmn:outgoing>Flow_19_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Cancel_19" name="Request cancelled; saved state retained">
      <bpmn:documentation>Cancelling the local confirmation creates no courier booking and changes no allocation/lock. This is not a provider cancellation API operation.</bpmn:documentation>
      <bpmn:incoming>Flow_19_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Allocation_19" name="Refer to BPMN-12 — Validate saved owner allocations" calledElement="k406:Process_12">
      <bpmn:documentation>Call k406:Process_12 in validation-only mode with owner account, fulfillment identity, expected version and action=courier booking. Validate saved line allocations, eligible owners/percentages, permissions, version and lock compatibility. Return exact rejection reason. Valid saved splits are reused without manual re-entry; optional supported combined drafts must remain atomic with protected changes.</bpmn:documentation>
      <bpmn:incoming>Flow_19_12</bpmn:incoming>
      <bpmn:outgoing>Flow_19_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="AllocationValid_19" name="Allocation/action validation passed?">
      <bpmn:incoming>Flow_19_13</bpmn:incoming>
      <bpmn:outgoing>Flow_19_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AllocationError_19" name="Show why the booking could not proceed">
      <bpmn:documentation>Reject this attempt, preserve latest saved state and require refresh/review or a separately allowed BPMN-12 correction. No provider request is sent.</bpmn:documentation>
      <bpmn:incoming>Flow_19_14</bpmn:incoming>
      <bpmn:outgoing>Flow_19_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="AllocationRejected_19" name="Correct booking details and retry">
      <bpmn:documentation>The Owner reviews the issue and corrects the saved details as applicable before reviewing and requesting the booking again.</bpmn:documentation>
      <bpmn:incoming>Flow_19_15</bpmn:incoming>
      <bpmn:incoming>Flow_19_19</bpmn:incoming>
      <bpmn:outgoing>Flow_19_RetryReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Pending_19" name="Save pending booking attempt and lock allocations">
      <bpmn:documentation>FR-DEL-17; FR-FUL-18-20; NFR-SEC-14, NFR-REL-03,05. Atomically recheck owner permission, version, paid Ready state, complete valid allocations, stored destination and absence of another pending/active/unresolved attempt. Persist one attempt identity, saved request context, prior-attempt link/history and pending lock/timestamp before calling provider. Failed local commit sends nothing and preserves prior state. Concurrent matching attempts reuse existing record; conflicting/stale attempts reject. Do not independently commit owner edits that conflict with the booking transaction.</bpmn:documentation>
      <bpmn:incoming>Flow_19_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PendingSaved_19" name="Pending attempt and lock saved?">
      <bpmn:incoming>Flow_19_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PendingError_19" name="Show why the booking request could not be saved">
      <bpmn:documentation>No request is sent without a saved consistent attempt/lock. Preserve independently committed newer booking state. Review and refresh before another authorized request; no blind provider retry.</bpmn:documentation>
      <bpmn:incoming>Flow_19_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Submit_19" name="Submit stored booking information to Lalamove; resolve response">
      <bpmn:documentation>Submit the saved attempt and use its identity to resolve the Lalamove response. If the response is missing or unclear, keep the pending attempt and allocation lock and look up that same attempt until its outcome is confirmed. Only a confirmed booking or definitive failure or cancellation proceeds to the provider outcome decision.</bpmn:documentation>
      <bpmn:incoming>Flow_19_20</bpmn:incoming>
      <bpmn:outgoing>Flow_19_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Outcome_19" name="Provider booking outcome?">
      <bpmn:incoming>Flow_19_21</bpmn:incoming>
      <bpmn:outgoing>Flow_19_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Accepted_19" name="Save confirmed courier booking">
      <bpmn:documentation>Save the confirmed provider booking reference and history while retaining the allocation lock. If saving fails, retain the attempt and reconcile the same booking before retrying its save. Continue to tracking only after saving it.</bpmn:documentation>
      <bpmn:incoming>Flow_19_22</bpmn:incoming>
      <bpmn:outgoing>Flow_19_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Booked_19" name="Booking established; continue tracking in BPMN-16">
      <bpmn:incoming>Flow_19_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Failure_19" name="Record failed or cancelled booking">
      <bpmn:documentation>Save the confirmed failure or cancellation in booking history. If saving fails, preserve the existing attempt and resolve the save before allowing a new request. The paid fulfillment remains open. The Owner reviews it before retrying.</bpmn:documentation>
      <bpmn:incoming>Flow_19_23</bpmn:incoming>
      <bpmn:outgoing>Flow_19_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Reconcile_19" name="Resolve existing attempt with Lalamove; do not create another">
      <bpmn:documentation>NFR-REL-01-03; FR-DEL-17. For pending/unresolved saved attempt, use preserved identity/provider reference and supported provider status lookup to determine its outcome. Never submit a new booking as a status query. If lookup is unavailable or cannot establish an outcome, retain unresolved state/lock and require further reconciliation. No fabricated cancellation or provider behavior is assumed. If recovery establishes delivery progress, BPMN-16 processes tracking/completion.</bpmn:documentation>
      <bpmn:incoming>Flow_19_9</bpmn:incoming>
      <bpmn:incoming>Flow_19_RetryLookup</bpmn:incoming>
      <bpmn:outgoing>Flow_19_30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Recovered_19" name="Existing booking outcome?">
      <bpmn:incoming>Flow_19_30</bpmn:incoming>
      <bpmn:outgoing>Flow_19_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RecoveryAccepted_19" name="Save recovered courier booking">
      <bpmn:documentation>Save the confirmed booking against its original attempt and keep the allocation lock. If the save fails, retain the existing booking and retry the save before continuing to tracking.</bpmn:documentation>
      <bpmn:incoming>Flow_19_31</bpmn:incoming>
      <bpmn:outgoing>Flow_19_35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RecoveryBooked_19" name="Existing booking recovered; continue BPMN-16">
      <bpmn:incoming>Flow_19_35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="RecoveryFailed_19" name="Record recovered failure or cancellation">
      <bpmn:documentation>Save the confirmed failure or cancellation against its original attempt and retain booking history. Resolve a failed save before the Owner can request another booking. Keep the paid fulfillment open.</bpmn:documentation>
      <bpmn:incoming>Flow_19_33</bpmn:incoming>
      <bpmn:outgoing>Flow_19_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="RecoveryUnknown_19" name="Wait before checking the existing booking again">
      <bpmn:documentation>Keep the existing attempt and its allocation lock. Retry the lookup for that booking after a delay.</bpmn:documentation>
      <bpmn:incoming>Flow_19_32</bpmn:incoming>
      <bpmn:outgoing>Flow_19_RetryLookup</bpmn:outgoing>
      <bpmn:timerEventDefinition id="RecoveryDelay_19">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">bookingRecoveryRetryDelay</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="RetryBooking_19" name="Retry courier booking">
      <bpmn:documentation>The Owner starts a fresh review after the failed or cancelled booking has been recorded.</bpmn:documentation>
      <bpmn:incoming>Flow_19_28</bpmn:incoming>
      <bpmn:incoming>Flow_19_38</bpmn:incoming>
      <bpmn:outgoing>Flow_19_RetryBooking</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_19_1" sourceRef="Start_19" targetRef="Load_19" />
    <bpmn:sequenceFlow id="Flow_19_2" sourceRef="Load_19" targetRef="Existing_19" />
    <bpmn:sequenceFlow id="Flow_19_8" sourceRef="Existing_19" targetRef="Review_19" name="None / failure / cancellation" />
    <bpmn:sequenceFlow id="Flow_19_9" sourceRef="Existing_19" targetRef="Reconcile_19" name="Pending / unresolved" />
    <bpmn:sequenceFlow id="Flow_19_10" sourceRef="Review_19" targetRef="Confirm_19" />
    <bpmn:sequenceFlow id="Flow_19_11" sourceRef="Confirm_19" targetRef="Cancel_19" name="No" />
    <bpmn:sequenceFlow id="Flow_19_12" sourceRef="Confirm_19" targetRef="Allocation_19" name="Yes" />
    <bpmn:sequenceFlow id="Flow_19_13" sourceRef="Allocation_19" targetRef="AllocationValid_19" />
    <bpmn:sequenceFlow id="Flow_19_14" sourceRef="AllocationValid_19" targetRef="AllocationError_19" name="No" />
    <bpmn:sequenceFlow id="Flow_19_15" sourceRef="AllocationError_19" targetRef="AllocationRejected_19" />
    <bpmn:sequenceFlow id="Flow_19_16" sourceRef="AllocationValid_19" targetRef="Pending_19" name="Yes" />
    <bpmn:sequenceFlow id="Flow_19_17" sourceRef="Pending_19" targetRef="PendingSaved_19" />
    <bpmn:sequenceFlow id="Flow_19_18" sourceRef="PendingSaved_19" targetRef="PendingError_19" name="No" />
    <bpmn:sequenceFlow id="Flow_19_19" sourceRef="PendingError_19" targetRef="AllocationRejected_19" />
    <bpmn:sequenceFlow id="Flow_19_20" sourceRef="PendingSaved_19" targetRef="Submit_19" name="Yes" />
    <bpmn:sequenceFlow id="Flow_19_21" sourceRef="Submit_19" targetRef="Outcome_19" />
    <bpmn:sequenceFlow id="Flow_19_22" sourceRef="Outcome_19" targetRef="Accepted_19" name="Established" />
    <bpmn:sequenceFlow id="Flow_19_23" sourceRef="Outcome_19" targetRef="Failure_19" name="Failed / cancelled" />
    <bpmn:sequenceFlow id="Flow_19_26" sourceRef="Accepted_19" targetRef="Booked_19" />
    <bpmn:sequenceFlow id="Flow_19_28" sourceRef="Failure_19" targetRef="RetryBooking_19" />
    <bpmn:sequenceFlow id="Flow_19_30" sourceRef="Reconcile_19" targetRef="Recovered_19" />
    <bpmn:sequenceFlow id="Flow_19_31" sourceRef="Recovered_19" targetRef="RecoveryAccepted_19" name="Established" />
    <bpmn:sequenceFlow id="Flow_19_32" sourceRef="Recovered_19" targetRef="RecoveryUnknown_19" name="Still pending" />
    <bpmn:sequenceFlow id="Flow_19_33" sourceRef="Recovered_19" targetRef="RecoveryFailed_19" name="Failed / cancelled" />
    <bpmn:sequenceFlow id="Flow_19_35" sourceRef="RecoveryAccepted_19" targetRef="RecoveryBooked_19" />
    <bpmn:sequenceFlow id="Flow_19_38" sourceRef="RecoveryFailed_19" targetRef="RetryBooking_19" />
    <bpmn:sequenceFlow id="Flow_19_RetryReview" sourceRef="AllocationRejected_19" targetRef="Review_19" />
    <bpmn:sequenceFlow id="Flow_19_RetryBooking" sourceRef="RetryBooking_19" targetRef="Review_19" />
    <bpmn:sequenceFlow id="Flow_19_RetryLookup" sourceRef="RecoveryUnknown_19" targetRef="Reconcile_19" />
    <bpmn:textAnnotation id="Rules_19">
      <bpmn:text>When to use this process
Admin/Owner books a paid Ready standard or weekly subscription delivery.
Use the saved checkout address and delivery details.
Already-booked deliveries use BPMN-16.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Rules_19" sourceRef="Load_19" targetRef="Rules_19" associationDirection="None" />
    <bpmn:textAnnotation id="Allocations_19">
      <bpmn:text>Refer to BPMN-12
Validate saved owner selections, permission, version and locks; no forced owner-split modal.
Pending/active/unresolved booking locks allocations.
Definitive failure/cancellation may permit review only while incomplete.
Staff acting does not earn an owner allocation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Allocations_19" sourceRef="Allocation_19" targetRef="Allocations_19" associationDirection="None" />
    <bpmn:textAnnotation id="Safeguards_19">
      <bpmn:text>Safe provider submission
Save attempt identity + pending lock before provider call.
Recheck current controls at commit.
Unknown result ≠ confirmed failure.
Retain evidence and lock; reconcile the existing attempt before another booking.
No blind creation retry after response loss.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Safeguards_19" sourceRef="Pending_19" targetRef="Safeguards_19" associationDirection="None" />
    <bpmn:textAnnotation id="Terms_19">
      <bpmn:text>Business boundaries
An established booking does not mean Delivered or that a rider is already assigned.
BPMN-16 owns tracking and completion.
No live rider-location tracking.
Subscription address remains agreed; bakery absorbs later actual-fee differences (BR-26/27).
No new customer charge/refund.
Failed/cancelled attempts require fresh owner review before rebooking.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Terms_19" sourceRef="Booked_19" targetRef="Terms_19" associationDirection="None" />
  </bpmn:process>
