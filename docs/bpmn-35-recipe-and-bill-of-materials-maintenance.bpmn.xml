    <bpmn:startEvent id="Start_35" name="Recipe viewing or maintenance requested">
      <bpmn:outgoing>Flow_35_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Load_35" name="Check role; load selected variant/cake mapping and inventory references">
      <bpmn:documentation>FR-BOM-01,05-06,10-12. Load applicable product variant or supported cake configuration option, saved ingredient rows/quantities, inventory units and record version. Authenticated Owner may maintain; authorized Staff may view production reference only. Unsupported/missing target or unauthorized access gives a safe reason. Inventory quantities/costs may be displayed only as permitted; Staff never receives restricted financial access.</bpmn:documentation>
      <bpmn:incoming>Flow_35_1</bpmn:incoming>
      <bpmn:outgoing>Flow_35_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed_35" name="Authorized reference access and target valid?">
      <bpmn:incoming>Flow_35_2</bpmn:incoming>
      <bpmn:outgoing>Flow_35_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Denied_35" name="Explain permission/target issue; keep recipe unchanged">
      <bpmn:incoming>Flow_35_29</bpmn:incoming>
      <bpmn:incoming>Flow_35_9</bpmn:incoming>
      <bpmn:incoming>Flow_35_3</bpmn:incoming>
      <bpmn:outgoing>Flow_35_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DeniedEnd_35" name="Request denied; saved definition retained">
      <bpmn:incoming>Flow_35_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="View_35" name="Review recipe/base-ingredient quantities and units">
      <bpmn:documentation>FR-BOM-10. Owner/authorized Staff reviews production details; Staff has read-only controls. Read-only reference does not compute consumption or alter stored mappings.</bpmn:documentation>
      <bpmn:incoming>Flow_35_5</bpmn:incoming>
      <bpmn:outgoing>Flow_35_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="EditRequested_35" name="Modification requested?">
      <bpmn:incoming>Flow_35_6</bpmn:incoming>
      <bpmn:outgoing>Flow_35_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ViewEnd_35" name="Recipe viewed; no changes">
      <bpmn:incoming>Flow_35_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Owner_35" name="Acting account is Admin/Owner?">
      <bpmn:documentation>FR-BOM-11-12. Recheck mutation authority; read-only access does not grant editing permission. Staff mutation attempts are rejected server-side.</bpmn:documentation>
      <bpmn:incoming>Flow_35_8</bpmn:incoming>
      <bpmn:outgoing>Flow_35_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Edit_35" name="Review current recipe against draft; edit ingredient rows and quantities">
      <bpmn:documentation>Select existing base inventory ingredients with supported quantities/units for this variant or cake option. Multiple rows are supported; another recipe may use the same ingredient. Adding/removing a row changes this recipe only, not the ingredient inventory record. No nested/subrecipe selector or intermediate preparation stock is allowed. Confirm intended composition before save; cancel retains prior definition. Missing inventory item creation is separate inventory maintenance, not invented inside recipe save. On recovery, explicitly compare the retained draft with freshly loaded recipe/version before reconciling and resubmitting. This is not blind stale-data replacement.</bpmn:documentation>
      <bpmn:incoming>Flow_35_28</bpmn:incoming>
      <bpmn:incoming>Flow_35_24</bpmn:incoming>
      <bpmn:incoming>Flow_35_10</bpmn:incoming>
      <bpmn:outgoing>Flow_35_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirm_35" name="Owner confirms recipe changes?">
      <bpmn:incoming>Flow_35_11</bpmn:incoming>
      <bpmn:outgoing>Flow_35_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Cancel_35" name="Cancelled; prior recipe retained">
      <bpmn:incoming>Flow_35_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Validate_35" name="Validate inventory links, positive quantities and single-level recipe structure">
      <bpmn:documentation>FR-BOM-02-06,13-14. Require applicable saved/current target and sufficient configured rows for a valid usable recipe/mapping; standalone recipe editor requires at least one ingredient. Every row references a supported existing base ingredient/inventory item, quantity is finite positive and uses the associated unit/compatible supported conversion. No repeated ingredient row within this recipe (prototype materialRecipe/P.save); sharing ingredients across distinct recipes is allowed. Reject nested/intermediate component mappings. Validate allowed changes and current record/dependency version. Availability/cost shortage alone does not invalidate a recipe definition: missing cost is reported downstream by BPMN-36, not treated as zero. A draft product with no configured recipe remains unready for ordering through BPMN-33; it is not falsely saved here as a complete usable recipe.</bpmn:documentation>
      <bpmn:incoming>Flow_35_13</bpmn:incoming>
      <bpmn:outgoing>Flow_35_14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Valid_35" name="All recipe rules and current version valid?">
      <bpmn:incoming>Flow_35_14</bpmn:incoming>
      <bpmn:outgoing>Flow_35_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="InputError_35" name="Explain invalid row/unit/structure or stale target; retain draft">
      <bpmn:documentation>Show exact required correction: missing/invalid target, repeated or unsupported ingredient, nonpositive quantity, incompatible unit, nested structure or stale version. No saved recipe/inventory mutation. Correct fields, explicitly reload/review changed data, or stop.</bpmn:documentation>
      <bpmn:incoming>Flow_35_15</bpmn:incoming>
      <bpmn:outgoing>Flow_35_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Save_35" name="Recheck Owner/version; save ingredient mapping and quantities consistently">
      <bpmn:documentation>FR-BOM-01-06,11-14; NFR-REL-03,05-06. Recheck role/target/current version and row validation at protected commit. Save recipe-to-inventory links and quantities together with change/version context; Owner is actor. Preserve other variant/cake mappings and existing requirement/material-consumption/order amount snapshots. A failed combined update preserves prior saved recipe and dependent state; do not apply only part of the row set. If recipe draft accompanies BPMN-33 product save, participate consistently with that caller without independently committing ahead of a failed product update. Existing recipe identity prevents repeated submit from duplicating rows. No change to recorded stock, reservations, actual consumption, final selling price or allocations.</bpmn:documentation>
      <bpmn:incoming>Flow_35_16</bpmn:incoming>
      <bpmn:outgoing>Flow_35_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Saved_35" name="Recipe changes saved?">
      <bpmn:incoming>Flow_35_17</bpmn:incoming>
      <bpmn:outgoing>Flow_35_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SaveError_35" name="Explain conflict/save failure; preserve latest definition and draft">
      <bpmn:documentation>Retain latest independently committed recipe, not a stale snapshot. A stale record requires reload and explicit review. Transient save error may be safely retried after revalidation; avoid duplicate rows or partial saved mappings.</bpmn:documentation>
      <bpmn:incoming>Flow_35_18</bpmn:incoming>
      <bpmn:outgoing>Flow_35_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Available_35" name="Display saved recipe; make quantities available to dependent modules">
      <bpmn:documentation>FR-BOM-07-10. Expose saved variant/cake-option ingredient quantities to inventory requirements/reservation/consumption consumers and current recipe/cost inputs to pricing. Staff may view production quantities but may not edit definitions or see restricted costing analytics. Actual material calculations are BPMN-22/09/11/13; costing/final price is BPMN-36. Changing recipe may affect current cost estimates under pricing rules but never automatically overwrites final selling prices or original paid amounts. No automatic rewrite of existing confirmed material snapshots or historical consumption is introduced.</bpmn:documentation>
      <bpmn:incoming>Flow_35_19</bpmn:incoming>
      <bpmn:outgoing>Flow_35_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_35" name="Valid recipe/mapping saved and available for authorized reuse">
      <bpmn:incoming>Flow_35_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ReviewError_35" name="Review error/current values; correct, reload/retry, or stop">
      <bpmn:documentation>Owner recovery path, not Staff edit authority. Retain draft separately; correcting invalid input returns to recipe editor. Stale version requires reload/current-data review before resubmission. Retry checks current role/version/rules. No automatic overwrite or unbounded automatic retry loop.</bpmn:documentation>
      <bpmn:incoming>Flow_35_22</bpmn:incoming>
      <bpmn:incoming>Flow_35_21</bpmn:incoming>
      <bpmn:outgoing>Flow_35_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Recovery_35" name="Owner recovery choice?">
      <bpmn:incoming>Flow_35_23</bpmn:incoming>
      <bpmn:outgoing>Flow_35_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_35_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Stop_35" name="Stopped for now; saved recipe unchanged">
      <bpmn:incoming>Flow_35_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Reload_35" name="Reload current recipe/version and recheck Owner edit permission">
      <bpmn:documentation>Recovery only: refresh current recipe/target and expected version; retain unsaved draft separately. Recheck authenticated Owner modification permission server-side. No new login or manual approval is required. Missing/unsupported target or revoked permission cannot authorize editing. If permitted, go directly to Owner review of current data against draft in Edit, bypassing initial read-only viewing and modification-request choices. Do not silently merge or save a stale draft.</bpmn:documentation>
      <bpmn:incoming>Flow_35_26</bpmn:incoming>
      <bpmn:outgoing>Flow_35_27</bpmn:outgoing>
    </bpmn:serviceTask>
