    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_35_28" sourceRef="RetryAllowed_35" targetRef="Edit_35" name="Yes — review/edit current recipe" />
    <bpmn:sequenceFlow id="Flow_35_29" sourceRef="RetryAllowed_35" targetRef="Denied_35" name="No — reject modification" />
  </bpmn:process>
