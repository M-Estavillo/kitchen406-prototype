        <dc:Bounds x="40" y="40" width="1510" height="5300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_40_owner" bpmnElement="Lane_40_owner" isHorizontal="false">
        <dc:Bounds x="70" y="70" width="420" height="5270" />
