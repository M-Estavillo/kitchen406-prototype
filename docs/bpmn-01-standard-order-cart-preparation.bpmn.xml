<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01" targetNamespace="https://kitchen406.local/bpmn">
<bpmn:collaboration id="Collaboration_01"><bpmn:participant id="Participant_01" name="BPMN-01 | Standard Order Cart Preparation" processRef="Process_01" /></bpmn:collaboration>
<bpmn:process id="Process_01" name="Standard Order Cart Preparation" isExecutable="false"><bpmn:documentation>Sources: docs/proposed-bpmn-catalog.md, BPMN-01; Chapters/Kitchen406 - Capstone Paper.md, SRS 4.5?4.6, FR-CAT-01?02 and FR-CART-01?05. Customer and System are responsibility lanes in one descriptive process. Read top to bottom. Output is a valid cart for BPMN-02; no scheduling, order confirmation, reservation or payment is performed here. Leaving ends this interaction without defining deletion, persistence, or an abandonment timeout. A rejected change retains the previous cart. Task documentation records requirement traceability.</bpmn:documentation><bpmn:laneSet id="LaneSet_01"><bpmn:lane id="Lane_C" name="Customer"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Edit</bpmn:flowNodeRef><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Action</bpmn:flowNodeRef><bpmn:flowNodeRef>Leave</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_S" name="Kitchen406 System"><bpmn:flowNodeRef>Catalog</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckEdit</bpmn:flowNodeRef><bpmn:flowNodeRef>EditOK</bpmn:flowNodeRef><bpmn:flowNodeRef>EditError</bpmn:flowNodeRef><bpmn:flowNodeRef>Apply</bpmn:flowNodeRef><bpmn:flowNodeRef>Subtotal</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckCart</bpmn:flowNodeRef><bpmn:flowNodeRef>CartOK</bpmn:flowNodeRef><bpmn:flowNodeRef>CartError</bpmn:flowNodeRef><bpmn:flowNodeRef>Handoff</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start" name="Start selecting products"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Catalog" name="Display products, details, variants and availability"><bpmn:documentation>FR-CAT-01?02: Display image, name, description, price, availability and supported variants.</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Edit" name="Select product / variant and quantity; or change quantity / remove item"><bpmn:documentation>FR-CART-01?03: Choose an add, quantity-change or removal action.</bpmn:documentation><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="CheckEdit" name="Validate requested cart change"><bpmn:documentation>FR-CART-01?03, 05: Validate variant, availability and quantity for additions or quantity changes. Allow removal of unavailable items. No numeric quantity limit is specified by the SRS.</bpmn:documentation><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="EditOK" name="Change valid?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="EditError" name="Explain rejected change; retain previous cart"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Apply" name="Apply add, quantity change or removal"><bpmn:documentation>FR-CART-01?03: Store selected variant and quantity, update quantity, or remove selected item.</bpmn:documentation><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Subtotal" name="Recalculate and display items, prices and cart subtotal"><bpmn:documentation>FR-CART-04; SRS 4.6.2: Recalculate after every accepted change. Display selected products, quantities, prices and subtotal. Fees belong to BPMN-02.</bpmn:documentation><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Review" name="Review cart and choose next action"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Action" name="Next action?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="Leave" name="Left without submission"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="CheckCart" name="Revalidate cart before checkout"><bpmn:documentation>FR-CART-05: Recheck current availability and valid quantities for all selected variants. Require a nonempty selection as a process guard. Resource reservation and capacity checks belong to BPMN-09.</bpmn:documentation><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="CartOK" name="Cart valid?"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="CartError" name="Block checkout; show items / quantities to correct"><bpmn:documentation>FR-CART-05: Prevent checkout until the cart is corrected.</bpmn:documentation><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Handoff" name="Forward valid cart to BPMN-02: Fulfillment Arrangement"><bpmn:documentation>SRS 4.6.2: Forward selected products/variants, quantities, displayed prices and subtotal. This is a handoff only; fulfillment arrangement is a separate process.</bpmn:documentation><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End" name="Valid cart submitted to BPMN-02"><bpmn:incoming>Flow_18</bpmn:incoming></bpmn:endEvent>
