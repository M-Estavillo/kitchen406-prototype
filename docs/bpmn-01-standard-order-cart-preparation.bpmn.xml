    <bpmn:sequenceFlow id="Flow_7" sourceRef="Auth" targetRef="SignIn" name="No"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="SignIn" targetRef="SignedIn"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="SignedIn" targetRef="AuthEnd" name="No"/>
