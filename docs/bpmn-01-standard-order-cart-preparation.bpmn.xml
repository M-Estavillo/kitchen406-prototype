    <bpmn:sequenceFlow id="Flow_11" sourceRef="RequestedAction" targetRef="Edit" name="Add item"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="RequestedAction" targetRef="Operation" name="Open existing cart"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Edit" targetRef="CheckEdit"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="CheckEdit" targetRef="EditOK"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="EditOK" targetRef="Operation" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="EditOK" targetRef="EditError" name="No"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="EditError" targetRef="Edit" name="Correct edit"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Operation" targetRef="OperationOK"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="OperationOK" targetRef="Subtotal" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="OperationOK" targetRef="OperationError" name="No"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="OperationError" targetRef="Retry"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Retry" targetRef="RetryChoice"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="RetryChoice" targetRef="Operation" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="RetryChoice" targetRef="RetryEnd" name="No"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Subtotal" targetRef="Review"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Review" targetRef="Action"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Action" targetRef="Leave" name="Leave"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Action" targetRef="Edit" name="Edit cart"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Action" targetRef="Catalog" name="Continue shopping"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Action" targetRef="CheckCart" name="Proceed to checkout"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="CheckCart" targetRef="CartOK"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="CartOK" targetRef="CartError" name="No"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="CartError" targetRef="Review" name="Review / correct"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="CartOK" targetRef="Handoff" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Handoff" targetRef="End"/>
    <bpmn:sequenceFlow id="Flow_OpenBag" sourceRef="OpenBag" targetRef="Auth"/>
    <bpmn:textAnnotation id="OneTime"><bpmn:text>Subscription-eligible products may be bought once and mixed with other standard items. Enrollment uses BPMN-03.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_OneTime" sourceRef="Catalog" targetRef="OneTime"/>
    <bpmn:textAnnotation id="EditRules"><bpmn:text>Use current variant availability and a positive whole quantity. Allow removal even when an item is unavailable.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_EditRules" sourceRef="CheckEdit" targetRef="EditRules"/>
    <bpmn:textAnnotation id="Processing"><bpmn:text>While loading or saving, show progress and disable affected controls. Preserve the cart on a failed update.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Processing" sourceRef="Operation" targetRef="Processing"/>
    <bpmn:textAnnotation id="CheckoutRules"><bpmn:text>Require a nonempty cart and recheck every selected variant and quantity.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_CheckoutRules" sourceRef="CheckCart" targetRef="CheckoutRules"/>
  </bpmn:process>
