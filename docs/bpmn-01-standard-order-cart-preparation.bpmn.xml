<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:collaboration id="Collaboration_01">
    <bpmn:participant id="Participant_01" name="BPMN-01 | Standard Order Cart Preparation" processRef="Process_01"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_01" name="Standard Order Cart Preparation" isExecutable="false">
    <bpmn:documentation>Sources: Kitchen406 Capstone Paper, SRS ?3.1 Figure 8 and ??4.1, 4.5?4.6; FR-AUTH-02, FR-CAT-01?02, FR-CAT-05 and FR-CART-01?05. Guest browsing is supported. The standard-cart handoff is to BPMN-02 for fulfillment arrangement. Leaving ends the interaction without specifying a retention period.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_01">
    <bpmn:lane id="Lane_Customer" name="Customer">
      <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenBag</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Intent</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>BrowseEnd</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>SignIn</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>AuthEnd</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Edit</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>RetryChoice</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>RetryEnd</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Leave</bpmn:flowNodeRef>
    </bpmn:lane>
    <bpmn:lane id="Lane_System" name="Kitchen406 System">
      <bpmn:flowNodeRef>Catalog</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Auth</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>SignedIn</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>RequestedAction</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>CheckEdit</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>EditOK</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>EditError</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Operation</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>OperationOK</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>OperationError</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Subtotal</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>CheckCart</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>CartOK</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>CartError</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Handoff</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
    </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Open storefront">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="OpenBag" name="Open bag directly">
      <bpmn:outgoing>Flow_OpenBag</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Catalog" name="Display catalog products, details and availability">
      <bpmn:documentation>FR-CAT-01?02, FR-CAT-05. Show images, names, descriptions, prices, availability, variants and subscription eligibility.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Request" name="Choose a product variant and quantity, or open the cart">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Intent" name="Next action?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BrowseEnd" name="Leave without checkout">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Auth" name="Signed in as a customer?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_OpenBag</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="SignIn" name="Sign in through BPMN-26" calledElement="Process_26_Reference">
      <bpmn:documentation>Resume the requested cart interaction after successful sign-in.</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="SignedIn" name="Sign-in completed?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="AuthEnd" name="Cart action not submitted">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="RequestedAction" name="Cart request?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Edit" name="Request add, quantity change, removal or undo">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CheckEdit" name="Validate requested cart change">
      <bpmn:documentation>FR-CART-01?03, FR-CART-05. Validate current variant availability and positive whole quantities for adds, quantity changes and undo. Allow removal of unavailable items. A rejected edit leaves the previous cart intact.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="EditOK" name="Change valid?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="EditError" name="Explain rejected change and keep previous cart">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Operation" name="Load cart or save validated change">
      <bpmn:documentation>SRS ?3.1, Figure 8. Show loading feedback while processing and prevent repeated actions. Retain the validated request for retry.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OperationOK" name="Cart operation succeeded?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OperationError" name="Explain cart error and offer retry">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Retry" name="Choose whether to retry">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RetryChoice" name="Retry operation?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RetryEnd" name="Leave with cart action incomplete">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Subtotal" name="Display items, prices and current subtotal">
      <bpmn:documentation>FR-CART-04; SRS ?4.6.2. Refresh the displayed subtotal after an accepted edit. An empty bag offers a return to the shop.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Review the cart">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Action" name="Next action?">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Leave" name="Leave without checkout">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CheckCart" name="Revalidate cart before checkout">
      <bpmn:documentation>FR-CART-05. Require a nonempty cart, current availability and valid quantities for all selected variants. Final resource validation and reservation are handled in BPMN-09.</bpmn:documentation>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CartOK" name="Cart valid?">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CartError" name="Block checkout and show what to correct">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Handoff" name="Forward valid cart to BPMN-02">
      <bpmn:documentation>SRS ?4.6.2. Forward selected variants, quantities, prices and subtotal for fulfillment arrangement.</bpmn:documentation>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Valid cart sent to fulfillment arrangement">
      <bpmn:incoming>Flow_35</bpmn:incoming>
    </bpmn:endEvent>
