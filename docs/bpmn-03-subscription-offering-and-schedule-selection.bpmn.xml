<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_03" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:collaboration id="Collaboration_03"><bpmn:participant id="Participant_03" name="BPMN-03 | Subscription Offering and Schedule Selection" processRef="Process_03" /></bpmn:collaboration>
  <bpmn:process id="Process_03" name="Subscription Offering and Schedule Selection" isExecutable="false">
    <bpmn:documentation>Sources: docs/proposed-bpmn-catalog.md, BPMN-03 and reuse rules; Chapters/Kitchen406 - Capstone Paper.md, SRS 4.5 FR-CAT-05; 4.8.1-4.8.3 FR-SUB-01, FR-SUB-02, FR-SUB-05; BR-11-12; OR-LOC-04. Precondition: authenticated registered customer; authentication is BPMN-26. Customer and system are responsibility lanes in one descriptive process. Read top to bottom. BPMN-02 arranges fulfillment and reviews the full payable total. BPMN-09 validates resources and reserves all four capacity commitments and only the first fulfillment ingredients before payment. BPMN-10 handles payment and confirmation. BPMN-04 creates four operational fulfillments and preserves confirmed schedules. This process takes no payment, reserves no resources and creates no confirmed subscription or weekly orders. Leaving defines no abandonment timeout or draft persistence policy. An accepted proposed schedule is not a confirmed commitment. Visible text annotations reference shared processes without invoking them prematurely. Local selection validation remains here because it belongs to BPMN-03; BPMN-34 maintains scheduling configuration and is not a checkout validation process.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_03">
      <bpmn:lane id="Lane_C" name="Customer"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Select</bpmn:flowNodeRef><bpmn:flowNodeRef>Choose</bpmn:flowNodeRef><bpmn:flowNodeRef>Intent</bpmn:flowNodeRef><bpmn:flowNodeRef>Leave</bpmn:flowNodeRef><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Action</bpmn:flowNodeRef><bpmn:flowNodeRef>LeaveReview</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_S" name="Kitchen406 System"><bpmn:flowNodeRef>Offerings</bpmn:flowNodeRef><bpmn:flowNodeRef>Schedules</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Error</bpmn:flowNodeRef><bpmn:flowNodeRef>Commitment</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Open subscription enrollment"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Offerings" name="Display available subscription products and variants"><bpmn:documentation>FR-CAT-05; FR-SUB-01: Show subscription-eligible, available offerings, supported variants and configured prices.</bpmn:documentation><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Select" name="Select one product, variant and quantity"><bpmn:documentation>Catalog reuse rules; SRS glossary: one eligible product per subscription. No invented quantity limit.</bpmn:documentation><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Schedules" name="Display applicable four-week schedules"><bpmn:documentation>SRS 4.8.2; BR-11-12; OR-LOC-04: Show four weekly preparation and fulfillment dates from configured schedules, in Asia/Manila time. These are proposed dates without capacity commitments.</bpmn:documentation><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Choose" name="Choose proposed schedule; or leave"><bpmn:documentation>Select an applicable four-week schedule. Leave if no offering or schedule is suitable.</bpmn:documentation><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Intent" name="Continue selection?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="Leave" name="No selection submitted"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="Validate" name="Validate subscription selection"><bpmn:documentation>FR-CAT-05; FR-SUB-01; catalog BPMN-03: Recheck current subscription eligibility, product availability, supported variant, valid quantity and applicable configured four-week schedule. Definitive capacity, blocked-date, cutoff, lead-time and ingredient checks and reservations belong to BPMN-09.</bpmn:documentation><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Selection valid?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Error" name="Explain invalid or unavailable selection"><bpmn:documentation>Explain corrections and return to selection. No selection is submitted on failure.</bpmn:documentation><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Commitment" name="Display four-week prepaid commitment and product total"><bpmn:documentation>FR-SUB-02; BR-11-12: Display selected product, variant, quantity, prices, product total for all four fulfillments and proposed preparation/fulfillment dates. Explain full cycle prepayment and no automatic renewal. BPMN-02 adds applicable delivery fees and displays the final payable total. FR-SUB-05 protects agreed schedules after confirmation; this selection remains provisional.</bpmn:documentation><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Review selection and prepaid commitment"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Action" name="Next action?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="LeaveReview" name="No selection submitted"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End" name="Selection ready for BPMN-02"><bpmn:documentation>Handoff record: purchase type Subscription; selected offering/product and variant IDs; quantity; displayed prices and four-week product total; proposed schedule containing four preparation and fulfillment dates. Continue with the separately defined BPMN-02. This end event completes selection only.</bpmn:documentation><bpmn:incoming>Flow_16</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Offerings" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Offerings" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Select" targetRef="Schedules" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Schedules" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Choose" targetRef="Intent" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Intent" targetRef="Leave" name="Leave" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Intent" targetRef="Validate" name="Continue" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Valid" targetRef="Error" name="No" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Error" targetRef="Select" name="Revise" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Valid" targetRef="Commitment" name="Yes" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Commitment" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Review" targetRef="Action" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Action" targetRef="Select" name="Change selection" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Action" targetRef="LeaveReview" name="Leave" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Action" targetRef="End" name="Proceed" />
    <bpmn:textAnnotation id="Note_Auth"><bpmn:text>Precondition: registered, authenticated customer. Authentication is defined in BPMN-26.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Auth" sourceRef="Start" targetRef="Note_Auth" associationDirection="None" />
    <bpmn:textAnnotation id="Note_Checks"><bpmn:text>Shared checkout checks: BPMN-09 validates all four capacity commitments, scheduling rules and required ingredients, and reserves resources before payment. Only selection validity is checked here.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Checks" sourceRef="Validate" targetRef="Note_Checks" associationDirection="None" />
    <bpmn:textAnnotation id="Note_Next"><bpmn:text>Continue in BPMN-02: fulfillment arrangement and full purchase review. Then BPMN-09: resource checks/reservations; BPMN-10: payment/confirmation; BPMN-04: activation and four fulfillment records. These are separate downstream processes.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Next" sourceRef="End" targetRef="Note_Next" associationDirection="None" />
  </bpmn:process>
