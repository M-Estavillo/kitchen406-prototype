<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_17" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:message id="OutForDeliveryNotice_21" name="Out for Delivery notification" />
  <bpmn:collaboration id="Collaboration_17">
    <bpmn:participant id="Participant_17" name="BPMN-17 | Owner-Managed Cake Delivery and Handoff" processRef="Process_17" />
    <bpmn:participant id="CustomerPool_21" name="Customer" processRef="CustomerProcess_21" />
    <bpmn:messageFlow id="CustomerNoticeFlow_21" sourceRef="NotifyCustomer_21" targetRef="ReceiveNotice_21" messageRef="OutForDeliveryNotice_21" />
  </bpmn:collaboration>
  <bpmn:process id="Process_17" name="Owner-Managed Cake Delivery and Handoff" isExecutable="false">
    <bpmn:documentation>Sources: capstone SRS FR-DEL-16, FR-FUL-20–21,26 and FR-CAKE-08–09. A paid custom cake is Ready for agreed Owner delivery. The Owner selects Out for Delivery and the customer receives a notice. The Owner records whether the cake was received. On successful handoff, the system records completion and locks existing allocations automatically. On unsuccessful handoff, the Owner records the outcome and reason. If saving completion fails, the Owner retries recording without repeating physical handoff.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_17">
      <bpmn:lane id="Lane_21_user" name="Admin/Owner — cake delivery and handoff">
        <bpmn:flowNodeRef>OutForDelivery_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Handover_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirmed_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancelled_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PhysicalHandoff_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LogUnsuccessfulHandoff_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RetrySave_21</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_21_system" name="Kitchen406 System — Fulfillment Management">
        <bpmn:flowNodeRef>Start_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyCustomer_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Commit_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Saved_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Completed_21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SaveError_21</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_21" name="Cake order marked Ready for Delivery">
      <bpmn:documentation>Start when the paid custom cake is marked Ready for its agreed Owner-managed delivery.</bpmn:documentation>
      <bpmn:outgoing>Flow_21_7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="OutForDelivery_21" name="Owner clicks “Out for Delivery”">
      <bpmn:documentation>The Admin/Owner selects Out for Delivery when leaving to deliver the prepared cake under the accepted arrangement.</bpmn:documentation>
      <bpmn:incoming>Flow_21_7</bpmn:incoming>
      <bpmn:outgoing>Flow_21_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="NotifyCustomer_21" name="Set Out for Delivery and notify the customer" messageRef="OutForDeliveryNotice_21">
      <bpmn:documentation>Save and display Out for Delivery and send an update to the customer that the Owner is on the way. The Owner can proceed without waiting for the customer to open the notice.</bpmn:documentation>
      <bpmn:incoming>Flow_21_8</bpmn:incoming>
      <bpmn:outgoing>Flow_21_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:manualTask id="Handover_21" name="Transport cake under the accepted owner-managed arrangement">
      <bpmn:documentation>FR-DEL-16; BR-20. Owner manually transports the prepared cake according to accepted quotation delivery terms. This is physical work outside API integration, with no Lalamove booking, fixed service-area distance cap or automated location tracking. If already handed over and retrying a recording, review the established fact instead of repeating transport.</bpmn:documentation>
      <bpmn:incoming>Flow_21_12</bpmn:incoming>
      <bpmn:outgoing>Flow_21_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Confirm_21" name="Record whether the customer received the cake">
      <bpmn:documentation>The Owner records the physical handoff outcome. If the customer did not receive the cake, record the reason.</bpmn:documentation>
      <bpmn:incoming>Flow_21_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirmed_21" name="Did the customer receive the cake?">
      <bpmn:incoming>Flow_21_14</bpmn:incoming>
      <bpmn:outgoing>Flow_21_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_21_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="LogUnsuccessfulHandoff_21" name="Record unsuccessful handoff and reason">
      <bpmn:documentation>The Owner records that the customer did not receive the cake and why. Leave the order incomplete for follow-up.</bpmn:documentation>
      <bpmn:incoming>Flow_21_15</bpmn:incoming>
      <bpmn:outgoing>NoHandoffEnd_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Cancelled_21" name="Unsuccessful handoff recorded">
      <bpmn:documentation>The attempt outcome and reason are saved. The order remains incomplete for follow-up.</bpmn:documentation>
      <bpmn:incoming>NoHandoffEnd_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Commit_21" name="Mark Completed and record handoff time">
      <bpmn:documentation>Save Completed status, actual completion timestamp and handoff history. Completion automatically locks the existing preparing-owner allocations under FR-FUL-20 and FR-FUL-26. Preserve the saved shares. A failed save preserves the existing record for retry.</bpmn:documentation>
      <bpmn:incoming>Flow_21_16</bpmn:incoming>
      <bpmn:incoming>RetryFlow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_21_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Saved_21" name="Was completion recorded?">
      <bpmn:documentation>A new save proceeds. If the same handoff was already recorded, use the saved result. If saving fails, the Owner can retry recording.</bpmn:documentation>
      <bpmn:incoming>Flow_21_17</bpmn:incoming>
      <bpmn:outgoing>Flow_21_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_21_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Publish_21" name="Use recorded cake completion for applicable notification follow-up">
      <bpmn:documentation>Use this same recorded completion identity for supported BPMN-24 external or BPMN-25 internal notification work, independently of successful completion. No generic broadcast-signal architecture is prescribed, and no customer receipt action or notification-delivery success is required. Cake orders do not call BPMN-05 subscription progress. Status inquiry is BPMN-30; report generation is BPMN-39.</bpmn:documentation>
      <bpmn:incoming>Flow_21_18</bpmn:incoming>
      <bpmn:outgoing>Flow_21_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Completed_21" name="Cake delivery completed">
      <bpmn:documentation>Output: paid cake fulfillment Completed with recorded handoff completion time, preserved original product amounts and locked allocations. Repeated requests cannot duplicate completion/sales or change its original timestamp. BPMN-39 uses actual completion date separately; BPMN-19 owns authorized accidental reversal. No general edit/unlock or automatic inventory reversal is introduced.</bpmn:documentation>
      <bpmn:incoming>Flow_21_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="SaveError_21" name="Record save failure">
      <bpmn:documentation>Keep the saved order and handoff details, and prompt the Owner to retry.</bpmn:documentation>
      <bpmn:incoming>Flow_21_5</bpmn:incoming>
      <bpmn:outgoing>Flow_21_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="RetrySave_21" name="Retry recording the handoff">
      <bpmn:documentation>The Owner retries saving the same confirmed handoff. The system saves the completion record without repeating delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_21_6</bpmn:incoming>
      <bpmn:outgoing>RetryFlow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="RetryFlow_21" sourceRef="RetrySave_21" targetRef="Commit_21" />
    <bpmn:sequenceFlow id="NoHandoffEnd_21" sourceRef="LogUnsuccessfulHandoff_21" targetRef="Cancelled_21" />
    <bpmn:sequenceFlow id="Flow_21_5" sourceRef="Saved_21" targetRef="SaveError_21" name="Save failed" />
    <bpmn:sequenceFlow id="Flow_21_6" sourceRef="SaveError_21" targetRef="RetrySave_21" />
    <bpmn:sequenceFlow id="Flow_21_7" sourceRef="Start_21" targetRef="OutForDelivery_21" />
    <bpmn:sequenceFlow id="Flow_21_8" sourceRef="OutForDelivery_21" targetRef="NotifyCustomer_21" />
    <bpmn:sequenceFlow id="Flow_21_12" sourceRef="NotifyCustomer_21" targetRef="Handover_21" />
    <bpmn:sequenceFlow id="Flow_21_13" sourceRef="Handover_21" targetRef="PhysicalHandoff_21" />
    <bpmn:sequenceFlow id="Flow_21_14" sourceRef="Confirm_21" targetRef="Confirmed_21" />
    <bpmn:sequenceFlow id="Flow_21_15" sourceRef="Confirmed_21" targetRef="LogUnsuccessfulHandoff_21" name="No" />
    <bpmn:sequenceFlow id="Flow_21_16" sourceRef="Confirmed_21" targetRef="Commit_21" name="Yes" />
    <bpmn:sequenceFlow id="Flow_21_17" sourceRef="Commit_21" targetRef="Saved_21" />
    <bpmn:sequenceFlow id="Flow_21_18" sourceRef="Saved_21" targetRef="Publish_21" name="New completion saved" />
    <bpmn:sequenceFlow id="Flow_21_19" sourceRef="Publish_21" targetRef="Completed_21" />
    <bpmn:textAnnotation id="CommitRules_21">
      <bpmn:text>Handoff completion
• Save Completed, handoff time and history.
• Existing allocations lock automatically on completion.
• A retry records the same handoff and keeps any saved completion timestamp.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_CommitRules_21" sourceRef="Commit_21" targetRef="CommitRules_21" associationDirection="None" />
    <bpmn:textAnnotation id="Handoffs_21">
      <bpmn:text>After cake completion
Applicable notices: BPMN-24/25, independently of successful completion.
Status inquiry: BPMN-30.
Reporting: BPMN-39 uses actual completion date and original amounts.
No subscription progress or new payment.
Any recording retry must not repeat physical delivery or handoff.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Handoffs_21" sourceRef="Publish_21" targetRef="Handoffs_21" associationDirection="None" />
    <bpmn:manualTask id="PhysicalHandoff_21" name="Carry out actual cake handoff under the agreed terms">
      <bpmn:documentation>Physical cake handoff by the owner. If handoff cannot be completed, do not confirm Completed; retain incomplete state and arrange next steps outside any invented automatic recovery policy. On system-only retry, verify the already completed handoff rather than perform it again.</bpmn:documentation>
      <bpmn:incoming>Flow_21_13</bpmn:incoming>
      <bpmn:outgoing>Flow_21_20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_21_20" sourceRef="PhysicalHandoff_21" targetRef="Confirm_21" />
  </bpmn:process>
