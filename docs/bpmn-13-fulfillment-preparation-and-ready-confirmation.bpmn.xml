<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_13" targetNamespace="https://kitchen406.local/bpmn" xmlns:k406="https://kitchen406.local/bpmn">
  <bpmn:import namespace="https://kitchen406.local/bpmn" location="bpmn-12-preparing-owner-assignment-and-allocation-validation.bpmn.xml" importType="http://www.omg.org/spec/BPMN/20100524/MODEL" />
  <bpmn:collaboration id="Collaboration_13">
    <bpmn:participant id="Participant_13" name="BPMN-13 | Fulfillment Preparation and Ready Confirmation" processRef="Process_13" />
  </bpmn:collaboration>
  <bpmn:process id="Process_13" name="Fulfillment Preparation and Ready Confirmation" isExecutable="false">
    <bpmn:documentation>Scope: preparation and Ready confirmation for paid standard orders, subscription weeks and accepted paid cake orders. Starting preparation checks material readiness and consumes reserved ingredients once. Start preparation invokes BPMN-12 (k406:Process_12) to validate a saved allocation or collect a draft. Commit any new allocation and its history together with ingredient consumption and Preparing. Mark Ready validates saved allocations. Reuse saved assignments after status reversal. Authentication is a BPMN-26 precondition. Recheck permissions, version and locks at commit. Batch results are independent per fulfillment. BPMN-11 owns scheduled subscription ingredient reservation and recovery. BPMN-19 owns accidental status correction. BPMN-14/15/16/17 own the actions after Ready.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_13">
      <bpmn:lane id="Lane_17_user" name="Admin/Owner or authorized Staff">
        <bpmn:flowNodeRef>Review_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestStart_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmedStart_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CancelStart_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyRequest_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmedReady_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CancelReady_17</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_17_system" name="Kitchen406 System — Fulfillment Management">
        <bpmn:flowNodeRef>Start_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Load_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckStart_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEligible_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Materials_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MaterialReady_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartAllocation_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartAllocationValid_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CommitStart_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartSaved_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ResumeReady_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyAllocation_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyAllocationValid_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckReady_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyEligible_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CommitReady_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadySaved_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EligibilityError_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EligibilityEnd_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MaterialError_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MaterialEnd_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartSaveError_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartSaveEnd_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyAllocationError_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyAllocationEnd_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyEligibilityError_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyEligibilityEnd_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadySaveError_17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadySaveEnd_17</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_17" name="Due fulfillment selected for preparation">
      <bpmn:outgoing>Flow_17_15</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Load_17" name="Load paid fulfillment, schedule, products and production details">
      <bpmn:documentation>FR-FUL-01-07,10-11,14; FR-BOM-10. Load confirmed operational fulfillment, products/variants/quantities, preparation and fulfillment dates, method, recipe and accepted cake specifications as applicable. Restrict staff to operational information; no sales/cost/profit/customer-management access. Review can include upcoming work, but starting preparation must satisfy the scheduled preparation date where one is established.</bpmn:documentation>
      <bpmn:incoming>Flow_17_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review_17" name="Review quantities, recipe or accepted cake details">
      <bpmn:documentation>Review instructions needed for this fulfillment, including the accepted quotation specifications for cakes. No mandatory extra owner approval of cake specifications is invented.</bpmn:documentation>
      <bpmn:incoming>Flow_17_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RequestStart_17" name="Confirm start preparation or cancel">
      <bpmn:documentation>Confirm that preparation is starting and ingredients will be recorded as used. Batch confirmation displays saved line allocations and validates and reports each selected fulfillment independently.</bpmn:documentation>
      <bpmn:incoming>Flow_17_17</bpmn:incoming>
      <bpmn:outgoing>Flow_17_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ConfirmedStart_17" name="Start confirmed?">
      <bpmn:incoming>Flow_17_18</bpmn:incoming>
      <bpmn:outgoing>Flow_17_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CancelStart_17" name="Cancelled; confirmed state unchanged">
      <bpmn:incoming>Flow_17_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="CheckStart_17" name="Check payment, current status and applicable preparation date">
      <bpmn:documentation>FR-FUL-01,03,08. Require verified paid/confirmed operational order, current Confirmed status, and that any scheduled preparation date has arrived. Use the recorded preparation date for subscriptions. A separate preparation date is not required for standard or cake orders without a preparation schedule. Do not start on an unpaid purchase or completed/ready fulfillment. A missing subscription preparation date is a rejection reason. No new payment verification workflow is performed here.</bpmn:documentation>
      <bpmn:incoming>Flow_17_20</bpmn:incoming>
      <bpmn:outgoing>Flow_17_21</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="StartEligible_17" name="Paid, confirmed and schedule eligible?">
      <bpmn:incoming>Flow_17_21</bpmn:incoming>
      <bpmn:outgoing>Flow_17_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Materials_17" name="Check full ingredient reservation and physical material readiness">
      <bpmn:documentation>FR-INV-09,19; FR-FUL-08. Require complete confirmed reservation linked to this fulfillment and every valid recipe/configuration ingredient quantity physically available for consumption, respecting other reservations. A projected requirement alone is not a reservation. First checkout reservations come from BPMN-09/10; later subscription reservations from BPMN-11. Do not silently create a missing reservation or use this as a new checkout.</bpmn:documentation>
      <bpmn:incoming>Flow_17_28</bpmn:incoming>
      <bpmn:outgoing>Flow_17_23</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="MaterialReady_17" name="All required materials ready?">
      <bpmn:incoming>Flow_17_23</bpmn:incoming>
      <bpmn:outgoing>Flow_17_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="StartAllocation_17" name="BPMN-12: Collect or validate preparing owners" calledElement="k406:Process_12">
      <bpmn:documentation>Check saved owners or validate a new draft per line. Leave the draft unsaved until preparation commits.</bpmn:documentation>
      <bpmn:incoming>Flow_17_30</bpmn:incoming>
      <bpmn:outgoing>Flow_17_40</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="StartAllocationValid_17" name="Allocation accepted?">
      <bpmn:incoming>Flow_17_40</bpmn:incoming>
      <bpmn:outgoing>Flow_17_41</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CommitStart_17" name="Consume ingredients once; save Preparing and audit history atomically">
      <bpmn:documentation>FR-INV-09,17,19; FR-FUL-23,26; NFR-REL-03,05. Under current version/permission/lock/material checks, deduct actual physical quantities once, convert linked reservation to consumed, record ingredient movements, actor/time and preparing transition/history/version together with any new allocation and per-line history. Preserve product amounts and existing reporting timestamps. Use fulfillment/action operation identity so repeated requests do not consume twice. If the same completed operation is replayed, return existing success without another mutation; conflicting/stale operations reject. Do not reserve a later subscription fulfillment here. Failed combined save retains the prior saved state with no partial consumption or status update.</bpmn:documentation>
      <bpmn:incoming>Flow_17_41</bpmn:incoming>
      <bpmn:outgoing>Flow_17_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="StartSaved_17" name="Preparation start saved?">
      <bpmn:incoming>Flow_17_24</bpmn:incoming>
      <bpmn:outgoing>Flow_17_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Prepare_17" name="Prepare products to recipe/specifications; pack and stage">
      <bpmn:documentation>Actual bakery preparation and packing by the designated baking owners. Staff may operate the system without receiving an owner share. Production instructions differ by product/accepted cake; no automated physical preparation, QA signoff or unsupported approval is introduced.</bpmn:documentation>
      <bpmn:incoming>Flow_17_34</bpmn:incoming>
      <bpmn:outgoing>Flow_17_35</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="ReadyRequest_17" name="Review prepared and packed products; confirm Ready or cancel">
      <bpmn:documentation>Confirm this fulfillment is prepared, packed and staged. BPMN-12 validates saved preparing-owner choices for this action. Batch Ready confirmation displays saved line allocations. Cancelling this confirmation does not reverse previously recorded preparation or ingredient consumption.</bpmn:documentation>
      <bpmn:incoming>Flow_17_36</bpmn:incoming>
      <bpmn:incoming>Flow_17_35</bpmn:incoming>
      <bpmn:outgoing>Flow_17_37</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="ResumeReady_17" name="Ready confirmation requested for an already Preparing fulfillment">
      <bpmn:documentation>Alternative re-entry after preparation was saved previously, or retry of a failed/cancelled ready confirmation. Enter the same Ready user confirmation and checks; do not replay ingredient consumption or skip actual preparation.</bpmn:documentation>
      <bpmn:outgoing>Flow_17_36</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ConfirmedReady_17" name="Ready confirmed?">
      <bpmn:incoming>Flow_17_37</bpmn:incoming>
      <bpmn:outgoing>Flow_17_38</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CancelReady_17" name="Ready cancelled; remains Preparing">
      <bpmn:incoming>Flow_17_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="ReadyAllocation_17" name="Refer to BPMN-12 — Validate saved preparing owners" calledElement="k406:Process_12">
      <bpmn:documentation>Invoke k406:Process_12 during Mark Ready. Check saved per-line assignments. Return specific permission, version, allocation and lock failures. A missing or invalid assignment is corrected through Edit Allocation before retrying.</bpmn:documentation>
      <bpmn:incoming>Flow_17_39</bpmn:incoming>
      <bpmn:outgoing>Flow_17_25</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="ReadyAllocationValid_17" name="Allocation/action validation passed?">
      <bpmn:incoming>Flow_17_25</bpmn:incoming>
      <bpmn:outgoing>Flow_17_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="CheckReady_17" name="Recheck paid Preparing state and recorded material consumption">
      <bpmn:documentation>FR-FUL-08-09,18,23. Require paid operational fulfillment still in Preparing state and successful ingredient-consumption record from its preparation start. Check current action/version context. Do not require a new unconsumed reservation or consume the ingredients again. Conflicting completion/booking/status changes cannot be overwritten.</bpmn:documentation>
      <bpmn:incoming>Flow_17_31</bpmn:incoming>
      <bpmn:outgoing>Flow_17_26</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ReadyEligible_17" name="Ready transition still valid?">
      <bpmn:incoming>Flow_17_26</bpmn:incoming>
      <bpmn:outgoing>Flow_17_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CommitReady_17" name="Save Ready and owner assignments together">
      <bpmn:documentation>FR-FUL-08-09,15,23,26. Recheck permissions/version/locks and prerequisite state at commit. Save ready-for-pickup or ready-for-delivery as applicable, status history, actor and new version consistently. Reuse existing allocations and preserve product amounts and reporting timestamps. No second consumption, completion timestamp, completion lock, fulfilled sale or courier booking. Same-operation retry reuses saved result; conflicting save fails without partial changes.</bpmn:documentation>
      <bpmn:incoming>Flow_17_32</bpmn:incoming>
      <bpmn:outgoing>Flow_17_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ReadySaved_17" name="Ready status saved?">
      <bpmn:incoming>Flow_17_27</bpmn:incoming>
      <bpmn:outgoing>Flow_17_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_17_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Ready_17" name="Ready for the separate pickup/delivery process">
      <bpmn:documentation>Output: paid ready fulfillment with preserved allocations, one recorded consumption and updated operational history. Standard/subscription pickup uses BPMN-14 for the pickup-ready notice and cutoff; standard/subscription delivery uses BPMN-15/16; cakes use BPMN-17 owner handoff. Ready is not completed and does not create Fulfilled sales. Authorized accidental reversals are handled by BPMN-19. Applicable notifications run independently in BPMN-24/25; customer status inquiry belongs to BPMN-30.</bpmn:documentation>
      <bpmn:incoming>Flow_17_33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="EligibilityError_17" name="Explain unpaid, not-due or invalid-status reason; retain state">
      <bpmn:documentation>Show exact business rejection. This attempt changes no allocations, materials or operational status. A fresh request may proceed when prerequisites hold.</bpmn:documentation>
      <bpmn:incoming>Flow_17_1</bpmn:incoming>
      <bpmn:outgoing>Flow_17_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EligibilityEnd_17" name="Preparation blocked; review eligibility">
      <bpmn:incoming>Flow_17_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="MaterialError_17" name="Explain missing reservation or ingredient shortage; retain Confirmed">
      <bpmn:documentation>Refer to BPMN-11 for later subscription reservation/retry; BPMN-20 for restocking. These are separate recovery processes, not automatic preparation approval. No consumption or cancellation. Missing/invalid recipe is a data issue, not zero ingredients.</bpmn:documentation>
      <bpmn:incoming>Flow_17_5</bpmn:incoming>
      <bpmn:outgoing>Flow_17_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="MaterialEnd_17" name="Preparation blocked; material recovery needed">
      <bpmn:incoming>Flow_17_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="StartSaveError_17" name="Explain allocation rejection or save failure; retain Confirmed">
      <bpmn:documentation>Return the BPMN-12 reason for a rejected allocation. For a failed combined update preserve prior saved allocations, physical stock, reservation state and operational state. A concurrently committed successful operation remains authoritative; replay it safely rather than deducting again. Log technical failure.</bpmn:documentation>
      <bpmn:incoming>Flow_17_7</bpmn:incoming>
      <bpmn:incoming>Flow_17_42</bpmn:incoming>
      <bpmn:outgoing>Flow_17_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="StartSaveEnd_17" name="Start failed; refresh, review and retry">
      <bpmn:incoming>Flow_17_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ReadyAllocationError_17" name="Return BPMN-12 reason; retain saved Preparing state">
      <bpmn:documentation>No second consumption or rollback of actual preparation. Refresh stale data, correct saved allocations through Edit Allocation or use authorized account as appropriate; retry ready confirmation separately.</bpmn:documentation>
      <bpmn:incoming>Flow_17_9</bpmn:incoming>
      <bpmn:outgoing>Flow_17_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ReadyAllocationEnd_17" name="Ready blocked; review allocation/action issue">
      <bpmn:incoming>Flow_17_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ReadyEligibilityError_17" name="Explain status/material-record conflict; retain latest saved state">
      <bpmn:documentation>Missing prior consumption or conflicting order state cannot authorize Ready. Investigate/reconcile current records without inventing physical stock restoration. No automatic reversal or completion.</bpmn:documentation>
      <bpmn:incoming>Flow_17_11</bpmn:incoming>
      <bpmn:outgoing>Flow_17_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ReadyEligibilityEnd_17" name="Ready blocked; review current fulfillment">
      <bpmn:incoming>Flow_17_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ReadySaveError_17" name="Return save/conflict reason; no partial Ready update">
      <bpmn:documentation>Preserve the prior saved Preparing state for this failed attempt, allocations and existing consumption. Do not undo newer independently committed state. Repeated successful operation returns its recorded result.</bpmn:documentation>
      <bpmn:incoming>Flow_17_13</bpmn:incoming>
      <bpmn:outgoing>Flow_17_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ReadySaveEnd_17" name="Ready save failed; review and retry">
      <bpmn:incoming>Flow_17_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_17_1" sourceRef="StartEligible_17" targetRef="EligibilityError_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_2" sourceRef="EligibilityError_17" targetRef="EligibilityEnd_17" />
    <bpmn:sequenceFlow id="Flow_17_5" sourceRef="MaterialReady_17" targetRef="MaterialError_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_6" sourceRef="MaterialError_17" targetRef="MaterialEnd_17" />
    <bpmn:sequenceFlow id="Flow_17_7" sourceRef="StartSaved_17" targetRef="StartSaveError_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_8" sourceRef="StartSaveError_17" targetRef="StartSaveEnd_17" />
    <bpmn:sequenceFlow id="Flow_17_9" sourceRef="ReadyAllocationValid_17" targetRef="ReadyAllocationError_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_10" sourceRef="ReadyAllocationError_17" targetRef="ReadyAllocationEnd_17" />
    <bpmn:sequenceFlow id="Flow_17_11" sourceRef="ReadyEligible_17" targetRef="ReadyEligibilityError_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_12" sourceRef="ReadyEligibilityError_17" targetRef="ReadyEligibilityEnd_17" />
    <bpmn:sequenceFlow id="Flow_17_13" sourceRef="ReadySaved_17" targetRef="ReadySaveError_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_14" sourceRef="ReadySaveError_17" targetRef="ReadySaveEnd_17" />
    <bpmn:sequenceFlow id="Flow_17_15" sourceRef="Start_17" targetRef="Load_17" />
    <bpmn:sequenceFlow id="Flow_17_16" sourceRef="Load_17" targetRef="Review_17" />
    <bpmn:sequenceFlow id="Flow_17_17" sourceRef="Review_17" targetRef="RequestStart_17" />
    <bpmn:sequenceFlow id="Flow_17_18" sourceRef="RequestStart_17" targetRef="ConfirmedStart_17" />
    <bpmn:sequenceFlow id="Flow_17_19" sourceRef="ConfirmedStart_17" targetRef="CancelStart_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_20" sourceRef="ConfirmedStart_17" targetRef="CheckStart_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_21" sourceRef="CheckStart_17" targetRef="StartEligible_17" />
    <bpmn:sequenceFlow id="Flow_17_23" sourceRef="Materials_17" targetRef="MaterialReady_17" />
    <bpmn:sequenceFlow id="Flow_17_24" sourceRef="CommitStart_17" targetRef="StartSaved_17" />
    <bpmn:sequenceFlow id="Flow_17_25" sourceRef="ReadyAllocation_17" targetRef="ReadyAllocationValid_17" />
    <bpmn:sequenceFlow id="Flow_17_26" sourceRef="CheckReady_17" targetRef="ReadyEligible_17" />
    <bpmn:sequenceFlow id="Flow_17_27" sourceRef="CommitReady_17" targetRef="ReadySaved_17" />
    <bpmn:sequenceFlow id="Flow_17_28" sourceRef="StartEligible_17" targetRef="Materials_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_30" sourceRef="MaterialReady_17" targetRef="StartAllocation_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_40" sourceRef="StartAllocation_17" targetRef="StartAllocationValid_17" />
    <bpmn:sequenceFlow id="Flow_17_41" sourceRef="StartAllocationValid_17" targetRef="CommitStart_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_42" sourceRef="StartAllocationValid_17" targetRef="StartSaveError_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_31" sourceRef="ReadyAllocationValid_17" targetRef="CheckReady_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_32" sourceRef="ReadyEligible_17" targetRef="CommitReady_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_33" sourceRef="ReadySaved_17" targetRef="Ready_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_34" sourceRef="StartSaved_17" targetRef="Prepare_17" name="Yes" />
    <bpmn:sequenceFlow id="Flow_17_35" sourceRef="Prepare_17" targetRef="ReadyRequest_17" />
    <bpmn:sequenceFlow id="Flow_17_36" sourceRef="ResumeReady_17" targetRef="ReadyRequest_17" />
    <bpmn:sequenceFlow id="Flow_17_37" sourceRef="ReadyRequest_17" targetRef="ConfirmedReady_17" />
    <bpmn:sequenceFlow id="Flow_17_38" sourceRef="ConfirmedReady_17" targetRef="CancelReady_17" name="No" />
    <bpmn:sequenceFlow id="Flow_17_39" sourceRef="ConfirmedReady_17" targetRef="ReadyAllocation_17" name="Yes" />
    <bpmn:textAnnotation id="EligibilityRules_17">
      <bpmn:text>Start requirements
Paid, confirmed operational fulfillment.
Scheduled preparation date reached where applicable.
Current state = Confirmed.
All three fulfillment types use these controls.
BPMN-26 owns sign-in; BPMN-12 checks action permissions/version/locks.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_EligibilityRules_17" sourceRef="CheckStart_17" targetRef="EligibilityRules_17" associationDirection="None" />
    <bpmn:textAnnotation id="MaterialRules_17">
