    <bpmn:sequenceFlow id="F22_05" sourceRef="N22_MapIssue" targetRef="N22_MapEnd" />
    <bpmn:sequenceFlow id="F22_06" sourceRef="N22_Located" targetRef="N22_Area" name="Yes" />
    <bpmn:sequenceFlow id="F22_07" sourceRef="N22_Area" targetRef="N22_Eligible" />
    <bpmn:sequenceFlow id="F22_08" sourceRef="N22_Eligible" targetRef="N22_Outside" name="No" />
    <bpmn:sequenceFlow id="F22_09" sourceRef="N22_Outside" targetRef="N22_OutsideEnd" />
    <bpmn:sequenceFlow id="F22_10" sourceRef="N22_Eligible" targetRef="N22_Quote" name="Yes" />
    <bpmn:sequenceFlow id="F22_11" sourceRef="N22_Quote" targetRef="N22_Usable" />
    <bpmn:sequenceFlow id="F22_12" sourceRef="N22_Usable" targetRef="N22_QuoteIssue" name="No / provider issue" />
    <bpmn:sequenceFlow id="F22_13" sourceRef="N22_QuoteIssue" targetRef="N22_QuoteEnd" />
    <bpmn:sequenceFlow id="F22_14" sourceRef="N22_Usable" targetRef="N22_Result" name="Yes" />
    <bpmn:sequenceFlow id="F22_15" sourceRef="N22_Result" targetRef="N22_Done" />
    <bpmn:sequenceFlow id="F22_MapRetry" sourceRef="N22_MapEnd" targetRef="N22_Input" />
    <bpmn:sequenceFlow id="F22_Edit" sourceRef="N22_OutsideEnd" targetRef="N22_EditAddress" name="Edit address">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">editDeliveryAddress</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22_EditRetry" sourceRef="N22_EditAddress" targetRef="N22_Input" />
    <bpmn:sequenceFlow id="F22_Pickup" sourceRef="N22_OutsideEnd" targetRef="N22_SwitchPickup" name="Switch to pickup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">selectPickup</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22_PickupReturn" sourceRef="N22_SwitchPickup" targetRef="N22_PickupReturn" />
    <bpmn:sequenceFlow id="F22_QuoteRetry" sourceRef="N22_QuoteEnd" targetRef="N22_Quote" name="No, retry fee request">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">attempts &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22_QuoteExhausted" sourceRef="N22_QuoteEnd" targetRef="N22_ShowQuoteFailure" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">attempts &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22_QuoteReturn" sourceRef="N22_ShowQuoteFailure" targetRef="N22_QuoteReturn" />
  </bpmn:process>
