<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_18" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:collaboration id="Collaboration_18">
    <bpmn:participant id="Participant_18" name="BPMN-18 | Courier Address Eligibility and Delivery Fee Quotation" processRef="Process_18_Reference" />
    <bpmn:participant id="Provider_22_Maps" name="Google Maps Platform" />
    <bpmn:participant id="Provider_22_Lalamove" name="Lalamove ? quotation only" />
    <bpmn:messageFlow id="M22_MapsRequest" sourceRef="N22_Maps" targetRef="Provider_22_Maps" name="Address validation / location request" />
    <bpmn:messageFlow id="M22_MapsResponse" sourceRef="Provider_22_Maps" targetRef="N22_Maps" name="Location result / provider issue" />
    <bpmn:messageFlow id="M22_QuoteRequest" sourceRef="N22_Quote" targetRef="Provider_22_Lalamove" name="Applicable quotation request(s)" />
    <bpmn:messageFlow id="M22_QuoteResponse" sourceRef="Provider_22_Lalamove" targetRef="N22_Quote" name="Fee quotation(s) / provider issue" />
  </bpmn:collaboration>
  <bpmn:process id="Process_18_Reference" name="Courier Address Eligibility and Delivery Fee Quotation" isExecutable="false">
    <bpmn:documentation>BPMN-02 calls this process for standard and subscription courier checkout. Google Maps checks the address and Lalamove quotes the delivery fee. Customers can retry or edit an address and can switch to pickup in BPMN-02. BPMN-31 owns saved address maintenance. Each quotation run allows three total attempts. If all three fail, return to BPMN-02 with delivery checkout unavailable for that attempt. A later customer-initiated retry starts a fresh run. FR-ADDR-04–05, FR-DEL-02–09, BR-26–27.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_18">
      <bpmn:lane id="Lane_22_Customer" name="Customer">
        <bpmn:flowNodeRef>N22_MapEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_OutsideEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_EditAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_SwitchPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_PickupReturn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_22_Checkout" name="Kitchen406 System ? Checkout coordination">
        <bpmn:flowNodeRef>N22_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_MapIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Outside</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_QuoteIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_QuoteEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_ShowQuoteFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_QuoteReturn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_22_Delivery" name="Kitchen406 System ? Delivery validation and quotation">
        <bpmn:flowNodeRef>N22_Maps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Located</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Usable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N22_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N22_Start" name="Delivery check requested by BPMN-02">
      <bpmn:documentation>Input: authenticated customer, selected saved address, purchase type, bakery origin and applicable delivery schedule(s). Only standard orders and courier subscriptions enter this process. Pickup bypasses it; custom cakes use BPMN-08 and BPMN-17.</bpmn:documentation>
      <bpmn:outgoing>F22_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="N22_Input" name="Load selected address and applicable delivery schedules">
      <bpmn:documentation>Load the selected address and applicable schedules. Use the latest selected or corrected address on each retry. One destination applies to all four subscription fulfillments (BR-26). Address maintenance uses BPMN-31.</bpmn:documentation>
      <bpmn:incoming>F22_01</bpmn:incoming>
      <bpmn:incoming>F22_MapRetry</bpmn:incoming>
      <bpmn:incoming>F22_EditRetry</bpmn:incoming>
      <bpmn:outgoing>F22_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N22_Maps" name="Validate and locate selected address with Google Maps">
      <bpmn:documentation>FR-ADDR-04; FR-DEL-03. Request validation/location and evaluate the response. Missing or invalid address, unresolved location, unavailable provider or timeout returns an address/provider issue; no eligibility is inferred from the prototype city list.</bpmn:documentation>
      <bpmn:incoming>F22_02</bpmn:incoming>
      <bpmn:outgoing>F22_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N22_Located" name="Valid location returned?">
      <bpmn:incoming>F22_03</bpmn:incoming>
      <bpmn:outgoing>F22_04</bpmn:outgoing>
      <bpmn:outgoing>F22_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N22_MapIssue" name="Show address or Google Maps issue">
      <bpmn:documentation>Show the address or Maps issue. For invalid or missing address details, the customer can correct the address before retrying. A provider issue does not establish that an address is out of area.</bpmn:documentation>
      <bpmn:incoming>F22_04</bpmn:incoming>
      <bpmn:outgoing>F22_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="N22_MapEnd" name="Retry address check">
      <bpmn:documentation>Retry using the currently selected address. Correct invalid address details first if needed.</bpmn:documentation>
      <bpmn:incoming>F22_05</bpmn:incoming>
      <bpmn:outgoing>F22_MapRetry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="N22_Area" name="Check configured courier service area (default maximum 10 km)">
      <bpmn:documentation>FR-DEL-04. Evaluate the located destination relative to the bakery using configured service-area rules. The SRS does not prescribe a distance algorithm; do not substitute the prototype city whitelist as the proposed policy.</bpmn:documentation>
      <bpmn:incoming>F22_06</bpmn:incoming>
      <bpmn:outgoing>F22_07</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="N22_Eligible" name="Within supported service area?">
      <bpmn:incoming>F22_07</bpmn:incoming>
      <bpmn:outgoing>F22_08</bpmn:outgoing>
      <bpmn:outgoing>F22_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N22_Outside" name="Show that the address is outside the delivery area">
      <bpmn:documentation>Explain that the selected address exceeds the configured service area, normally a maximum of 10 km. No quotation request is sent for this address.</bpmn:documentation>
      <bpmn:incoming>F22_08</bpmn:incoming>
      <bpmn:outgoing>F22_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N22_OutsideEnd" name="Edit address or switch to pickup?">
      <bpmn:documentation>The customer chooses whether to keep delivery with a different address or return to BPMN-02 with pickup selected.</bpmn:documentation>
      <bpmn:incoming>F22_09</bpmn:incoming>
      <bpmn:outgoing>F22_Edit</bpmn:outgoing>
      <bpmn:outgoing>F22_Pickup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N22_Quote" name="Request applicable delivery fee quotation(s) from Lalamove">
      <bpmn:documentation>Request Lalamove fees for the validated destination and applicable schedules. Count each request cycle as one attempt. For a subscription, a cycle must produce all four fees. Start at attempt 1 for each new quotation run. This request creates no courier booking.</bpmn:documentation>
      <bpmn:incoming>F22_10</bpmn:incoming>
      <bpmn:incoming>F22_QuoteRetry</bpmn:incoming>
      <bpmn:outgoing>F22_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N22_Usable" name="All required fees available?">
      <bpmn:incoming>F22_11</bpmn:incoming>
      <bpmn:outgoing>F22_12</bpmn:outgoing>
      <bpmn:outgoing>F22_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N22_QuoteIssue" name="Record failed quotation attempt">
      <bpmn:documentation>Record the failed attempt, including a timeout or an incomplete or unusable fee response. Repeat the quotation request only while fewer than three attempts have been made.</bpmn:documentation>
      <bpmn:incoming>F22_12</bpmn:incoming>
      <bpmn:outgoing>F22_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N22_QuoteEnd" name="Three attempts used?">
      <bpmn:documentation>The first request counts as attempt one. If fewer than three attempts were made, issue another quotation request.</bpmn:documentation>
      <bpmn:incoming>F22_13</bpmn:incoming>
      <bpmn:outgoing>F22_QuoteRetry</bpmn:outgoing>
      <bpmn:outgoing>F22_QuoteExhausted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N22_Result" name="Return eligible destination and fee breakdown to BPMN-02">
      <bpmn:documentation>FR-DEL-07-08. Return selected address/location, eligibility and applicable provider quotation information and amounts, including all four subscription fees. BPMN-02 displays fees in the purchase summary before payment and hands reviewed details onward. Preserve confirmed-order delivery data through BPMN-09/10 for subsequent BPMN-15 booking. No reservation, payment or order confirmation occurs here.</bpmn:documentation>
      <bpmn:incoming>F22_14</bpmn:incoming>
      <bpmn:outgoing>F22_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="N22_Done" name="Eligible address and quotation(s) returned">
      <bpmn:incoming>F22_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="N22_EditAddress" name="Edit or select another address">
      <bpmn:documentation>Correct or replace the selected delivery address. Use BPMN-31 for changes to the saved address book. Recheck the address after it is selected.</bpmn:documentation>
      <bpmn:incoming>F22_Edit</bpmn:incoming>
      <bpmn:outgoing>F22_EditRetry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N22_SwitchPickup" name="Switch to pickup">
      <bpmn:documentation>Return pickup as the selected fulfillment arrangement for BPMN-02.</bpmn:documentation>
      <bpmn:incoming>F22_Pickup</bpmn:incoming>
      <bpmn:outgoing>F22_PickupReturn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="N22_PickupReturn" name="Continue with pickup in BPMN-02">
      <bpmn:documentation>Return to Fulfillment Arrangement and Order Summary with pickup selected.</bpmn:documentation>
      <bpmn:incoming>F22_PickupReturn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="N22_ShowQuoteFailure" name="Delivery fee unavailable. Try again later.">
      <bpmn:documentation>After three failed attempts, show that no delivery fee could be obtained. A delivery checkout cannot proceed to payment without the required fee.</bpmn:documentation>
      <bpmn:incoming>F22_QuoteExhausted</bpmn:incoming>
      <bpmn:outgoing>F22_QuoteReturn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="N22_QuoteReturn" name="Return to fulfillment options in BPMN-02">
      <bpmn:documentation>The quotation run ends. A customer can initiate a fresh quotation run later from BPMN-02.</bpmn:documentation>
      <bpmn:incoming>F22_QuoteReturn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F22_01" sourceRef="N22_Start" targetRef="N22_Input" />
    <bpmn:sequenceFlow id="F22_02" sourceRef="N22_Input" targetRef="N22_Maps" />
    <bpmn:sequenceFlow id="F22_03" sourceRef="N22_Maps" targetRef="N22_Located" />
