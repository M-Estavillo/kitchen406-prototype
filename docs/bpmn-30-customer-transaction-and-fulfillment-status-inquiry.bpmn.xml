<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_30" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_30">
    <bpmn:participant id="Pool_34" name="BPMN-30 | Customer Transaction and Fulfillment Status Inquiry" processRef="Process_30" />
  </bpmn:collaboration>
  <bpmn:process id="Process_30" name="Customer Transaction and Fulfillment Status Inquiry" isExecutable="false">
    <bpmn:documentation>Sources: proposed-bpmn-catalog.md BPMN-30; Kitchen406 - Capstone Paper.md SRS 4.2.2, FR-PROF-03 and 04, FR-FUL-12 and 13, FR-SUB-04, FR-DEL-13 and NFR-SEC-04; index.html and linked app/orders.js, app/subscriptions.js, app/cake-requests.js and app/delivery-tracking.js. BPMN-26 owns sign-in and shared authorization rules. This read-only inquiry uses saved progress from BPMN-05, courier status from BPMN-16 and cake request and quotation records from BPMN-07 and BPMN-08. Operational workflows remain independent of customer viewing. The SRS specifies latest available delivery status; the prototype courier handoff is outside this inquiry.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_34">
      <bpmn:lane id="Lane_C" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>View</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndShown</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_S" name="Kitchen406 System">
        <bpmn:flowNodeRef>Scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Present</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Transaction inquiry opened">
      <bpmn:documentation>Customer opens a transaction list or a specific transaction or status view.</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Select" name="Open history or select a transaction">
      <bpmn:documentation>Open history, an order, a subscription, or a custom cake request. A direct link to a detail view follows the same checks.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Scope" name="Check customer access">
      <bpmn:documentation>Apply BPMN-26 session and role rules. Scope every list, lookup and related record to the authenticated customer profile before retrieving private data.</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Allowed" name="Customer access valid?" gatewayDirection="Diverging" default="F05">
      <bpmn:documentation>Proceed only in an authorized customer context. Specific record eligibility is resolved in the customer-scoped lookup.</bpmn:documentation>
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Denied" name="Access denied">
      <bpmn:documentation>Show the applicable access response without exposing private data. An unauthenticated customer may sign in through BPMN-26 and try again.</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Read" name="Retrieve matching records and status">
      <bpmn:documentation>FR-PROF-03 and 04: read transactions associated with the requesting profile. A record outside the customer scope appears unavailable. Retrieve related fulfillment details and current saved statuses where applicable.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Found" name="Results available?" gatewayDirection="Diverging" default="F08">
      <bpmn:documentation>A successful lookup must provide authorized data to enter the display path.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="NoResult" name="Show empty or unavailable result">
      <bpmn:documentation>Show empty history if no results match, an unavailable result for a missing or out-of-scope detail, or retry feedback for a load failure. Use the same unavailable result for a missing or out-of-scope reference.</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Present" name="Display requested details and status">
      <bpmn:documentation>FR-PROF-04: show matching transaction history. FR-FUL-12 and 13: show owned order status and saved fulfillment date and method. FR-SUB-04: show completed and remaining deliveries and applicable schedule. Show the saved cake request status and applicable quotation details. FR-DEL-13: show the latest available courier status for applicable orders, as recorded by BPMN-16.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="View" name="View transaction information">
      <bpmn:documentation>The customer views the list, detail, or empty or unavailable result. The customer may change the inquiry or retry as appropriate. Selecting another transaction starts an inquiry with the same scope checks.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndShown" name="Information viewed">
      <bpmn:documentation>The inquiry finishes after the information is made available to the customer.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="Select" />
    <bpmn:sequenceFlow id="F02" sourceRef="Select" targetRef="Scope" />
    <bpmn:sequenceFlow id="F03" sourceRef="Scope" targetRef="Allowed" />
    <bpmn:sequenceFlow id="F04" sourceRef="Allowed" targetRef="Read" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The session and customer role permit the inquiry.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F05" sourceRef="Allowed" targetRef="Denied" name="No" />
    <bpmn:sequenceFlow id="F06" sourceRef="Read" targetRef="Found" />
    <bpmn:sequenceFlow id="F07" sourceRef="Found" targetRef="Present" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Authorized matching data was retrieved.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F08" sourceRef="Found" targetRef="NoResult" name="No" />
    <bpmn:sequenceFlow id="F09" sourceRef="NoResult" targetRef="View" />
    <bpmn:sequenceFlow id="F10" sourceRef="Present" targetRef="View" />
    <bpmn:sequenceFlow id="F11" sourceRef="View" targetRef="EndShown" />
  </bpmn:process>
