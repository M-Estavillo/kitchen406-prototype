<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_33" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_33">
    <bpmn:participant id="Pool_33" name="BPMN-33 | Customer Profile Update" processRef="Process_33" />
  </bpmn:collaboration>
  <bpmn:process id="Process_33" name="Customer Profile Update" isExecutable="false">
    <bpmn:documentation>Sources: proposed-bpmn-catalog.md BPMN-33; Kitchen406 - Capstone Paper.md SRS 4.2.2, FR-PROF-01 through FR-PROF-03, customer profile interface, Figure 16 and NFR-SEC-02 through NFR-SEC-05 and NFR-SEC-08; index.html and linked app/account.js and app/account-state.js. BPMN-30 supplies session and role controls, BPMN-32 handles forgotten passwords, BPMN-34 handles transaction inquiry, and BPMN-35 handles saved addresses. Updates retain the same customer identity and relationships.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_33">
      <bpmn:lane id="Lane_C" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unchanged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CodeAction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EmailCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_S" name="Kitchen406 System">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Saved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Profile opened">
      <bpmn:documentation>Precondition: an authenticated Customer may access their own profile under BPMN-30 and the profile was loaded successfully. Unauthorized or unavailable requests do not enter this update flow.</bpmn:documentation>
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Choose" name="View profile or submit a change">
      <bpmn:documentation>FR-PROF-01: Show name, verified email, membership information and mobile number. Personal details include first name, last name and mobile number. Submit the current password with an email change, or with a new password and confirmation for a password change.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Action" name="Customer action?" gatewayDirection="Diverging" default="F07">
      <bpmn:documentation>Route the selected action.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Unchanged" name="Profile unchanged">
      <bpmn:documentation>The customer leaves or cancels before submitting a change.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Prepare" name="Check request and issue code">
      <bpmn:documentation>Recheck authorization and target email availability. On initial request verify the current password. On resend confirm the pending authorized request. Issue the code for this account, address and purpose. Replacement invalidates earlier codes for the same account and purpose.</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Ready" name="Code issued?" gatewayDirection="Diverging" default="F12">
      <bpmn:documentation>Proceed only when the email request passed validation and the code was issued.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Rejected" name="Email unchanged">
      <bpmn:documentation>Show the relevant error and allow correction or retry.</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Dispatch" name="BPMN-28: Send email code" calledElement="Process_28_Reference">
      <bpmn:documentation>Send the verification code to the proposed address using shared dispatch. On dispatch failure show feedback and allow retry or cancellation.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="Code" name="Enter code from new email">
      <bpmn:documentation>Enter the code received at the new address. If the code is unavailable or expired, the customer may request a replacement or cancel.</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="CodeAction" name="Code action?" gatewayDirection="Diverging" default="F21">
      <bpmn:documentation>Submit the code, request a replacement, or cancel the email change.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EmailCancelled" name="Email change cancelled">
      <bpmn:documentation>Keep the existing verified email.</bpmn:documentation>
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge" gatewayDirection="Converging">
      <bpmn:documentation>Join the email verification and direct update paths.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Save" name="Validate and save changes">
      <bpmn:documentation>FR-PROF-02: Recheck access. Validate names and Philippine mobile number for a personal update. For a password change, verify the current password, validate the new password and confirmation, and save an adaptive hash. For an email change, validate the current unexpired unused code and recheck target availability. Consume the code when committing the verified email. FR-PROF-03: Preserve the profile's existing orders, subscriptions, custom cake requests, address and feedback associations.</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Saved" name="Change saved?" gatewayDirection="Diverging" default="F18">
      <bpmn:documentation>Continue only after the valid update is committed.</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Success" name="Profile updated">
      <bpmn:documentation>Confirm the update and show changed profile details where applicable.</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Failed" name="Prior profile retained">
      <bpmn:documentation>Show relevant access, field or save feedback and allow correction or retry when applicable. Failed or abandoned email verification leaves the current email intact.</bpmn:documentation>
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="Choose" />
    <bpmn:sequenceFlow id="F06" sourceRef="Choose" targetRef="Action" />
    <bpmn:sequenceFlow id="F07" sourceRef="Action" targetRef="Unchanged" name="Leave" />
    <bpmn:sequenceFlow id="F08" sourceRef="Action" targetRef="Prepare" name="Email">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">An email change is submitted.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F09" sourceRef="Action" targetRef="Merge" name="Personal details or password">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A personal-details or password change is submitted.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="Prepare" targetRef="Ready" />
    <bpmn:sequenceFlow id="F11" sourceRef="Ready" targetRef="Dispatch" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The email request passed validation and a code was issued.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="Ready" targetRef="Rejected" name="No" />
    <bpmn:sequenceFlow id="F13" sourceRef="Dispatch" targetRef="Code" />
    <bpmn:sequenceFlow id="F14" sourceRef="Code" targetRef="CodeAction" />
    <bpmn:sequenceFlow id="F15" sourceRef="Merge" targetRef="Save" />
    <bpmn:sequenceFlow id="F16" sourceRef="Save" targetRef="Saved" />
    <bpmn:sequenceFlow id="F17" sourceRef="Saved" targetRef="Success" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The change was saved.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" sourceRef="Saved" targetRef="Failed" name="No" />
    <bpmn:sequenceFlow id="F19" sourceRef="CodeAction" targetRef="Merge" name="Submit code">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The customer submits a code.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F20" sourceRef="CodeAction" targetRef="Prepare" name="Resend">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">The customer requests a replacement code.</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F21" sourceRef="CodeAction" targetRef="EmailCancelled" name="Cancel" />
  </bpmn:process>
  <bpmn:process id="Process_28_Reference" name="BPMN-28 | External Notification Dispatch and Retry (reference only)" isExecutable="false">
    <bpmn:documentation>Catalog reference. Input: verification email for the proposed address and account activity context. Output: dispatch outcome under the shared notification policy.</bpmn:documentation>
  </bpmn:process>
