<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_InventoryControl" targetNamespace="https://kitchen406.example/bpmn">
<bpmn:collaboration id="Collaboration_Inventory"><bpmn:participant id="Participant_Inventory" name="Inventory Control" processRef="Process_Inventory"/></bpmn:collaboration>
<bpmn:process id="Process_Inventory" name="Inventory Control" isExecutable="false"><bpmn:documentation>Read top to bottom. Scope: review stock, record restocks or physical-count adjustments, retain movement history, update stock alerts and purchase eligibility, and recover due subscription material reservations. Source: Chapters/Kitchen406 - Capstone Paper.md, SRS 4.12 FR-INV-01 through FR-INV-23; website app/inventory-state.js, owner-inventory.js, staff-ui.js and staff-state.js. Checkout holds/releases belong to Payment; ingredient consumption belongs to Order Fulfillment; scheduled reservation timing belongs to Scheduled Fulfillment. Those workflows update the same stock ledger but are not repeated here. Ingredient definitions, thresholds and recipe edits belong to Product Setup. This is proposed descriptive behavior, not a deployed executable workflow.</bpmn:documentation>
<bpmn:laneSet id="LaneSet_Inventory"><bpmn:lane id="Lane_Operations" name="Owner / Authorized Staff"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Action</bpmn:flowNodeRef><bpmn:flowNodeRef>Receive</bpmn:flowNodeRef><bpmn:flowNodeRef>Restock</bpmn:flowNodeRef><bpmn:flowNodeRef>Count</bpmn:flowNodeRef><bpmn:flowNodeRef>Adjustment</bpmn:flowNodeRef><bpmn:flowNodeRef>Correct</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef><bpmn:flowNodeRef>NoChange</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_System" name="Kitchen406 System"><bpmn:flowNodeRef>Load</bpmn:flowNodeRef><bpmn:flowNodeRef>MergeInput</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Apply</bpmn:flowNodeRef><bpmn:flowNodeRef>Ledger</bpmn:flowNodeRef><bpmn:flowNodeRef>Refresh</bpmn:flowNodeRef><bpmn:flowNodeRef>Low</bpmn:flowNodeRef><bpmn:flowNodeRef>Alert</bpmn:flowNodeRef><bpmn:flowNodeRef>AlertMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Depleted</bpmn:flowNodeRef><bpmn:flowNodeRef>Block</bpmn:flowNodeRef><bpmn:flowNodeRef>Restore</bpmn:flowNodeRef><bpmn:flowNodeRef>ProductMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Due</bpmn:flowNodeRef><bpmn:flowNodeRef>RetryReserve</bpmn:flowNodeRef><bpmn:flowNodeRef>FinishMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Result</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start" name="Inventory review needed"><bpmn:documentation>Start on routine review, a stock alert, a material shortage, or a physical-count discrepancy. Requires an authenticated owner or authorized staff account.</bpmn:documentation><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Load" name="Load stock and requirements"><bpmn:documentation>FR-INV-01-05,19. Load ingredient and packaging records, physical stock, active reservations, available stock, current thresholds, projected BoM requirements and movements. Available = physical minus active reserved quantities. Future projected requirements are not all reserved.</bpmn:documentation><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Review" name="Review stock and shortages"><bpmn:documentation>FR-INV-02,05. Review quantities, upcoming requirements and history. Owner and authorized staff can record restocking and adjustments; master definitions, recipes and threshold configuration belong to Product Setup.</bpmn:documentation><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Action" name="Stock action?"><bpmn:documentation>Choose restock, physical-count adjustment, or finish without changes.</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="Receive" name="Receive replenished stock"><bpmn:documentation>FR-INV-13. Obtain and physically receive ingredients before recording a restock. Purchasing and supplier payment occur outside the platform; no automated purchase order is implied.</bpmn:documentation><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="Restock" name="Enter restock details"><bpmn:documentation>FR-INV-13-14. Select material; enter positive quantity added, supported unit, nonnegative total cost in PHP and optional notes. Website: owner-inventory.js, staff-ui.js and inventory-state.js. Cost entry does not grant staff financial-report access.</bpmn:documentation><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing></bpmn:userTask>
<bpmn:manualTask id="Count" name="Count physical stock"><bpmn:documentation>FR-INV-15. Count actual stock; identify spoilage, damage, miscount, theft, correction or another reason. No automatic waste or yield measurement.</bpmn:documentation><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="Adjustment" name="Enter count and reason"><bpmn:documentation>FR-INV-15-16. Enter actual physical count, not an amount to deduct; choose a required reason and add notes as applicable. Count may be zero. Delta = actual count minus recorded physical stock.</bpmn:documentation><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="MergeInput"><bpmn:documentation>Exclusive merge of alternative stock submissions.</bpmn:documentation><bpmn:incoming>F09</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Validate" name="Validate stock submission"><bpmn:documentation>Check operational authorization, material existence, movement type, numeric quantities, supported units and required fields. Convert kg to g or l to ml; whole pieces, otherwise up to 3 decimals. Restock must be positive with nonnegative cost up to 2 decimals; adjustment requires a valid reason. Reject invalid requests without changing stock. Detect repeat operation identifiers to avoid duplicate movements. FR-INV-13-19; inventory-state.js I.change.</bpmn:documentation><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Valid" name="Submission result?"><bpmn:documentation>Invalid or failed saves retain prior stock. Unchanged physical count creates no adjustment movement. A previously saved identical operation returns its existing result instead of applying again.</bpmn:documentation><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F34</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Correct" name="Review issue and retry"><bpmn:documentation>Show validation or save error; user corrects inputs, refreshes if needed, retries, or finishes without a change. A retry must not duplicate an already saved movement.</bpmn:documentation><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Apply" name="Save stock change"><bpmn:documentation>FR-INV-14-15. Restock: add quantity and update weighted unit cost using entered total cost. Adjustment: set physical stock to the counted quantity and compute its signed delta. Do not silently discard active reservations or automatically cancel paid orders if stock is now insufficient. Website I.change.</bpmn:documentation><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Ledger" name="Record stock movement"><bpmn:documentation>FR-INV-17-18. Save movement type, material, signed quantity, before/after stock, actor/account, timestamp, reason/notes, operation key and applicable cost snapshots. Stock and its movement form one successful business update; do not duplicate them on retry. Consumption and authorized reversal records are displayed here but originate in their owning workflows.</bpmn:documentation><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Refresh" name="Recalculate stock availability"><bpmn:documentation>FR-INV-05,19-20. Recompute physical, reserved and available quantities and outstanding material requirements. Reservations are commitments, not physical consumption. Availability below commitments indicates a shortage requiring attention; do not erase reservations to hide it.</bpmn:documentation><bpmn:incoming>F18</bpmn:incoming><bpmn:incoming>F34</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Low" name="At or below threshold?"><bpmn:documentation>FR-INV-10-11. Website stock state uses available quantity against the configured threshold.</bpmn:documentation><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:outgoing>F21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Alert" name="Queue low-stock alert"><bpmn:documentation>Notify the Admin/Owner through Notifications. Website suppresses repeated low-stock alerts within the same low-stock episode. Notification delivery must not undo or repeat a stock save.</bpmn:documentation><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="AlertMerge"><bpmn:documentation>Continue whether or not an alert was needed.</bpmn:documentation><bpmn:incoming>F21</bpmn:incoming><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="Depleted" name="Required stock unavailable?"><bpmn:documentation>FR-INV-12,20. Determine affected products whose required ingredients cannot support ordering. Website marks available stock at or below zero as out of stock and also checks required quantities per order.</bpmn:documentation><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing><bpmn:outgoing>F25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Block" name="Block affected purchases"><bpmn:documentation>FR-INV-12. Disable purchases that cannot be fulfilled from available required materials. Do not cancel existing commitments automatically.</bpmn:documentation><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="Restore" name="Refresh product eligibility"><bpmn:documentation>Reevaluate ingredient-based purchase eligibility after replenishment. Keep catalog activation, recipe completeness, scheduling and capacity checks independent; replenishment alone does not make every product purchasable.</bpmn:documentation><bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="ProductMerge"><bpmn:documentation>Merge ingredient-based product-availability outcomes.</bpmn:documentation><bpmn:incoming>F26</bpmn:incoming><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="Due" name="Due reservations pending?"><bpmn:documentation>FR-INV-21-23. Only consider unreserved subscription requirements that are already due or previously failed; do not reserve every future week after restocking.</bpmn:documentation><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F29</bpmn:outgoing><bpmn:outgoing>F30</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:subProcess id="RetryReserve" name="Retry due reservations"><bpmn:documentation>FR-INV-21-23. Invoke Scheduled Fulfillment material reservation for due or previously failed commitments. First fulfillment retains its existing reservation; later reservations are due one day before preparation. Retry once for eligible records without duplicate reservations. Successful reservation does not consume physical stock. Unresolved shortages retain pending fulfillment and notify the owner; no automatic cancellation, extra payment or deferment.</bpmn:documentation><bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing><bpmn:startEvent id="ReserveStart"><bpmn:outgoing>RF1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="ReserveTask" name="Retry eligible reservations and report shortages"><bpmn:incoming>RF1</bpmn:incoming><bpmn:outgoing>RF2</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="ReserveEnd"><bpmn:incoming>RF2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="RF1" sourceRef="ReserveStart" targetRef="ReserveTask"/><bpmn:sequenceFlow id="RF2" sourceRef="ReserveTask" targetRef="ReserveEnd"/></bpmn:subProcess>
<bpmn:exclusiveGateway id="FinishMerge"><bpmn:documentation>Finish after any eligible reservation retry, including pending shortage outcomes.</bpmn:documentation><bpmn:incoming>F30</bpmn:incoming><bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Result" name="Show updated stock and history"><bpmn:documentation>Show the saved result, stock quantities, movements and outstanding shortage/reservation status. After retries, refresh available quantities, product eligibility and threshold alerts from the resulting reservation state.</bpmn:documentation><bpmn:incoming>F32</bpmn:incoming><bpmn:outgoing>F33</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End" name="Inventory review complete"><bpmn:documentation>End this inventory-control action. Some shortages may remain unresolved; completion does not claim all stock is sufficient. Operator may start another review when more stock arrives.</bpmn:documentation><bpmn:incoming>F33</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="NoChange" name="No stock change"><bpmn:documentation>Operator chose review only, or physical count matched stock. No new movement is posted.</bpmn:documentation><bpmn:incoming>F06</bpmn:incoming><bpmn:incoming>F15</bpmn:incoming></bpmn:endEvent>
