<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderCheckout" targetNamespace="https://kitchen406.example/bpmn">
<bpmn:collaboration id="Collaboration_Checkout"><bpmn:participant id="Participant_Checkout" name="Order Checkout" processRef="Process_OrderCheckout"/></bpmn:collaboration>
<bpmn:process id="Process_OrderCheckout" name="Order Checkout" isExecutable="false"><bpmn:documentation>Standard-order checkout, read top to bottom. Vertical lanes separate customer actions from Kitchen406 automation. Source: Chapters/Kitchen406 - Capstone Paper.md, SRS 4.1, 4.4, 4.6, 4.7, 4.10, 4.11, 4.12 and 4.16. Provider calls are summarized in system tasks; detailed API messages and authentication belong to their own diagrams. Payment, reservations, production and courier booking are outside this boundary. This descriptive process is not executable.</bpmn:documentation>
<bpmn:laneSet id="Lanes_Checkout"><bpmn:lane id="Lane_Customer" name="Customer"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Login</bpmn:flowNodeRef><bpmn:flowNodeRef>EditCart</bpmn:flowNodeRef><bpmn:flowNodeRef>Choose</bpmn:flowNodeRef><bpmn:flowNodeRef>Address</bpmn:flowNodeRef><bpmn:flowNodeRef>FixDelivery</bpmn:flowNodeRef><bpmn:flowNodeRef>Retry</bpmn:flowNodeRef><bpmn:flowNodeRef>FixBooking</bpmn:flowNodeRef><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Proceed</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_System" name="Kitchen406 System"><bpmn:flowNodeRef>Access</bpmn:flowNodeRef><bpmn:flowNodeRef>SignedIn</bpmn:flowNodeRef><bpmn:flowNodeRef>Cart</bpmn:flowNodeRef><bpmn:flowNodeRef>CartOK</bpmn:flowNodeRef><bpmn:flowNodeRef>Dates</bpmn:flowNodeRef><bpmn:flowNodeRef>Delivery</bpmn:flowNodeRef><bpmn:flowNodeRef>Location</bpmn:flowNodeRef><bpmn:flowNodeRef>LocationOK</bpmn:flowNodeRef><bpmn:flowNodeRef>Fee</bpmn:flowNodeRef><bpmn:flowNodeRef>FeeOK</bpmn:flowNodeRef><bpmn:flowNodeRef>Pickup</bpmn:flowNodeRef><bpmn:flowNodeRef>Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Available</bpmn:flowNodeRef><bpmn:flowNodeRef>Total</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start" name="Checkout started"><bpmn:documentation>Customer requests checkout for a standard-order cart.</bpmn:documentation><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Access" name="Check account access"><bpmn:documentation>FR-PAY-01; SRS 4.1. Require a registered and authenticated customer with required verification.</bpmn:documentation><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="SignedIn" name="Access valid?"><bpmn:documentation>Authentication must succeed before the protected transaction proceeds.</bpmn:documentation><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing><bpmn:outgoing>F05</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Login" name="Sign in or register"><bpmn:documentation>Use the separate account-access workflow, including verification where required. Return only after successful authentication.</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Cart" name="Validate cart"><bpmn:documentation>FR-CART-05; FR-PAY-02. Check non-empty cart, active products and variants, valid quantities and current prices.</bpmn:documentation><bpmn:incoming>F05</bpmn:incoming><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="CartOK" name="Cart valid?"><bpmn:documentation>Reject unavailable items or invalid quantities.</bpmn:documentation><bpmn:incoming>F06</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing><bpmn:outgoing>F09</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="EditCart" name="Correct cart"><bpmn:documentation>Customer changes quantities or removes unavailable items; system recalculates the subtotal before retrying.</bpmn:documentation><bpmn:incoming>F07</bpmn:incoming><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Dates" name="Find eligible dates"><bpmn:documentation>FR-CAP-11-12; Scope 1.4.1(3). Offer dates common to every cart item, considering production batches, lead times, cut-offs, blocked dates and current availability. If none qualify, customer revises the cart or returns later.</bpmn:documentation><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Choose" name="Choose method and date"><bpmn:documentation>Select pickup or delivery and one eligible fulfillment date for the entire standard order. No same-day fulfillment.</bpmn:documentation><bpmn:incoming>F10</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming><bpmn:incoming>F22</bpmn:incoming><bpmn:incoming>F33</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Delivery" name="Delivery?"><bpmn:documentation>Pickup requires no destination or courier charge.</bpmn:documentation><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Address" name="Confirm delivery address"><bpmn:documentation>FR-ADDR-01-05. Select a saved address or add one; confirm the destination and delivery instructions for this purchase.</bpmn:documentation><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Location" name="Check delivery location"><bpmn:documentation>FR-DEL-02-05. Use Google Maps to validate and locate the address and check the configured service area; default maximum distance is 10 km. Invalid, unserviceable or unverified locations cannot proceed.</bpmn:documentation><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="LocationOK" name="Location valid?"><bpmn:documentation>If validation fails, show the reason. Customer corrects the destination or chooses pickup.</bpmn:documentation><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Fee" name="Get courier quote"><bpmn:documentation>FR-DEL-06-09. Request the delivery quotation from Lalamove. No courier is booked during checkout.</bpmn:documentation><bpmn:incoming>F17</bpmn:incoming><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="FeeOK" name="Quote received?"><bpmn:documentation>Proceed only with a usable delivery quotation. A failed request must not silently become a zero delivery fee.</bpmn:documentation><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing><bpmn:outgoing>F23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="FixDelivery" name="Retry or change delivery"><bpmn:documentation>Review the failure; retry with the current address, correct the address, or return to method selection and choose pickup.</bpmn:documentation><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Retry" name="Retry quote?"><bpmn:documentation>Yes retries quotation; No returns to fulfillment selection, where the customer can change the address or method.</bpmn:documentation><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Pickup" name="Set pickup fee to zero"><bpmn:documentation>Scope 1.4.1(3). Pickup is collected from the bakery without a delivery fee. Clear delivery-only details from this checkout arrangement.</bpmn:documentation><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F24</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Merge"><bpmn:documentation>Merge pickup and delivery paths before final booking validation.</bpmn:documentation><bpmn:incoming>F23</bpmn:incoming><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="Validate" name="Recheck booking availability"><bpmn:documentation>FR-PAY-02; FR-CAP-01-14; FR-INV-20. Invoke shared booking-validation rules for current product/variant quantities, ingredients, standard-order capacity, common batch date, blocked dates, lead time and cut-off. This is an availability check, not a resource hold.</bpmn:documentation><bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="Available" name="Available?"><bpmn:documentation>If availability changed, identify the issue and require correction before payment.</bpmn:documentation><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing><bpmn:outgoing>F29</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="FixBooking" name="Revise items or schedule"><bpmn:documentation>System identifies the conflict. Customer may update cart items/quantities, method or date; the checkout repeats all affected checks.</bpmn:documentation><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Total" name="Show order and total"><bpmn:documentation>FR-PAY-03; FR-ORD-02. Display current products, quantities, prices, method, date, confirmed address when applicable, delivery fee and full payable total. One delivered order incurs one delivery fee.</bpmn:documentation><bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F30</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Review" name="Review order"><bpmn:documentation>Customer reviews the complete summary, including current prices and fees, and chooses whether to proceed or edit.</bpmn:documentation><bpmn:incoming>F30</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Proceed" name="Proceed to payment?"><bpmn:documentation>Yes hands the reviewed checkout to Payment. Editing returns to fulfillment selection and revalidation; cart editing remains available there.</bpmn:documentation><bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing><bpmn:outgoing>F33</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End" name="Ready for payment"><bpmn:documentation>Hand off to the separate Payment process. At payment entry, revalidate and reserve resources, create a pending purchase, and start the 30-minute QR session and 32-minute hold. Only verified full payment confirms the order. FR-ORD-01; FR-PAY-04-08; FR-CAP-14.</bpmn:documentation><bpmn:incoming>F32</bpmn:incoming></bpmn:endEvent>
