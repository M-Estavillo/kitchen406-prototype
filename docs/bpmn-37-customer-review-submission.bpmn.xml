    <bpmn:sequenceFlow id="Flow_37_29" sourceRef="Recovery_37" targetRef="Eligibility_37" name="Reload eligibility / safe retry" />
    <bpmn:textAnnotation id="EligibilityRules_37">
      <bpmn:text>Review eligibility (FR-REV-01–03,07; BR-21)
Customer owns the purchase.
Standard/cake: completed order, one review per purchased item.
Subscription: one review per original enrollment ONLY after all four weekly fulfillments complete.
Individual subscription weeks are not reviewable.
Existing different review blocks a second submission.
Do not require a separate receipt-button action beyond documented completion.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_EligibilityRules_37" sourceRef="Eligibility_37" targetRef="EligibilityRules_37" associationDirection="None" />
    <bpmn:textAnnotation id="ContentRules_37">
      <bpmn:text>Content/photo validation
Required rating (prototype 1–5 stars).
Comment optional; no invented mandatory text.
Zero to three optional photos.
Only supported image type/size; reject executable content before storage.
Prototype two demo slots are not the SRS limit.
No sentiment/profanity classification; Owner moderation is separate BPMN-38.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_ContentRules_37" sourceRef="Validate_37" targetRef="ContentRules_37" associationDirection="None" />
    <bpmn:textAnnotation id="SaveRules_37">
      <bpmn:text>Save and reuse safeguards
Recheck customer, owned review unit, completion and duplicate constraint at save.
Preserve draft on failed write.
Retry photo failures without duplicating usable matching stored files.
Save once; reuse matching saved request result.
Concurrent different review is not permission to overwrite.
No Owner preapproval or auto-classification.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_SaveRules_37" sourceRef="Save_37" targetRef="SaveRules_37" associationDirection="None" />
  </bpmn:process>
