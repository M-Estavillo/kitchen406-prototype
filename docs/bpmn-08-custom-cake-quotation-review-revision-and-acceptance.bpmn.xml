<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_08" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:collaboration id="Collaboration_08">
    <bpmn:participant id="Pool_08" name="BPMN-08 | Custom Cake Quotation Review, Revision, and Acceptance" processRef="Process_08"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_08" name="Custom Cake Quotation Review, Revision, and Acceptance" isExecutable="false">
    <bpmn:documentation>Sources: docs/proposed-bpmn-catalog.md, BPMN-08 and reuse rules; Chapters/Kitchen406 - Capstone Paper.md, custom-cake workflow and SRS 4.9, FR-CAKE-05–08, FR-DEL-16 and FR-CAP-21; index.html and its linked owner-cake-state.js, owner-cakes.js, cake-requests.js and cake-state.js. Owner and customer access are authenticated (BPMN-30). The three lanes record roles within a single process; sequence flows connect their work. BPMN-07 supplies the submitted request. Applicable external notification dispatch is asynchronous in BPMN-28. BPMN-09 is a separate checkout handoff. Quotation acceptance alone creates no paid order. The proposed owner-managed delivery rules take precedence over prototype pickup and geographic restrictions.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_08">
      <bpmn:lane id="Lane_Owner" name="Admin / Owner">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Feasible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Saved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Expiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Request ready for review (BPMN-07)">
      <bpmn:documentation>Input: the submitted request with original submission timestamp, cake configuration, any reference images, preliminary estimate, and requested fulfillment details.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Review" name="Assess feasibility and decide whether to quote">
      <bpmn:documentation>FR-CAKE-05, FR-CAP-21 and FR-DEL-16. Assess design complexity, date, materials and the proposed owner-managed delivery. Use the original submission timestamp from BPMN-07: later review does not invalidate timely submission if fulfillment is still feasible. Delivery is subject to the owner's agreement, with no fixed distance limit.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Feasible" name="Feasible terms?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Reject" name="Save and show rejection reason">
      <bpmn:documentation>The owner rejects a request that cannot reasonably be accommodated. The system saves the reason and makes the rejection visible to the customer.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Rejected" name="Request rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Prepare" name="Prepare or revise quotation">
      <bpmn:documentation>FR-CAKE-06 and FR-DEL-16. Set the proposed cake specifications, feasible fulfillment date, owner-managed delivery address and terms, and the final price including any case-by-case design/customization and delivery charges. Reassess any changed terms on revision. If no revision is issued, the request remains in its applicable review or quoted state.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Publish" name="Save and publish a new quotation version">
      <bpmn:documentation>FR-CAKE-06–07. Validate the issue action and save a new version with its specifications, fulfillment details and price. Keep earlier snapshots accessible in history and prevent superseded versions from being accepted. Invalid data or an unsuccessful save leaves the prior state intact and allows correction or retry before publication. If an applicable external notification is triggered, dispatch is asynchronous in BPMN-28.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Read" name="Review the quotation, delivery terms and total">
      <bpmn:documentation>The issued version awaits customer review and can remain pending while unanswered. The customer may discuss changes with the bakery before accepting.</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Expiry" attachedToRef="Read" cancelActivity="true">
      <bpmn:documentation>When the issued version reaches its applicable validity deadline before a customer response, interrupt this review. No fixed quotation validity period is specified here. Validate the applicable version again if a response reaches the system near the deadline.</bpmn:documentation>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="QuoteValidityTimer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">quotation.validUntil</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Expired" name="Quotation expired">
      <bpmn:documentation>The system shows expiry for the unanswered version and preserves its history. Expiry leaves a newer version or recorded acceptance unchanged.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Response" name="Customer response?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Decline" name="Decline this quotation">
      <bpmn:documentation>Record the customer's decline against the offered quotation, preserving version history. The request can return to the owner for another offer. A decline does not create an accepted quotation or initiate checkout.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Declined" name="Quotation declined · owner may revise">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Accept" name="Validate and record acceptance of this version">
      <bpmn:documentation>FR-CAKE-08 and NFR-SEC-04. Confirm the signed-in customer owns the request and the selected version is still the current issued, unexpired offer. Save its exact quotation ID against the request and preserve the agreed snapshot. Outdated or invalid responses and failed saves leave prior records intact and provide the current status or a retry message.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Saved" name="Acceptance saved?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Blocked" name="Acceptance not recorded">
      <bpmn:documentation>No checkout handoff. The customer can reopen the request for its current status or retry a recoverable failure.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Accepted" name="Accepted quotation ready for BPMN-09">
      <bpmn:documentation>Handoff: purchase type, request and accepted quotation IDs, cake specifications, agreed date and owner-managed delivery terms, and saved payable total. BPMN-09 owns the definitive checks and temporary reservation. Shared payment follows. BPMN-13 links the paid quotation to the confirmed order under FR-CAKE-09.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Review"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Review" targetRef="Feasible"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Feasible" targetRef="Reject" name="No"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Reject" targetRef="Rejected"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Feasible" targetRef="Prepare" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Prepare" targetRef="Publish"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Publish" targetRef="Read"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Read" targetRef="Response"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Response" targetRef="Prepare" name="Discuss changes"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Response" targetRef="Accept" name="Accept"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Response" targetRef="Decline" name="Decline"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Decline" targetRef="Declined"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Expiry" targetRef="Expired"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Accept" targetRef="Saved"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Saved" targetRef="Blocked" name="No"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Saved" targetRef="Accepted" name="Yes"/>
    <bpmn:textAnnotation id="Next"><bpmn:text>Refer to BPMN-09 — Ingredient and Capacity Validation and Purchase Reservation.
Continue with shared payment only after reservation. BPMN-13 links the paid quotation to the confirmed order.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="NextReference" sourceRef="Accepted" targetRef="Next"/>
  </bpmn:process>
