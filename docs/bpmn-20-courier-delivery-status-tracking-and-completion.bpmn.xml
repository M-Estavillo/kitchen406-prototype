    <bpmn:textAnnotation id="CompletionRules_20">
      <bpmn:text>Completion rules (FR-DEL-18)
Valid Delivered completes fulfillment automatically.
No owner-split modal or customer acknowledgment.
Save status, completion time and locks consistently.
Preserve owner shares and original amounts.
Do not consume ingredients, collect payment or count completion again.
Recheck duplicate identity at commit: a concurrent matching completion reuses its original time/result. Follow-up uses that same identity.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_CompletionRules_20" sourceRef="CompletionChecks_20" targetRef="CompletionRules_20" associationDirection="None" />
    <bpmn:serviceTask id="ReuseCompletion_20" name="Reuse saved completion identity and original time; no new completion">
      <bpmn:documentation>Another valid update committed this same delivery completion after the initial duplicate check. Return that matching saved result without overwriting its completion/lock timestamp, allocations or product amounts. Do not create another completion/sale/count. This is distinct from a stale conflicting update, which takes the failure path. Continue downstream only with the existing logical completion identity, so any pending follow-up can recover safely without duplicate effects.</bpmn:documentation>
      <bpmn:incoming>Flow_20_34</bpmn:incoming>
      <bpmn:outgoing>Flow_20_35</bpmn:outgoing>
    </bpmn:serviceTask>
