<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_02" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:collaboration id="Collaboration_02">
<bpmn:participant id="Participant_02" name="BPMN-02 | Checkout Fulfillment Arrangement and Purchase Review" processRef="Process_02" />
</bpmn:collaboration>
  <bpmn:process id="Process_02" name="Checkout Fulfillment Arrangement and Purchase Review" isExecutable="false">
    <bpmn:documentation>Sources: docs/proposed-bpmn-catalog.md, BPMN-02 and reuse rules; Chapters/Kitchen406 - Capstone Paper.md, SRS scope items 3 and 6; 4.4 (FR-ADDR-05), 4.7 (FR-ORD-02), 4.8 (FR-SUB-01, 02, 05), 4.10 (FR-PAY-03), 4.16 (FR-DEL-02 through 09); BR-11, 12, 19, 26, 27. Read top to bottom. Customer and Kitchen406 System are responsibility swimlanes in one descriptive process; cross-lane arrows are sequence flows. BPMN-18 encapsulates provider interactions. Authentication is a precondition. Confirmation means customer review only; BPMN-09 owns final resource checks/reservation. Custom cakes bypass this process. BPMN-01 owns cart edits and its subtotal; BPMN-03 owns subscription configuration. This process displays those inputs again for complete purchase review, without editing them. Re-entry after changes requires schedule validation, applicable address checks, quotations and recalculation.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_02">
      <bpmn:lane id="Lane_02_C" name="Customer">
<bpmn:flowNodeRef>Arrange</bpmn:flowNodeRef>
<bpmn:flowNodeRef>SubscriptionArrange</bpmn:flowNodeRef>
<bpmn:flowNodeRef>EditType</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ReturnCart</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ReturnSubscription</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Continue</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Address</bpmn:flowNodeRef>
<bpmn:flowNodeRef>AddressAction</bpmn:flowNodeRef>
<bpmn:flowNodeRef>MaintainAddress</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Recover</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Recovery</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Leave</bpmn:flowNodeRef>
</bpmn:lane>
      <bpmn:lane id="Lane_02_S" name="Kitchen406 System">
<bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>PurchaseType</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Invalid</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Delivery</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Quote</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Eligible</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Total</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
</bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Valid cart or subscription selection received">
      <bpmn:documentation>Input: valid standard cart from BPMN-01, or selected subscription offering and proposed four-week schedule from BPMN-03. Authenticated customer is a precondition. Cakes use BPMN-08 instead.</bpmn:documentation>
      <bpmn:outgoing>Flow_02_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Arrange" name="Select one common standard-order date and pickup / delivery">
      <bpmn:documentation>FR-ORD-02; SRS scope item 3. Standard orders select one eligible date shared by every cart item, including applicable production batch dates, cutoffs and lead times. Offer pickup or delivery. Date choices use scheduling rules; final resource revalidation and reservation remain in BPMN-09.</bpmn:documentation>
      <bpmn:incoming>Flow_02_standard</bpmn:incoming>
      <bpmn:outgoing>Flow_02_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Continue" name="Continue?">
      <bpmn:incoming>Flow_02_2</bpmn:incoming>
<bpmn:incoming>Flow_02_subscription_done</bpmn:incoming>
      <bpmn:outgoing>Flow_02_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Validate" name="Check required schedule and permitted fulfillment method">
      <bpmn:documentation>FR-ORD-02; FR-SUB-05. Check completeness and consistency of arrangement inputs, including all four subscription schedules. Final product, cutoff, blocked-date, capacity and ingredient revalidation/reservation belong to BPMN-09.</bpmn:documentation>
      <bpmn:incoming>Flow_02_3</bpmn:incoming>
      <bpmn:outgoing>Flow_02_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Details complete and consistent?">
      <bpmn:incoming>Flow_02_5</bpmn:incoming>
      <bpmn:outgoing>Flow_02_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Invalid" name="Show missing / inconsistent details; block submission">
      <bpmn:documentation>Invalid details remain unsubmitted. Allow correction or leaving without proceeding to reservation/payment.</bpmn:documentation>
      <bpmn:incoming>Flow_02_6</bpmn:incoming>
      <bpmn:outgoing>Flow_02_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Delivery" name="Delivery required?">
      <bpmn:documentation>Pickup for either purchase type bypasses address and courier quotation. Only courier delivery requires an address and quotation.</bpmn:documentation>
      <bpmn:incoming>Flow_02_8</bpmn:incoming>
      <bpmn:outgoing>Flow_02_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Address" name="Select a saved address or request an add/edit">
      <bpmn:documentation>FR-ADDR-05; FR-DEL-02; BR-26. Confirm the selected address as the destination. For courier subscriptions, one address applies to all four fulfillments and is fixed after payment confirmation. Pickup requires no delivery address.</bpmn:documentation>
      <bpmn:incoming>Flow_02_9</bpmn:incoming>
      <bpmn:incoming>Flow_02_AddressReturn</bpmn:incoming>
      <bpmn:incoming>Flow_02_CorrectAddress</bpmn:incoming>
      <bpmn:incoming>Flow_02_EditAddress</bpmn:incoming>
      <bpmn:outgoing>Flow_02_AddressAction</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="AddressAction" name="Address action?">
      <bpmn:incoming>Flow_02_AddressAction</bpmn:incoming>
      <bpmn:outgoing>Flow_02_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_MaintainAddress</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="MaintainAddress" name="Add or edit address via BPMN-31" calledElement="Process_31_Reference">
      <bpmn:incoming>Flow_02_MaintainAddress</bpmn:incoming>
      <bpmn:outgoing>Flow_02_AddressReturn</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Quote" name="BPMN-18: Check address eligibility and quote delivery fees" calledElement="Process_18_Reference">
      <bpmn:documentation>FR-DEL-02 through FR-DEL-09. Invoke separate reusable BPMN-18: Google Maps address validation/location, configured service area (default maximum 10 km), and Lalamove quotation. Return destination, eligibility, applicable fees or address/provider issue. For subscriptions obtain applicable fees for all four scheduled deliveries. Do not book a courier.</bpmn:documentation>
      <bpmn:incoming>Flow_02_11</bpmn:incoming>
      <bpmn:incoming>Flow_02_16</bpmn:incoming>
      <bpmn:outgoing>Flow_02_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Eligible" name="Eligible address and usable quotation(s)?">
      <bpmn:documentation>Proceed only when address is supported and all applicable delivery fees are available.</bpmn:documentation>
      <bpmn:incoming>Flow_02_12</bpmn:incoming>
      <bpmn:outgoing>Flow_02_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Issue" name="Explain address / service-area / provider issue; block delivery checkout">
      <bpmn:documentation>FR-DEL-05. Never treat a missing or failed quotation as a zero delivery fee. Customer can retry, correct the address, or change the arrangement where permitted.</bpmn:documentation>
      <bpmn:incoming>Flow_02_13</bpmn:incoming>
      <bpmn:outgoing>Flow_02_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Recover" name="Choose retry, correction, or leave">
      <bpmn:documentation>Retry the same address, return directly to address selection to correct the destination, or change the fulfillment arrangement. Both standard orders and subscriptions may switch to pickup.</bpmn:documentation>
      <bpmn:incoming>Flow_02_14</bpmn:incoming>
      <bpmn:outgoing>Flow_02_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Recovery" name="Recovery choice?">
      <bpmn:incoming>Flow_02_15</bpmn:incoming>
      <bpmn:outgoing>Flow_02_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_CorrectAddress</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Total" name="Calculate payable total; display products, schedule and fee breakdown">
      <bpmn:documentation>FR-PAY-03; FR-ORD-02; FR-DEL-07; FR-SUB-02; BR-27. Show products/variants, quantities, prices, subtotal, fulfillment method and schedule, plus selected address and applicable quoted fees for delivery. Pickup has no courier fee for either purchase type. Subscription summary includes all four schedules and the selected method in one fully prepaid total; courier delivery includes all enrollment delivery fees, while pickup has no delivery fee. Later actual courier-fee differences are absorbed by the bakery without extra customer charges or refunds. Any applicable refund of prepaid delivery fees following a later change to pickup is handled manually outside the platform, as stated in scope item 6.</bpmn:documentation>
      <bpmn:incoming>Flow_02_10</bpmn:incoming>
      <bpmn:incoming>Flow_02_19</bpmn:incoming>
      <bpmn:incoming>Flow_02_UpdatedAmount</bpmn:incoming>
      <bpmn:outgoing>Flow_02_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Review fulfillment details and payable summary">
      <bpmn:documentation>Customer reviews the current arrangement and amount before submitting. Recheck catalog prices and applicable fees at submission. If any amount changed, recalculate and show the breakdown for another review before handing off to BPMN-09.</bpmn:documentation>
      <bpmn:incoming>Flow_02_20</bpmn:incoming>
      <bpmn:outgoing>Flow_02_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Customer decision?">
      <bpmn:incoming>Flow_02_21</bpmn:incoming>
      <bpmn:outgoing>Flow_02_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_EditAddress</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_UpdatedAmount</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_24</bpmn:outgoing>
<bpmn:outgoing>Flow_02_edit_selection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Save" name="Retain reviewed details and amount for BPMN-09">
      <bpmn:documentation>FR-ORD-02; FR-DEL-08; FR-SUB-05. Pass purchase type, products/variants, quantities, prices, schedule(s), fulfillment method, delivery destination and applicable quotations/fees, and reviewed payable total to BPMN-09. This is a checkout handoff, not a confirmed order. On later successful purchase confirmation, preserve agreed schedules and delivery details for operations.</bpmn:documentation>
      <bpmn:incoming>Flow_02_24</bpmn:incoming>
      <bpmn:outgoing>Flow_02_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Reviewed purchase ready for BPMN-09">
      <bpmn:documentation>BPMN-09 performs final resource validation and purchase reservation before payment. No resource reservation, payment, paid subscription activation or courier booking occurs here.</bpmn:documentation>
      <bpmn:incoming>Flow_02_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Leave" name="Arrangement left unsubmitted">
      <bpmn:documentation>No handoff to BPMN-09. Leaving does not specify deletion, retention duration or an abandonment timeout.</bpmn:documentation>
      <bpmn:incoming>Flow_02_4</bpmn:incoming>
      <bpmn:incoming>Flow_02_18</bpmn:incoming>
      <bpmn:incoming>Flow_02_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_02_1" sourceRef="Start" targetRef="PurchaseType" />
    <bpmn:sequenceFlow id="Flow_02_2" sourceRef="Arrange" targetRef="Continue" />
    <bpmn:sequenceFlow id="Flow_02_3" sourceRef="Continue" targetRef="Validate" name="Continue" />
    <bpmn:sequenceFlow id="Flow_02_4" sourceRef="Continue" targetRef="Leave" name="Leave" />
    <bpmn:sequenceFlow id="Flow_02_5" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_02_6" sourceRef="Valid" targetRef="Invalid" name="No" />
    <bpmn:sequenceFlow id="Flow_02_7" sourceRef="Invalid" targetRef="PurchaseType" name="Correct" />
    <bpmn:sequenceFlow id="Flow_02_8" sourceRef="Valid" targetRef="Delivery" name="Yes" />
    <bpmn:sequenceFlow id="Flow_02_9" sourceRef="Delivery" targetRef="Address" name="Yes: delivery" />
    <bpmn:sequenceFlow id="Flow_02_10" sourceRef="Delivery" targetRef="Total" name="Pickup: either type" />
    <bpmn:sequenceFlow id="Flow_02_11" sourceRef="AddressAction" targetRef="Quote" name="Confirm selection" />
    <bpmn:sequenceFlow id="Flow_02_AddressAction" sourceRef="Address" targetRef="AddressAction" />
    <bpmn:sequenceFlow id="Flow_02_MaintainAddress" sourceRef="AddressAction" targetRef="MaintainAddress" name="Add or edit" />
    <bpmn:sequenceFlow id="Flow_02_AddressReturn" sourceRef="MaintainAddress" targetRef="Address" />
    <bpmn:sequenceFlow id="Flow_02_12" sourceRef="Quote" targetRef="Eligible" />
    <bpmn:sequenceFlow id="Flow_02_13" sourceRef="Eligible" targetRef="Issue" name="No / unavailable" />
    <bpmn:sequenceFlow id="Flow_02_14" sourceRef="Issue" targetRef="Recover" />
    <bpmn:sequenceFlow id="Flow_02_15" sourceRef="Recover" targetRef="Recovery" />
    <bpmn:sequenceFlow id="Flow_02_16" sourceRef="Recovery" targetRef="Quote" name="Retry quotation" />
    <bpmn:sequenceFlow id="Flow_02_17" sourceRef="Recovery" targetRef="PurchaseType" name="Change fulfillment" />
    <bpmn:sequenceFlow id="Flow_02_CorrectAddress" sourceRef="Recovery" targetRef="Address" name="Correct address" />
    <bpmn:sequenceFlow id="Flow_02_18" sourceRef="Recovery" targetRef="Leave" name="Leave" />
    <bpmn:sequenceFlow id="Flow_02_19" sourceRef="Eligible" targetRef="Total" name="Yes" />
    <bpmn:sequenceFlow id="Flow_02_20" sourceRef="Total" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_02_21" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="Flow_02_22" sourceRef="Decision" targetRef="PurchaseType" name="Edit fulfillment" />
    <bpmn:sequenceFlow id="Flow_02_EditAddress" sourceRef="Decision" targetRef="Address" name="Edit delivery address" />
    <bpmn:sequenceFlow id="Flow_02_UpdatedAmount" sourceRef="Decision" targetRef="Total" name="Price or fee changed" />
    <bpmn:sequenceFlow id="Flow_02_23" sourceRef="Decision" targetRef="Leave" name="Leave" />
    <bpmn:sequenceFlow id="Flow_02_24" sourceRef="Decision" targetRef="Save" name="Proceed to reservation" />
    <bpmn:sequenceFlow id="Flow_02_25" sourceRef="Save" targetRef="Done" />
<bpmn:exclusiveGateway id="PurchaseType" name="Purchase type?">
<bpmn:incoming>Flow_02_1</bpmn:incoming>
<bpmn:incoming>Flow_02_7</bpmn:incoming>
<bpmn:incoming>Flow_02_17</bpmn:incoming>
<bpmn:incoming>Flow_02_22</bpmn:incoming>
<bpmn:outgoing>Flow_02_standard</bpmn:outgoing>
<bpmn:outgoing>Flow_02_subscription</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="SubscriptionArrange" name="Retain four subscription dates; choose pickup / delivery">
<bpmn:documentation>SRS scope item 6; FR-SUB-01, 02, 05. Retain the offering, variant, quantity and four-week schedule from BPMN-03. The selected fulfillment method applies to all four fulfillments. Do not select another schedule here; configuration edits return to BPMN-03.</bpmn:documentation>
<bpmn:incoming>Flow_02_subscription</bpmn:incoming>
<bpmn:outgoing>Flow_02_subscription_done</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="EditType" name="Selection to edit?">
<bpmn:incoming>Flow_02_edit_selection</bpmn:incoming>
<bpmn:outgoing>Flow_02_edit_cart</bpmn:outgoing>
<bpmn:outgoing>Flow_02_edit_subscription</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="ReturnCart" name="Return to BPMN-01: edit cart">
<bpmn:incoming>Flow_02_edit_cart</bpmn:incoming>
<bpmn:documentation>End this review. After cart changes, re-enter BPMN-02 with the validated cart; revalidate the common date and recalculate applicable quotations and totals.</bpmn:documentation>
</bpmn:endEvent>
<bpmn:endEvent id="ReturnSubscription" name="Return to BPMN-03: edit configuration">
<bpmn:incoming>Flow_02_edit_subscription</bpmn:incoming>
<bpmn:documentation>End this review. Change offering, variant, quantity or schedule in BPMN-03, then re-enter BPMN-02. Revalidate applicable fulfillment details, quotations and totals.</bpmn:documentation>
</bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_02_standard" sourceRef="PurchaseType" targetRef="Arrange" name="Standard order" />
<bpmn:sequenceFlow id="Flow_02_subscription" sourceRef="PurchaseType" targetRef="SubscriptionArrange" name="Subscription" />
<bpmn:sequenceFlow id="Flow_02_subscription_done" sourceRef="SubscriptionArrange" targetRef="Continue" name="" />
<bpmn:sequenceFlow id="Flow_02_edit_selection" sourceRef="Decision" targetRef="EditType" name="Edit items / configuration" />
<bpmn:sequenceFlow id="Flow_02_edit_cart" sourceRef="EditType" targetRef="ReturnCart" name="Standard order" />
<bpmn:sequenceFlow id="Flow_02_edit_subscription" sourceRef="EditType" targetRef="ReturnSubscription" name="Subscription" />
  </bpmn:process>
  <bpmn:process id="Process_31_Reference" name="BPMN-31 | Saved Delivery Address Maintenance (reference only)" isExecutable="false">
    <bpmn:documentation>See bpmn-31-saved-delivery-address-maintenance.bpmn.xml. Return to address selection after saving or cancelling the edit.</bpmn:documentation>
  </bpmn:process>
  <bpmn:process id="Process_18_Reference" name="BPMN-18 | Courier Address Eligibility and Delivery Fee Quotation (reference only)" isExecutable="false">
<bpmn:documentation>Reference stub for the separately catalogued reusable BPMN-18, not its implementation. Input: selected address and applicable delivery schedule(s). Output: validated destination, service-area eligibility and applicable Lalamove quotation(s), or an address/provider issue. Detailed BPMN-18 is intentionally outside this diagram. Replace this reference with the full reusable process when combining models.</bpmn:documentation>
</bpmn:process>
