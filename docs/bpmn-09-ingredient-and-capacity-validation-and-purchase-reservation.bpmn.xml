    <bpmn:sequenceFlow id="Flow_5" sourceRef="ProductOK" targetRef="Lead" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Lead" targetRef="LeadOK"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="LeadOK" targetRef="LeadBlocked" name="No"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="LeadOK" targetRef="Dates" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Dates" targetRef="DatesOK"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="DatesOK" targetRef="DatesBlocked" name="No"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="DatesOK" targetRef="Capacity" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Capacity" targetRef="CapacityOK"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="CapacityOK" targetRef="CapacityBlocked" name="No"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="CapacityOK" targetRef="Materials" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Materials" targetRef="MaterialsOK"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="MaterialsOK" targetRef="MaterialsBlocked" name="No"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="MaterialsOK" targetRef="Reserve" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Reserve" targetRef="Held"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Held" targetRef="Explain" name="No"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Explain" targetRef="ContinueCheckout"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Held" targetRef="Ready" name="Yes"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="ProductBlocked" targetRef="Explain"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="LeadBlocked" targetRef="Explain"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="DatesBlocked" targetRef="Explain"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="CapacityBlocked" targetRef="Explain"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="MaterialsBlocked" targetRef="Explain"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="ContinueCheckout" targetRef="ReviseOrRetry" name="Revise or retry"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="ContinueCheckout" targetRef="Blocked" name="Stop"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="ReviseOrRetry" targetRef="Load"/>
    <bpmn:textAnnotation id="RecoveryRoutes"><bpmn:text>Standard cart changes: BPMN-01
Subscription selection changes: BPMN-03
Fulfillment arrangement and review: BPMN-02
Cake quotation changes and acceptance: BPMN-08</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Reference_RecoveryRoutes" sourceRef="ReviseOrRetry" targetRef="RecoveryRoutes"/>
    <bpmn:textAnnotation id="Upstream"><bpmn:text>Reviewed standard or subscription purchase: BPMN-02
Accepted custom cake quotation: BPMN-08</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Reference_Upstream" sourceRef="Start" targetRef="Upstream"/>
    <bpmn:textAnnotation id="LeadRules"><bpmn:text>Standard: noon at least one day before fulfillment, or earlier if required.
Subscription: noon at least one day before first preparation, subject to product lead time.
Cake: original submission must be at least 7 calendar days ahead (BPMN-07).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Reference_LeadRules" sourceRef="Lead" targetRef="LeadRules"/>
    <bpmn:textAnnotation id="CapacityRules"><bpmn:text>Configured in BPMN-34. Defaults:
Standard: 4 varieties per fulfillment day, 10 units each.
Subscription: 10 units per product per week. Check all 4 fulfillments.
Cake: 2 per week on distinct dates.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Reference_CapacityRules" sourceRef="Capacity" targetRef="CapacityRules"/>
    <bpmn:textAnnotation id="MaterialRules"><bpmn:text>Refer to BPMN-22 for BoM quantities. Available stock is stock on hand minus existing reservations. Checkout checks ingredients for the first subscription fulfillment only.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Reference_MaterialRules" sourceRef="Materials" targetRef="MaterialRules"/>
    <bpmn:textAnnotation id="PaymentHandoff"><bpmn:text>Continue to BPMN-10 for QR Ph payment, hold-expiry checks, and purchase confirmation or release.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Reference_PaymentHandoff" sourceRef="Ready" targetRef="PaymentHandoff"/>
  </bpmn:process>
