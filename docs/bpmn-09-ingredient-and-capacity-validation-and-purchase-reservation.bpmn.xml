  id="Definitions_09" targetNamespace="https://kitchen406.local/bpmn">
  <bpmn:collaboration id="Collaboration_09">
    <bpmn:participant id="Pool_09" name="BPMN-09 | Ingredient and Capacity Validation and Purchase Reservation" processRef="Process_09"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_09" name="Ingredient and Capacity Validation and Purchase Reservation" isExecutable="false">
    <bpmn:documentation>Sources: docs/proposed-bpmn-catalog.md BPMN-09 and reuse rules; Chapters/Kitchen406 - Capstone Paper.md SRS 4.7, 4.10–4.12 and BoM requirements; index.html and linked checkout, scheduling, subscription, cake, inventory, capacity, and checkout-hold modules. The SRS governs the 32-minute hold. Customer and system responsibilities are lanes in a single process. BPMN-06 and the late-payment path in BPMN-10 reuse the applicable validation rules for deferment and reconciliation without invoking the normal checkout hold workflow.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_09">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ContinueCheckout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviseOrRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Blocked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Product</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProductOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProductBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LeadOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LeadBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DatesOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DatesBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Capacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CapacityOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CapacityBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MaterialsOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MaterialsBlocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Held</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Explain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Enter checkout for reviewed purchase">
      <bpmn:documentation>Authenticated customer enters from BPMN-02 (standard or subscription) or BPMN-08 (accepted cake quotation).</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Load" name="Load reviewed purchase and applicable rules">
      <bpmn:documentation>FR-PAY-01; FR-ORD-02–03. Verify registered-customer access and purchase ownership. Use the reviewed items, prices, agreed fulfillment details and schedule or the accepted cake quotation snapshot. Authentication belongs to BPMN-26. Scheduling and recipe configuration come from BPMN-34 and BPMN-35.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Product" name="Check product eligibility and quantities">
      <bpmn:documentation>FR-PAY-02; FR-INV-12. Check the selected product or accepted cake configuration and applicable quantities against current eligibility. Display the affected item and return standard cart changes to BPMN-01, subscription selection changes to BPMN-03, or cake quotation changes to BPMN-08.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ProductOK" name="Items and quantities eligible?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ProductBlocked" name="Identify unavailable items or invalid quantities">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Lead" name="Check lead time and checkout cutoff">
      <bpmn:documentation>FR-CAP-12–13, 19–21. For standard orders, apply the noon cutoff at least one day before fulfillment or an earlier product-specific deadline. For subscriptions, apply the noon enrollment cutoff at least one day before the first preparation date, subject to configured lead time. For cakes, use the original timely submission established by BPMN-07 and assess feasibility of the agreed date. Later review does not restart the seven-calendar-day clock.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="LeadOK" name="Lead time and cutoff met?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="LeadBlocked" name="Identify missed lead time or cutoff">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Dates" name="Check requested dates against blocked dates">
      <bpmn:documentation>FR-CAP-10–11. Check each agreed fulfillment date against current blocked dates. For subscriptions, check all four commitments.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="DatesOK" name="All required dates open?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DatesBlocked" name="Identify blocked fulfillment dates">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Capacity" name="Check available slots in the applicable capacity pool">
      <bpmn:documentation>FR-CAP-01, 03–09, 17–18. Check the agreed fulfillment dates and quantities against existing allocations in the applicable pool. Standard default: four varieties per fulfillment day, up to ten units each. Subscription default: ten units per product per week; all four commitments must fit. Cake default: two per week on distinct fulfillment dates.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="CapacityOK" name="Enough capacity for every fulfillment?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CapacityBlocked" name="Identify fulfillments without capacity">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Materials" name="Calculate ingredient needs and check available stock">
      <bpmn:documentation>FR-INV-03–06, 12, 19–20; FR-BOM-07–08. Apply BPMN-22 calculation rules using saved item quantities or accepted cake configuration and applicable recipes or BoMs. Compare requirements with stock available after existing reservations. Checkout ingredient checks apply only to the first subscription fulfillment; BPMN-11 handles subsequent reservations.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="MaterialsOK" name="Enough ingredients to reserve?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="MaterialsBlocked" name="Identify ingredient shortage">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Reserve" name="Save pending purchase and reserve resources for 32 minutes">
      <bpmn:documentation>FR-ORD-01–03; FR-CAP-08, 14, 16; FR-INV-06, 19; NFR-PERF-06, NFR-SAF-02 and NFR-REL-03. If all checks pass, atomically create or associate the pending purchase with the saved payable amount and agreed details, record the checkout hold and expiry, and reserve capacity and ingredients. Standard and cake purchases hold capacity and required ingredients; subscriptions hold all four capacity commitments and first-fulfillment ingredients only. Reservations leave physical stock unchanged. Guard the save against concurrent allocation and duplicate submissions. Eligibility failure, lost availability or failed save leaves prior state intact with no new or partial allocation.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Held" name="Purchase and hold saved?">
      <bpmn:documentation>Success requires a saved pending purchase and all applicable temporary reservations.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Explain" name="Show why checkout is blocked and how to proceed">
      <bpmn:documentation>Show the specific validation failure or save conflict, block payment, and preserve prior state without creating a new or partial hold. Offer changes or retry as applicable and preserve reviewed details where possible.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ContinueCheckout" name="Continue checkout?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ReviseOrRetry" name="Submit revised purchase details or retry checkout">
      <bpmn:documentation>Make corrections in the owning workflow and resume once the revised purchase is reviewed or the revised quotation is accepted. Retry the unchanged purchase when appropriate. Each attempt reloads current details and revalidates all rules.</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Blocked" name="Checkout ends before payment">
      <bpmn:incoming>Flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Ready" name="Pending purchase ready for payment (BPMN-10)">
      <bpmn:documentation>Pass the purchase ID, saved payable amount, reservations and hold expiry to BPMN-10 for payment and purchase confirmation.</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Load"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Load" targetRef="Product"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Product" targetRef="ProductOK"/>
