    <bpmn:sequenceFlow id="Flow_6_41" sourceRef="Sum_41" targetRef="Round_41" />
    <bpmn:sequenceFlow id="Flow_7_41" sourceRef="Round_41" targetRef="Display_41" />
    <bpmn:sequenceFlow id="Flow_8_41" sourceRef="Display_41" targetRef="View_41" />
    <bpmn:sequenceFlow id="Flow_9_41" sourceRef="Pending_41" targetRef="View_41" />
    <bpmn:sequenceFlow id="Flow_10_41" sourceRef="View_41" targetRef="Action_41" />
    <bpmn:sequenceFlow id="Flow_11_41" sourceRef="Action_41" targetRef="Options_41" name="Change / retry" />
    <bpmn:sequenceFlow id="Flow_12_41" sourceRef="Action_41" targetRef="End_41" name="Finish viewing" />
    <bpmn:textAnnotation id="Rounding_41">
      <bpmn:text>Example: ₱1,225 subtotal + ₱25 rounding = ₱1,250 preliminary estimate. An exact multiple such as ₱1,250 stays the same.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Rounding_link_41" sourceRef="Round_41" targetRef="Rounding_41" />
    <bpmn:textAnnotation id="Quotation_41">
