      <bpmn:outgoing>Flow_8_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="View_41" name="View updated preliminary estimate or status">
      <bpmn:incoming>Flow_8_41</bpmn:incoming>
      <bpmn:incoming>Flow_9_41</bpmn:incoming>
      <bpmn:outgoing>Flow_10_41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Action_41" name="Change options or retry?">
      <bpmn:incoming>Flow_10_41</bpmn:incoming>
      <bpmn:outgoing>Flow_11_41</bpmn:outgoing>
      <bpmn:outgoing>Flow_12_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_41" name="Customer finishes viewing the estimate">
