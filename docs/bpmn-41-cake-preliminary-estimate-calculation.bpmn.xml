      <bpmn:outgoing>Flow_5_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Pending_41" name="Show available breakdown and prompt for missing choices, or explain error and keep draft">
      <bpmn:incoming>Flow_4_41</bpmn:incoming>
      <bpmn:outgoing>Flow_9_41</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Sum_41" name="Add each selected cake option price once">
      <bpmn:incoming>Flow_5_41</bpmn:incoming>
      <bpmn:outgoing>Flow_6_41</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="Round_41" name="Round the subtotal up once: 50 × ceiling(subtotal ÷ 50)">
      <bpmn:incoming>Flow_6_41</bpmn:incoming>
      <bpmn:outgoing>Flow_7_41</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Display_41" name="Refresh option breakdown, subtotal, rounding adjustment and preliminary estimate">
