    <bpmn:startEvent id="Start_42" name="Authorized Owner opens submitted feedback for review">
      <bpmn:outgoing>Flow_42_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Load_42" name="Load review, current visibility/version and history">
      <bpmn:documentation>FR-REV-08,13. Authorized Owner page access is an entry precondition. Load existing feedback with customer/product/purchase context, rating, optional comment/photos, hidden/visible state and history/version. No new Cloudinary upload or review submission. Empty/filter results may return to selection; a missing selected record is safely explained.</bpmn:documentation>
      <bpmn:incoming>Flow_42_1</bpmn:incoming>
      <bpmn:outgoing>Flow_42_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed_42" name="Selected review available?">
      <bpmn:incoming>Flow_42_2</bpmn:incoming>
      <bpmn:outgoing>Flow_42_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Denied_42" name="Explain missing-review/load issue; retain saved feedback">
      <bpmn:incoming>Flow_42_30</bpmn:incoming>
      <bpmn:incoming>Flow_42_3</bpmn:incoming>
      <bpmn:outgoing>Flow_42_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DeniedEnd_42" name="Moderation unavailable; no changes">
      <bpmn:incoming>Flow_42_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Review_42" name="Inspect rating/comment/photos and history; choose desired visibility">
      <bpmn:documentation>FR-REV-08-10,14. Owner manually decides whether this feedback should remain as-is, be hidden as inappropriate, or be restored if hidden. No automatic classification/rating threshold or sentiment analysis. Review source content is read-only; choosing a visibility state does not alter the customer feedback. Closing/viewing-only leaves state unchanged.</bpmn:documentation>
      <bpmn:incoming>Flow_42_29</bpmn:incoming>
      <bpmn:incoming>Flow_42_25</bpmn:incoming>
      <bpmn:incoming>Flow_42_5</bpmn:incoming>
      <bpmn:outgoing>Flow_42_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Change_42" name="Visibility change requested?">
      <bpmn:incoming>Flow_42_6</bpmn:incoming>
      <bpmn:outgoing>Flow_42_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Unchanged_42" name="Reviewed; visibility unchanged">
      <bpmn:incoming>Flow_42_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Hide_42" name="Hide a currently visible review?">
      <bpmn:documentation>Hide path requires a moderation reason; restore path is only for a currently hidden review. No-change is handled before this split. Server rechecks current state/version before any mutation.</bpmn:documentation>
      <bpmn:incoming>Flow_42_8</bpmn:incoming>
      <bpmn:outgoing>Flow_42_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Reason_42" name="Select hiding reason; specify explanation for Other">
      <bpmn:documentation>FR-REV-11-12. Supported reasons: Spam, Abusive language, Off-topic content, Sexual content, Other. For Other require a specified explanation. Optional additional notes may accompany supported reason; no SRS-specific comment-length requirement is invented. This is Owner judgement, not automated content detection.</bpmn:documentation>
      <bpmn:incoming>Flow_42_9</bpmn:incoming>
      <bpmn:outgoing>Flow_42_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Confirm_42" name="Review desired visibility and applicable reason; confirm or cancel">
      <bpmn:documentation>Explicitly submit the chosen action. Unhide needs no new hiding reason; retain prior reasons/history. Cancel preserves saved state. If another moderator changed the review, refreshed current state must be reviewed rather than silently replacing it.</bpmn:documentation>
      <bpmn:incoming>Flow_42_11</bpmn:incoming>
      <bpmn:incoming>Flow_42_10</bpmn:incoming>
      <bpmn:outgoing>Flow_42_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirmed_42" name="Owner confirms moderation?">
      <bpmn:incoming>Flow_42_12</bpmn:incoming>
      <bpmn:outgoing>Flow_42_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Cancel_42" name="Cancelled; saved visibility/history retained">
      <bpmn:incoming>Flow_42_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Validate_42" name="Validate current review/version, requested action and hiding reason">
      <bpmn:documentation>FR-REV-09-14; NFR-SEC-03,08. Require existing selected review, current expected version and supported requested visibility. Authorized Owner access is an entry precondition. Newly hiding requires a supported reason; Other requires nonblank specified explanation. Restoring hidden feedback does not require inventing a new hiding reason or removing prior history. Unchanged action is a no-op. Unknown state/action, missing reason or stale version yields exact failure. No mutation of rating/text/photos and no automatic inappropriate-content classification.</bpmn:documentation>
      <bpmn:incoming>Flow_42_14</bpmn:incoming>
      <bpmn:outgoing>Flow_42_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Valid_42" name="Moderation request valid/current?">
      <bpmn:incoming>Flow_42_15</bpmn:incoming>
      <bpmn:outgoing>Flow_42_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="InputError_42" name="Explain missing reason, invalid action or stale review; retain draft">
      <bpmn:incoming>Flow_42_16</bpmn:incoming>
      <bpmn:outgoing>Flow_42_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Save_42" name="Recheck version; save visibility and moderator history together">
      <bpmn:documentation>FR-REV-09-13; NFR-REL-03,05. Atomically recheck review version and applicable reason; save hidden/restored visibility, acting Owner account identity, action/reason/notes, time and new version as one moderation update. Preserve all earlier moderation history and original feedback/purchase links. Same successful request or already matching no-op does not duplicate history. Concurrent different version/state requires explicit review; no stale overwrite. Failed combined save leaves prior saved visibility/history intact. No actual feedback deletion, photo deletion, reply, payment or transaction state change.</bpmn:documentation>
      <bpmn:incoming>Flow_42_17</bpmn:incoming>
      <bpmn:outgoing>Flow_42_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Saved_42" name="Visibility/history saved or unchanged?">
      <bpmn:incoming>Flow_42_18</bpmn:incoming>
      <bpmn:outgoing>Flow_42_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SaveError_42" name="Explain conflict/save failure; retain latest visibility/history and draft">
      <bpmn:incoming>Flow_42_19</bpmn:incoming>
      <bpmn:outgoing>Flow_42_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Refresh_42" name="Show saved moderation result; refresh public visibility from saved state">
      <bpmn:documentation>FR-REV-08-10. Hidden feedback remains in Owner management/history but is excluded from public display; restored feedback is visible again. Refresh public review lists/related displayed review summary consistently from saved visible feedback as applicable to website R.public. Display failure does not undo a saved moderation change; refresh safely. No new review, customer email/SMS or automated classification. Review content and customer purchase association remain unchanged.</bpmn:documentation>
      <bpmn:incoming>Flow_42_20</bpmn:incoming>
      <bpmn:outgoing>Flow_42_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_42" name="Owner moderation complete; saved visibility/history retained">
      <bpmn:incoming>Flow_42_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="RecoveryReview_42" name="Review error; correct reason/action, reload and retry, or stop">
      <bpmn:documentation>Invalid hiding reason can be corrected in the draft. Stale data requires current review/visibility/history reload and explicit re-evaluation. Safe retry rechecks target/version and avoids duplicate moderation history. End only if Owner stops, not merely because a recoverable error occurred.</bpmn:documentation>
      <bpmn:incoming>Flow_42_23</bpmn:incoming>
      <bpmn:incoming>Flow_42_22</bpmn:incoming>
      <bpmn:outgoing>Flow_42_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Recovery_42" name="Owner recovery choice?">
      <bpmn:incoming>Flow_42_24</bpmn:incoming>
      <bpmn:outgoing>Flow_42_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_26</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Stop_42" name="Stopped for now; current moderation state retained">
      <bpmn:incoming>Flow_42_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Reload_42" name="Reload current feedback/version; retain moderation draft for review">
      <bpmn:documentation>Refresh feedback, visibility/history and version while keeping unsaved action/reason draft separately. No silent merger onto a newer moderation decision. Return directly to review when the selected feedback is available; explain a missing record or failed read.</bpmn:documentation>
      <bpmn:incoming>Flow_42_27</bpmn:incoming>
      <bpmn:outgoing>Flow_42_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RetryAllowed_42" name="Selected review still available?">
      <bpmn:incoming>Flow_42_28</bpmn:incoming>
      <bpmn:outgoing>Flow_42_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_42_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
