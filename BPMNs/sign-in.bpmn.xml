<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_SignIn" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_SignIn">
    <bpmn:participant id="Participant_SignIn" name="Sign In" processRef="Process_SignIn" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SignIn" name="Sign In" isExecutable="false">
    <bpmn:documentation>Customers, staff, and admins use the same sign-in process. Access comes from the account’s assigned role. Invalid credentials, inactive accounts, customer accounts awaiting verification, and temporary attempt limits prevent a session from starting. Active staff who have not changed their temporary password are routed to Staff First Sign-In and Password Setup. Forgot Password is a separate process.</bpmn:documentation>

    <bpmn:laneSet id="Lanes_SignIn">
      <bpmn:lane id="Lane_User" name="User (Customer, Staff, or Admin)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignedIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Sign-in requested">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Submit" name="Enter email and password">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Check credentials and account status">
      <bpmn:incoming>Flow_Submit_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Allowed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Sign-in allowed?" gatewayDirection="Diverging" default="Flow_Allowed_Error">
      <bpmn:incoming>Flow_Check_Allowed</bpmn:incoming>
      <bpmn:outgoing>Flow_Allowed_Session</bpmn:outgoing>
      <bpmn:outgoing>Flow_Allowed_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Session" name="Start session and open the assigned workspace">
      <bpmn:incoming>Flow_Allowed_Session</bpmn:incoming>
      <bpmn:outgoing>Flow_Session_SignedIn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="SignedIn" name="Signed in">
      <bpmn:incoming>Flow_Session_SignedIn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Error" name="Show sign-in error and available next step">
      <bpmn:incoming>Flow_Allowed_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_Error_Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Retry" name="Try again?" gatewayDirection="Diverging" default="Flow_Retry_End">
      <bpmn:incoming>Flow_Error_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Submit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Sign-in closed">
      <bpmn:incoming>Flow_Retry_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_Submit_Check" sourceRef="Submit" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Allowed" sourceRef="Check" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_Allowed_Session" name="Yes" sourceRef="Allowed" targetRef="Session" />
    <bpmn:sequenceFlow id="Flow_Session_SignedIn" sourceRef="Session" targetRef="SignedIn" />
    <bpmn:sequenceFlow id="Flow_Allowed_Error" name="No" sourceRef="Allowed" targetRef="Error" />
    <bpmn:sequenceFlow id="Flow_Error_Retry" sourceRef="Error" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_Retry_Submit" name="Retry" sourceRef="Retry" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_Retry_End" name="Close" sourceRef="Retry" targetRef="End" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_SignIn">
    <bpmndi:BPMNPlane id="Plane_SignIn" bpmnElement="Collaboration_SignIn">
      <bpmndi:BPMNShape id="Shape_Participant_SignIn" bpmnElement="Participant_SignIn" isHorizontal="true">
        <dc:Bounds x="14" y="22" width="1075" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserLane" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="44" y="22" width="1045" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SystemLane" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="44" y="322" width="1045" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="87" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="48" y="169" width="114" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Submit" bpmnElement="Submit">
        <dc:Bounds x="184" y="109" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check">
        <dc:Bounds x="389" y="354" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Allowed" bpmnElement="Allowed" isMarkerVisible="true">
        <dc:Bounds x="625" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="591" y="332" width="118" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Session" bpmnElement="Session">
        <dc:Bounds x="749" y="354" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SignedIn" bpmnElement="SignedIn">
        <dc:Bounds x="982" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="943" y="414" width="114" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Error" bpmnElement="Error">
        <dc:Bounds x="574" y="499" width="152" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Retry" bpmnElement="Retry" isMarkerVisible="true">
        <dc:Bounds x="445" y="227" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="499" y="239" width="80" height="25" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End">
        <dc:Bounds x="242" y="234" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="203" y="276" width="114" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_Submit" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="123" y="145" />
        <di:waypoint x="184" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Submit_Check" bpmnElement="Flow_Submit_Check">
        <di:waypoint x="336" y="145" />
        <di:waypoint x="365" y="145" />
        <di:waypoint x="365" y="390" />
        <di:waypoint x="389" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Check_Allowed" bpmnElement="Flow_Check_Allowed">
        <di:waypoint x="541" y="390" />
        <di:waypoint x="625" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Allowed_Session" bpmnElement="Flow_Allowed_Session">
        <di:waypoint x="675" y="390" />
        <di:waypoint x="749" y="390" />
        <bpmndi:BPMNLabel><dc:Bounds x="694" y="366" width="24" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Session_SignedIn" bpmnElement="Flow_Session_SignedIn">
        <di:waypoint x="901" y="390" />
        <di:waypoint x="982" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Allowed_Error" bpmnElement="Flow_Allowed_Error">
        <di:waypoint x="650" y="415" />
        <di:waypoint x="650" y="499" />
        <bpmndi:BPMNLabel><dc:Bounds x="657" y="448" width="18" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Error_Retry" bpmnElement="Flow_Error_Retry">
        <di:waypoint x="574" y="535" />
        <di:waypoint x="550" y="535" />
        <di:waypoint x="550" y="304" />
        <di:waypoint x="470" y="304" />
        <di:waypoint x="470" y="277" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Retry_Submit" bpmnElement="Flow_Retry_Submit">
        <di:waypoint x="470" y="227" />
