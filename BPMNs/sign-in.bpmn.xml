        <di:waypoint x="260" y="109" />
        <bpmndi:BPMNLabel><dc:Bounds x="347" y="64" width="36" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Retry_End" bpmnElement="Flow_Retry_End">
        <di:waypoint x="445" y="252" />
        <di:waypoint x="278" y="252" />
        <bpmndi:BPMNLabel><dc:Bounds x="338" y="230" width="36" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
