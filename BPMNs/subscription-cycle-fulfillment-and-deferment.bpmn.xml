<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_SubscriptionCycleFulfillment" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_SubscriptionCycleFulfillment">
    <bpmn:participant id="Participant_SubscriptionCycleFulfillment" name="Subscription Cycle Fulfillment and Deferment" processRef="Process_SubscriptionCycleFulfillment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SubscriptionCycleFulfillment" name="Subscription Cycle Fulfillment and Deferment" isExecutable="false">
    <bpmn:documentation>Current SQLite v6 flow for one paid subscription cycle. Subscription API activity checks due reservations and missed pickups. A deferred cycle retains its prepaid amounts. Courier Address and Fulfillment covers the delivery handoff.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_SubscriptionCycleFulfillment">
      <bpmn:lane id="Lane_0" name="Customer">
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Kitchen406 System">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Defer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deferred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Consume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Shortage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Missed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Admin or Eligible Staff">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Courier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Handoff</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Subscription cycle scheduled">
      <bpmn:outgoing>Flow_Start_Action</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Action" name="Deferment requested?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Start_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_Action_Request</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Reserve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Request" name="Request next day or next week">
      <bpmn:incoming>Flow_Action_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Defer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Defer" name="Validate and apply eligible deferment">
      <bpmn:documentation>Check customer ownership, one deferment per subscription, scheduled status, and that preparation has not reached its scheduled date. The replacement is the next day or one week after the latest cycle. Check the cutoff, blocked date, and capacity. On success, release the old allocation, create its replacement, and update the fulfillment and material dates together. The cycle remains scheduled and follows the usual reservation and preparation flow for the new date.</bpmn:documentation>
      <bpmn:incoming>Flow_Request_Defer</bpmn:incoming>
      <bpmn:outgoing>Flow_Defer_Deferred</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Deferred" name="Return updated dates or validation issue">
      <bpmn:incoming>Flow_Defer_Deferred</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Reserve" name="Check due material reservations">
      <bpmn:documentation>First cycle uses checkout reservations. For later cycles, subscription API activity attempts reservation from the day before preparation. Shortages can be retried during a later request.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Prepare" name="Start preparation on or after the preparation date">
      <bpmn:incoming>Flow_Reserve_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Consume</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Consume" name="Retry shortage and consume confirmed stock">
      <bpmn:documentation>Reserve outstanding requirements when stock is sufficient, consume confirmed reservations, and move to Preparing in one transaction. A stock conflict leaves the cycle scheduled.</bpmn:documentation>
      <bpmn:incoming>Flow_Prepare_Consume</bpmn:incoming>
      <bpmn:outgoing>Flow_Consume_Prepared</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Prepared" name="Preparation started?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Consume_Prepared</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepared_Shortage</bpmn:outgoing>
      <bpmn:outgoing>Flow_Prepared_Ready</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Shortage" name="Keep cycle scheduled for retry">
      <bpmn:incoming>Flow_Prepared_Shortage</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Ready" name="Mark cycle ready">
      <bpmn:incoming>Flow_Prepared_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Method</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Method" name="Fulfillment method?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Ready_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Method_Courier</bpmn:outgoing>
      <bpmn:outgoing>Flow_Method_Arrival</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Courier" name="Ready for courier booking">
      <bpmn:incoming>Flow_Method_Courier</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Arrival" name="Pickup arrival recorded in time?" gatewayDirection="Diverging">
      <bpmn:documentation>Arrival can be recorded on the scheduled date through 7:00 p.m. Manila time. Before the cutoff the Ready cycle can await arrival.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Arrival</bpmn:incoming>
      <bpmn:outgoing>Flow_Arrival_Missed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Arrival_Handoff</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Missed" name="Cancel missed pickup on subscription API activity">
      <bpmn:documentation>Cancel only a Ready pickup that has no recorded arrival after the Manila cutoff. Release its capacity and record cancellation in order history.</bpmn:documentation>
      <bpmn:incoming>Flow_Arrival_Missed</bpmn:incoming>
      <bpmn:outgoing>Flow_Missed_Cancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Cancelled" name="Cycle cancelled">
      <bpmn:incoming>Flow_Missed_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Handoff" name="Confirm pickup handoff">
      <bpmn:incoming>Flow_Arrival_Handoff</bpmn:incoming>
      <bpmn:outgoing>Flow_Handoff_Complete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Complete" name="Record fulfilled cycle">
      <bpmn:documentation>Save fulfilled_at. Mark the subscription completed once all four cycles are fulfilled.</bpmn:documentation>
      <bpmn:incoming>Flow_Handoff_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Cycle fulfilled">
      <bpmn:incoming>Flow_Complete_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Action" sourceRef="Start" targetRef="Action" />
    <bpmn:sequenceFlow id="Flow_Action_Request" name="Yes" sourceRef="Action" targetRef="Request" />
    <bpmn:sequenceFlow id="Flow_Request_Defer" sourceRef="Request" targetRef="Defer" />
    <bpmn:sequenceFlow id="Flow_Defer_Deferred" sourceRef="Defer" targetRef="Deferred" />
    <bpmn:sequenceFlow id="Flow_Action_Reserve" name="Proceed with scheduled cycle" sourceRef="Action" targetRef="Reserve" />
    <bpmn:sequenceFlow id="Flow_Reserve_Prepare" sourceRef="Reserve" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_Consume" sourceRef="Prepare" targetRef="Consume" />
    <bpmn:sequenceFlow id="Flow_Consume_Prepared" sourceRef="Consume" targetRef="Prepared" />
    <bpmn:sequenceFlow id="Flow_Prepared_Shortage" name="No" sourceRef="Prepared" targetRef="Shortage" />
    <bpmn:sequenceFlow id="Flow_Prepared_Ready" name="Yes" sourceRef="Prepared" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_Ready_Method" sourceRef="Ready" targetRef="Method" />
    <bpmn:sequenceFlow id="Flow_Method_Courier" name="Delivery" sourceRef="Method" targetRef="Courier" />
    <bpmn:sequenceFlow id="Flow_Method_Arrival" name="Pickup" sourceRef="Method" targetRef="Arrival" />
    <bpmn:sequenceFlow id="Flow_Arrival_Missed" name="Cutoff passed without arrival" sourceRef="Arrival" targetRef="Missed" />
    <bpmn:sequenceFlow id="Flow_Missed_Cancelled" sourceRef="Missed" targetRef="Cancelled" />
    <bpmn:sequenceFlow id="Flow_Arrival_Handoff" name="Arrival recorded" sourceRef="Arrival" targetRef="Handoff" />
    <bpmn:sequenceFlow id="Flow_Handoff_Complete" sourceRef="Handoff" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_Done" sourceRef="Complete" targetRef="Done" />
  </bpmn:process>
