<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DC"
  id="Definitions_ProtectedAccess" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_ProtectedAccess">
    <bpmn:participant id="Participant_ProtectedAccess" name="Protected Action Access" processRef="Process_ProtectedAccess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProtectedAccess" name="Validate Session and Authorize Action" isExecutable="false">
    <bpmn:documentation>Server-side process for protected customer, staff, and admin API actions. The server hashes the session cookie token and checks AuthSession for an unexpired match. It checks the active Account, role profile, and permissions for the requested action, including customer record ownership where applicable. Staff who have not completed password setup are restricted to session and setup actions. The caller handles the sign-in or access-denied result.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_ProtectedAccess">
      <bpmn:lane id="Lane_User" name="User (Customer, Staff, or Admin)">
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>CheckSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denied</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Request" name="Protected action requested">
      <bpmn:outgoing>Flow_Request_CheckSession</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CheckSession" name="Look up session by token hash and check expiry">
      <bpmn:incoming>Flow_Request_CheckSession</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSession_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Valid session?" gatewayDirection="Diverging" default="Flow_Valid_SignIn">
      <bpmn:incoming>Flow_CheckSession_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_CheckAccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_SignIn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CheckAccess" name="Check role, setup status, and action permissions">
      <bpmn:incoming>Flow_Valid_CheckAccess</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckAccess_Allowed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Action allowed?" gatewayDirection="Diverging" default="Flow_Allowed_Denied">
      <bpmn:incoming>Flow_CheckAccess_Allowed</bpmn:incoming>
      <bpmn:outgoing>Flow_Allowed_Continue</bpmn:outgoing>
      <bpmn:outgoing>Flow_Allowed_Denied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Continue" name="Continue protected action">
      <bpmn:incoming>Flow_Allowed_Continue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="SignIn" name="Sign-in required">
      <bpmn:incoming>Flow_Valid_SignIn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Denied" name="Access denied">
      <bpmn:incoming>Flow_Allowed_Denied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Request_CheckSession" sourceRef="Request" targetRef="CheckSession" />
    <bpmn:sequenceFlow id="Flow_CheckSession_Valid" sourceRef="CheckSession" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_CheckAccess" sourceRef="Valid" targetRef="CheckAccess" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Valid_SignIn" sourceRef="Valid" targetRef="SignIn" name="No" />
    <bpmn:sequenceFlow id="Flow_CheckAccess_Allowed" sourceRef="CheckAccess" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_Allowed_Continue" sourceRef="Allowed" targetRef="Continue" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Allowed_Denied" sourceRef="Allowed" targetRef="Denied" name="No" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ProtectedAccess">
    <bpmndi:BPMNPlane id="Plane_ProtectedAccess" bpmnElement="Collaboration_ProtectedAccess">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_ProtectedAccess" isHorizontal="true">
        <dc:Bounds x="30" y="20" width="1060" height="375" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_User" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="60" y="20" width="1030" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="140" width="1030" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Request" bpmnElement="Request">
        <dc:Bounds x="130" y="48" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="95" y="91" width="106" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckSession" bpmnElement="CheckSession">
        <dc:Bounds x="220" y="180" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Valid" bpmnElement="Valid" isMarkerVisible="true">
        <dc:Bounds x="445" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="417" y="155" width="106" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CheckAccess" bpmnElement="CheckAccess">
        <dc:Bounds x="555" y="180" width="185" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Allowed" bpmnElement="Allowed" isMarkerVisible="true">
        <dc:Bounds x="800" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="772" y="155" width="106" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Continue" bpmnElement="Continue">
        <dc:Bounds x="965" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="930" y="245" width="106" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SignIn" bpmnElement="SignIn">
        <dc:Bounds x="452" y="305" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="417" y="348" width="106" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Denied" bpmnElement="Denied">
        <dc:Bounds x="807" y="305" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="772" y="348" width="106" height="32" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Request_CheckSession" bpmnElement="Flow_Request_CheckSession">
        <di:waypoint x="166" y="66" />
        <di:waypoint x="192" y="66" />
        <di:waypoint x="192" y="220" />
        <di:waypoint x="220" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CheckSession_Valid" bpmnElement="Flow_CheckSession_Valid">
        <di:waypoint x="390" y="220" />
        <di:waypoint x="445" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Valid_CheckAccess" bpmnElement="Flow_Valid_CheckAccess">
        <di:waypoint x="495" y="220" />
        <di:waypoint x="555" y="220" />
        <bpmndi:BPMNLabel><dc:Bounds x="510" y="196" width="24" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Valid_SignIn" bpmnElement="Flow_Valid_SignIn">
        <di:waypoint x="470" y="245" />
        <di:waypoint x="470" y="305" />
        <bpmndi:BPMNLabel><dc:Bounds x="480" y="270" width="24" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CheckAccess_Allowed" bpmnElement="Flow_CheckAccess_Allowed">
        <di:waypoint x="740" y="220" />
        <di:waypoint x="800" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Allowed_Continue" bpmnElement="Flow_Allowed_Continue">
        <di:waypoint x="850" y="220" />
        <di:waypoint x="965" y="220" />
        <bpmndi:BPMNLabel><dc:Bounds x="890" y="196" width="24" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Allowed_Denied" bpmnElement="Flow_Allowed_Denied">
        <di:waypoint x="825" y="245" />
        <di:waypoint x="825" y="305" />
        <bpmndi:BPMNLabel><dc:Bounds x="835" y="270" width="24" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
