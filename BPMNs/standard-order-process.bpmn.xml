<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_StandardOrderProcess" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_StandardOrderProcess">
    <bpmn:participant id="Participant_StandardOrderProcess" name="Standard Order Process" processRef="Process_StandardOrderProcess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StandardOrderProcess" name="Standard Order Process" isExecutable="false">
    <bpmn:documentation>Standard orders start when the customer selects Add to Cart. A confirmed payment sends the order to the bakery for preparation. The order is completed after pickup handoff or confirmed courier delivery.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_StandardOrderProcess">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>ReceiveDeliveryProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RetryPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectProduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProceedCheckout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ContinueBrowsing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveCompletion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Expiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignedIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DisplayDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordCourier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Admin or Eligible Staff">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivery</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Start shopping">
      <bpmn:outgoing>Flow_Start_SelectProduct</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="SelectProduct" name="Add Product to Cart">
      <bpmn:documentation>The customer selects a product and requests Add to Cart. The system checks sign-in before adding the item.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_SelectProduct</bpmn:incoming>
      <bpmn:incoming>Flow_ContinueBrowsing_SelectProduct</bpmn:incoming>
      <bpmn:incoming>Flow_SignIn_SelectProduct</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectProduct_SignedIn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ProceedCheckout" name="Proceed to checkout?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Add_ProceedCheckout</bpmn:incoming>
      <bpmn:outgoing>Flow_ProceedCheckout_ContinueBrowsing</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProceedCheckout_DisplayDates</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ContinueBrowsing" name="Continue Browsing">
      <bpmn:incoming>Flow_ProceedCheckout_ContinueBrowsing</bpmn:incoming>
      <bpmn:outgoing>Flow_ContinueBrowsing_SelectProduct</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SignIn" name="Sign in to continue">
      <bpmn:documentation>After signing in, return to the product and select Add to Cart again.</bpmn:documentation>
      <bpmn:incoming>Flow_SignedIn_SignIn</bpmn:incoming>
      <bpmn:outgoing>Flow_SignIn_SelectProduct</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Review" name="Select available fulfillment method">
      <bpmn:documentation>Choose bakery pickup or courier delivery. Provide a delivery address for courier delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_SelectDate_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Calculate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Pay" name="Pay for Order Total">
      <bpmn:incoming>Flow_Calculate_Pay</bpmn:incoming>
      <bpmn:incoming>Flow_RetryPayment_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_PaymentOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SignedIn" name="Signed in?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_SelectProduct_SignedIn</bpmn:incoming>
      <bpmn:outgoing>Flow_SignedIn_SignIn</bpmn:outgoing>
      <bpmn:outgoing>Flow_SignedIn_Add</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Add" name="Add item to cart">
      <bpmn:incoming>Flow_SignedIn_Add</bpmn:incoming>
      <bpmn:outgoing>Flow_Add_ProceedCheckout</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DisplayDates" name="Display available dates">
      <bpmn:documentation>Show dates that are open for orders and have enough capacity.</bpmn:documentation>
      <bpmn:incoming>Flow_ProceedCheckout_DisplayDates</bpmn:incoming>
      <bpmn:outgoing>Flow_DisplayDates_SelectDate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PaymentOutcome" name="Payment outcome?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Pay_PaymentOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentOutcome_Expiry</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentOutcome_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Closed" name="Order Canceled">
      <bpmn:incoming>Flow_RetryPayment_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Confirm" name="Confirm order and allocate ingredients">
      <bpmn:incoming>Flow_PaymentOutcome_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Complete" name="Record completion and notify customer">
      <bpmn:documentation>After confirmed pickup handoff or successful courier delivery, set fulfillment to completed, save the completion time and status history, and notify the customer. Courier delivery notifications report the delivered status.</bpmn:documentation>
      <bpmn:incoming>Flow_Pickup_Fulfilled</bpmn:incoming>
      <bpmn:incoming>Flow_Delivery_Fulfilled</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_ReceiveCompletion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Order completed">
      <bpmn:incoming>Flow_ReceiveCompletion_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Prepare" name="Prepare order and mark it ready">
      <bpmn:incoming>Flow_Confirm_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Method</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Method" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Prepare_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Method_Pickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_Method_Delivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Pickup" name="Confirm pickup handoff">
      <bpmn:documentation>Record the customer's arrival and confirm that the order has been handed over.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Fulfilled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Delivery" name="Book courier delivery">
      <bpmn:documentation>An admin confirms the courier booking for a Ready order. Booking alone does not complete the order.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Delivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Delivery_RecordCourier</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="RecordCourier" name="Track courier delivery">
      <bpmn:documentation>Record courier status changes as delivery progresses. The system sends a progress notification when the courier is booked or the order goes in transit. Once delivery is confirmed, send the delivered update through the order completion notification.</bpmn:documentation>
      <bpmn:incoming>Flow_Delivery_RecordCourier</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordCourier_ConfirmDelivery</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ConfirmDelivery" name="Confirm successful courier delivery">
      <bpmn:documentation>Within the system, admin or eligible staff checks courier tracking until successful delivery is confirmed. This system-lane user task represents the tracking interaction in the reference diagram. In the prototype, checking status advances simulated tracking; the delivered update triggers completion in the same operation.</bpmn:documentation>
      <bpmn:incoming>Flow_RecordCourier_ConfirmDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Delivery_Fulfilled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_SignedIn_SignIn" name="No" sourceRef="SignedIn" targetRef="SignIn" />
    <bpmn:sequenceFlow id="Flow_SignedIn_Add" name="Yes" sourceRef="SignedIn" targetRef="Add" />
    <bpmn:sequenceFlow id="Flow_Pay_PaymentOutcome" sourceRef="Pay" targetRef="PaymentOutcome" />
    <bpmn:sequenceFlow id="Flow_Confirm_Prepare" sourceRef="Confirm" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_Method" sourceRef="Prepare" targetRef="Method" />
    <bpmn:sequenceFlow id="Flow_Method_Pickup" name="Pickup" sourceRef="Method" targetRef="Pickup" />
    <bpmn:sequenceFlow id="Flow_Method_Delivery" name="Courier delivery" sourceRef="Method" targetRef="Delivery" />
    <bpmn:sequenceFlow id="Flow_Pickup_Fulfilled" sourceRef="Pickup" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Delivery_RecordCourier" sourceRef="Delivery" targetRef="RecordCourier" />
    <bpmn:sequenceFlow id="Flow_RecordCourier_ConfirmDelivery" sourceRef="RecordCourier" targetRef="ConfirmDelivery" />
    <bpmn:sequenceFlow id="Flow_Delivery_Fulfilled" sourceRef="ConfirmDelivery" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Start_SelectProduct" sourceRef="Start" targetRef="SelectProduct" />
    <bpmn:sequenceFlow id="Flow_SelectProduct_SignedIn" sourceRef="SelectProduct" targetRef="SignedIn" />
    <bpmn:sequenceFlow id="Flow_ContinueBrowsing_SelectProduct" sourceRef="ContinueBrowsing" targetRef="SelectProduct" />
    <bpmn:sequenceFlow id="Flow_Add_ProceedCheckout" sourceRef="Add" targetRef="ProceedCheckout" />
    <bpmn:sequenceFlow id="Flow_ProceedCheckout_ContinueBrowsing" name="No" sourceRef="ProceedCheckout" targetRef="ContinueBrowsing" />
    <bpmn:task id="ReceiveCompletion" name="Receive order completed notification">
      <bpmn:documentation>The customer receives the completion notification sent by the system after pickup handoff or successful courier delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_Complete_ReceiveCompletion</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveCompletion_Done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Complete_ReceiveCompletion" sourceRef="Complete" targetRef="ReceiveCompletion" />
    <bpmn:userTask id="SelectDate" name="Select delivery date">
      <bpmn:documentation>Choose the date for pickup or delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_DisplayDates_SelectDate</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectDate_Review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Calculate" name="Calculate order total and delivery fee if applicable">
      <bpmn:documentation>Include the delivery fee for courier delivery after checking that the address can be served.</bpmn:documentation>
      <bpmn:incoming>Flow_Review_Calculate</bpmn:incoming>
      <bpmn:outgoing>Flow_Calculate_Pay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Expiry" name="Show Expiry Message">
      <bpmn:incoming>Flow_PaymentOutcome_Expiry</bpmn:incoming>
      <bpmn:outgoing>Flow_Expiry_RetryPayment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RetryPayment" name="Retry payment?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Expiry_RetryPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryPayment_Pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_RetryPayment_Closed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_SignIn_SelectProduct" sourceRef="SignIn" targetRef="SelectProduct" />
    <bpmn:sequenceFlow id="Flow_Review_Calculate" sourceRef="Review" targetRef="Calculate" />
    <bpmn:sequenceFlow id="Flow_Calculate_Pay" sourceRef="Calculate" targetRef="Pay" />
    <bpmn:sequenceFlow id="Flow_PaymentOutcome_Expiry" name="Expired" sourceRef="PaymentOutcome" targetRef="Expiry" />
    <bpmn:sequenceFlow id="Flow_Expiry_RetryPayment" sourceRef="Expiry" targetRef="RetryPayment" />
    <bpmn:sequenceFlow id="Flow_RetryPayment_Pay" name="Yes" sourceRef="RetryPayment" targetRef="Pay" />
    <bpmn:sequenceFlow id="Flow_RetryPayment_Closed" name="No" sourceRef="RetryPayment" targetRef="Closed" />
    <bpmn:sequenceFlow id="Flow_PaymentOutcome_Confirm" name="Successful" sourceRef="PaymentOutcome" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_ProceedCheckout_DisplayDates" name="Yes" sourceRef="ProceedCheckout" targetRef="DisplayDates" />
    <bpmn:sequenceFlow id="Flow_DisplayDates_SelectDate" sourceRef="DisplayDates" targetRef="SelectDate" />
    <bpmn:sequenceFlow id="Flow_SelectDate_Review" sourceRef="SelectDate" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_ReceiveCompletion_Done" sourceRef="ReceiveCompletion" targetRef="Done" />
    <bpmn:task id="ReceiveDeliveryProgress" name="Receive Delivery Progress Notifications">
      <bpmn:documentation>The customer receives a notification for each progress update as delivery tracking continues.</bpmn:documentation>
    </bpmn:task>
    <bpmn:association id="Association_DeliveryProgressNotification" sourceRef="RecordCourier" targetRef="ReceiveDeliveryProgress" associationDirection="One" />
  </bpmn:process>
