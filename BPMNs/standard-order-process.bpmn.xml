<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_StandardOrderProcess" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_StandardOrderProcess">
    <bpmn:participant id="Participant_StandardOrderProcess" name="Standard Order Process" processRef="Process_StandardOrderProcess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StandardOrderProcess" name="Standard Order Process" isExecutable="false">
    <bpmn:documentation>Standard orders start when the customer selects Add to Cart. A confirmed payment sends the order to the bakery for preparation. The order is completed after pickup handoff or confirmed courier delivery.</bpmn:documentation>

    <bpmn:laneSet id="Lanes_StandardOrderProcess">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>SignedIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Admin or Eligible Staff">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fulfilled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Customer selects Add to Cart">
      <bpmn:outgoing>Flow_Start_SignedIn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="SignIn" name="Sign in and retry Add to Cart">
      <bpmn:documentation>After signing in, return to the product and select Add to Cart again.</bpmn:documentation>
      <bpmn:incoming>Flow_SignedIn_SignIn</bpmn:incoming>
      <bpmn:outgoing>Flow_SignIn_Add</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Review" name="Review cart and choose pickup or delivery">
      <bpmn:documentation>Review the items and quantities, choose a fulfillment date, and provide a delivery address for courier delivery. Review the order total before proceeding to payment.</bpmn:documentation>
      <bpmn:incoming>Flow_Add_Review</bpmn:incoming>
      <bpmn:incoming>Flow_Issue_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Pay" name="Pay for the order">
      <bpmn:documentation>The customer can retry an unsuccessful payment if checkout is still available.</bpmn:documentation>
      <bpmn:incoming>Flow_Valid_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_PaymentOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="SignedIn" name="Signed in?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Start_SignedIn</bpmn:incoming>
      <bpmn:outgoing>Flow_SignedIn_SignIn</bpmn:outgoing>
      <bpmn:outgoing>Flow_SignedIn_Add</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Add" name="Add item to cart">
      <bpmn:incoming>Flow_SignedIn_Add</bpmn:incoming>
      <bpmn:incoming>Flow_SignIn_Add</bpmn:incoming>
      <bpmn:outgoing>Flow_Add_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Validate" name="Check cart, date, and delivery details">
      <bpmn:documentation>Check item availability, quantities, and prices. Check that the chosen date is open for orders and has enough capacity. For courier delivery, check that the address can be served and the delivery fee is current.</bpmn:documentation>
      <bpmn:incoming>Flow_Review_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Checkout valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Validate_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Issue</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Pay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Issue" name="Show checkout issue">
      <bpmn:documentation>The customer can revise the cart or fulfillment details and try again.</bpmn:documentation>
      <bpmn:incoming>Flow_Valid_Issue</bpmn:incoming>
      <bpmn:outgoing>Flow_Issue_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PaymentOutcome" name="Payment outcome?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Pay_PaymentOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentOutcome_Closed</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentOutcome_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Closed" name="Checkout closed">
      <bpmn:incoming>Flow_PaymentOutcome_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Confirm" name="Confirm order">
      <bpmn:incoming>Flow_PaymentOutcome_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Complete" name="Mark order completed">
      <bpmn:incoming>Flow_Fulfilled_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Order completed">
      <bpmn:incoming>Flow_Complete_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Prepare" name="Prepare order and mark it ready">
      <bpmn:incoming>Flow_Confirm_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Method</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Method" name="Fulfillment method?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Prepare_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Method_Pickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_Method_Delivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Pickup" name="Confirm pickup handoff">
      <bpmn:documentation>Record the customer's arrival and confirm that the order has been handed over.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Fulfilled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Delivery" name="Arrange and confirm courier delivery">
      <bpmn:documentation>An admin books the courier. Confirm delivery once the order has reached the customer.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Delivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Delivery_Fulfilled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Fulfilled" gatewayDirection="Converging">
      <bpmn:incoming>Flow_Pickup_Fulfilled</bpmn:incoming>
      <bpmn:incoming>Flow_Delivery_Fulfilled</bpmn:incoming>
      <bpmn:outgoing>Flow_Fulfilled_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Start_SignedIn" sourceRef="Start" targetRef="SignedIn" />
    <bpmn:sequenceFlow id="Flow_SignedIn_SignIn" name="No" sourceRef="SignedIn" targetRef="SignIn" />
    <bpmn:sequenceFlow id="Flow_SignedIn_Add" name="Yes" sourceRef="SignedIn" targetRef="Add" />
    <bpmn:sequenceFlow id="Flow_SignIn_Add" sourceRef="SignIn" targetRef="Add" />
    <bpmn:sequenceFlow id="Flow_Add_Review" sourceRef="Add" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Review_Validate" sourceRef="Review" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Valid" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_Issue" name="No" sourceRef="Valid" targetRef="Issue" />
    <bpmn:sequenceFlow id="Flow_Issue_Review" sourceRef="Issue" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Valid_Pay" name="Yes" sourceRef="Valid" targetRef="Pay" />
    <bpmn:sequenceFlow id="Flow_Pay_PaymentOutcome" sourceRef="Pay" targetRef="PaymentOutcome" />
    <bpmn:sequenceFlow id="Flow_PaymentOutcome_Closed" name="Canceled or expired" sourceRef="PaymentOutcome" targetRef="Closed" />
    <bpmn:sequenceFlow id="Flow_PaymentOutcome_Confirm" name="Confirmed" sourceRef="PaymentOutcome" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_Confirm_Prepare" sourceRef="Confirm" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_Method" sourceRef="Prepare" targetRef="Method" />
    <bpmn:sequenceFlow id="Flow_Method_Pickup" name="Pickup" sourceRef="Method" targetRef="Pickup" />
    <bpmn:sequenceFlow id="Flow_Method_Delivery" name="Courier delivery" sourceRef="Method" targetRef="Delivery" />
    <bpmn:sequenceFlow id="Flow_Pickup_Fulfilled" sourceRef="Pickup" targetRef="Fulfilled" />
    <bpmn:sequenceFlow id="Flow_Delivery_Fulfilled" sourceRef="Delivery" targetRef="Fulfilled" />
    <bpmn:sequenceFlow id="Flow_Fulfilled_Complete" sourceRef="Fulfilled" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_Done" sourceRef="Complete" targetRef="Done" />
  </bpmn:process>
