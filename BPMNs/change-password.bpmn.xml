<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ChangePassword" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_ChangePassword">
    <bpmn:participant id="Participant_ChangePassword" name="Change Password" processRef="Process_ChangePassword" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ChangePassword" name="Change Password" isExecutable="false">
    <bpmn:documentation>Signed-in customers, staff, and admins change their password with their current password and a new password. The system verifies the current password and checks that the new password meets policy and differs from the current password. Saving revokes existing sessions and prompts the user to sign in again.</bpmn:documentation>

    <bpmn:laneSet id="Lanes_ChangePassword">
      <bpmn:lane id="Lane_User" name="User (Customer, Staff, or Admin)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignedIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Password change requested">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Submit" name="Enter current and new passwords">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Validate current password and new password">
      <bpmn:incoming>Flow_Submit_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Allowed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Details valid?" gatewayDirection="Diverging" default="Flow_Allowed_Error">
      <bpmn:incoming>Flow_Check_Allowed</bpmn:incoming>
      <bpmn:outgoing>Flow_Allowed_Session</bpmn:outgoing>
      <bpmn:outgoing>Flow_Allowed_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Session" name="Save password and revoke sessions">
      <bpmn:incoming>Flow_Allowed_Session</bpmn:incoming>
      <bpmn:outgoing>Flow_Session_SignedIn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="SignedIn" name="Changed Password Successfully">
      <bpmn:incoming>Flow_Session_SignedIn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Error" name="Show password error">
      <bpmn:incoming>Flow_Allowed_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_Error_Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Retry" name="Retry?" gatewayDirection="Diverging" default="Flow_Retry_End">
      <bpmn:incoming>Flow_Error_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Submit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Change Password Cancelled">
      <bpmn:incoming>Flow_Retry_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="Start" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_Submit_Check" sourceRef="Submit" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Allowed" sourceRef="Check" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_Allowed_Session" name="Yes" sourceRef="Allowed" targetRef="Session" />
    <bpmn:sequenceFlow id="Flow_Session_SignedIn" sourceRef="Session" targetRef="SignedIn" />
    <bpmn:sequenceFlow id="Flow_Allowed_Error" sourceRef="Allowed" targetRef="Error" />
    <bpmn:sequenceFlow id="Flow_Error_Retry" sourceRef="Error" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_Retry_Submit" name="Yes" sourceRef="Retry" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_Retry_End" name="No" sourceRef="Retry" targetRef="End" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_ChangePassword">
    <bpmndi:BPMNPlane id="Plane_ChangePassword" bpmnElement="Collaboration_ChangePassword">
      <bpmndi:BPMNShape id="Shape_Participant_ChangePassword" bpmnElement="Participant_ChangePassword" isHorizontal="false">
        <dc:Bounds x="10" y="14" width="1054" height="727" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserLane" bpmnElement="Lane_User" isHorizontal="false">
        <dc:Bounds x="10" y="44" width="527" height="697" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SystemLane" bpmnElement="Lane_System" isHorizontal="false">
        <dc:Bounds x="537" y="44" width="527" height="697" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="208" y="103" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="255" y="101" width="108" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Submit" bpmnElement="Submit">
        <dc:Bounds x="149" y="234" width="153" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check">
        <dc:Bounds x="606" y="234" width="153" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Allowed" bpmnElement="Allowed" isMarkerVisible="true">
        <dc:Bounds x="658" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="571" y="408" width="82" height="22" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Session" bpmnElement="Session">
        <dc:Bounds x="847" y="384" width="153" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SignedIn" bpmnElement="SignedIn">
        <dc:Bounds x="906" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="863" y="642" width="122" height="33" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Error" bpmnElement="Error">
        <dc:Bounds x="606" y="604" width="153" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Retry" bpmnElement="Retry" isMarkerVisible="true">
        <dc:Bounds x="316" y="615" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="309" y="671" width="64" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End">
        <dc:Bounds x="323" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="284" y="424" width="114" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_Submit" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="226" y="139" />
        <di:waypoint x="226" y="234" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Submit_Check" bpmnElement="Flow_Submit_Check">
        <di:waypoint x="302" y="270" />
        <di:waypoint x="606" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Check_Allowed" bpmnElement="Flow_Check_Allowed">
        <di:waypoint x="683" y="306" />
        <di:waypoint x="683" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Allowed_Session" bpmnElement="Flow_Allowed_Session">
        <di:waypoint x="708" y="420" />
        <di:waypoint x="847" y="420" />
        <bpmndi:BPMNLabel><dc:Bounds x="758" y="399" width="31" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Session_SignedIn" bpmnElement="Flow_Session_SignedIn">
        <di:waypoint x="924" y="456" />
        <di:waypoint x="924" y="602" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Allowed_Error" bpmnElement="Flow_Allowed_Error">
        <di:waypoint x="683" y="445" />
        <di:waypoint x="683" y="604" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Error_Retry" bpmnElement="Flow_Error_Retry">
        <di:waypoint x="606" y="640" />
        <di:waypoint x="366" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Retry_Submit" bpmnElement="Flow_Retry_Submit">
        <di:waypoint x="316" y="640" />
        <di:waypoint x="100" y="640" />
        <di:waypoint x="100" y="270" />
        <di:waypoint x="149" y="270" />
        <bpmndi:BPMNLabel><dc:Bounds x="201" y="610" width="34" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Retry_End" bpmnElement="Flow_Retry_End">
        <di:waypoint x="341" y="615" />
        <di:waypoint x="341" y="498" />
        <bpmndi:BPMNLabel><dc:Bounds x="344" y="536" width="27" height="20" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
