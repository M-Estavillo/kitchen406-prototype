        <di:waypoint x="620" y="253" />
        <di:waypoint x="620" y="322" />
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="278.5" width="22" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Save_Mail" bpmnElement="Flow_Save_Mail">
        <di:waypoint x="891" y="228" />
        <di:waypoint x="924" y="228" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Mail_Sent" bpmnElement="Flow_Mail_Sent">
