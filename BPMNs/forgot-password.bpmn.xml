<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ForgotPassword" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_ForgotPassword">
    <bpmn:participant id="Participant_ForgotPassword" name="Forgot Password" processRef="Process_ForgotPassword" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ForgotPassword" name="Forgot Password" isExecutable="false">
    <bpmn:documentation>Customers who cannot sign in enter their account email. Only active customer accounts are eligible for the public recovery flow. The system issues a time-limited, single-use recovery code for an eligible account. A successful reset revokes existing sessions and opens Sign In. Signed-in password changes follow the separate Change Password process.</bpmn:documentation>

    <bpmn:laneSet id="Lanes_ForgotPassword">
      <bpmn:lane id="Lane_User" name="User (Customer, Staff, or Admin)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DetailsError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CodeError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Password recovery requested">
      <bpmn:outgoing>Flow_Start_Input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Input" name="Enter account email">
      <bpmn:incoming>Flow_Start_Input</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Input</bpmn:incoming>
      <bpmn:outgoing>Flow_Input_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validate" name="Check for active customer account">
      <bpmn:incoming>Flow_Input_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Ready" name="Account eligible?" gatewayDirection="Diverging" default="Flow_Ready_DetailsError">
      <bpmn:incoming>Flow_Validate_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Issue</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ready_DetailsError</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Issue" name="Issue password verification code with resend cooldown">
      <bpmn:incoming>Flow_Ready_Issue</bpmn:incoming>
      <bpmn:incoming>Flow_Action_Issue</bpmn:incoming>
      <bpmn:outgoing>Flow_Issue_Enter</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Enter" name="Enter code and confirm new password, or resend code">
      <bpmn:incoming>Flow_Issue_Enter</bpmn:incoming>
      <bpmn:incoming>Flow_CodeError_Enter</bpmn:incoming>
      <bpmn:outgoing>Flow_Enter_Action</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Action" name="Code action?" gatewayDirection="Diverging" default="Flow_Action_Cancel">
      <bpmn:incoming>Flow_Enter_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_Action_Apply</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Issue</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Apply" name="Check code and save the new password">
      <bpmn:incoming>Flow_Action_Apply</bpmn:incoming>
      <bpmn:outgoing>Flow_Apply_Applied</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Applied" name="Password saved?" gatewayDirection="Diverging" default="Flow_Applied_CodeError">
      <bpmn:incoming>Flow_Apply_Applied</bpmn:incoming>
      <bpmn:outgoing>Flow_Applied_Done</bpmn:outgoing>
      <bpmn:outgoing>Flow_Applied_CodeError</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Done" name="Sessions ended. Sign In opens.">
      <bpmn:incoming>Flow_Applied_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="DetailsError" name="Show account or email error">
      <bpmn:incoming>Flow_Ready_DetailsError</bpmn:incoming>
      <bpmn:outgoing>Flow_DetailsError_Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Retry" name="Try again?" gatewayDirection="Diverging" default="Flow_Retry_NoRequest">
      <bpmn:incoming>Flow_DetailsError_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Input</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_NoRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NoRequest" name="Request closed">
      <bpmn:incoming>Flow_Retry_NoRequest</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Cancel" name="Password unchanged">
      <bpmn:incoming>Flow_Action_Cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CodeError" name="Show code or password error">
      <bpmn:incoming>Flow_Applied_CodeError</bpmn:incoming>
      <bpmn:outgoing>Flow_CodeError_Enter</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Start_Input" sourceRef="Start" targetRef="Input" />
    <bpmn:sequenceFlow id="Flow_Input_Validate" sourceRef="Input" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Ready" sourceRef="Validate" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_Ready_Issue" name="Yes" sourceRef="Ready" targetRef="Issue" />
    <bpmn:sequenceFlow id="Flow_Ready_DetailsError" name="No" sourceRef="Ready" targetRef="DetailsError" />
    <bpmn:sequenceFlow id="Flow_DetailsError_Retry" sourceRef="DetailsError" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_Retry_Input" name="Retry" sourceRef="Retry" targetRef="Input" />
    <bpmn:sequenceFlow id="Flow_Retry_NoRequest" name="Close" sourceRef="Retry" targetRef="NoRequest" />
    <bpmn:sequenceFlow id="Flow_Issue_Enter" sourceRef="Issue" targetRef="Enter" />
    <bpmn:sequenceFlow id="Flow_Enter_Action" sourceRef="Enter" targetRef="Action" />
    <bpmn:sequenceFlow id="Flow_Action_Apply" name="Submit" sourceRef="Action" targetRef="Apply" />
    <bpmn:sequenceFlow id="Flow_Action_Issue" name="Resend after cooldown" sourceRef="Action" targetRef="Issue" />
    <bpmn:sequenceFlow id="Flow_Action_Cancel" name="Leave" sourceRef="Action" targetRef="Cancel" />
    <bpmn:sequenceFlow id="Flow_Apply_Applied" sourceRef="Apply" targetRef="Applied" />
    <bpmn:sequenceFlow id="Flow_Applied_Done" name="Yes" sourceRef="Applied" targetRef="Done" />
    <bpmn:sequenceFlow id="Flow_Applied_CodeError" name="No" sourceRef="Applied" targetRef="CodeError" />
    <bpmn:sequenceFlow id="Flow_CodeError_Enter" sourceRef="CodeError" targetRef="Enter" />
  </bpmn:process>

