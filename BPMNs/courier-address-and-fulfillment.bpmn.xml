<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_CourierAddressAndFulfillment" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_CourierAddressAndFulfillment">
    <bpmn:participant id="Participant_CourierAddressAndFulfillment" name="Courier Address and Fulfillment" processRef="Process_CourierAddressAndFulfillment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CourierAddressAndFulfillment" name="Courier Address and Fulfillment" isExecutable="false">
    <bpmn:documentation>Current SQLite v6 behavior for standard and subscription courier delivery. Quotation validates eligibility and returns signed fees. Booking, reconciliation, and tracking use the local simulator. Owner-managed cake delivery follows a separate design.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_CourierAddressAndFulfillment">
      <bpmn:lane id="Lane_0" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Address</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Kitchen406 System">
        <bpmn:flowNodeRef>Quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Snapshot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Admin or Eligible Staff">
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Track</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Customer chooses delivery">
      <bpmn:outgoing>Flow_Start_Address</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Address" name="Choose an address or manage saved addresses">
      <bpmn:documentation>The customer can save, edit, remove, or change the default address in their own address book.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Address</bpmn:incoming>
      <bpmn:outgoing>Flow_Address_Quote</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Quote" name="Check route and quote fees by date">
      <bpmn:documentation>Return a signed checkout quote tied to the address, dates, fees, and expiry. Standard checkout needs one date. Subscription checkout needs four.</bpmn:documentation>
      <bpmn:incoming>Flow_Address_Quote</bpmn:incoming>
      <bpmn:outgoing>Flow_Quote_Eligible</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Eligible" name="Usable quotation?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Quote_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible_Issue</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible_Snapshot</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Issue" name="Show address or quotation issue">
      <bpmn:incoming>Flow_Eligible_Issue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Snapshot" name="Validate quote and save checkout snapshot">
      <bpmn:documentation>The standard and subscription checkout flows persist their own address and fee snapshots. Quote failure or expiration returns the customer to obtain a fresh quotation.</bpmn:documentation>
      <bpmn:incoming>Flow_Eligible_Snapshot</bpmn:incoming>
      <bpmn:outgoing>Flow_Snapshot_Ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Ready" name="Prepare paid fulfillment and mark ready">
      <bpmn:incoming>Flow_Snapshot_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Book</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Book" name="Admin requests simulated booking">
      <bpmn:documentation>Only admins book or reconcile. Use an operation key and prevent duplicate active bookings.</bpmn:documentation>
      <bpmn:incoming>Flow_Ready_Book</bpmn:incoming>
      <bpmn:outgoing>Flow_Book_Result</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Result" name="Booking outcome?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Book_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_Result_Reconcile</bpmn:outgoing>
      <bpmn:outgoing>Flow_Result_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_Result_Track</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Reconcile" name="Admin reconciles pending booking">
      <bpmn:documentation>The admin checks the simulated result for a pending booking. It stays pending when the outcome is still unknown.</bpmn:documentation>
      <bpmn:incoming>Flow_Result_Reconcile</bpmn:incoming>
      <bpmn:outgoing>Flow_Reconcile_Resolved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Resolved" name="Reconciliation result?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Reconcile_Resolved</bpmn:incoming>
      <bpmn:outgoing>Flow_Resolved_Pending</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resolved_Retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_Resolved_Track</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Pending" name="Keep booking pending for later check">
      <bpmn:incoming>Flow_Resolved_Pending</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Retry" name="Booking failed or cancelled. Admin may retry.">
      <bpmn:incoming>Flow_Result_Retry</bpmn:incoming>
      <bpmn:incoming>Flow_Resolved_Retry</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Track" name="Track booked and in-transit updates">
      <bpmn:documentation>An admin or eligible staff member can record tracking updates. On a tracking error, the saved state is retained for retry.</bpmn:documentation>
      <bpmn:incoming>Flow_Result_Track</bpmn:incoming>
      <bpmn:incoming>Flow_Resolved_Track</bpmn:incoming>
      <bpmn:outgoing>Flow_Track_Done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Done" name="Record delivery and complete fulfillment">
      <bpmn:documentation>Persist the courier transition to delivered. Complete a standard order in StandardCourierDelivery or a subscription cycle in SubscriptionDelivery and write order status history.</bpmn:documentation>
      <bpmn:incoming>Flow_Track_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_Done_Delivered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Delivered" name="Delivery completed">
      <bpmn:incoming>Flow_Done_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Address" sourceRef="Start" targetRef="Address" />
    <bpmn:sequenceFlow id="Flow_Address_Quote" sourceRef="Address" targetRef="Quote" />
    <bpmn:sequenceFlow id="Flow_Quote_Eligible" sourceRef="Quote" targetRef="Eligible" />
    <bpmn:sequenceFlow id="Flow_Eligible_Issue" name="No" sourceRef="Eligible" targetRef="Issue" />
    <bpmn:sequenceFlow id="Flow_Eligible_Snapshot" name="Yes" sourceRef="Eligible" targetRef="Snapshot" />
    <bpmn:sequenceFlow id="Flow_Snapshot_Ready" name="Payment confirmed in checkout" sourceRef="Snapshot" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_Ready_Book" sourceRef="Ready" targetRef="Book" />
    <bpmn:sequenceFlow id="Flow_Book_Result" sourceRef="Book" targetRef="Result" />
    <bpmn:sequenceFlow id="Flow_Result_Reconcile" name="Unknown outcome" sourceRef="Result" targetRef="Reconcile" />
    <bpmn:sequenceFlow id="Flow_Result_Retry" name="Failed or cancelled" sourceRef="Result" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_Result_Track" name="Booked" sourceRef="Result" targetRef="Track" />
    <bpmn:sequenceFlow id="Flow_Reconcile_Resolved" sourceRef="Reconcile" targetRef="Resolved" />
    <bpmn:sequenceFlow id="Flow_Resolved_Pending" name="Still unknown" sourceRef="Resolved" targetRef="Pending" />
    <bpmn:sequenceFlow id="Flow_Resolved_Retry" name="Failed or cancelled" sourceRef="Resolved" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_Resolved_Track" name="Booked" sourceRef="Resolved" targetRef="Track" />
    <bpmn:sequenceFlow id="Flow_Track_Done" name="Delivered" sourceRef="Track" targetRef="Done" />
    <bpmn:sequenceFlow id="Flow_Done_Delivered" sourceRef="Done" targetRef="Delivered" />
  </bpmn:process>
