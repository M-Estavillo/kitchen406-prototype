<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SalesRevenue" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_SalesRevenue">
    <bpmn:participant id="Participant_SalesRevenue" name="Sales Revenue" processRef="Process_SalesRevenue" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SalesRevenue" name="Sales Revenue" isExecutable="false">
    <bpmn:documentation>Follow a confirmed order or scheduled subscription fulfillment through owner revenue allocation, or open Sales Analytics to review revenue independently.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_SalesRevenue">
      <bpmn:lane id="Lane_Team" name="Owner and Staff">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allocate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fulfill</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bakers" name="Preparing Owners">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Attribute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ShowSales</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Owner" name="Owner">
        <bpmn:flowNodeRef>ReviewStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenAnalytics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectFilters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewSales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ChangeFilters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Order ready for preparation">
      <bpmn:outgoing>Flow_Start_Open</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Open" name="Open order to start preparation">
      <bpmn:incoming>Flow_Start_Open</bpmn:incoming>
      <bpmn:outgoing>Flow_Open_Allocate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Allocate" name="Choose preparing owners and shares per item">
      <bpmn:documentation>Choose the baking owners who will prepare each item. One owner receives 100%. For two owners, the default is 50/50 and the shares can be adjusted. Staff can record the allocation.</bpmn:documentation>
      <bpmn:incoming>Flow_Open_Allocate</bpmn:incoming>
      <bpmn:outgoing>Flow_Allocate_Prepare</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Prepare" name="Prepare assigned items">
      <bpmn:incoming>Flow_Allocate_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Fulfill</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:task id="Fulfill" name="Fulfill order by pickup or delivery">
      <bpmn:documentation>The allocation can be edited before active courier booking or order completion. Active courier booking or completion locks the allocation.</bpmn:documentation>
      <bpmn:incoming>Flow_Prepare_Fulfill</bpmn:incoming>
      <bpmn:outgoing>Flow_Fulfill_Complete</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Complete" name="Pickup or delivery completed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Fulfill_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Pending</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_Record</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Pending" name="Order remains outside fulfilled sales">
      <bpmn:incoming>Flow_Complete_Pending</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Record" name="Record completed product sales">
      <bpmn:documentation>Use the fulfillment completion date and net product amounts. Exclude delivery fees. For a prepaid subscription, include only the product revenue assigned to the completed fulfillment.</bpmn:documentation>
      <bpmn:incoming>Flow_Complete_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_Attribute</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Attribute" name="Attribute revenue to preparing owners">
      <bpmn:documentation>Apply the saved owner percentages to each item's net product revenue. Sales Analytics shows these shares under Fulfilled sales. Historical completed items without an allocation appear as Unallocated.</bpmn:documentation>
      <bpmn:incoming>Flow_Record_Attribute</bpmn:incoming>
      <bpmn:outgoing>Flow_Attribute_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Revenue attributed to preparing owners">
      <bpmn:incoming>Flow_Attribute_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Open" sourceRef="Start" targetRef="Open" />
    <bpmn:sequenceFlow id="Flow_Prepare_Fulfill" sourceRef="Prepare" targetRef="Fulfill" />
    <bpmn:sequenceFlow id="Flow_Fulfill_Complete" sourceRef="Fulfill" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_Pending" sourceRef="Complete" targetRef="Pending" name="No" />
    <bpmn:sequenceFlow id="Flow_Complete_Record" sourceRef="Complete" targetRef="Record" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Record_Attribute" sourceRef="Record" targetRef="Attribute" />
    <bpmn:sequenceFlow id="Flow_Attribute_End" sourceRef="Attribute" targetRef="End" />
    <bpmn:startEvent id="ReviewStart" name="Sales review needed">
      <bpmn:outgoing>Flow_ReviewStart_OpenAnalytics</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="OpenAnalytics" name="Open Sales Analytics">
      <bpmn:incoming>Flow_ReviewStart_OpenAnalytics</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenAnalytics_SelectFilters</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SelectFilters" name="Choose period, sales basis and filters">
      <bpmn:documentation>The Owner can choose Recorded payments or Fulfilled sales and filter by product or order type. Fulfilled sales also supports filtering by preparing owner.</bpmn:documentation>
      <bpmn:incoming>Flow_ChangeFilters_SelectFilters</bpmn:incoming>
      <bpmn:incoming>Flow_OpenAnalytics_SelectFilters</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectFilters_ShowSales</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="ShowSales" name="Show sales and estimated profit">
      <bpmn:documentation>Recorded payments uses payment dates. Fulfilled sales uses completion dates and shows preparing-owner shares. Show an empty result when no sales match. Show estimated profit as unavailable when cost information is missing.</bpmn:documentation>
      <bpmn:incoming>Flow_SelectFilters_ShowSales</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowSales_ReviewSales</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="ReviewSales" name="Review sales results">
      <bpmn:incoming>Flow_ShowSales_ReviewSales</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewSales_ChangeFilters</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ChangeFilters" name="Change filters?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_ReviewSales_ChangeFilters</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeFilters_SelectFilters</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChangeFilters_ReviewEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ReviewEnd" name="Sales review complete">
      <bpmn:incoming>Flow_ChangeFilters_ReviewEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ReviewStart_OpenAnalytics" sourceRef="ReviewStart" targetRef="OpenAnalytics" />
    <bpmn:sequenceFlow id="Flow_ShowSales_ReviewSales" sourceRef="ShowSales" targetRef="ReviewSales" />
    <bpmn:sequenceFlow id="Flow_ReviewSales_ChangeFilters" sourceRef="ReviewSales" targetRef="ChangeFilters" />
    <bpmn:sequenceFlow id="Flow_ChangeFilters_SelectFilters" sourceRef="ChangeFilters" targetRef="SelectFilters" name="Yes" />
    <bpmn:sequenceFlow id="Flow_ChangeFilters_ReviewEnd" sourceRef="ChangeFilters" targetRef="ReviewEnd" name="No" />
    <bpmn:sequenceFlow id="Flow_Open_Allocate" sourceRef="Open" targetRef="Allocate" />
    <bpmn:sequenceFlow id="Flow_Allocate_Prepare" sourceRef="Allocate" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_OpenAnalytics_SelectFilters" sourceRef="OpenAnalytics" targetRef="SelectFilters" />
    <bpmn:sequenceFlow id="Flow_SelectFilters_ShowSales" sourceRef="SelectFilters" targetRef="ShowSales" />
  </bpmn:process>
