<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_PhysicalStockAdjustment" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_PhysicalStockAdjustment">
    <bpmn:participant id="Participant_PhysicalStockAdjustment" name="Physical Stock Adjustment" processRef="Process_PhysicalStockAdjustment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PhysicalStockAdjustment" name="Physical Stock Adjustment" isExecutable="false">
    <bpmn:documentation>Record the actual physical count of an existing material. The owner opens the material through Edit. Staff can use their inventory stock controls.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_PhysicalStockAdjustment">
      <bpmn:lane id="Lane_Operator" name="Owner or Staff">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reopen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Correction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Same</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prior</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Stock action opened">
      <bpmn:outgoing>Flow_Start_Enter</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Enter" name="Enter actual count, reason, and optional notes">
      <bpmn:incoming>Flow_Start_Enter</bpmn:incoming>
      <bpmn:incoming>Flow_Reopen_Enter</bpmn:incoming>
      <bpmn:incoming>Flow_Correction_Enter</bpmn:incoming>
      <bpmn:outgoing>Flow_Enter_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Reopen" name="Reopen the stock form">
      <bpmn:documentation>Reload the material and use the latest information before submitting.</bpmn:documentation>
      <bpmn:incoming>Flow_Outcome_Reopen</bpmn:incoming>
      <bpmn:outgoing>Flow_Reopen_Enter</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Check access, material, and version">
      <bpmn:documentation>Only an active authorized owner or staff member can submit. An archived material must be restored by an owner before stock is recorded. If the same operation already succeeded, return its saved result.</bpmn:documentation>
      <bpmn:incoming>Flow_Enter_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Outcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Outcome" name="Request state?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Check_Outcome</bpmn:incoming>
      <bpmn:outgoing>Flow_Outcome_Validate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Reopen</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Blocked</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_Prior</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Validate" name="Validate count and calculate difference">
      <bpmn:documentation>Check the physical count and allowed adjustment reason in the material’s base unit. Convert kilograms or liters where applicable.</bpmn:documentation>
      <bpmn:incoming>Flow_Outcome_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Input valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Validate_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Correction</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Same</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Correction" name="Show input error">
      <bpmn:documentation>Keep the entered values so the operator can correct them and resubmit or close the form.</bpmn:documentation>
      <bpmn:incoming>Flow_Valid_Correction</bpmn:incoming>
      <bpmn:outgoing>Flow_Correction_Enter</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Same" name="Count matches?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Valid_Same</bpmn:incoming>
      <bpmn:outgoing>Flow_Same_Save</bpmn:outgoing>
      <bpmn:outgoing>Flow_Same_NoChange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NoChange" name="Count already matches · no movement">
      <bpmn:incoming>Flow_Same_NoChange</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Save" name="Update stock and log signed adjustment">
      <bpmn:documentation>Record the quantity difference, reason, notes, and signed-in account. Update stock status and append the movement in the same transaction.</bpmn:documentation>
      <bpmn:incoming>Flow_Same_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Save_Success</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Success" name="Updated inventory shown">
      <bpmn:incoming>Flow_Save_Success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Blocked" name="Stock action blocked">
      <bpmn:incoming>Flow_Outcome_Blocked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Prior" name="Return saved result">
      <bpmn:incoming>Flow_Outcome_Prior</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Enter" sourceRef="Start" targetRef="Enter" />
    <bpmn:sequenceFlow id="Flow_Enter_Check" sourceRef="Enter" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Outcome" sourceRef="Check" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_Outcome_Validate" sourceRef="Outcome" targetRef="Validate" name="Current" />
    <bpmn:sequenceFlow id="Flow_Outcome_Reopen" sourceRef="Outcome" targetRef="Reopen" name="Stale" />
    <bpmn:sequenceFlow id="Flow_Reopen_Enter" sourceRef="Reopen" targetRef="Enter" />
    <bpmn:sequenceFlow id="Flow_Outcome_Blocked" sourceRef="Outcome" targetRef="Blocked" name="Archived / unauthorized" />
    <bpmn:sequenceFlow id="Flow_Outcome_Prior" sourceRef="Outcome" targetRef="Prior" name="Already saved" />
    <bpmn:sequenceFlow id="Flow_Validate_Valid" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_Correction" sourceRef="Valid" targetRef="Correction" name="No" />
    <bpmn:sequenceFlow id="Flow_Correction_Enter" sourceRef="Correction" targetRef="Enter" name="Correct and resubmit" />
    <bpmn:sequenceFlow id="Flow_Valid_Same" sourceRef="Valid" targetRef="Same" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Same_Save" sourceRef="Same" targetRef="Save" name="No" />
    <bpmn:sequenceFlow id="Flow_Same_NoChange" sourceRef="Same" targetRef="NoChange" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Save_Success" sourceRef="Save" targetRef="Success" />
  </bpmn:process>
