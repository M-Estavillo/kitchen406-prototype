<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_InventoryProcess" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="InventoryCollaboration">
    <bpmn:participant id="InventoryPool" name="Inventory Process" processRef="InventoryProcess" />
  </bpmn:collaboration>
  <bpmn:process id="InventoryProcess" name="Inventory Process" isExecutable="false">
    <bpmn:laneSet id="InventoryLanes">
      <bpmn:lane id="Lane_Admin" name="Owner/Staff">
        <bpmn:flowNodeRef>Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveLow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AddMaterial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectMaterialUnits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Materials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Shortage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DisplayUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyShortage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Low</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DisplayLow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Updated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>OrderStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Place</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Continue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Settled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Open" name="Open Inventory">
      <bpmn:outgoing>Flow_Open_Access</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Access" name="Signed in as Owner/Staff?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Open_Access</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_Denied</bpmn:outgoing>
      <bpmn:outgoing>Flow_Access_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Denied" name="Access denied">
      <bpmn:incoming>Flow_Access_Denied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Review" name="Review materials and stock">
      <bpmn:incoming>Flow_Access_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Action</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Action" name="What inventory operation?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Review_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_Action_AddMaterial</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Materials</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Stock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Materials" name="Edit material details">
      <bpmn:documentation>Edit the details of an existing material.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Materials</bpmn:incoming>
      <bpmn:outgoing>Flow_Materials_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Stock" name="Restock material">
      <bpmn:documentation>Enter the quantity of material being restocked.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Stock</bpmn:incoming>
      <bpmn:outgoing>Flow_Stock_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join" gatewayDirection="Converging">
      <bpmn:incoming>Flow_SelectMaterialUnits_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Materials_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Stock_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Save" name="Update Inventory">
      <bpmn:incoming>Flow_Join_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Save_Updated</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Updated" name="Inventory updated">
      <bpmn:incoming>Flow_Save_Updated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="AddMaterial" name="Input name, stock, total cost, and reorder threshold">
      <bpmn:incoming>Flow_Action_AddMaterial</bpmn:incoming>
      <bpmn:outgoing>Flow_AddMaterial_SelectMaterialUnits</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SelectMaterialUnits" name="Select material category and unit of measurement">
      <bpmn:incoming>Flow_AddMaterial_SelectMaterialUnits</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectMaterialUnits_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Open_Access" sourceRef="Open" targetRef="Access" />
    <bpmn:sequenceFlow id="Flow_Access_Denied" sourceRef="Access" targetRef="Denied" name="No" />
    <bpmn:sequenceFlow id="Flow_Access_Review" sourceRef="Access" targetRef="Review" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Review_Action" sourceRef="Review" targetRef="Action" />
    <bpmn:sequenceFlow id="Flow_Save_Updated" sourceRef="Save" targetRef="Updated" />
    <bpmn:startEvent id="OrderStart" name="Customer starts an order">
      <bpmn:outgoing>Flow_OrderStart_Place</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Place" name="Place an order for a specific date">
      <bpmn:incoming>Flow_OrderStart_Place</bpmn:incoming>
      <bpmn:outgoing>Flow_Place_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Check" name="Check required materials and available stock">
      <bpmn:incoming>Flow_Place_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Available</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Available" name="Can stock be reserved?" gatewayDirection="Diverging">
      <bpmn:documentation>Required materials must be active, have defined quantities, and have enough available stock.</bpmn:documentation>
      <bpmn:incoming>Flow_Check_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_Available_Shortage</bpmn:outgoing>
      <bpmn:outgoing>Flow_Available_Low</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Shortage" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Available_Shortage</bpmn:incoming>
      <bpmn:outgoing>Flow_Shortage_DisplayUnavailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_Shortage_NotifyShortage</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="DisplayUnavailable" name="Display Item/s Unavailable Message">
      <bpmn:incoming>Flow_Shortage_DisplayUnavailable</bpmn:incoming>
    </bpmn:task>
    <bpmn:receiveTask id="ReceiveUnavailable" name="Receive Item/s Unavailable Notification">
      <bpmn:outgoing>Flow_ReceiveUnavailable_Unavailable</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Unavailable" name="Item/s Unavailable">
      <bpmn:incoming>Flow_ReceiveUnavailable_Unavailable</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="NotifyShortage" name="Notify Owner/Staff of Insufficient Stock">
      <bpmn:incoming>Flow_Shortage_NotifyShortage</bpmn:incoming>
    </bpmn:task>
    <bpmn:receiveTask id="Resolve" name="Receive Insufficient Stock Alert">
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Low" name="reorder threshold met?" gatewayDirection="Diverging">
      <bpmn:documentation>Check whether the reservation would leave available stock at or below the low-stock threshold.</bpmn:documentation>
      <bpmn:incoming>Flow_Available_Low</bpmn:incoming>
      <bpmn:outgoing>Flow_Low_DisplayLow</bpmn:outgoing>
      <bpmn:outgoing>Flow_Low_Reserve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="DisplayLow" name="Display Low-Stock Notification">
      <bpmn:incoming>Flow_Low_DisplayLow</bpmn:incoming>
    </bpmn:task>
    <bpmn:receiveTask id="ReceiveLow" name="Receive Low-Stock Alert">
      <bpmn:outgoing>Flow_ReceiveLow_Reserve</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Reserve" name="Update inventory count with reserved ingredients">
      <bpmn:documentation>Record the reservation and reduce the stock available for other orders.</bpmn:documentation>
      <bpmn:incoming>Flow_ReceiveLow_Reserve</bpmn:incoming>
      <bpmn:incoming>Flow_Low_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_Continue</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Continue" name="Continue Order Process">
      <bpmn:incoming>Flow_Reserve_Continue</bpmn:incoming>
      <bpmn:outgoing>Flow_Continue_Settled</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Settled" name="Order Placed Successfully">
      <bpmn:incoming>Flow_Continue_Settled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_OrderStart_Place" sourceRef="OrderStart" targetRef="Place" />
    <bpmn:sequenceFlow id="Flow_Place_Check" sourceRef="Place" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Available" sourceRef="Check" targetRef="Available" />
    <bpmn:sequenceFlow id="Flow_Available_Shortage" sourceRef="Available" targetRef="Shortage" name="No" />
    <bpmn:sequenceFlow id="Flow_Available_Low" sourceRef="Available" targetRef="Low" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Shortage_DisplayUnavailable" sourceRef="Shortage" targetRef="DisplayUnavailable" />
    <bpmn:sequenceFlow id="Flow_ReceiveUnavailable_Unavailable" sourceRef="ReceiveUnavailable" targetRef="Unavailable" />
    <bpmn:sequenceFlow id="Flow_Shortage_NotifyShortage" sourceRef="Shortage" targetRef="NotifyShortage" />
    <bpmn:sequenceFlow id="Flow_Low_DisplayLow" sourceRef="Low" targetRef="DisplayLow" name="Yes" />
    <bpmn:sequenceFlow id="Flow_ReceiveLow_Reserve" sourceRef="ReceiveLow" targetRef="Reserve" />
    <bpmn:sequenceFlow id="Flow_Low_Reserve" sourceRef="Low" targetRef="Reserve" name="No" />
    <bpmn:sequenceFlow id="Flow_Reserve_Continue" sourceRef="Reserve" targetRef="Continue" />
    <bpmn:sequenceFlow id="Flow_Continue_Settled" sourceRef="Continue" targetRef="Settled" />
    <bpmn:sequenceFlow id="Flow_Action_AddMaterial" sourceRef="Action" targetRef="AddMaterial" name="Add new material" />
    <bpmn:sequenceFlow id="Flow_Action_Materials" sourceRef="Action" targetRef="Materials" name="Edit Existing Material" />
    <bpmn:sequenceFlow id="Flow_Action_Stock" sourceRef="Action" targetRef="Stock" name="Update Stock" />
    <bpmn:sequenceFlow id="Flow_AddMaterial_SelectMaterialUnits" sourceRef="AddMaterial" targetRef="SelectMaterialUnits" />
    <bpmn:sequenceFlow id="Flow_SelectMaterialUnits_Join" sourceRef="SelectMaterialUnits" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Materials_Join" sourceRef="Materials" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Stock_Join" sourceRef="Stock" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Join_Save" sourceRef="Join" targetRef="Save" />
    <bpmn:association id="Association_NotifyShortage_Resolve" sourceRef="NotifyShortage" targetRef="Resolve" associationDirection="One" />
    <bpmn:association id="Association_DisplayUnavailable_ReceiveUnavailable" sourceRef="DisplayUnavailable" targetRef="ReceiveUnavailable" associationDirection="One" />
    <bpmn:association id="Association_DisplayLow_ReceiveLow" sourceRef="DisplayLow" targetRef="ReceiveLow" associationDirection="One" />
  </bpmn:process>
