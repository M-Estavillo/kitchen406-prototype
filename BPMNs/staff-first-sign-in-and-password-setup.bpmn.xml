<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_StaffSetup" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_StaffSetup">
    <bpmn:participant id="Participant_StaffSetup" name="Staff First Sign-In and Password Setup" processRef="Process_StaffSetup" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StaffSetup" name="Staff First Sign-In and Password Setup" isExecutable="false">
    <bpmn:documentation>This process begins once the staff member receives temporary credentials. Routine sign-in is covered by the general Sign In BPMN. The setup session grants access to password setup only. The new password must meet password rules and differ from the temporary password.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_StaffSetup">
      <bpmn:lane id="Lane_Staff" name="Staff Member">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pick</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prompt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Temporary credentials received">
      <bpmn:outgoing>Flow_Start_Enter</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Enter" name="Sign in with email and temporary password">
      <bpmn:incoming>Flow_Start_Enter</bpmn:incoming>
      <bpmn:outgoing>Flow_Enter_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Check credentials, account access, and setup status">
      <bpmn:incoming>Flow_Enter_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Allowed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Setup access allowed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Check_Allowed</bpmn:incoming>
      <bpmn:outgoing>Flow_Allowed_Prompt</bpmn:outgoing>
      <bpmn:outgoing>Flow_Allowed_Denied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Prompt" name="Open password setup">
      <bpmn:incoming>Flow_Allowed_Prompt</bpmn:incoming>
      <bpmn:outgoing>Flow_Prompt_Pick</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Pick" name="Enter and confirm a new password">
      <bpmn:incoming>Flow_Prompt_Pick</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Pick</bpmn:incoming>
      <bpmn:outgoing>Flow_Pick_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Validate" name="New password accepted?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Pick_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Complete</bpmn:outgoing>
      <bpmn:outgoing>Flow_Validate_Retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Complete" name="Save new password, complete setup, and remove temporary password">
      <bpmn:incoming>Flow_Validate_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Open</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Open" name="Staff workspace opens">
      <bpmn:incoming>Flow_Complete_Open</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Denied" name="Show sign-in or access error">
      <bpmn:incoming>Flow_Allowed_Denied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Retry" name="Show password error">
      <bpmn:incoming>Flow_Validate_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Pick</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Start_Enter" sourceRef="Start" targetRef="Enter" />
    <bpmn:sequenceFlow id="Flow_Enter_Check" sourceRef="Enter" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Allowed" sourceRef="Check" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_Allowed_Prompt" sourceRef="Allowed" targetRef="Prompt" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Allowed_Denied" sourceRef="Allowed" targetRef="Denied" name="No" />
    <bpmn:sequenceFlow id="Flow_Prompt_Pick" sourceRef="Prompt" targetRef="Pick" />
    <bpmn:sequenceFlow id="Flow_Pick_Validate" sourceRef="Pick" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Complete" sourceRef="Validate" targetRef="Complete" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Complete_Open" sourceRef="Complete" targetRef="Open" />
    <bpmn:sequenceFlow id="Flow_Validate_Retry" sourceRef="Validate" targetRef="Retry" name="No" />
    <bpmn:sequenceFlow id="Flow_Retry_Pick" sourceRef="Retry" targetRef="Pick" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_StaffSetup">
    <bpmndi:BPMNPlane id="Plane_StaffSetup" bpmnElement="Collaboration_StaffSetup">
      <bpmndi:BPMNShape id="Shape_Participant_StaffSetup" bpmnElement="Participant_StaffSetup" isHorizontal="true">
        <dc:Bounds x="30" y="20" width="1602" height="415" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Staff" bpmnElement="Lane_Staff" isHorizontal="true">
        <dc:Bounds x="60" y="20" width="1572" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="60" y="180" width="1572" height="255" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="112" y="77" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="58" y="118" width="144" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
