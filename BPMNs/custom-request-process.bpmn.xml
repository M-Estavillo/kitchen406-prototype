<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CustomRequestProcess" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_CustomRequestProcess">
    <bpmn:participant id="Participant_CustomRequestProcess" name="Custom Request Process" processRef="Process_CustomRequestProcess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CustomRequestProcess" name="Custom Request Process" isExecutable="false">
    <bpmn:documentation>High-level custom cake request process. Required-field validation is part of request creation and submission. The system provides pricing recommendations; the owner approves or changes the final quotation. Payment expiry permits an eligible retry after quotation and availability checks. Pickup or successful owner delivery triggers recorded completion and customer notification.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_CustomRequestProcess">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unpaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ResponseDeadline</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Estimate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyDecline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Expiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CalculateCost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LateQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Warning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Forfeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Forfeited</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Owner or Eligible Staff">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Possible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AddMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NeedMaterials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MarkReady</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Custom cake request started">
      <bpmn:outgoing>Flow_Start_Create</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Create" name="Create the custom cake request">
      <bpmn:documentation>Choose cake options, reference images, notes, requested date, and pickup or owner delivery details. Required details are validated within the request form.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Estimate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Estimate" name="Calculate preliminary cake estimate">
      <bpmn:documentation>Calculate an indicative estimate from the selected cake options. The final quotation is subject to owner review.</bpmn:documentation>
      <bpmn:incoming>Flow_Create_Estimate</bpmn:incoming>
      <bpmn:outgoing>Flow_Estimate_Submit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Submit" name="Review estimate and submit request">
      <bpmn:documentation>Sign in and submit the completed request. Form validation remains within this interaction rather than a separate process branch.</bpmn:documentation>
      <bpmn:incoming>Flow_Estimate_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Review" name="Assess design feasibility">
      <bpmn:incoming>Flow_Submit_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Possible</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Possible" name="Can the bakery fulfill the request?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Review_Possible</bpmn:incoming>
      <bpmn:outgoing>Flow_Possible_Decline</bpmn:outgoing>
      <bpmn:outgoing>Flow_Possible_NeedMaterials</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Decline" name="Decline request and record reason">
      <bpmn:incoming>Flow_Possible_Decline</bpmn:incoming>
      <bpmn:outgoing>Flow_Decline_NotifyDecline</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="NotifyDecline" name="Notify customer of declined request">
      <bpmn:documentation>Save the declined status and notify the customer. The recorded rejection reason is available in the request details.</bpmn:documentation>
      <bpmn:incoming>Flow_Decline_NotifyDecline</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyDecline_Rejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Rejected" name="Request declined">
      <bpmn:incoming>Flow_NotifyDecline_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Quote" name="Input final price and send quotation">
      <bpmn:documentation>The owner can keep or override the recommended cake price, include design charges and owner delivery fees, and issue the final design, date, price, and expiry. Quotation changes before acceptance are included in this task.</bpmn:documentation>
      <bpmn:incoming>Flow_CalculateCost_Quote</bpmn:incoming>
      <bpmn:outgoing>Flow_Quote_LateQuote</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Read" name="Review and respond to quotation">
      <bpmn:incoming>Flow_LateQuote_Read</bpmn:incoming>
      <bpmn:incoming>Flow_Warning_Read</bpmn:incoming>
      <bpmn:outgoing>Flow_Read_Accepted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Accepted" name="Accept or decline?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Read_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted_Closed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accepted_Pay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Closed" name="Quotation declined">
      <bpmn:incoming>Flow_Accepted_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Pay" name="Pay the full amount">
      <bpmn:documentation>Pay the full accepted quotation amount. Retry returns directly to this task; required payment and reservation checks are internal to checkout rather than separate high-level gateways.</bpmn:documentation>
      <bpmn:incoming>Flow_Accepted_Pay</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_Paid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Paid" name="Payment outcome?" gatewayDirection="Diverging">
      <bpmn:documentation>Summarizes the final payment result. Pending verification remains within payment processing; never offer another payment while verification is unresolved.</bpmn:documentation>
      <bpmn:incoming>Flow_Pay_Paid</bpmn:incoming>
      <bpmn:outgoing>Flow_Paid_Expiry</bpmn:outgoing>
      <bpmn:outgoing>Flow_Paid_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Expiry" name="Display unsuccessful payment message">
      <bpmn:documentation>Display an unsuccessful payment message, including payment-session expiry. The customer can choose whether to retry.</bpmn:documentation>
      <bpmn:incoming>Flow_Paid_Expiry</bpmn:incoming>
      <bpmn:outgoing>Flow_Expiry_Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Retry" name="Retry payment?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Expiry_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_Unpaid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Unpaid" name="Order canceled">
      <bpmn:incoming>Flow_Retry_Unpaid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Confirm" name="Confirm cake order and allocate ingredients">
      <bpmn:documentation>On successful full payment, confirm the order and its ingredient allocation by confirming the checkout ingredient reservation. Ingredients are temporarily held when checkout begins; payment confirms that allocation. Physical stock is deducted when preparation starts, not at payment or handoff.</bpmn:documentation>
      <bpmn:incoming>Flow_Paid_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Prepare" name="Prepare cake">
      <bpmn:documentation>Prepare the cake. Starting preparation consumes the allocated ingredients and records inventory movements. Marking Ready is modeled separately.</bpmn:documentation>
      <bpmn:incoming>Flow_Confirm_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_MarkReady</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Method" name="Pickup or owner delivery?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_NotifyReady_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Method_Pickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_Method_Delivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Pickup" name="Confirm bakery pickup">
      <bpmn:documentation>Record customer arrival where required and confirm successful pickup handoff.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Complete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Delivery" name="Deliver cake and confirm handoff">
      <bpmn:documentation>The owner manages delivery. Record completion only after successful handoff; failed handoffs remain unresolved.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Delivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Delivery_Complete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Complete" name="Mark order completed and record handoff">
      <bpmn:documentation>After either successful bakery pickup or owner delivery handoff, save the completed order status, handoff completion time, and status history. Ingredients were already consumed at preparation; no further deduction occurs here.</bpmn:documentation>
      <bpmn:incoming>Flow_Pickup_Complete</bpmn:incoming>
      <bpmn:incoming>Flow_Delivery_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_NotifyComplete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Receive" name="Receive order completed notification">
      <bpmn:incoming>Flow_NotifyComplete_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_Receive_Done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Done" name="Order completed">
      <bpmn:incoming>Flow_Receive_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="NotifyComplete" name="Notify customer of order completion">
      <bpmn:documentation>Send the customer an order completion notification after the completed status and handoff are recorded. This system response applies to both pickup and owner delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_Complete_NotifyComplete</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyComplete_Receive</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="AddMaterials" name="Add additional ingredient materials">
      <bpmn:documentation>The owner selects additional ingredients or materials and their quantities required by the custom design, if any, beyond the chosen cake options.</bpmn:documentation>
      <bpmn:incoming>Flow_NeedMaterials_AddMaterials</bpmn:incoming>
      <bpmn:outgoing>Flow_AddMaterials_CalculateCost</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CalculateCost" name="Calculate total cost and recommend cake price">
      <bpmn:documentation>Calculate ingredient and additional-material costs, labor based on recipe timing, and overhead, then apply the configured markup to recommend the cake selling price. The owner can use or override this recommendation when entering the final quotation price.</bpmn:documentation>
      <bpmn:incoming>Flow_NeedMaterials_CalculateCost</bpmn:incoming>
      <bpmn:incoming>Flow_AddMaterials_CalculateCost</bpmn:incoming>
      <bpmn:outgoing>Flow_CalculateCost_Quote</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="NeedMaterials" name="Add additional ingredient materials?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Possible_NeedMaterials</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedMaterials_AddMaterials</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedMaterials_CalculateCost</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="LateQuote" name="Quotation sent over 48 hours after request?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Quote_LateQuote</bpmn:incoming>
      <bpmn:outgoing>Flow_LateQuote_Warning</bpmn:outgoing>
      <bpmn:outgoing>Flow_LateQuote_Read</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Warning" name="Show warning about days remaining">
      <bpmn:documentation>When the quotation is sent more than 48 hours after request submission, show the number of days remaining until the requested fulfillment date. The customer still has 48 hours from quotation issuance to respond.</bpmn:documentation>
      <bpmn:incoming>Flow_LateQuote_Warning</bpmn:incoming>
      <bpmn:outgoing>Flow_Warning_Read</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Forfeit" name="Forfeit order and notify customer">
      <bpmn:documentation>If no response is recorded within 48 hours of quotation issuance, expire the unanswered quotation, forfeit the unpaid order opportunity, and notify the customer. A response after the deadline cannot accept this quotation.</bpmn:documentation>
      <bpmn:incoming>Flow_ResponseDeadline_Forfeit</bpmn:incoming>
      <bpmn:outgoing>Flow_Forfeit_Forfeited</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Forfeited" name="Order forfeited">
      <bpmn:incoming>Flow_Forfeit_Forfeited</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="MarkReady" name="Mark cake ready">
      <bpmn:incoming>Flow_Prepare_MarkReady</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkReady_NotifyReady</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="NotifyReady" name="Notify customer that cake is ready">
      <bpmn:documentation>Save the Ready status and send the customer a ready notification for pickup or owner delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_MarkReady_NotifyReady</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyReady_Method</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="ReceiveReady" name="Receive cake ready notification">
      </bpmn:task>
    <bpmn:boundaryEvent id="ResponseDeadline" name="48 hours without response" attachedToRef="Read" cancelActivity="true">
      <bpmn:documentation>The deadline starts when the quotation is sent, not when the request is submitted. The interrupting timer ends the waiting-for-response activity when the deadline passes.</bpmn:documentation>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_ResponseDeadline_Forfeit</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Start_Create" sourceRef="Start" targetRef="Create" />
    <bpmn:sequenceFlow id="Flow_Create_Estimate" sourceRef="Create" targetRef="Estimate" />
    <bpmn:sequenceFlow id="Flow_Estimate_Submit" sourceRef="Estimate" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_Submit_Review" sourceRef="Submit" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Review_Possible" sourceRef="Review" targetRef="Possible" />
    <bpmn:sequenceFlow id="Flow_Possible_Decline" sourceRef="Possible" targetRef="Decline" name="No" />
    <bpmn:sequenceFlow id="Flow_Decline_NotifyDecline" sourceRef="Decline" targetRef="NotifyDecline" />
    <bpmn:sequenceFlow id="Flow_NotifyDecline_Rejected" sourceRef="NotifyDecline" targetRef="Rejected" />
    <bpmn:sequenceFlow id="Flow_Possible_NeedMaterials" sourceRef="Possible" targetRef="NeedMaterials" name="Yes" />
    <bpmn:sequenceFlow id="Flow_NeedMaterials_AddMaterials" sourceRef="NeedMaterials" targetRef="AddMaterials" name="Yes" />
    <bpmn:sequenceFlow id="Flow_NeedMaterials_CalculateCost" sourceRef="NeedMaterials" targetRef="CalculateCost" name="No" />
    <bpmn:sequenceFlow id="Flow_AddMaterials_CalculateCost" sourceRef="AddMaterials" targetRef="CalculateCost" />
    <bpmn:sequenceFlow id="Flow_CalculateCost_Quote" sourceRef="CalculateCost" targetRef="Quote" />
    <bpmn:sequenceFlow id="Flow_Quote_LateQuote" sourceRef="Quote" targetRef="LateQuote" />
    <bpmn:sequenceFlow id="Flow_LateQuote_Warning" sourceRef="LateQuote" targetRef="Warning" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LateQuote_Read" sourceRef="LateQuote" targetRef="Read" name="No" />
    <bpmn:sequenceFlow id="Flow_Warning_Read" sourceRef="Warning" targetRef="Read" />
    <bpmn:sequenceFlow id="Flow_Read_Accepted" sourceRef="Read" targetRef="Accepted" />
    <bpmn:sequenceFlow id="Flow_ResponseDeadline_Forfeit" sourceRef="ResponseDeadline" targetRef="Forfeit" />
    <bpmn:sequenceFlow id="Flow_Forfeit_Forfeited" sourceRef="Forfeit" targetRef="Forfeited" />
    <bpmn:sequenceFlow id="Flow_Accepted_Closed" sourceRef="Accepted" targetRef="Closed" name="Declined" />
    <bpmn:sequenceFlow id="Flow_Accepted_Pay" sourceRef="Accepted" targetRef="Pay" name="Accepted" />
    <bpmn:sequenceFlow id="Flow_Pay_Paid" sourceRef="Pay" targetRef="Paid" />
    <bpmn:sequenceFlow id="Flow_Paid_Expiry" sourceRef="Paid" targetRef="Expiry" name="Unsuccessful" />
    <bpmn:sequenceFlow id="Flow_Paid_Confirm" sourceRef="Paid" targetRef="Confirm" name="Successful" />
    <bpmn:sequenceFlow id="Flow_Expiry_Retry" sourceRef="Expiry" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_Retry_Pay" sourceRef="Retry" targetRef="Pay" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Retry_Unpaid" sourceRef="Retry" targetRef="Unpaid" name="No" />
    <bpmn:sequenceFlow id="Flow_Confirm_Prepare" sourceRef="Confirm" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_MarkReady" sourceRef="Prepare" targetRef="MarkReady" />
    <bpmn:sequenceFlow id="Flow_MarkReady_NotifyReady" sourceRef="MarkReady" targetRef="NotifyReady" />
    <bpmn:sequenceFlow id="Flow_NotifyReady_Method" sourceRef="NotifyReady" targetRef="Method" />
    <bpmn:sequenceFlow id="Flow_Method_Pickup" sourceRef="Method" targetRef="Pickup" name="Pickup" />
    <bpmn:sequenceFlow id="Flow_Method_Delivery" sourceRef="Method" targetRef="Delivery" name="Owner delivery" />
    <bpmn:sequenceFlow id="Flow_Pickup_Complete" sourceRef="Pickup" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Delivery_Complete" sourceRef="Delivery" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_NotifyComplete" sourceRef="Complete" targetRef="NotifyComplete" />
    <bpmn:sequenceFlow id="Flow_NotifyComplete_Receive" sourceRef="NotifyComplete" targetRef="Receive" />
    <bpmn:sequenceFlow id="Flow_Receive_Done" sourceRef="Receive" targetRef="Done" />
    <bpmn:association id="Association_ReadyNotification" sourceRef="NotifyReady" targetRef="ReceiveReady" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CustomRequestProcess">
    <bpmndi:BPMNPlane id="Plane_CustomRequestProcess" bpmnElement="Collaboration_CustomRequestProcess">
      <bpmndi:BPMNShape id="Shape_Participant_CustomRequestProcess" bpmnElement="Participant_CustomRequestProcess" isHorizontal="false">
        <dc:Bounds x="17" y="15" width="1500" height="3050" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Customer" bpmnElement="Lane_Customer" isHorizontal="false">
        <dc:Bounds x="17" y="45" width="323" height="3020" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_System" bpmnElement="Lane_System" isHorizontal="false">
        <dc:Bounds x="340" y="45" width="610" height="3020" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Team" bpmnElement="Lane_Team" isHorizontal="false">
        <dc:Bounds x="950" y="45" width="567" height="3020" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
