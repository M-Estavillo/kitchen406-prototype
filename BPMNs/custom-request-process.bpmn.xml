        <dc:Bounds x="135" y="180" width="170" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Estimate" bpmnElement="Estimate">
        <dc:Bounds x="535" y="180" width="170" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Submit" bpmnElement="Submit">
        <dc:Bounds x="135" y="290" width="170" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Review">
        <dc:Bounds x="1060" y="290" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Possible" bpmnElement="Possible" isMarkerVisible="true">
        <dc:Bounds x="1131" y="420" width="48" height="48" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1075.0" y="380" width="160" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Decline" bpmnElement="Decline">
        <dc:Bounds x="1300" y="409" width="170" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NotifyDecline" bpmnElement="NotifyDecline">
        <dc:Bounds x="735" y="510" width="170" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Rejected" bpmnElement="Rejected">
        <dc:Bounds x="802" y="620" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="740.0" y="666" width="160" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NeedMaterials" bpmnElement="NeedMaterials" isMarkerVisible="true">
        <dc:Bounds x="1131" y="540" width="48" height="48" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1075.0" y="500" width="160" height="32" />
        </bpmndi:BPMNLabel>
