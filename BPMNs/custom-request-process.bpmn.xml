<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_CustomRequestProcess" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_CustomRequestProcess">
    <bpmn:participant id="Participant_CustomRequestProcess" name="Custom Request Process" processRef="Process_CustomRequestProcess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_CustomRequestProcess" name="Custom Request Process" isExecutable="false">
    <bpmn:documentation>This process covers custom cake requests from creation through quotation, full payment, preparation, and pickup or owner delivery.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_CustomRequestProcess">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unpaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Owner or Eligible Staff">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Possible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Custom cake request started">
      <bpmn:outgoing>Flow_Start_Create</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Create" name="Create the custom cake request">
      <bpmn:documentation>Choose cake options, add reference images and notes, and enter the requested date and pickup or delivery details.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Create</bpmn:incoming>
      <bpmn:incoming>Flow_Correct_Create</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Submit" name="Review the estimate and submit the request">
      <bpmn:documentation>Sign in before submitting the request.</bpmn:documentation>
      <bpmn:incoming>Flow_Create_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Check the request details">
      <bpmn:documentation>Check that the customer is signed in and that required details, reference images, and date are valid.</bpmn:documentation>
      <bpmn:incoming>Flow_Submit_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Request details valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Check_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Correct</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Review</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Correct" name="Show what needs to be corrected">
      <bpmn:incoming>Flow_Valid_Correct</bpmn:incoming>
      <bpmn:outgoing>Flow_Correct_Create</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Review the design, ingredients, and schedule">
      <bpmn:incoming>Flow_Valid_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Possible</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Possible" name="Can the bakery fulfill the request?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Review_Possible</bpmn:incoming>
      <bpmn:outgoing>Flow_Possible_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Possible_Quote</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Rejected" name="Request declined">
      <bpmn:documentation>The owner gives the customer a reason.</bpmn:documentation>
      <bpmn:incoming>Flow_Possible_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Quote" name="Send the final quotation">
      <bpmn:documentation>Include the agreed design, pickup or delivery date, final price, and any owner delivery fee. The owner can revise the quotation before acceptance.</bpmn:documentation>
      <bpmn:incoming>Flow_Possible_Quote</bpmn:incoming>
      <bpmn:outgoing>Flow_Quote_Read</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Read" name="Review and respond to the quotation">
      <bpmn:documentation>The customer can discuss changes with the bakery before accepting.</bpmn:documentation>
      <bpmn:incoming>Flow_Quote_Read</bpmn:incoming>
      <bpmn:outgoing>Flow_Read_Accepted</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Accepted" name="Quotation accepted before expiry?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Read_Accepted</bpmn:incoming>
      <bpmn:outgoing>Flow_Accepted_Closed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Accepted_Pay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Closed" name="Quotation closed">
      <bpmn:incoming>Flow_Accepted_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Pay" name="Pay the full amount">
      <bpmn:incoming>Flow_Accepted_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_Paid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Paid" name="Payment confirmed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Pay_Paid</bpmn:incoming>
      <bpmn:outgoing>Flow_Paid_Unpaid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Paid_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Unpaid" name="Checkout closed">
      <bpmn:documentation>If payment can still be retried, checkout remains open.</bpmn:documentation>
      <bpmn:incoming>Flow_Paid_Unpaid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Confirm" name="Confirm the custom cake order">
      <bpmn:documentation>Confirm the agreed date and availability before releasing the paid order for production.</bpmn:documentation>
      <bpmn:incoming>Flow_Paid_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Prepare" name="Prepare the cake and mark it ready">
      <bpmn:incoming>Flow_Confirm_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Method</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Method" name="Pickup or owner delivery?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Prepare_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Method_Pickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_Method_Delivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Pickup" name="Confirm bakery pickup">
      <bpmn:incoming>Flow_Method_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Delivery" name="Deliver the cake and confirm handoff">
      <bpmn:documentation>The owner handles delivery. If the handoff fails, record the reason and confirm completion only after a successful handoff.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Delivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Delivery_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Join" gatewayDirection="Converging">
      <bpmn:incoming>Flow_Pickup_Join</bpmn:incoming>
      <bpmn:incoming>Flow_Delivery_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Complete" name="Mark the order completed">
      <bpmn:incoming>Flow_Join_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Order completed">
      <bpmn:incoming>Flow_Complete_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Create" sourceRef="Start" targetRef="Create" />
    <bpmn:sequenceFlow id="Flow_Create_Submit" sourceRef="Create" targetRef="Submit" />
    <bpmn:sequenceFlow id="Flow_Submit_Check" sourceRef="Submit" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Valid" sourceRef="Check" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_Correct" name="No" sourceRef="Valid" targetRef="Correct" />
    <bpmn:sequenceFlow id="Flow_Correct_Create" sourceRef="Correct" targetRef="Create" />
    <bpmn:sequenceFlow id="Flow_Valid_Review" name="Yes" sourceRef="Valid" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Review_Possible" sourceRef="Review" targetRef="Possible" />
    <bpmn:sequenceFlow id="Flow_Possible_Rejected" name="No" sourceRef="Possible" targetRef="Rejected" />
    <bpmn:sequenceFlow id="Flow_Possible_Quote" name="Yes" sourceRef="Possible" targetRef="Quote" />
    <bpmn:sequenceFlow id="Flow_Quote_Read" sourceRef="Quote" targetRef="Read" />
    <bpmn:sequenceFlow id="Flow_Read_Accepted" sourceRef="Read" targetRef="Accepted" />
    <bpmn:sequenceFlow id="Flow_Accepted_Closed" name="Declined or expired" sourceRef="Accepted" targetRef="Closed" />
    <bpmn:sequenceFlow id="Flow_Accepted_Pay" name="Yes" sourceRef="Accepted" targetRef="Pay" />
    <bpmn:sequenceFlow id="Flow_Pay_Paid" sourceRef="Pay" targetRef="Paid" />
    <bpmn:sequenceFlow id="Flow_Paid_Unpaid" name="Canceled or expired" sourceRef="Paid" targetRef="Unpaid" />
    <bpmn:sequenceFlow id="Flow_Paid_Confirm" name="Yes" sourceRef="Paid" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_Confirm_Prepare" sourceRef="Confirm" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_Method" sourceRef="Prepare" targetRef="Method" />
    <bpmn:sequenceFlow id="Flow_Method_Pickup" name="Pickup" sourceRef="Method" targetRef="Pickup" />
    <bpmn:sequenceFlow id="Flow_Method_Delivery" name="Owner delivery" sourceRef="Method" targetRef="Delivery" />
    <bpmn:sequenceFlow id="Flow_Pickup_Join" sourceRef="Pickup" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Delivery_Join" sourceRef="Delivery" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Join_Complete" sourceRef="Join" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_Done" sourceRef="Complete" targetRef="Done" />
  </bpmn:process>
