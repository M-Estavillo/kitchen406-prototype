<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ProductSubscriptionProcess" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_ProductSubscriptionProcess">
    <bpmn:participant id="Participant_ProductSubscriptionProcess" name="Product Subscription Process" processRef="Process_ProductSubscriptionProcess" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProductSubscriptionProcess" name="Product Subscription Process" isExecutable="false">
    <bpmn:documentation>A product subscription covers four orders, normally scheduled one week apart, with one upfront payment. The customer chooses bakery pickup or courier delivery for all four orders. The subscription is completed after all four orders are picked up or delivered.</bpmn:documentation>

    <bpmn:laneSet id="Lanes_ProductSubscriptionProcess">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>ReceiveDeliveryProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveSubscriptionCompletion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectFulfillment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Configure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScheduleReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Regenerate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Failed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>ConfirmDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TrackCourier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SignedIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllFour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Expiry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Admin or Eligible Staff">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Delivery</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Subscription enrollment started">
      <bpmn:documentation>The customer begins subscription enrollment.</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_Select</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Select subscription product">
      <bpmn:incoming>Flow_Start_Select</bpmn:incoming>
      <bpmn:incoming>Flow_SignIn_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_SignedIn</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SignIn" name="Sign In to Continue">
      <bpmn:incoming>Flow_SignedIn_SignIn</bpmn:incoming>
      <bpmn:outgoing>Flow_SignIn_Select</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Configure" name="Choose a product variant and quantity">
      <bpmn:incoming>Flow_SignedIn_Configure</bpmn:incoming>
      <bpmn:outgoing>Flow_Configure_ScheduleReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ScheduleReview" name="View Subscription Schedule">
      <bpmn:documentation>Review the four scheduled dates.</bpmn:documentation>
      <bpmn:incoming>Flow_Configure_ScheduleReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ScheduleReview_SelectFulfillment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Pay" name="Pay for subscription total upfront">
      <bpmn:documentation>One payment covers all four orders and any applicable delivery fees.</bpmn:documentation>
      <bpmn:incoming>Flow_Regenerate_Pay</bpmn:incoming>
      <bpmn:incoming>Flow_Calculate_Pay</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_PaymentOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Regenerate" name="Retry payment?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Expiry_Regenerate</bpmn:incoming>
      <bpmn:outgoing>Flow_Regenerate_Pay</bpmn:outgoing>
      <bpmn:outgoing>Flow_Regenerate_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Failed" name="Subscription Failed">
      <bpmn:incoming>Flow_Regenerate_Failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="SignedIn" name="Signed in?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Select_SignedIn</bpmn:incoming>
      <bpmn:outgoing>Flow_SignedIn_SignIn</bpmn:outgoing>
      <bpmn:outgoing>Flow_SignedIn_Configure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="PaymentOutcome" name="Payment outcome?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Pay_PaymentOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentOutcome_Expiry</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentOutcome_Activate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activate" name="Activate the subscription and allocate ingredients">
      <bpmn:documentation>Allocate ingredients for the first scheduled order. Each scheduled order is already paid for. The customer can view the four orders in their subscription details.</bpmn:documentation>
      <bpmn:incoming>Flow_PaymentOutcome_Activate</bpmn:incoming>
      <bpmn:outgoing>Flow_Activate_Next</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Next" name="Wait until the next order is due for preparation">
      <bpmn:documentation>Follow the current scheduled date of the next order, including any approved rescheduling. This overview follows orders through successful pickup or delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_Activate_Next</bpmn:incoming>
      <bpmn:incoming>Flow_AllFour_Next</bpmn:incoming>
      <bpmn:outgoing>Flow_Next_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Record" name="Record order completion">
      <bpmn:documentation>Count each order after the pickup handoff or confirmed courier delivery.</bpmn:documentation>
      <bpmn:incoming>Flow_Pickup_Record</bpmn:incoming>
      <bpmn:incoming>Flow_ConfirmDelivery_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_AllFour</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="AllFour" name="All four orders completed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Record_AllFour</bpmn:incoming>
      <bpmn:outgoing>Flow_AllFour_ReceiveSubscriptionCompletion</bpmn:outgoing>
      <bpmn:outgoing>Flow_AllFour_Next</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Done" name="Subscription completed">
      <bpmn:documentation>The subscription completes when the fourth order is fulfilled. It does not renew automatically.</bpmn:documentation>
      <bpmn:incoming>Flow_ReceiveSubscriptionCompletion_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Calculate" name="Calculate order total and delivery fee if applicable">
      <bpmn:incoming>Flow_SelectFulfillment_Calculate</bpmn:incoming>
      <bpmn:outgoing>Flow_Calculate_Pay</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Expiry" name="Show Expiry Message">
      <bpmn:incoming>Flow_PaymentOutcome_Expiry</bpmn:incoming>
      <bpmn:outgoing>Flow_Expiry_Regenerate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Prepare" name="Prepare the scheduled order and mark it ready">
      <bpmn:documentation>Confirm ingredient availability before starting preparation. Keep the order scheduled if preparation must wait for ingredients.</bpmn:documentation>
      <bpmn:incoming>Flow_Next_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Method</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Method" name="Pickup or courier delivery?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Prepare_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Method_Pickup</bpmn:outgoing>
      <bpmn:outgoing>Flow_Method_Delivery</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Pickup" name="Handle the scheduled bakery pickup">
      <bpmn:documentation>Record the customer's arrival and confirm the handoff before recording the order as completed.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Pickup</bpmn:incoming>
      <bpmn:outgoing>Flow_Pickup_Record</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Delivery" name="Book courier delivery">
      <bpmn:documentation>An admin books the courier for the scheduled order.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Delivery</bpmn:incoming>
      <bpmn:outgoing>Flow_Delivery_TrackCourier</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_Start_Select" sourceRef="Start" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_Select_SignedIn" sourceRef="Select" targetRef="SignedIn" />
    <bpmn:sequenceFlow id="Flow_SignedIn_SignIn" name="No" sourceRef="SignedIn" targetRef="SignIn" />
    <bpmn:sequenceFlow id="Flow_SignIn_Select" sourceRef="SignIn" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_SignedIn_Configure" name="Yes" sourceRef="SignedIn" targetRef="Configure" />
    <bpmn:sequenceFlow id="Flow_Configure_ScheduleReview" sourceRef="Configure" targetRef="ScheduleReview" />
    <bpmn:sequenceFlow id="Flow_Pay_PaymentOutcome" sourceRef="Pay" targetRef="PaymentOutcome" />
    <bpmn:sequenceFlow id="Flow_PaymentOutcome_Expiry" name="Expired" sourceRef="PaymentOutcome" targetRef="Expiry" />
    <bpmn:sequenceFlow id="Flow_Expiry_Regenerate" sourceRef="Expiry" targetRef="Regenerate" />
    <bpmn:sequenceFlow id="Flow_Regenerate_Pay" name="Yes" sourceRef="Regenerate" targetRef="Pay" />
    <bpmn:sequenceFlow id="Flow_Regenerate_Failed" name="No" sourceRef="Regenerate" targetRef="Failed" />
    <bpmn:sequenceFlow id="Flow_PaymentOutcome_Activate" name="Confirmed" sourceRef="PaymentOutcome" targetRef="Activate" />
    <bpmn:sequenceFlow id="Flow_Activate_Next" sourceRef="Activate" targetRef="Next" />
    <bpmn:sequenceFlow id="Flow_Next_Prepare" sourceRef="Next" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_Method" sourceRef="Prepare" targetRef="Method" />
    <bpmn:sequenceFlow id="Flow_Method_Pickup" name="Pickup" sourceRef="Method" targetRef="Pickup" />
    <bpmn:sequenceFlow id="Flow_Method_Delivery" name="Courier delivery" sourceRef="Method" targetRef="Delivery" />
    <bpmn:sequenceFlow id="Flow_Record_AllFour" sourceRef="Record" targetRef="AllFour" />
    <bpmn:sequenceFlow id="Flow_AllFour_ReceiveSubscriptionCompletion" name="Yes" sourceRef="AllFour" targetRef="ReceiveSubscriptionCompletion" />
    <bpmn:sequenceFlow id="Flow_AllFour_Next" name="No" sourceRef="AllFour" targetRef="Next" />

    <bpmn:userTask id="SelectFulfillment" name="Select Available Fulfillment Method">
      <bpmn:documentation>The same fulfillment method applies to all four orders. For courier delivery, select a delivery address.</bpmn:documentation>
      <bpmn:incoming>Flow_ScheduleReview_SelectFulfillment</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectFulfillment_Calculate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="TrackCourier" name="Track courier delivery">
      <bpmn:documentation>Track courier progress and notify the customer when the courier is booked or the order goes in transit. Confirm delivery separately for each scheduled order.</bpmn:documentation>
      <bpmn:incoming>Flow_Delivery_TrackCourier</bpmn:incoming>
      <bpmn:outgoing>Flow_TrackCourier_ConfirmDelivery</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ConfirmDelivery" name="Confirm successful courier delivery">
      <bpmn:documentation>Confirm that the courier delivered the order before recording completion.</bpmn:documentation>
      <bpmn:incoming>Flow_TrackCourier_ConfirmDelivery</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmDelivery_Record</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ScheduleReview_SelectFulfillment" sourceRef="ScheduleReview" targetRef="SelectFulfillment" />
    <bpmn:sequenceFlow id="Flow_SelectFulfillment_Calculate" sourceRef="SelectFulfillment" targetRef="Calculate" />
    <bpmn:sequenceFlow id="Flow_Calculate_Pay" sourceRef="Calculate" targetRef="Pay" />
    <bpmn:sequenceFlow id="Flow_Pickup_Record" sourceRef="Pickup" targetRef="Record" />
    <bpmn:sequenceFlow id="Flow_Delivery_TrackCourier" sourceRef="Delivery" targetRef="TrackCourier" />
    <bpmn:sequenceFlow id="Flow_TrackCourier_ConfirmDelivery" sourceRef="TrackCourier" targetRef="ConfirmDelivery" />
    <bpmn:sequenceFlow id="Flow_ConfirmDelivery_Record" sourceRef="ConfirmDelivery" targetRef="Record" />
    <bpmn:task id="ReceiveDeliveryProgress" name="Receive Delivery Progress Notifications">
      <bpmn:documentation>The customer receives courier progress updates for each scheduled delivery.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="ReceiveSubscriptionCompletion" name="Receive subscription completed notification">
      <bpmn:incoming>Flow_AllFour_ReceiveSubscriptionCompletion</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveSubscriptionCompletion_Done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_ReceiveSubscriptionCompletion_Done" sourceRef="ReceiveSubscriptionCompletion" targetRef="Done" />
    <bpmn:association id="Association_DeliveryProgressNotification" sourceRef="TrackCourier" targetRef="ReceiveDeliveryProgress" associationDirection="One" />
    <bpmn:textAnnotation id="RescheduleNote">
      <bpmn:text>The customer can request to reschedule one order before its preparation day. The new date depends on availability, and the order stays prepaid.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Reschedule" sourceRef="Next" targetRef="RescheduleNote" />
  </bpmn:process>
