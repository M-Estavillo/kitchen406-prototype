      <bpmndi:BPMNEdge id="Edge_Flow_Configure_ScheduleReview" bpmnElement="Flow_Configure_ScheduleReview">
        <di:waypoint x="220" y="438" />
        <di:waypoint x="220" y="484" />
      </bpmndi:BPMNEdge>
