        <di:waypoint x="625" y="714" />
        <di:waypoint x="625" y="805" />
        <di:waypoint x="550" y="805" />
        <bpmndi:BPMNLabel><dc:Bounds x="553" y="780" width="58" height="17" /></bpmndi:BPMNLabel>
