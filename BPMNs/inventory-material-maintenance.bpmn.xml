<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_InventoryMaterialMaintenance" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_InventoryMaterialMaintenance">
    <bpmn:participant id="Participant_InventoryMaterialMaintenance" name="Inventory Material Maintenance" processRef="Process_InventoryMaterialMaintenance" />
  </bpmn:collaboration>
  <bpmn:process id="Process_InventoryMaterialMaintenance" name="Inventory Material Maintenance" isExecutable="false">
    <bpmn:documentation>The owner maintains ingredient and packaging records. Existing materials are opened through Edit on the inventory list. The material page also shows recipe usage, browser-session reservations, and movement history with type and date filters.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_InventoryMaterialMaintenance">
      <bpmn:lane id="Lane_Operator" name="Owner">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Lifecycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Correct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Opening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WithStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DetailsOnly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Saved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LifecycleCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LifecycleAllowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LifecycleSave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LifecycleDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LifecycleBlocked</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Inventory opened">
      <bpmn:outgoing>Flow_Start_Choose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Choose" name="Choose an inventory action">
      <bpmn:incoming>Flow_Start_Choose</bpmn:incoming>
      <bpmn:incoming>Flow_Invalid_Choose</bpmn:incoming>
      <bpmn:outgoing>Flow_Choose_Action</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Action" name="Action?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Choose_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_Action_Add</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Edit</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Lifecycle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Add" name="Enter new material details">
      <bpmn:documentation>Enter the name, type, base unit, threshold, opening quantity, and total opening cost.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Add</bpmn:incoming>
      <bpmn:outgoing>Flow_Add_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Edit" name="Edit existing material details">
      <bpmn:documentation>The form may lock the unit for a known material requirement. The SQLite edit API locks the unit after a movement or recipe use.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Edit</bpmn:incoming>
      <bpmn:outgoing>Flow_Edit_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Lifecycle" name="Select Archive, Restore, or Remove and confirm">
      <bpmn:documentation>Open the material details. Cancel closes the confirmation without making a change.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Lifecycle</bpmn:incoming>
      <bpmn:outgoing>Flow_Lifecycle_LifecycleCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validate" name="Check owner access, name, and form">
      <bpmn:documentation>Compare names without regard to capitalization across both ingredients and packaging. Check input values and edit version. Positive opening cost requires positive opening stock. A stale edit must be reopened.</bpmn:documentation>
      <bpmn:incoming>Flow_Add_Validate</bpmn:incoming>
      <bpmn:incoming>Flow_Edit_Validate</bpmn:incoming>
      <bpmn:incoming>Flow_Correct_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Details</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Details" name="Validation result?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Validate_Details</bpmn:incoming>
      <bpmn:outgoing>Flow_Details_Duplicate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Details_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Details_Opening</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Duplicate" name="Show duplicate-name error">
      <bpmn:documentation>Keep the submitted values and highlight that the name already exists.</bpmn:documentation>
      <bpmn:incoming>Flow_Details_Duplicate</bpmn:incoming>
      <bpmn:outgoing>Flow_Duplicate_Correct</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Invalid" name="Show what needs correction">
      <bpmn:documentation>Retain form values for invalid input. Ask the owner to reopen a stale form or sign in again if needed.</bpmn:documentation>
      <bpmn:incoming>Flow_Details_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid_Choose</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Opening" name="New material with opening stock?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Details_Opening</bpmn:incoming>
      <bpmn:outgoing>Flow_Opening_DetailsOnly</bpmn:outgoing>
      <bpmn:outgoing>Flow_Opening_WithStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="WithStock" name="Create material and record opening restock">
      <bpmn:documentation>Calculate opening cost per base unit. Save the material and its movement together in one transaction.</bpmn:documentation>
      <bpmn:incoming>Flow_Opening_WithStock</bpmn:incoming>
      <bpmn:outgoing>Flow_WithStock_Saved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DetailsOnly" name="Save material details">
      <bpmn:documentation>Create a zero-stock row or update the existing material. Recalculate stock status.</bpmn:documentation>
      <bpmn:incoming>Flow_Opening_DetailsOnly</bpmn:incoming>
      <bpmn:outgoing>Flow_DetailsOnly_Saved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Saved" name="Inventory details updated">
      <bpmn:incoming>Flow_DetailsOnly_Saved</bpmn:incoming>
      <bpmn:incoming>Flow_WithStock_Saved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="LifecycleCheck" name="Check lifecycle rules and record version">
      <bpmn:documentation>The server checks for zero physical stock and active SQLite reservations before archiving. Restore clears the archive date. Removal requires zero stock and no movement, recipe, or material requirement references.</bpmn:documentation>
      <bpmn:incoming>Flow_Lifecycle_LifecycleCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_LifecycleCheck_LifecycleAllowed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="LifecycleAllowed" name="Action allowed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_LifecycleCheck_LifecycleAllowed</bpmn:incoming>
      <bpmn:outgoing>Flow_LifecycleAllowed_LifecycleSave</bpmn:outgoing>
      <bpmn:outgoing>Flow_LifecycleAllowed_LifecycleBlocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="LifecycleSave" name="Archive, restore, or remove material">
      <bpmn:documentation>Archive sets the archive date and retains movement history and recipe links. Restore clears the archive date. Permanent removal is limited to unused materials.</bpmn:documentation>
      <bpmn:incoming>Flow_LifecycleAllowed_LifecycleSave</bpmn:incoming>
      <bpmn:outgoing>Flow_LifecycleSave_LifecycleDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="LifecycleDone" name="Inventory refreshed">
      <bpmn:incoming>Flow_LifecycleSave_LifecycleDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="LifecycleBlocked" name="Action blocked or form must be reopened">
      <bpmn:incoming>Flow_LifecycleAllowed_LifecycleBlocked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Correct" name="Correct the name and resubmit">
      <bpmn:documentation>The owner can correct the name in the current form or cancel.</bpmn:documentation>
      <bpmn:incoming>Flow_Duplicate_Correct</bpmn:incoming>
      <bpmn:outgoing>Flow_Correct_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Start_Choose" sourceRef="Start" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_Choose_Action" sourceRef="Choose" targetRef="Action" />
    <bpmn:sequenceFlow id="Flow_Action_Add" sourceRef="Action" targetRef="Add" name="Add" />
    <bpmn:sequenceFlow id="Flow_Action_Edit" sourceRef="Action" targetRef="Edit" name="Edit" />
    <bpmn:sequenceFlow id="Flow_Action_Lifecycle" sourceRef="Action" targetRef="Lifecycle" name="Archive / restore / remove" />
    <bpmn:sequenceFlow id="Flow_Add_Validate" sourceRef="Add" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Edit_Validate" sourceRef="Edit" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Details" sourceRef="Validate" targetRef="Details" />
    <bpmn:sequenceFlow id="Flow_Details_Duplicate" sourceRef="Details" targetRef="Duplicate" name="Duplicate name" />
    <bpmn:sequenceFlow id="Flow_Details_Invalid" sourceRef="Details" targetRef="Invalid" name="Invalid / stale" />
    <bpmn:sequenceFlow id="Flow_Invalid_Choose" sourceRef="Invalid" targetRef="Choose" name="Correct or reopen" />
    <bpmn:sequenceFlow id="Flow_Details_Opening" sourceRef="Details" targetRef="Opening" name="Valid" />
    <bpmn:sequenceFlow id="Flow_Opening_DetailsOnly" sourceRef="Opening" targetRef="DetailsOnly" name="No" />
    <bpmn:sequenceFlow id="Flow_Opening_WithStock" sourceRef="Opening" targetRef="WithStock" name="Yes" />
    <bpmn:sequenceFlow id="Flow_DetailsOnly_Saved" sourceRef="DetailsOnly" targetRef="Saved" />
    <bpmn:sequenceFlow id="Flow_WithStock_Saved" sourceRef="WithStock" targetRef="Saved" />
    <bpmn:sequenceFlow id="Flow_Lifecycle_LifecycleCheck" sourceRef="Lifecycle" targetRef="LifecycleCheck" />
    <bpmn:sequenceFlow id="Flow_LifecycleCheck_LifecycleAllowed" sourceRef="LifecycleCheck" targetRef="LifecycleAllowed" />
    <bpmn:sequenceFlow id="Flow_LifecycleAllowed_LifecycleSave" sourceRef="LifecycleAllowed" targetRef="LifecycleSave" name="Yes" />
    <bpmn:sequenceFlow id="Flow_LifecycleAllowed_LifecycleBlocked" sourceRef="LifecycleAllowed" targetRef="LifecycleBlocked" name="No" />
    <bpmn:sequenceFlow id="Flow_LifecycleSave_LifecycleDone" sourceRef="LifecycleSave" targetRef="LifecycleDone" />
    <bpmn:sequenceFlow id="Flow_Duplicate_Correct" sourceRef="Duplicate" targetRef="Correct" />
    <bpmn:sequenceFlow id="Flow_Correct_Validate" sourceRef="Correct" targetRef="Validate" />
  </bpmn:process>
