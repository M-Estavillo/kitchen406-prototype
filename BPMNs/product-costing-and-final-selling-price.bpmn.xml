<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ProductCostingAndFinalSellingPrice" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_ProductCostingAndFinalSellingPrice">
    <bpmn:participant id="Participant_ProductCostingAndFinalSellingPrice" name="Product Costing and Final Selling Price" processRef="Process_ProductCostingAndFinalSellingPrice" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProductCostingAndFinalSellingPrice" name="Product Costing and Final Selling Price" isExecutable="false">
    <bpmn:documentation>This workflow estimates production cost for one sellable pack. Products can have different recipes and selling prices for the 6-pack and 12-pack. Utility overhead is the browser default estimate or a stored variant override. The recommendation does not automatically change the selling price.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_ProductCostingAndFinalSellingPrice">
      <bpmn:lane id="Lane_Administrator" name="Administrator">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Inputs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Variant price needed">
      <bpmn:outgoing>Flow_Start_Select</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Open variant costing or pricing">
      <bpmn:incoming>Flow_Start_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_Inputs</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Inputs" name="Read recipe, material costs and settings">
      <bpmn:documentation>Read per-unit material costs, ingredient and packaging quantities, estimated utility overhead, and markup.</bpmn:documentation>
      <bpmn:incoming>Flow_Select_Inputs</bpmn:incoming>
      <bpmn:outgoing>Flow_Inputs_Complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Complete" name="Cost inputs complete?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Inputs_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Calculate</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_Unavailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Calculate" name="Show costs and recommended price">
      <bpmn:documentation>Sum ingredient and packaging costs and utility overhead. Apply the configured markup to the estimated production cost. Show the recommendation and estimated margin when available.</bpmn:documentation>
      <bpmn:incoming>Flow_Complete_Calculate</bpmn:incoming>
      <bpmn:outgoing>Flow_Calculate_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Unavailable" name="Show recommendation unavailable">
      <bpmn:documentation>Avoid treating missing recipe or cost inputs as zero. The owner can provide a final selling price, subject to the usual product and recipe save rules.</bpmn:documentation>
      <bpmn:incoming>Flow_Complete_Unavailable</bpmn:incoming>
      <bpmn:outgoing>Flow_Unavailable_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Review" name="Enter or confirm the final selling price">
      <bpmn:documentation>Review the recommendation if present. The administrator sets the final price for the selected variant.</bpmn:documentation>
      <bpmn:incoming>Flow_Calculate_Review</bpmn:incoming>
      <bpmn:incoming>Flow_Unavailable_Review</bpmn:incoming>
      <bpmn:incoming>Flow_Error_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validate" name="Validate final price">
      <bpmn:documentation>The selling price must be a positive amount. Check that the saved record has not changed.</bpmn:documentation>
      <bpmn:incoming>Flow_Review_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Price valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Validate_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Save</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Error" name="Show price error">
      <bpmn:incoming>Flow_Valid_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_Error_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Save" name="Record the final variant price">
      <bpmn:documentation>Commit the final price through the product editor and store it on ProductVariant. The catalog uses this saved value. Default markup and utility overhead are browser settings.</bpmn:documentation>
      <bpmn:incoming>Flow_Valid_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Save_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Final price recorded">
      <bpmn:incoming>Flow_Save_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Select" sourceRef="Start" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_Select_Inputs" sourceRef="Select" targetRef="Inputs" />
    <bpmn:sequenceFlow id="Flow_Inputs_Complete" sourceRef="Inputs" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_Calculate" sourceRef="Complete" targetRef="Calculate" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Complete_Unavailable" sourceRef="Complete" targetRef="Unavailable" name="No" />
    <bpmn:sequenceFlow id="Flow_Calculate_Review" sourceRef="Calculate" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Unavailable_Review" sourceRef="Unavailable" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_Review_Validate" sourceRef="Review" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Valid" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_Save" sourceRef="Valid" targetRef="Save" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Valid_Error" sourceRef="Valid" targetRef="Error" name="No" />
    <bpmn:sequenceFlow id="Flow_Error_Review" sourceRef="Error" targetRef="Review" name="Correct or reopen" />
    <bpmn:sequenceFlow id="Flow_Save_Done" sourceRef="Save" targetRef="Done" />
  </bpmn:process>
