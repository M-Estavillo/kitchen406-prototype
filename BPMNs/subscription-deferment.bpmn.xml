<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_SubscriptionDeferment" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_SubscriptionDeferment">
    <bpmn:participant id="Participant_SubscriptionDeferment" name="Subscription Deferment" processRef="Process_SubscriptionDeferment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SubscriptionDeferment" name="Subscription Deferment" isExecutable="false">
    <bpmn:documentation>Deferment allows a customer to move one scheduled subscription order to a later date. The system checks the order and the replacement date before approving the change.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_SubscriptionDeferment">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Week</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FailedMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllowanceUsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DatesUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DisplayDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Customer wants to defer an order">
      <bpmn:outgoing>Flow_Start_Request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Request" name="Select a scheduled subscription order to defer">
      <bpmn:incoming>Flow_Start_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Week</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Week" name="Select subscription week to defer">
      <bpmn:incoming>Flow_Request_Week</bpmn:incoming>
      <bpmn:outgoing>Flow_Week_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Check remaining deferment allowance">
      <bpmn:documentation>A customer has one deferment per subscription.</bpmn:documentation>
      <bpmn:incoming>Flow_Week_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Eligible</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Eligible" name="Deferment allowance unused?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Check_Eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible_AllowanceUsed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible_Availability</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AllowanceUsed" name="Display Deferment Allowance Used Message">
      <bpmn:incoming>Flow_Eligible_AllowanceUsed</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Availability" name="Check If Dates Available for Deferment">
      <bpmn:documentation>Check that the signed-in customer owns the active subscription, the selected order is still scheduled, and its preparation day has not arrived. Check the date cutoff, blocked dates, and capacity for each replacement option.</bpmn:documentation>
      <bpmn:incoming>Flow_Eligible_Availability</bpmn:incoming>
      <bpmn:outgoing>Flow_Availability_Available</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Available" name="Dates available?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Availability_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_Available_DatesUnavailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_Available_DisplayDates</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DatesUnavailable" name="Display Dates Unavailable Message">
      <bpmn:incoming>Flow_Available_DatesUnavailable</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="FailedMessage" name="Receive Deferment Failed Message">
      <bpmn:outgoing>Flow_FailedMessage_Failed</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Failed" name="Deferment Failed">
      <bpmn:incoming>Flow_FailedMessage_Failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="DisplayDates" name="Display Available Dates">
      <bpmn:documentation>Show the day after the selected order or one week after the last scheduled order, subject to availability.</bpmn:documentation>
      <bpmn:incoming>Flow_Available_DisplayDates</bpmn:incoming>
      <bpmn:outgoing>Flow_DisplayDates_Choose</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Choose" name="Select deferment date">
      <bpmn:incoming>Flow_DisplayDates_Choose</bpmn:incoming>
      <bpmn:outgoing>Flow_Choose_Approve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Approve" name="Approve deferment and update subscription schedule">
      <bpmn:documentation>Recheck eligibility and date availability before applying the change. Update the preparation date, keep the order prepaid, and notify the customer.</bpmn:documentation>
      <bpmn:incoming>Flow_Choose_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Deferment approved">
      <bpmn:incoming>Flow_Approve_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Request" sourceRef="Start" targetRef="Request" />
    <bpmn:sequenceFlow id="Flow_Request_Week" sourceRef="Request" targetRef="Week" />
    <bpmn:sequenceFlow id="Flow_Week_Check" sourceRef="Week" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Eligible" sourceRef="Check" targetRef="Eligible" />
    <bpmn:sequenceFlow id="Flow_Eligible_AllowanceUsed" name="No" sourceRef="Eligible" targetRef="AllowanceUsed" />
    <bpmn:sequenceFlow id="Flow_Eligible_Availability" name="Yes" sourceRef="Eligible" targetRef="Availability" />
    <bpmn:sequenceFlow id="Flow_Availability_Available" sourceRef="Availability" targetRef="Available" />
    <bpmn:sequenceFlow id="Flow_Available_DatesUnavailable" name="No" sourceRef="Available" targetRef="DatesUnavailable" />
    <bpmn:sequenceFlow id="Flow_FailedMessage_Failed" sourceRef="FailedMessage" targetRef="Failed" />
    <bpmn:sequenceFlow id="Flow_Available_DisplayDates" name="Yes" sourceRef="Available" targetRef="DisplayDates" />
    <bpmn:sequenceFlow id="Flow_DisplayDates_Choose" sourceRef="DisplayDates" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_Choose_Approve" sourceRef="Choose" targetRef="Approve" />
    <bpmn:sequenceFlow id="Flow_Approve_Done" sourceRef="Approve" targetRef="Done" />
    <bpmn:association id="Association_AllowanceUsed_FailedMessage" sourceRef="AllowanceUsed" targetRef="FailedMessage" associationDirection="One" />
    <bpmn:association id="Association_DatesUnavailable_FailedMessage" sourceRef="DatesUnavailable" targetRef="FailedMessage" associationDirection="One" />
  </bpmn:process>
