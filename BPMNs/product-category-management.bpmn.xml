<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ProductCategoryManagement" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_ProductCategoryManagement">
    <bpmn:participant id="Participant_ProductCategoryManagement" name="Product Category Management" processRef="Process_ProductCategoryManagement" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProductCategoryManagement" name="Product Category Management" isExecutable="false">
    <bpmn:documentation>Entry condition: an authorized administrator opens Manage categories from Products. Active categories appear in the customer Shop filter. Hiding a category removes its filter while its active products still appear under All Products. The standard and subscription checkout APIs currently reject products in hidden categories.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_ProductCategoryManagement">
      <bpmn:lane id="Lane_Administrator" name="Administrator">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Remove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Manage categories opened">
      <bpmn:outgoing>Flow_Start_Choose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Choose" name="Choose a category action">
      <bpmn:incoming>Flow_Start_Choose</bpmn:incoming>
      <bpmn:incoming>Flow_Blocked_Choose</bpmn:incoming>
      <bpmn:outgoing>Flow_Choose_Action</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Action" name="Which action?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Choose_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_Action_Change</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Remove</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Change" name="Add, rename, hide or show category">
      <bpmn:documentation>Enter the name or confirm the visibility change. Names must be unique regardless of capitalization.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Change</bpmn:incoming>
      <bpmn:outgoing>Flow_Change_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Remove" name="Request removal and confirm">
      <bpmn:incoming>Flow_Action_Remove</bpmn:incoming>
      <bpmn:outgoing>Flow_Remove_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Cancel" name="No change requested">
      <bpmn:incoming>Flow_Action_Cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Check" name="Check name, status or product assignments">
      <bpmn:documentation>Check owner access and the current version. For removal, check for any assigned product, including an inactive one. An assigned product must be reassigned before the category can be removed.</bpmn:documentation>
      <bpmn:incoming>Flow_Change_Check</bpmn:incoming>
      <bpmn:incoming>Flow_Remove_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Allowed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Change allowed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Check_Allowed</bpmn:incoming>
      <bpmn:outgoing>Flow_Allowed_Save</bpmn:outgoing>
      <bpmn:outgoing>Flow_Allowed_Blocked</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Blocked" name="Explain validation or removal block">
      <bpmn:documentation>The category stays as it was. Correct the name, reopen a stale form, or reassign all affected products before retrying removal.</bpmn:documentation>
      <bpmn:incoming>Flow_Allowed_Blocked</bpmn:incoming>
      <bpmn:outgoing>Flow_Blocked_Choose</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Save" name="Save change and update Shop filters">
      <bpmn:documentation>Commit the category change. Existing product labels follow a rename. Standard and subscription checkout require the product category to be active. A removed category disappears from administration and the Shop.</bpmn:documentation>
      <bpmn:incoming>Flow_Allowed_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Save_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Category list updated">
      <bpmn:incoming>Flow_Save_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Choose" sourceRef="Start" targetRef="Choose" />
    <bpmn:sequenceFlow id="Flow_Choose_Action" sourceRef="Choose" targetRef="Action" />
    <bpmn:sequenceFlow id="Flow_Action_Change" sourceRef="Action" targetRef="Change" name="Add / rename / visibility" />
    <bpmn:sequenceFlow id="Flow_Action_Remove" sourceRef="Action" targetRef="Remove" name="Remove" />
    <bpmn:sequenceFlow id="Flow_Action_Cancel" sourceRef="Action" targetRef="Cancel" name="Cancel" />
    <bpmn:sequenceFlow id="Flow_Change_Check" sourceRef="Change" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Remove_Check" sourceRef="Remove" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Allowed" sourceRef="Check" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_Allowed_Save" sourceRef="Allowed" targetRef="Save" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Allowed_Blocked" sourceRef="Allowed" targetRef="Blocked" name="No" />
    <bpmn:sequenceFlow id="Flow_Save_Done" sourceRef="Save" targetRef="Done" />
    <bpmn:sequenceFlow id="Flow_Blocked_Choose" sourceRef="Blocked" targetRef="Choose" name="Return to category list" />
  </bpmn:process>
