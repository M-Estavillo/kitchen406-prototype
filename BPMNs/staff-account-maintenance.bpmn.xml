<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_StaffMaintenance" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_StaffMaintenance">
    <bpmn:participant id="Participant_StaffMaintenance" name="Staff Account Maintenance" processRef="Process_StaffMaintenance" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StaffMaintenance" name="Staff Account Maintenance" isExecutable="false">
    <bpmn:documentation>Admins can edit the name or view and copy the temporary password only while the account is Pending. Pending email corrections are documented in a separate BPMN. Deactivation revokes sessions and blocks sign-in. Reactivated staff return to Pending if they have not completed setup, or Active if they have.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_StaffMaintenance">
      <bpmn:lane id="Lane_Admin" name="Admin / Owner">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Copy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PasswordDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Name</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Password</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NameDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AccessDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Staff account selected">
      <bpmn:outgoing>Flow_Start_Select</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Choose and submit a staff account action">
      <bpmn:incoming>Flow_Start_Select</bpmn:incoming>
      <bpmn:outgoing>Flow_Select_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Check admin access and validate the requested action">
      <bpmn:incoming>Flow_Select_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Allowed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Allowed" name="Action allowed?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Check_Allowed</bpmn:incoming>
      <bpmn:outgoing>Flow_Allowed_Type</bpmn:outgoing>
      <bpmn:outgoing>Flow_Allowed_Error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Type" name="Which action?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Allowed_Type</bpmn:incoming>
      <bpmn:outgoing>Flow_Type_Name</bpmn:outgoing>
      <bpmn:outgoing>Flow_Type_Access</bpmn:outgoing>
      <bpmn:outgoing>Flow_Type_Password</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Name" name="Save staff name">
      <bpmn:incoming>Flow_Type_Name</bpmn:incoming>
      <bpmn:outgoing>Flow_Name_NameDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Access" name="Set access status; revoke sessions if deactivated">
      <bpmn:incoming>Flow_Type_Access</bpmn:incoming>
      <bpmn:outgoing>Flow_Access_AccessDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Password" name="Show temporary password">
      <bpmn:incoming>Flow_Type_Password</bpmn:incoming>
      <bpmn:outgoing>Flow_Password_Copy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Error" name="Show error; no change">
      <bpmn:incoming>Flow_Allowed_Error</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="NameDone" name="Name updated">
      <bpmn:incoming>Flow_Name_NameDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="AccessDone" name="Access status updated">
      <bpmn:incoming>Flow_Access_AccessDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Copy" name="View or copy temporary password">
      <bpmn:incoming>Flow_Password_Copy</bpmn:incoming>
      <bpmn:outgoing>Flow_Copy_PasswordDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PasswordDone" name="Password action complete">
      <bpmn:incoming>Flow_Copy_PasswordDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Select" sourceRef="Start" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_Select_Check" sourceRef="Select" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_Check_Allowed" sourceRef="Check" targetRef="Allowed" />
    <bpmn:sequenceFlow id="Flow_Allowed_Type" sourceRef="Allowed" targetRef="Type" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Allowed_Error" sourceRef="Allowed" targetRef="Error" name="No" />
    <bpmn:sequenceFlow id="Flow_Type_Name" sourceRef="Type" targetRef="Name" name="Edit name" />
    <bpmn:sequenceFlow id="Flow_Type_Access" sourceRef="Type" targetRef="Access" name="Activate / Deactivate" />
    <bpmn:sequenceFlow id="Flow_Type_Password" sourceRef="Type" targetRef="Password" name="Temporary password" />
    <bpmn:sequenceFlow id="Flow_Name_NameDone" sourceRef="Name" targetRef="NameDone" />
    <bpmn:sequenceFlow id="Flow_Access_AccessDone" sourceRef="Access" targetRef="AccessDone" />
    <bpmn:sequenceFlow id="Flow_Password_Copy" sourceRef="Password" targetRef="Copy" />
    <bpmn:sequenceFlow id="Flow_Copy_PasswordDone" sourceRef="Copy" targetRef="PasswordDone" />
  </bpmn:process>
