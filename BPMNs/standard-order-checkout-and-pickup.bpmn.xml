<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_StandardCheckoutAndPickup" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_StandardCheckoutAndPickup">
    <bpmn:participant id="Participant_StandardCheckoutAndPickup" name="Standard Order Checkout and Pickup" processRef="Process_StandardCheckoutAndPickup" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StandardCheckoutAndPickup" name="Standard Order Checkout and Pickup" isExecutable="false">
    <bpmn:documentation>Current SQLite v6 flow for standard pickup and courier orders. Courier Address and Fulfillment covers address eligibility, quotation, booking, and delivery completion. Stock Validation and Reservation describes the shared stock rules.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_StandardCheckoutAndPickup">
      <bpmn:lane id="Lane_0" name="Customer">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Kitchen406 System">
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Consume</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Admin or Eligible Staff">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Courier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Arrival</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Ready to check out">
      <bpmn:outgoing>Flow_Start_Details</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Details" name="Select fulfillment method and date">
      <bpmn:incoming>Flow_Start_Details</bpmn:incoming>
      <bpmn:outgoing>Flow_Details_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validate" name="Validate checkout details">
      <bpmn:documentation>Recheck the Manila noon cutoff, blocked date, active product, variant and category, current prices, capacity, and available stock. For delivery, validate the server-signed quote against the address, date, and fee.</bpmn:documentation>
      <bpmn:incoming>Flow_Details_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Checkout valid?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Validate_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Hold</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Rejected" name="Show checkout issue">
      <bpmn:incoming>Flow_Valid_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Hold" name="Save order and hold resources">
      <bpmn:documentation>In one transaction save the order and item snapshots, requirements, held stock and capacity, checkout hold, and demo payment. For delivery, also persist the address and fee snapshot.</bpmn:documentation>
      <bpmn:incoming>Flow_Valid_Hold</bpmn:incoming>
      <bpmn:outgoing>Flow_Hold_Payment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Payment" name="Confirm or cancel demo payment">
      <bpmn:documentation>Payment confirmation is available for 30 minutes. The resource hold expires at 32 minutes.</bpmn:documentation>
      <bpmn:incoming>Flow_Hold_Payment</bpmn:incoming>
      <bpmn:outgoing>Flow_Payment_Paid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Paid" name="Payment outcome?" gatewayDirection="Diverging">
      <bpmn:documentation>When the payment window closes, confirmation is blocked. A pending checkout keeps its resource hold until cancellation or until the server processes hold expiry.</bpmn:documentation>
      <bpmn:incoming>Flow_Payment_Paid</bpmn:incoming>
      <bpmn:outgoing>Flow_Paid_Release</bpmn:outgoing>
      <bpmn:outgoing>Flow_Paid_Confirm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Release" name="Close checkout and release resources">
      <bpmn:incoming>Flow_Paid_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_Release_Closed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Closed" name="Checkout closed">
      <bpmn:incoming>Flow_Release_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Confirm" name="Record paid and confirm reservations">
      <bpmn:incoming>Flow_Paid_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirm_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Prepare" name="Start preparation">
      <bpmn:documentation>Preparation may start on or after the fulfillment date in Asia/Manila.</bpmn:documentation>
      <bpmn:incoming>Flow_Confirm_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Consume</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Consume" name="Consume reserved stock">
      <bpmn:documentation>Atomically write linked consumption movements, update stock, and enter Preparing. A stock conflict or an early request leaves the previous state available for retry.</bpmn:documentation>
      <bpmn:incoming>Flow_Prepare_Consume</bpmn:incoming>
      <bpmn:outgoing>Flow_Consume_Ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Ready" name="Mark order ready">
      <bpmn:incoming>Flow_Consume_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Method</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Method" name="Fulfillment method?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Ready_Method</bpmn:incoming>
      <bpmn:outgoing>Flow_Method_Courier</bpmn:outgoing>
      <bpmn:outgoing>Flow_Method_Arrival</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Courier" name="Ready for courier booking">
      <bpmn:incoming>Flow_Method_Courier</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Arrival" name="Record customer arrival">
      <bpmn:documentation>Accept arrival on the scheduled date through 7:00 p.m. Manila time.</bpmn:documentation>
      <bpmn:incoming>Flow_Method_Arrival</bpmn:incoming>
      <bpmn:outgoing>Flow_Arrival_Complete</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Complete" name="Confirm pickup handoff">
      <bpmn:incoming>Flow_Arrival_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Save</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Save" name="Record pickup completion and time">
      <bpmn:incoming>Flow_Complete_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Save_Done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Done" name="Pickup complete">
      <bpmn:incoming>Flow_Save_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Details" sourceRef="Start" targetRef="Details" />
    <bpmn:sequenceFlow id="Flow_Details_Validate" sourceRef="Details" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Valid" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_Rejected" name="No" sourceRef="Valid" targetRef="Rejected" />
    <bpmn:sequenceFlow id="Flow_Valid_Hold" name="Yes" sourceRef="Valid" targetRef="Hold" />
    <bpmn:sequenceFlow id="Flow_Hold_Payment" sourceRef="Hold" targetRef="Payment" />
    <bpmn:sequenceFlow id="Flow_Payment_Paid" sourceRef="Payment" targetRef="Paid" />
    <bpmn:sequenceFlow id="Flow_Paid_Release" name="Cancelled or hold expired" sourceRef="Paid" targetRef="Release" />
    <bpmn:sequenceFlow id="Flow_Release_Closed" sourceRef="Release" targetRef="Closed" />
    <bpmn:sequenceFlow id="Flow_Paid_Confirm" name="Confirmed before payment expiry" sourceRef="Paid" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_Confirm_Prepare" sourceRef="Confirm" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_Consume" sourceRef="Prepare" targetRef="Consume" />
    <bpmn:sequenceFlow id="Flow_Consume_Ready" sourceRef="Consume" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_Ready_Method" sourceRef="Ready" targetRef="Method" />
    <bpmn:sequenceFlow id="Flow_Method_Courier" name="Delivery" sourceRef="Method" targetRef="Courier" />
    <bpmn:sequenceFlow id="Flow_Method_Arrival" name="Pickup" sourceRef="Method" targetRef="Arrival" />
    <bpmn:sequenceFlow id="Flow_Arrival_Complete" sourceRef="Arrival" targetRef="Complete" />
    <bpmn:sequenceFlow id="Flow_Complete_Save" sourceRef="Complete" targetRef="Save" />
    <bpmn:sequenceFlow id="Flow_Save_Done" sourceRef="Save" targetRef="Done" />
  </bpmn:process>
