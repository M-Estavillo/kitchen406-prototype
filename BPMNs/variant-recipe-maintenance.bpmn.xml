        <di:waypoint x="566" y="130" />
        <di:waypoint x="614" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_Validate_di" bpmnElement="Flow_Submit_Validate">
        <di:waypoint x="690" y="163" />
        <di:waypoint x="690" y="395" />
        <di:waypoint x="764" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_Valid_di" bpmnElement="Flow_Validate_Valid">
        <di:waypoint x="916" y="395" />
        <di:waypoint x="997" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_Apply_di" bpmnElement="Flow_Valid_Apply">
        <di:waypoint x="1043" y="395" />
