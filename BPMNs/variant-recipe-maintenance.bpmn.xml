          <dc:Bounds x="1318" y="419" width="124" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Select_di" bpmnElement="Flow_Start_Select">
        <di:waypoint x="128" y="130" />
        <di:waypoint x="199" y="130" />
      </bpmndi:BPMNEdge>
