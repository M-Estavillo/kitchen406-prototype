<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_StockValidationAndReservation" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_StockValidationAndReservation">
    <bpmn:participant id="Participant_StockValidationAndReservation" name="Stock Validation and Reservation" processRef="Process_StockValidationAndReservation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_StockValidationAndReservation" name="Stock Validation and Reservation" isExecutable="false">
    <bpmn:documentation>SQLite reserves stock for standard pickup and delivery checkout and for subscription fulfillment. Checkout creates held reservations. Demo payment confirms the hold and its reservations, while cancellation or hold expiry closes them and releases the stock. Starting preparation consumes confirmed quantities and writes linked InventoryMovement rows in the same transaction. Subscription API activity checks later cycles once their reservation time is due, and starting preparation retries any remaining shortage. Accepted cake quotation reservations remain planned.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_StockValidationAndReservation">
      <bpmn:lane id="Lane_Operator" name="Calling Workflow">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Missing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Archived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Advisory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AdvisoryDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Stock check needed">
      <bpmn:outgoing>Flow_Start_Request</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Request" name="Request stock check or reservation">
      <bpmn:documentation>Pass the fulfillment or variant requirements and the requested mode.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Requirements</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Requirements" name="Resolve material requirements">
      <bpmn:documentation>Use the saved variant recipe for a new checkout or an OrderMaterialRequirement snapshot for existing fulfillment. Accepted quotation ingredients are part of the custom cake design.</bpmn:documentation>
      <bpmn:incoming>Flow_Request_Requirements</bpmn:incoming>
      <bpmn:outgoing>Flow_Requirements_Valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Requirements usable?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Requirements_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Mode</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Missing</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Archived</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Missing" name="Return missing recipe or requirement data">
      <bpmn:incoming>Flow_Valid_Missing</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Archived" name="Return archived material issue">
      <bpmn:incoming>Flow_Valid_Archived</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Mode" name="Reservation requested?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Valid_Mode</bpmn:incoming>
      <bpmn:outgoing>Flow_Mode_Advisory</bpmn:outgoing>
      <bpmn:outgoing>Flow_Mode_Reserve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Advisory" name="Check currently available stock">
      <bpmn:documentation>For server availability, subtract active held and unconsumed confirmed reservations from physical stock. Catalog availability is advisory and uses a physical stock snapshot. Checkout performs its own availability check.</bpmn:documentation>
      <bpmn:incoming>Flow_Mode_Advisory</bpmn:incoming>
      <bpmn:outgoing>Flow_Advisory_AdvisoryDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AdvisoryDone" name="Return advisory availability">
      <bpmn:incoming>Flow_Advisory_AdvisoryDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Reserve" name="Recheck stock and attempt reservation">
      <bpmn:documentation>Within one database transaction, recheck that materials are active and have sufficient unreserved stock. Reuse an existing applicable reservation, or write a held or confirmed reservation linked to CheckoutHold. An active hold supplies the expiry for a held reservation.</bpmn:documentation>
      <bpmn:incoming>Flow_Mode_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_Result</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Result" name="Reservation outcome?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Reserve_Result</bpmn:incoming>
      <bpmn:outgoing>Flow_Result_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Result_Unavailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_Result_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Success" name="Return reservation">
      <bpmn:incoming>Flow_Result_Success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Unavailable" name="Return shortage or inactive material">
      <bpmn:incoming>Flow_Result_Unavailable</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Failed" name="Return retryable save error">
      <bpmn:incoming>Flow_Result_Failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Request" sourceRef="Start" targetRef="Request" />
    <bpmn:sequenceFlow id="Flow_Request_Requirements" sourceRef="Request" targetRef="Requirements" />
    <bpmn:sequenceFlow id="Flow_Requirements_Valid" sourceRef="Requirements" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_Mode" sourceRef="Valid" targetRef="Mode" name="Usable" />
    <bpmn:sequenceFlow id="Flow_Valid_Missing" sourceRef="Valid" targetRef="Missing" name="Missing" />
    <bpmn:sequenceFlow id="Flow_Valid_Archived" sourceRef="Valid" targetRef="Archived" name="Archived" />
    <bpmn:sequenceFlow id="Flow_Mode_Advisory" sourceRef="Mode" targetRef="Advisory" name="No" />
    <bpmn:sequenceFlow id="Flow_Advisory_AdvisoryDone" sourceRef="Advisory" targetRef="AdvisoryDone" />
    <bpmn:sequenceFlow id="Flow_Mode_Reserve" sourceRef="Mode" targetRef="Reserve" name="Yes" />
    <bpmn:sequenceFlow id="Flow_Reserve_Result" sourceRef="Reserve" targetRef="Result" />
    <bpmn:sequenceFlow id="Flow_Result_Success" sourceRef="Result" targetRef="Success" name="Reserved / reused" />
    <bpmn:sequenceFlow id="Flow_Result_Unavailable" sourceRef="Result" targetRef="Unavailable" name="Unavailable" />
    <bpmn:sequenceFlow id="Flow_Result_Failed" sourceRef="Result" targetRef="Failed" name="Save failed" />
  </bpmn:process>
