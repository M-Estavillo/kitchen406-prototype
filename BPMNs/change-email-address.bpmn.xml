<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_ChangeEmailAddress" targetNamespace="https://kitchen406.example/bpmn">
  <bpmn:collaboration id="Collaboration_ChangeEmailAddress">
    <bpmn:participant id="Participant_ChangeEmailAddress" name="Change Email Address" processRef="Process_ChangeEmailAddress" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ChangeEmailAddress" name="Change Email Address" isExecutable="false">
    <bpmn:documentation>Customers, staff, and admins use this process while signed in. Staff must have completed initial setup. Check the current password and the proposed email. Send the code to the proposed address for customers and to the current address for staff and admins. Codes expire, are single-use, and can only be resent after the cooldown. Recheck availability when applying the change. The account keeps its ID and role.</bpmn:documentation>

    <bpmn:laneSet id="Lanes_ChangeEmailAddress">
      <bpmn:lane id="Lane_User" name="User (Customer, Staff, or Admin)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Kitchen406 System">
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Role</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IssueCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IssueTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DetailsError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CodeError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Email change requested">
      <bpmn:outgoing>Flow_Start_Input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Input" name="Enter new email and current password">
      <bpmn:incoming>Flow_Start_Input</bpmn:incoming>
      <bpmn:incoming>Flow_Action_Input</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Input</bpmn:incoming>
      <bpmn:outgoing>Flow_Input_Validate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validate" name="Check session, password, and new email">
      <bpmn:incoming>Flow_Input_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Ready" name="Details valid?" gatewayDirection="Diverging" default="Flow_Ready_DetailsError">
      <bpmn:incoming>Flow_Validate_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Role</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ready_DetailsError</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Role" name="Account role?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Ready_Role</bpmn:incoming>
      <bpmn:outgoing>Flow_Role_IssueCustomer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Role_IssueTeam</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IssueCustomer" name="Send code to proposed email">
      <bpmn:documentation>For customers, store the proposed address as both target_email and delivery_email.</bpmn:documentation>
      <bpmn:incoming>Flow_Role_IssueCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueCustomer_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="IssueTeam" name="Send code to current email">
      <bpmn:documentation>For staff and admins, store the proposed address as target_email and the current address as delivery_email.</bpmn:documentation>
      <bpmn:incoming>Flow_Role_IssueTeam</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueTeam_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Join" gatewayDirection="Converging">
      <bpmn:incoming>Flow_IssueCustomer_Join</bpmn:incoming>
      <bpmn:incoming>Flow_IssueTeam_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Enter</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Enter" name="Enter code or choose to resend">
      <bpmn:incoming>Flow_Join_Enter</bpmn:incoming>
      <bpmn:incoming>Flow_CodeError_Enter</bpmn:incoming>
      <bpmn:outgoing>Flow_Enter_Action</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Action" name="Code action?" gatewayDirection="Diverging" default="Flow_Action_Cancel">
      <bpmn:incoming>Flow_Enter_Action</bpmn:incoming>
      <bpmn:outgoing>Flow_Action_Apply</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Input</bpmn:outgoing>
      <bpmn:outgoing>Flow_Action_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Apply" name="Verify code and save new email if available">
      <bpmn:documentation>Validate the challenge for the signed-in account and recheck email uniqueness. Set email_verified_at for customers. Clear email_verified_at for staff and admins because their code was delivered to their current address.</bpmn:documentation>
      <bpmn:incoming>Flow_Action_Apply</bpmn:incoming>
      <bpmn:outgoing>Flow_Apply_Applied</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Applied" name="Email updated?" gatewayDirection="Diverging" default="Flow_Applied_CodeError">
      <bpmn:incoming>Flow_Apply_Applied</bpmn:incoming>
      <bpmn:outgoing>Flow_Applied_Done</bpmn:outgoing>
      <bpmn:outgoing>Flow_Applied_CodeError</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Done" name="Email address updated">
      <bpmn:incoming>Flow_Applied_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="DetailsError" name="Show why the request cannot proceed">
      <bpmn:incoming>Flow_Ready_DetailsError</bpmn:incoming>
      <bpmn:outgoing>Flow_DetailsError_Retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Retry" name="Try again?" gatewayDirection="Diverging" default="Flow_Retry_NoRequest">
      <bpmn:incoming>Flow_DetailsError_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Input</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retry_NoRequest</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NoRequest" name="Request closed">
      <bpmn:incoming>Flow_Retry_NoRequest</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Cancel" name="Current email retained">
      <bpmn:incoming>Flow_Action_Cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="CodeError" name="Show code or email availability error">
      <bpmn:incoming>Flow_Applied_CodeError</bpmn:incoming>
      <bpmn:outgoing>Flow_CodeError_Enter</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_Start_Input" sourceRef="Start" targetRef="Input" />
    <bpmn:sequenceFlow id="Flow_Input_Validate" sourceRef="Input" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_Validate_Ready" sourceRef="Validate" targetRef="Ready" />
    <bpmn:sequenceFlow id="Flow_Ready_Role" name="Yes" sourceRef="Ready" targetRef="Role" />
    <bpmn:sequenceFlow id="Flow_Ready_DetailsError" name="No" sourceRef="Ready" targetRef="DetailsError" />
    <bpmn:sequenceFlow id="Flow_DetailsError_Retry" sourceRef="DetailsError" targetRef="Retry" />
    <bpmn:sequenceFlow id="Flow_Retry_Input" name="Retry" sourceRef="Retry" targetRef="Input" />
    <bpmn:sequenceFlow id="Flow_Retry_NoRequest" name="Close" sourceRef="Retry" targetRef="NoRequest" />
    <bpmn:sequenceFlow id="Flow_Role_IssueCustomer" name="Customer" sourceRef="Role" targetRef="IssueCustomer" />
    <bpmn:sequenceFlow id="Flow_Role_IssueTeam" name="Staff or admin" sourceRef="Role" targetRef="IssueTeam" />
    <bpmn:sequenceFlow id="Flow_IssueCustomer_Join" sourceRef="IssueCustomer" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_IssueTeam_Join" sourceRef="IssueTeam" targetRef="Join" />
    <bpmn:sequenceFlow id="Flow_Join_Enter" sourceRef="Join" targetRef="Enter" />
    <bpmn:sequenceFlow id="Flow_Enter_Action" sourceRef="Enter" targetRef="Action" />
    <bpmn:sequenceFlow id="Flow_Action_Apply" name="Submit" sourceRef="Action" targetRef="Apply" />
    <bpmn:sequenceFlow id="Flow_Action_Input" name="Resend after cooldown" sourceRef="Action" targetRef="Input" />
    <bpmn:sequenceFlow id="Flow_Action_Cancel" name="Leave" sourceRef="Action" targetRef="Cancel" />
    <bpmn:sequenceFlow id="Flow_Apply_Applied" sourceRef="Apply" targetRef="Applied" />
    <bpmn:sequenceFlow id="Flow_Applied_Done" name="Yes" sourceRef="Applied" targetRef="Done" />
    <bpmn:sequenceFlow id="Flow_Applied_CodeError" name="No" sourceRef="Applied" targetRef="CodeError" />
    <bpmn:sequenceFlow id="Flow_CodeError_Enter" sourceRef="CodeError" targetRef="Enter" />
  </bpmn:process>

