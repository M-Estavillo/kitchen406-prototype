generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  account_id          String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  email               String                @unique
  password_hash       String
  first_name          String
  last_name           String
  role                String                @default("customer")
  status              String                @default("pending_verification")
  email_verified_at   DateTime?             @db.Timestamptz(6)
  password_changed_at DateTime?             @db.Timestamptz(6)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  AccountVerification AccountVerification[]
  AdminProfile        AdminProfile?
  CustomerProfile     CustomerProfile?
  InventoryMovement   InventoryMovement[]
  NotificationLog     NotificationLog[]
  OrderStatusHistory  OrderStatusHistory[]
  StaffProfile        StaffProfile?
}

model AdminProfile {
  admin_id             String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  account_id           String                 @unique
  Account              Account                @relation(fields: [account_id], references: [account_id], onUpdate: NoAction)
  BlockedDate          BlockedDate[]
  CakeAddon            CakeAddon[]
  CakeOption           CakeOption[]
  CapacityConfig       CapacityConfig[]
  CustomCakeQuotation  CustomCakeQuotation[]
  CustomerFeedback     CustomerFeedback[]
  PostDraft            PostDraft[]
  PricingConfig        PricingConfig[]
  SeasonalOccasion     SeasonalOccasion[]
  StaffProfile         StaffProfile[]
  SubscriptionSchedule SubscriptionSchedule[]
}

model StaffProfile {
  staff_id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  account_id           String       @unique
  is_temp_pass_changed Boolean      @default(false)
  created_by_admin_id  String
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @default(now()) @db.Timestamptz(6)
  Account              Account      @relation(fields: [account_id], references: [account_id], onUpdate: NoAction)
  AdminProfile         AdminProfile @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
}

model CustomerProfile {
  customer_id       String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  account_id        String              @unique
  mobile_number     String
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  Address           Address[]
  Cart              Cart?
  CustomCakeRequest CustomCakeRequest[]
  CustomerFeedback  CustomerFeedback[]
  Account           Account             @relation(fields: [account_id], references: [account_id], onUpdate: NoAction)
  Order             Order[]
  Subscription      Subscription[]
}

model AccountVerification {
  account_verification_id String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  account_id              String
  purpose                 String    @default("email_verification")
  otp_code_hash           String
  target_email            String?
  expires_at              DateTime  @default(now()) @db.Timestamptz(6)
  verified_at             DateTime? @db.Timestamptz(6)
  attempt_count           Int       @default(0)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  Account                 Account   @relation(fields: [account_id], references: [account_id], onUpdate: NoAction)
}

model Address {
  address_id        String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  customer_id       String
  label             String
  add_line_1        String
  add_line_2        String?
  city              String
  postal_code       String
  landmark          String?
  latitude          Decimal             @default(0) @db.Decimal(14, 4)
  longitude         Decimal             @default(0) @db.Decimal(14, 4)
  is_default        Boolean             @default(false)
  status            String              @default("active")
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  CustomerProfile   CustomerProfile     @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  CustomCakeRequest CustomCakeRequest[]
  Order             Order[]
  Subscription      Subscription[]
}

model Category {
  category_id   String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  category_name String    @unique
  status        String    @default("active")
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  Product       Product[]
}

model Product {
  product_id            String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  category_id           String
  name                  String
  description           String
  img_url               String
  subscription_eligible Boolean                @default(false)
  status                String                 @default("active")
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  CapacityAllocation    CapacityAllocation[]
  PostDraft             PostDraft[]
  Category              Category               @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)
  ProductVariant        ProductVariant[]
  SubscriptionSchedule  SubscriptionSchedule[]
}

model ProductVariant {
  variant_id       String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  product_id       String
  size             String
  final_price      Decimal        @default(0) @db.Decimal(14, 4)
  suggested_price  Decimal        @default(0) @db.Decimal(14, 4)
  utility_overhead Decimal?       @db.Decimal(14, 4)
  status           String         @default("available")
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  CartItem         CartItem[]
  OrderItem        OrderItem[]
  ProductBOM       ProductBOM[]
  Product          Product        @relation(fields: [product_id], references: [product_id], onUpdate: NoAction)
  Subscription     Subscription[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model PricingConfig {
  pricing_config_id        String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  default_utility_overhead Decimal      @default(0) @db.Decimal(14, 4)
  markup_percentage        Decimal      @default(0) @db.Decimal(14, 4)
  updated_by_admin_id      String
  created_at               DateTime     @default(now()) @db.Timestamptz(6)
  updated_at               DateTime     @default(now()) @db.Timestamptz(6)
  AdminProfile             AdminProfile @relation(fields: [updated_by_admin_id], references: [admin_id], onUpdate: NoAction)
}

model Inventory {
  inventory_id             String                     @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                     String
  unit                     String
  stock_on_hand            Decimal                    @default(0) @db.Decimal(14, 4)
  reorder_threshold        Decimal                    @default(0) @db.Decimal(14, 4)
  cost_per_unit            Decimal                    @default(0) @db.Decimal(14, 4)
  status                   String                     @default("available")
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  CakeAddonIngredient      CakeAddonIngredient[]
  CakeOptionIngredient     CakeOptionIngredient[]
  InventoryMovement        InventoryMovement[]
  OrderMaterialRequirement OrderMaterialRequirement[]
  ProductBOM               ProductBOM[]
}

model ProductBOM {
  product_bom_id    String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  variant_id        String
  inventory_id      String
  quantity_required Decimal        @default(0) @db.Decimal(14, 4)
  Inventory         Inventory      @relation(fields: [inventory_id], references: [inventory_id], onUpdate: NoAction)
  ProductVariant    ProductVariant @relation(fields: [variant_id], references: [variant_id], onUpdate: NoAction)

  @@unique([variant_id, inventory_id])
}

model Cart {
  cart_id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  customer_id     String          @unique
  subtotal        Decimal         @default(0) @db.Decimal(14, 4)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  CustomerProfile CustomerProfile @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  CartItem        CartItem[]
  Order           Order[]
}

model CartItem {
  cart_item_id   String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  cart_id        String
  variant_id     String
  quantity       Int
  added_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  Cart           Cart           @relation(fields: [cart_id], references: [cart_id], onUpdate: NoAction)
  ProductVariant ProductVariant @relation(fields: [variant_id], references: [variant_id], onUpdate: NoAction)

  @@unique([cart_id, variant_id])
}

model Order {
  order_id                                                          String                     @id @default(dbgenerated("(gen_random_uuid())::text"))
  customer_id                                                       String
  cart_id                                                           String?
  address_id                                                        String?
  address_snapshot                                                  Json?
  ref_number                                                        String                     @unique
  type                                                              String                     @default("standard_purchase")
  total                                                             Decimal                    @default(0) @db.Decimal(14, 4)
  amount_payable                                                    Decimal                    @default(0) @db.Decimal(14, 4)
  placed_at                                                         DateTime                   @default(now()) @db.Timestamptz(6)
  fulfillment_date                                                  DateTime?                  @db.Date
  fulfillment_method                                                String?
  status                                                            String                     @default("pending_payment")
  created_at                                                        DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                                        DateTime                   @default(now()) @db.Timestamptz(6)
  checkout_delivery_fee                                             Decimal                    @default(0) @db.Decimal(14, 4)
  CapacityAllocation_CapacityAllocation_fulfillment_order_idToOrder CapacityAllocation[]       @relation("CapacityAllocation_fulfillment_order_idToOrder")
  CapacityAllocation_CapacityAllocation_source_order_idToOrder      CapacityAllocation[]       @relation("CapacityAllocation_source_order_idToOrder")
  CheckoutHold                                                      CheckoutHold[]
  Delivery                                                          Delivery[]
  InventoryMovement                                                 InventoryMovement[]
  Address                                                           Address?                   @relation(fields: [address_id], references: [address_id], onDelete: Restrict, onUpdate: NoAction)
  Cart                                                              Cart?                      @relation(fields: [cart_id], references: [cart_id], onDelete: Restrict, onUpdate: NoAction)
  CustomerProfile                                                   CustomerProfile            @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  OrderItem                                                         OrderItem[]
  OrderMaterialRequirement                                          OrderMaterialRequirement[]
  OrderStatusHistory                                                OrderStatusHistory[]
  Payment                                                           Payment[]
  Subscription                                                      Subscription?
  SubscriptionDelivery                                              SubscriptionDelivery?

  @@index([customer_id], map: "order_customer")
}

model OrderStatusHistory {
  history_id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_id              String
  status                String
  changed_by_account_id String?
  changed_at            DateTime @default(now()) @db.Timestamptz(6)
  Account               Account? @relation(fields: [changed_by_account_id], references: [account_id], onDelete: Restrict, onUpdate: NoAction)
  Order                 Order    @relation(fields: [order_id], references: [order_id], onUpdate: NoAction)
}

model OrderItem {
  order_item_id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_id               String
  variant_id             String?
  quotation_id           String?              @unique
  quantity               Int
  unit_price_snapshot    Decimal              @default(0) @db.Decimal(14, 4)
  material_cost_snapshot Decimal              @default(0) @db.Decimal(14, 4)
  overhead_cost_snapshot Decimal              @default(0) @db.Decimal(14, 4)
  CustomerFeedback       CustomerFeedback?
  Order                  Order                @relation(fields: [order_id], references: [order_id], onUpdate: NoAction)
  CustomCakeQuotation    CustomCakeQuotation? @relation(fields: [quotation_id], references: [quotation_id], onDelete: Restrict, onUpdate: NoAction)
  ProductVariant         ProductVariant?      @relation(fields: [variant_id], references: [variant_id], onDelete: Restrict, onUpdate: NoAction)
}

model CheckoutHold {
  hold_id              String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_id             String
  status               String                 @default("active")
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  expires_at           DateTime               @default(now()) @db.Timestamptz(6)
  confirmed_at         DateTime?              @db.Timestamptz(6)
  released_at          DateTime?              @db.Timestamptz(6)
  CapacityAllocation   CapacityAllocation[]
  Order                Order                  @relation(fields: [order_id], references: [order_id], onUpdate: NoAction)
  InventoryReservation InventoryReservation[]
  Payment              Payment?
}

model Payment {
  payment_id      String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_id        String
  hold_id         String       @unique
  paymongo_id     String       @unique
  amount          Decimal      @default(0) @db.Decimal(14, 4)
  qr_img_url      String
  status          String       @default("pending")
  failure_code    String?
  failure_message String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  expires_at      DateTime     @default(now()) @db.Timestamptz(6)
  paid_at         DateTime?    @db.Timestamptz(6)
  CheckoutHold    CheckoutHold @relation(fields: [hold_id], references: [hold_id], onUpdate: NoAction)
  Order           Order        @relation(fields: [order_id], references: [order_id], onUpdate: NoAction)

  @@index([status], map: "payment_status")
}

model Delivery {
  delivery_id  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_id     String
  lalamove_id  String?   @unique
  longitude    Decimal   @default(0) @db.Decimal(14, 4)
  latitude     Decimal   @default(0) @db.Decimal(14, 4)
  fee          Decimal   @default(0) @db.Decimal(14, 4)
  status       String    @default("pending")
  delivered_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  Order        Order     @relation(fields: [order_id], references: [order_id], onUpdate: NoAction)
}

model CapacityConfig {
  capacity_config_id    String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_type            String               @unique @default("standard")
  max_varieties_per_day Int?
  max_cakes_per_week    Int?
  max_cakes_per_day     Int?
  max_units             Int?
  cutoff_time           String
  lead_time_value       Int
  lead_time_unit        String               @default("hours")
  created_by_admin_id   String
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @default(now()) @db.Timestamptz(6)
  CapacityAllocation    CapacityAllocation[]
  AdminProfile          AdminProfile         @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
}

model CapacityAllocation {
  allocation_id                                                                             String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  capacity_config_id                                                                        String
  product_id                                                                                String?
  source_order_id                                                                           String
  fulfillment_order_id                                                                      String?
  hold_id                                                                                   String?
  cycle_number                                                                              Int?
  fulfillment_date                                                                          DateTime                @db.Date
  quantity                                                                                  Int
  status                                                                                    String                  @default("held")
  expires_at                                                                                DateTime?               @db.Timestamptz(6)
  created_at                                                                                DateTime                @default(now()) @db.Timestamptz(6)
  released_at                                                                               DateTime?               @db.Timestamptz(6)
  CapacityConfig                                                                            CapacityConfig          @relation(fields: [capacity_config_id], references: [capacity_config_id], onUpdate: NoAction)
  Order_CapacityAllocation_fulfillment_order_idToOrder                                      Order?                  @relation("CapacityAllocation_fulfillment_order_idToOrder", fields: [fulfillment_order_id], references: [order_id], onDelete: Restrict, onUpdate: NoAction)
  CheckoutHold                                                                              CheckoutHold?           @relation(fields: [hold_id], references: [hold_id], onDelete: Restrict, onUpdate: NoAction)
  Product                                                                                   Product?                @relation(fields: [product_id], references: [product_id], onDelete: Restrict, onUpdate: NoAction)
  Order_CapacityAllocation_source_order_idToOrder                                           Order                   @relation("CapacityAllocation_source_order_idToOrder", fields: [source_order_id], references: [order_id], onUpdate: NoAction)
  SubscriptionDeferment_SubscriptionDeferment_original_allocation_idToCapacityAllocation    SubscriptionDeferment[] @relation("SubscriptionDeferment_original_allocation_idToCapacityAllocation")
  SubscriptionDeferment_SubscriptionDeferment_replacement_allocation_idToCapacityAllocation SubscriptionDeferment?  @relation("SubscriptionDeferment_replacement_allocation_idToCapacityAllocation")

  @@index([fulfillment_date, status], map: "allocations_date")
}

model BlockedDate {
  blocked_date_id     String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  date                DateTime     @unique @db.Date
  reason              String?
  created_by_admin_id String
  created_at          DateTime     @default(now()) @db.Timestamptz(6)
  AdminProfile        AdminProfile @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
}

model SubscriptionSchedule {
  schedule_id         String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  product_id          String?
  preparation_day     Int
  fulfillment_day     Int
  status              String         @default("active")
  created_by_admin_id String
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  Subscription        Subscription[]
  AdminProfile        AdminProfile   @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
  Product             Product?       @relation(fields: [product_id], references: [product_id], onDelete: Restrict, onUpdate: NoAction)
}

model Subscription {
  subscription_id       String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  customer_id           String
  variant_id            String
  purchase_order_id     String                 @unique
  address_id            String
  schedule_id           String
  quantity_per_delivery Int
  product_total         Decimal                @default(0) @db.Decimal(14, 4)
  delivery_fee_total    Decimal                @default(0) @db.Decimal(14, 4)
  total_price           Decimal                @default(0) @db.Decimal(14, 4)
  start_date            DateTime               @db.Date
  status                String                 @default("pending_payment")
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  Address               Address                @relation(fields: [address_id], references: [address_id], onUpdate: NoAction)
  CustomerProfile       CustomerProfile        @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  Order                 Order                  @relation(fields: [purchase_order_id], references: [order_id], onUpdate: NoAction)
  SubscriptionSchedule  SubscriptionSchedule   @relation(fields: [schedule_id], references: [schedule_id], onUpdate: NoAction)
  ProductVariant        ProductVariant         @relation(fields: [variant_id], references: [variant_id], onUpdate: NoAction)
  SubscriptionDeferment SubscriptionDeferment?
  SubscriptionDelivery  SubscriptionDelivery[]
}

model SubscriptionDelivery {
  subscription_delivery_id String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  subscription_id          String
  fulfillment_order_id     String                 @unique
  cycle_number             Int
  original_scheduled_date  DateTime               @db.Date
  scheduled_date           DateTime               @db.Date
  status                   String                 @default("scheduled")
  fulfilled_at             DateTime?              @db.Timestamptz(6)
  created_at               DateTime               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime               @default(now()) @db.Timestamptz(6)
  SubscriptionDeferment    SubscriptionDeferment?
  Order                    Order                  @relation(fields: [fulfillment_order_id], references: [order_id], onUpdate: NoAction)
  Subscription             Subscription           @relation(fields: [subscription_id], references: [subscription_id], onUpdate: NoAction)

  @@unique([subscription_id, cycle_number])
}

model SubscriptionDeferment {
  deferment_id                                                                           String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  subscription_id                                                                        String               @unique
  subscription_delivery_id                                                               String               @unique
  original_allocation_id                                                                 String
  replacement_allocation_id                                                              String               @unique
  original_scheduled_date                                                                DateTime             @db.Date
  new_scheduled_date                                                                     DateTime             @db.Date
  deferment_option                                                                       String               @default("next_week")
  created_at                                                                             DateTime             @default(now()) @db.Timestamptz(6)
  CapacityAllocation_SubscriptionDeferment_original_allocation_idToCapacityAllocation    CapacityAllocation   @relation("SubscriptionDeferment_original_allocation_idToCapacityAllocation", fields: [original_allocation_id], references: [allocation_id], onUpdate: NoAction)
  CapacityAllocation_SubscriptionDeferment_replacement_allocation_idToCapacityAllocation CapacityAllocation   @relation("SubscriptionDeferment_replacement_allocation_idToCapacityAllocation", fields: [replacement_allocation_id], references: [allocation_id], onUpdate: NoAction)
  SubscriptionDelivery                                                                   SubscriptionDelivery @relation(fields: [subscription_delivery_id], references: [subscription_delivery_id], onUpdate: NoAction)
  Subscription                                                                           Subscription         @relation(fields: [subscription_id], references: [subscription_id], onUpdate: NoAction)
}

model OrderMaterialRequirement {
  requirement_id       String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_id             String
  inventory_id         String
  quantity_required    Decimal                @default(0) @db.Decimal(14, 4)
  fulfillment_date     DateTime               @db.Date
  reserve_at           DateTime               @default(now()) @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  InventoryReservation InventoryReservation[]
  Inventory            Inventory              @relation(fields: [inventory_id], references: [inventory_id], onUpdate: NoAction)
  Order                Order                  @relation(fields: [order_id], references: [order_id], onUpdate: NoAction)

  @@unique([order_id, inventory_id])
  @@index([reserve_at], map: "requirements_due")
}

model InventoryReservation {
  reservation_id           String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  requirement_id           String
  hold_id                  String?
  quantity                 Decimal                  @db.Decimal(14, 4)
  status                   String                   @default("held")
  expires_at               DateTime?                @db.Timestamptz(6)
  created_at               DateTime                 @default(now()) @db.Timestamptz(6)
  consumed_at              DateTime?                @db.Timestamptz(6)
  released_at              DateTime?                @db.Timestamptz(6)
  InventoryMovement        InventoryMovement[]
  CheckoutHold             CheckoutHold?            @relation(fields: [hold_id], references: [hold_id], onDelete: Restrict, onUpdate: NoAction)
  OrderMaterialRequirement OrderMaterialRequirement @relation(fields: [requirement_id], references: [requirement_id], onUpdate: NoAction)
}

model InventoryMovement {
  movement_id             String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  inventory_id            String
  order_id                String?
  reservation_id          String?
  performed_by_account_id String?
  movement_type           String                @default("consumption")
  quantity_change         Decimal               @default(0) @db.Decimal(14, 4)
  unit_cost_snapshot      Decimal?              @db.Decimal(14, 4)
  reason                  String?
  notes                   String?
  operation_key           String                @unique
  occurred_at             DateTime              @default(now()) @db.Timestamptz(6)
  Inventory               Inventory             @relation(fields: [inventory_id], references: [inventory_id], onUpdate: NoAction)
  Order                   Order?                @relation(fields: [order_id], references: [order_id], onDelete: Restrict, onUpdate: NoAction)
  Account                 Account?              @relation(fields: [performed_by_account_id], references: [account_id], onDelete: Restrict, onUpdate: NoAction)
  InventoryReservation    InventoryReservation? @relation(fields: [reservation_id], references: [reservation_id], onDelete: Restrict, onUpdate: NoAction)
}

model CustomCakeRequest {
  custom_request_id                                                                String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  customer_id                                                                      String
  address_id                                                                       String?
  shape_option_id                                                                  String
  flavor_option_id                                                                 String
  size_option_id                                                                   String
  color_option_id                                                                  String
  icing_option_id                                                                  String
  accepted_quotation_id                                                            String?               @unique
  ref_number                                                                       String                @unique
  design_description                                                               String
  img_url                                                                          String?
  estimated_price                                                                  Decimal               @default(0) @db.Decimal(14, 4)
  requested_date                                                                   DateTime              @db.Date
  requested_delivery_window                                                        String                @default("morning")
  fulfillment_method                                                               String?
  status                                                                           String                @default("pending_review")
  created_at                                                                       DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                                                       DateTime              @default(now()) @db.Timestamptz(6)
  CakeRequestAddon                                                                 CakeRequestAddon[]
  CustomCakeQuotation_CustomCakeQuotation_custom_request_idToCustomCakeRequest     CustomCakeQuotation[] @relation("CustomCakeQuotation_custom_request_idToCustomCakeRequest")
  CustomCakeQuotation_CustomCakeRequest_accepted_quotation_idToCustomCakeQuotation CustomCakeQuotation?  @relation("CustomCakeRequest_accepted_quotation_idToCustomCakeQuotation", fields: [accepted_quotation_id], references: [quotation_id], onDelete: Restrict, onUpdate: NoAction)
  Address                                                                          Address?              @relation(fields: [address_id], references: [address_id], onDelete: Restrict, onUpdate: NoAction)
  CakeOption_CustomCakeRequest_color_option_idToCakeOption                         CakeOption            @relation("CustomCakeRequest_color_option_idToCakeOption", fields: [color_option_id], references: [option_id], onUpdate: NoAction)
  CustomerProfile                                                                  CustomerProfile       @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  CakeOption_CustomCakeRequest_flavor_option_idToCakeOption                        CakeOption            @relation("CustomCakeRequest_flavor_option_idToCakeOption", fields: [flavor_option_id], references: [option_id], onUpdate: NoAction)
  CakeOption_CustomCakeRequest_icing_option_idToCakeOption                         CakeOption            @relation("CustomCakeRequest_icing_option_idToCakeOption", fields: [icing_option_id], references: [option_id], onUpdate: NoAction)
  CakeOption_CustomCakeRequest_shape_option_idToCakeOption                         CakeOption            @relation("CustomCakeRequest_shape_option_idToCakeOption", fields: [shape_option_id], references: [option_id], onUpdate: NoAction)
  CakeOption_CustomCakeRequest_size_option_idToCakeOption                          CakeOption            @relation("CustomCakeRequest_size_option_idToCakeOption", fields: [size_option_id], references: [option_id], onUpdate: NoAction)
}

model CakeOption {
  option_id                                                        String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  created_by_admin_id                                              String
  option_type                                                      String                 @default("shape")
  scale_factor                                                     Decimal?               @db.Decimal(14, 4)
  option_name                                                      String
  price                                                            Decimal                @default(0) @db.Decimal(14, 4)
  status                                                           String                 @default("available")
  created_at                                                       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                                       DateTime               @default(now()) @db.Timestamptz(6)
  AdminProfile                                                     AdminProfile           @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
  CakeOptionIngredient                                             CakeOptionIngredient[]
  CustomCakeRequest_CustomCakeRequest_color_option_idToCakeOption  CustomCakeRequest[]    @relation("CustomCakeRequest_color_option_idToCakeOption")
  CustomCakeRequest_CustomCakeRequest_flavor_option_idToCakeOption CustomCakeRequest[]    @relation("CustomCakeRequest_flavor_option_idToCakeOption")
  CustomCakeRequest_CustomCakeRequest_icing_option_idToCakeOption  CustomCakeRequest[]    @relation("CustomCakeRequest_icing_option_idToCakeOption")
  CustomCakeRequest_CustomCakeRequest_shape_option_idToCakeOption  CustomCakeRequest[]    @relation("CustomCakeRequest_shape_option_idToCakeOption")
  CustomCakeRequest_CustomCakeRequest_size_option_idToCakeOption   CustomCakeRequest[]    @relation("CustomCakeRequest_size_option_idToCakeOption")
}

model CakeOptionIngredient {
  option_ingredient_id String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  option_id            String
  inventory_id         String
  quantity_required    Decimal    @default(0) @db.Decimal(14, 4)
  Inventory            Inventory  @relation(fields: [inventory_id], references: [inventory_id], onUpdate: NoAction)
  CakeOption           CakeOption @relation(fields: [option_id], references: [option_id], onUpdate: NoAction)

  @@unique([option_id, inventory_id])
}

model CakeAddon {
  addon_id            String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  created_by_admin_id String
  name                String
  price               Decimal               @default(0) @db.Decimal(14, 4)
  status              String                @default("available")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  AdminProfile        AdminProfile          @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
  CakeAddonIngredient CakeAddonIngredient[]
  CakeRequestAddon    CakeRequestAddon[]
}

model CakeAddonIngredient {
  addon_ingredient_id String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  addon_id            String
  inventory_id        String
  quantity_required   Decimal   @default(0) @db.Decimal(14, 4)
  CakeAddon           CakeAddon @relation(fields: [addon_id], references: [addon_id], onUpdate: NoAction)
  Inventory           Inventory @relation(fields: [inventory_id], references: [inventory_id], onUpdate: NoAction)

  @@unique([addon_id, inventory_id])
}

model CakeRequestAddon {
  cake_request_addon_id String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  custom_request_id     String
  addon_id              String
  quantity              Int
  CakeAddon             CakeAddon         @relation(fields: [addon_id], references: [addon_id], onUpdate: NoAction)
  CustomCakeRequest     CustomCakeRequest @relation(fields: [custom_request_id], references: [custom_request_id], onUpdate: NoAction)

  @@unique([custom_request_id, addon_id])
}

model CustomCakeQuotation {
  quotation_id                                                                   String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  custom_request_id                                                              String
  version_number                                                                 Int
  created_by_admin_id                                                            String
  fulfillment_date                                                               DateTime           @db.Date
  delivery_window                                                                String             @default("morning")
  fulfillment_method                                                             String             @default("pickup")
  address_snapshot                                                               Json?
  options_total                                                                  Decimal            @default(0) @db.Decimal(14, 4)
  addons_total                                                                   Decimal            @default(0) @db.Decimal(14, 4)
  complexity_charge                                                              Decimal            @default(0) @db.Decimal(14, 4)
  delivery_fee                                                                   Decimal            @default(0) @db.Decimal(14, 4)
  total                                                                          Decimal            @default(0) @db.Decimal(14, 4)
  status                                                                         String             @default("draft")
  issued_at                                                                      DateTime?          @db.Timestamptz(6)
  expires_at                                                                     DateTime?          @db.Timestamptz(6)
  accepted_at                                                                    DateTime?          @db.Timestamptz(6)
  created_at                                                                     DateTime           @default(now()) @db.Timestamptz(6)
  specification_snapshot                                                         Json               @default("{}")
  material_cost_snapshot                                                         Decimal            @default(0) @db.Decimal(14, 4)
  AdminProfile                                                                   AdminProfile       @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
  CustomCakeRequest_CustomCakeQuotation_custom_request_idToCustomCakeRequest     CustomCakeRequest  @relation("CustomCakeQuotation_custom_request_idToCustomCakeRequest", fields: [custom_request_id], references: [custom_request_id], onUpdate: NoAction)
  CustomCakeRequest_CustomCakeRequest_accepted_quotation_idToCustomCakeQuotation CustomCakeRequest? @relation("CustomCakeRequest_accepted_quotation_idToCustomCakeQuotation")
  OrderItem                                                                      OrderItem?

  @@unique([custom_request_id, version_number])
}

model PostDraft {
  draft_id             String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  product_id           String?
  occasion_id          String?
  reviewed_by_admin_id String?
  category             String            @default("new_product_launch")
  caption              String
  img_url              String
  status               String            @default("pending_review")
  regenerate_count     Int               @default(0)
  was_edited           Boolean           @default(false)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  reviewed_at          DateTime?         @db.Timestamptz(6)
  trigger_key          String?           @unique
  SeasonalOccasion     SeasonalOccasion? @relation(fields: [occasion_id], references: [occasion_id], onDelete: Restrict, onUpdate: NoAction)
  Product              Product?          @relation(fields: [product_id], references: [product_id], onDelete: Restrict, onUpdate: NoAction)
  AdminProfile         AdminProfile?     @relation(fields: [reviewed_by_admin_id], references: [admin_id], onDelete: Restrict, onUpdate: NoAction)
}

model SeasonalOccasion {
  occasion_id         String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  created_by_admin_id String
  name                String
  start_date          DateTime     @db.Date
  end_date            DateTime     @db.Date
  status              String       @default("active")
  created_at          DateTime     @default(now()) @db.Timestamptz(6)
  updated_at          DateTime     @default(now()) @db.Timestamptz(6)
  PostDraft           PostDraft[]
  AdminProfile        AdminProfile @relation(fields: [created_by_admin_id], references: [admin_id], onUpdate: NoAction)
}

model NotificationLog {
  notification_log_id  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  recipient_account_id String
  type                 String    @default("order_confirmed")
  provider             String    @default("brevo")
  status               String    @default("pending")
  error_message        String?
  sent_at              DateTime? @db.Timestamptz(6)
  related_entity_type  String    @default("order")
  related_entity_id    String
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  attempt_count        Int       @default(0)
  next_attempt_at      DateTime? @db.Timestamptz(6)
  provider_message_id  String?
  event_key            String?   @unique
  Account              Account   @relation(fields: [recipient_account_id], references: [account_id], onUpdate: NoAction)
}

model SystemNotification {
  system_notification_id String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  recipient_role         String    @default("admin")
  notification_type      String    @default("new_order")
  message                String
  related_entity_type    String    @default("order")
  related_entity_id      String
  is_read                Boolean   @default(false)
  read_at                DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
}

model CustomerFeedback {
  feedback_id        String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_item_id      String          @unique
  customer_id        String
  hidden_by_admin_id String?
  rating             Int
  comment            String?
  status             String          @default("visible")
  hidden_reason      String?
  hidden_at          DateTime?       @db.Timestamptz(6)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  CustomerProfile    CustomerProfile @relation(fields: [customer_id], references: [customer_id], onUpdate: NoAction)
  AdminProfile       AdminProfile?   @relation(fields: [hidden_by_admin_id], references: [admin_id], onDelete: Restrict, onUpdate: NoAction)
  OrderItem          OrderItem       @relation(fields: [order_item_id], references: [order_item_id], onUpdate: NoAction)
  FeedbackImage      FeedbackImage[]
}

model FeedbackImage {
  feedback_image_id String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  feedback_id       String
  img_url           String
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  CustomerFeedback  CustomerFeedback @relation(fields: [feedback_id], references: [feedback_id], onUpdate: NoAction)
}
